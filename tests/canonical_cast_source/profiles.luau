local Profiles=require('../../src/server/gameplay/CanonicalCastProfiles')
local passed=0
local function check(name,fn) fn();passed+=1;print('PASS source profiles '..name) end
check('frozen bank-specific identity',function()
    assert(Profiles.get('DarkQueen').namespace=='heroStatic:Queen')
    assert(Profiles.get('Buzzball').namespace=='heroStatic:Clinger')
    assert(Profiles.get('Shark').namespace=='object:Tubes')
    assert(Profiles.get('Mr. Brown')==Profiles.get('Hero'))
    assert(not pcall(function() Profiles.get('Pig').neutralFrame=0 end))
end)
check('explicit locomotion phase has exact ordered source frames',function()
    local expected={3,4,3,2}
    for phase=0,7 do assert(Profiles.sample('Pig',{mode='Walk',phase=phase}).frameId==expected[phase%4+1]) end
    assert(Profiles.sample('Dragon',{mode='Fly',phase=2}).frameId==10)
    assert(Profiles.sample('Hammerfish',{mode='Swim',phase=1}).frameId==0xDA)
end)
check('unknown counters and untraced states stay unknown',function()
    local row,code=Profiles.sample('Pig',{mode='Walk'})
    assert(row==nil and code=='UNKNOWN_STATE')
    assert(Profiles.sample('Hordhead',{mode='Walk',phase=2})==nil)
    assert(Profiles.sample('GasTurret',{state='GasProjectile',phase=2})==nil)
    assert(Profiles.sample('Snowman',{state='Dead'})==nil)
    assert(Profiles.sample('Pig',{state='HeavyReaction',timerRaw=256})==nil)
    assert(Profiles.sample('RetroBlaster',{state='Reaction',speed=0/0})==nil)
end)
check('reaction frames obey raw source thresholds',function()
    assert(Profiles.sample('Pig',{state='LightReaction',timerRaw=0x3A}).frameId==4)
    assert(Profiles.sample('Pig',{state='LightReaction',timerRaw=0x3B}).frameId==7)
    assert(Profiles.sample('Dragon',{state='HeavyDisabled'}).frameId==10)
    assert(Profiles.sample('RetroBlaster',{state='Reaction',speed=1}).frameId==0x60)
end)
check('source hero jump tests signed byte branch without a guessed cycle',function()
    assert(Profiles.sample('Hero',{state='Airborne',verticalSpeed=-2}).frameId==0x2D)
    assert(Profiles.sample('Hero',{state='Airborne',verticalSpeed=3}).frameId==5)
    assert(Profiles.sample('Hero',{state='Airborne'})==nil)
end)
check('boss floor branch and source clips retain high bit metadata',function()
    assert(Profiles.sample('BigBlag',{state='Airborne'}).frameId==0xF1)
    assert(Profiles.sample('RoboManus',{state='Grounded'}).frameId==0xF8)
    assert(Profiles.get('GeneralSlaughter').attackClips[1].animationIds[1]==0x86)
    assert(Profiles.get('GeneralSlaughter').attackClips[1].postprocess=='OR0x80')
    assert(Profiles.sample('DarkQueen',{state='Airborne'}).appliesDamage==false)
end)
print('PASS source profile contracts',passed)
