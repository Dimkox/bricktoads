local Input=require('../src/client/MovementInput')
local input=Input.new()
input:press('Right',0)
local v=input:vector({x=-1,z=0},true)
assert(v.x==1 and v.z==0,'Tower right is tangent input; an orbiting camera must not transform it twice')
input:release('Right');input:press('Forward',.1)
v=input:vector({x=-1,z=0},true)
assert(v.x==0 and v.z==-1,'native up must keep its mode-local vertical/radial meaning')
v=input:vector({x=-1,z=0},false)
assert(v.x==-1 and v.z==0,'ordinary free ground movement must remain camera-relative')
print('CampaignInput: mode-local arrows and ordinary camera-relative movement passed')
