local function heroContext(id,now)
    return {enabled=true,actorId=id,now=now or 0,dt=0,grounded=true,mode='Idle',speed=0}
end
local function heroAttack(id,action,start)
    return {actorId=id,action=action,at=(start or 0)+.1,tuning={windup=.1}}
end
test('source punch drives real cosmetic C0 while preserving every physical R6 joint',function()
    local a=actor('source-punch');assert(Appearance.attach(a,'Mr. Green',canonicalTemplates()))
    local before={};for name,row in pairs(a.poseMotors)do before[name]=row.joint.C0 end
    local c=heroContext('source-punch');c.attack=heroAttack(c.actorId,'HeroJab')
    Appearance.update(a,c)
    local shoulder=a.appearance.joints.RightShoulder
    assert(shoulder.motor.C0.rx-shoulder.base.rx>1,'Source19 must visibly extend the punching arm')
    assert(a.appearance.joints.RightElbow.motor.C0.rx-a.appearance.joints.RightElbow.base.rx<.25)
    for name,row in pairs(a.poseMotors)do assert(row.joint.C0==before[name],'Presentation cannot write the physical '..name)end
    assert(a.humanoid.Health==100 and a.model.Torso.CanCollide and not a.root.Anchored)
end)
test('source kick really changes thigh and lower-leg targets and finishes at neutral',function()
    local a=actor('source-kick');assert(Appearance.attach(a,'Mr. Yellow',canonicalTemplates()))
    local c=heroContext('source-kick',17/60);c.attack=heroAttack(c.actorId,'HeroKick')
    Appearance.update(a,c)
    local hip=a.appearance.joints.RightHip
    assert(hip.motor.C0.rx-hip.base.rx>1,'Source20 must visibly extend the kicking leg')
    local knee=a.appearance.joints.RightKnee;assert(math.abs(knee.motor.C0.rx-knee.base.rx)<.25)
    c.now=2;Appearance.update(a,c)
    for _,joint in pairs(a.appearance.joints)do
        assert(math.abs(joint.motor.C0.rx-joint.base.rx)<1e-6 and math.abs(joint.motor.C0.ry-joint.base.ry)<1e-6
            and math.abs(joint.motor.C0.rz-joint.base.rz)<1e-6,'A finished clip must clear every extended joint')
    end
end)
test('priority fallback restores existing R6 pose and cannot resurrect a canceled source attack',function()
    local a=actor('source-priority');assert(Appearance.attach(a,'Mr. Green',canonicalTemplates()))
    local c=heroContext('source-priority');c.attack=heroAttack(c.actorId,'HeroBoot')
    Appearance.update(a,c);c.now=.5;Appearance.update(a,c)
    assert(a.appearance.joints.RightHip.motor.C0.rx-a.appearance.joints.RightHip.base.rx>1)
    a.poseMotors['Right Shoulder'].joint.C0=cf.Angles(.65,0,.25)
    c.blocked='Reaction';Appearance.update(a,c)
    assert(math.abs(a.appearance.joints.RightShoulder.motor.C0.rx-.65)<1e-6)
    c.blocked=nil;c.now=.6;Appearance.update(a,c)
    assert(a.appearance.joints.RightHip.motor.C0.rx==a.appearance.joints.RightHip.base.rx)
end)
test('new accepted action replaces actual source arm and leg joints in one presentation update',function()
    local a=actor('source-replace');assert(Appearance.attach(a,'Mr. Green',canonicalTemplates()))
    local c=heroContext('source-replace',.5);c.attack=heroAttack(c.actorId,'HeroBoot')
    Appearance.update(a,c);assert(a.appearance.joints.RightHip.motor.C0.rx>1)
    c.attack=heroAttack(c.actorId,'HeroJab',.5);Appearance.update(a,c)
    assert(a.appearance.joints.RightHip.motor.C0.rx<1 and a.appearance.joints.RightShoulder.motor.C0.rx>1)
end)
test('source presentation state belongs to each cosmetic attachment and detaches safely',function()
    local a,b=actor('source-a'),actor('source-b');local templates=canonicalTemplates()
    assert(Appearance.attach(a,'Mr. Green',templates)and Appearance.attach(b,'Mr. Yellow',templates))
    local c=heroContext('source-a');c.attack=heroAttack(c.actorId,'HeroJab')
    Appearance.update(a,c);Appearance.update(b,heroContext('source-b'))
    assert(a.appearance.joints.RightShoulder.motor.C0.rx>1 and b.appearance.joints.RightShoulder.motor.C0.rx==0)
    local old=a.appearance;Appearance.detach(a);assert(old.model.destroyed and not a.appearance)
    assert(b.appearance.model.Parent==b.model and b.humanoid.Health==100)
end)
test('legacy appearance continues its established retarget even with canonical action context',function()
    local a=actor('source-legacy');assert(Appearance.attach(a,'Mr. Green'))
    local c=heroContext('source-legacy');c.attack=heroAttack(c.actorId,'HeroJab')
    Appearance.update(a,c)
    assert(a.appearance.joints.RightShoulder.motor.C0.rx==0)
    assert(math.abs(a.appearance.joints.RightShoulder.motor.C0.rz+math.rad(45))<1e-6)
end)
print('Source-presentation appearance wiring: 6 passed')
