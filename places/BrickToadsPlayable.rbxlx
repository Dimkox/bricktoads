    ["Buzzball"]={["kind"]="Buzzball",["namespace"]="heroStatic:Clinger",["spriteNamespace"]="heroStatic",["bankRecipe"]="Clinger",["neutralFrame"]=124,["locomotion"]={["frames"]={124,125,126,127},["clockBasis"]="Triangular FrameCounter-derived signed increment is added directly to Obj_various_cnt; top-two-bit phase selects7C+phase.",["source"]="main.asm:14783-14803"},["sourceFrameSelectors"]={{["state"]="ChaseToCombatPulse",["frames"]={0},["rule"]="At zero Xspeed, cnt3 transition pulses hidden gfx0 when FrameCounter&amp;4==0, then changes type7AB†’7B without actor replacement.",["source"]="main.asm:14843-14866"}},["attackClips"]={},["unknown"]={"Combat movement/bounces are physics and shared BigBlag helper, not a distinct source attack-pointer clip."}},
