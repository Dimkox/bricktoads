        <Item class="ModuleScript" referent="BT31">
          <Properties>
            <string name="Name">DragonWorld</string>
            <ProtectedString name="Source">-- Roblox physical boundary for same-body Dragon transport; all coordinates passed in are group-local.
local Workspace=game:GetService('Workspace')
local function living(world,id)
    local a=world.actors[id]
    return a and a.root.Parent and a.humanoid.Health&gt;0 and a or nil
end
local function facing(a)
    local v=a.root.CFrame.LookVector
    if not v then return 1,0 end
    local n=math.sqrt(v.X*v.X+v.Z*v.Z)
    if n&lt;.001 then return 1,0 end
    return v.X/n,v.Z/n
end
return function(World)
    if World.dragonMotion then return World end
    local previousNew,previousMove,previousReaction,previousClear=World.new,World.move,World.setReaction,World.clearActors
    function World.new(...)
        local self=previousNew(...)
        self.dragonFlights,self.dragonLinks,self.dragonFires={},{},{}
        self.dragonOverlap=OverlapParams.new();self.dragonOverlap.FilterType=Enum.RaycastFilterType.Include
        self.dragonOverlap.FilterDescendantsInstances={self.geometry};self.dragonOverlap.RespectCanCollide=true
        self.dragonFireFolder=Instance.new('Folder');self.dragonFireFolder.Name='DragonFire';self.dragonFireFolder.Parent=self.folder
        return self
    end
    function World:dragonFloor(id)
        local a=living(self,id);if not a then return nil end
        local p=a.root.Position
        local hit=Workspace:Raycast(p,Vector3.new(0,-64,0),self.ray)
        if hit and hit.Normal.Y&gt;.9 and not hit.Instance:GetAttribute('Hazard') then return hit.Position.Y-self.offset.Y+3 end
    end
    function World:dragonGrounded(id)
        local a=living(self,id);if not a or a.root.Anchored then return false end
        local hit=Workspace:Raycast(a.root.Position,Vector3.new(0,-3.5,0),self.ray)
        return hit~=nil and hit.Normal.Y&gt;.9 and not hit.Instance:GetAttribute('Hazard')
            and math.abs(a.root.AssemblyLinearVelocity.Y)&lt;2
    end
    function World:dragonCanMount(slot,id,range,height)
        local hero,dragon=living(self,slot),living(self,id)
        if not hero or not dragon or hero.root.Anchored or hero.humanoid.PlatformStand
            or self.dragonLinks[slot] or hero.model:GetAttribute('CarryingEnemy') then return false end
        local delta=dragon.root.Position-hero.root.Position
        if delta.Magnitude&gt;range or math.abs(delta.Y)&gt;height or not self:dragonGrounded(slot) then return false end
        return Workspace:Raycast(hero.root.Position,delta,self.ray)==nil
    end
    function World:dragonAscentBlocked(id,height)
        local a=living(self,id);if not a then return false end
        local rise=height+self.offset.Y-a.root.Position.Y
        if rise&lt;=0 then return false end
        local ceiling=Workspace:Raycast(a.root.Position,Vector3.new(0,rise,0),self.ray)
        return ceiling~=nil and ceiling.Instance.CanCollide and ceiling.Normal.Y&lt;-.9
    end
    function World:dragonMotion(id,x,z,height,speed)
        local a=living(self,id);if not a or a.root.Anchored then return false end
        local row=self.dragonFlights[id]
        if row and row.actor~=a then self:stopDragon(id);row=nil end
        if self:dragonAscentBlocked(id,height) then
            -- Restore ordinary gravity once. A blocked retry must not
            -- recreate lift or erase the body's subsequent falling speed.
            self:stopDragon(id)
            return false,'ASCENT_BLOCKED'
        end
        if not row then
            if a.humanoid.PlatformStand then return false end
            self:resetLocomotion(id,a)
            local attachment=Instance.new('Attachment');attachment.Name='DragonLift';attachment.Parent=a.root
            local force=Instance.new('VectorForce');force.Name='DragonGravity';force.Attachment0=attachment
            force.RelativeTo=Enum.ActuatorRelativeTo.World;force.ApplyAtCenterOfMass=true;force.Parent=a.root
            row={actor=a,attachment=attachment,force=force,platformStand=a.humanoid.PlatformStand,
                evaluate=a.humanoid.EvaluateStateMachine,autoRotate=a.humanoid.AutoRotate,walkSpeed=a.humanoid.WalkSpeed}
            self.dragonFlights[id]=row
            if a.root:CanSetNetworkOwnership() then a.root:SetNetworkOwner(nil) end
        end
        a.humanoid.EvaluateStateMachine=false;a.humanoid.PlatformStand=true;a.humanoid.AutoRotate=false;a.humanoid.WalkSpeed=0
        row.force.Force=Vector3.new(0,a.root.AssemblyMass*Workspace.Gravity,0)
        local p=a.root.Position-self.offset
        local bounds=self.config.Level and self.config.Level.bounds
        if bounds then
            if (p.X&lt;=bounds.minX+2 and x&lt;0) or (p.X&gt;=bounds.maxX-2 and x&gt;0) then x=0 end
            if (p.Z&lt;=bounds.minZ+2 and z&lt;0) or (p.Z&gt;=bounds.maxZ-2 and z&gt;0) then z=0 end
        end
        local vertical=math.clamp((height-p.Y)*6,-14,14)
        a.root.AssemblyLinearVelocity=Vector3.new(x*speed,vertical,z*speed)
        a.root.AssemblyAngularVelocity=Vector3.new()
        if x*x+z*z&gt;.001 then
            local origin=a.root.Position;a.root.CFrame=CFrame.lookAt(origin,origin+Vector3.new(x,0,z))
        end
        a.model:SetAttribute('DragonFlight',true)
        return true
    end
    function World:stopDragon(id)
        local row=self.dragonFlights[id];if not row then return end
        self.dragonFlights[id]=nil;row.force:Destroy();row.attachment:Destroy()
        local a=row.actor;a.model:SetAttribute('DragonFlight',nil)
        if a.root.Parent then
            a.humanoid.EvaluateStateMachine=row.evaluate;a.humanoid.PlatformStand=row.platformStand
            a.humanoid.AutoRotate=row.autoRotate;a.humanoid.WalkSpeed=row.walkSpeed
            a.root.AssemblyLinearVelocity=Vector3.new();a.root.AssemblyAngularVelocity=Vector3.new()
        end
    end
    function World:dragonLink(id,slot,mode)
        local dragon,hero=living(self,id),living(self,slot)
        if not dragon or not hero or (mode~='Mounted' and mode~='Captured') then return false end
        local row=self.dragonLinks[slot]
        if row and (row.hero~=hero or row.dragon~=dragon or row.mode~=mode) then return false end
        for other,link in pairs(self.dragonLinks) do if other~=slot and link.dragon==dragon then return false end end
        if not row then
            if hero.root.Anchored then return false end
            self:resetLocomotion(slot,hero)
            row={hero=hero,dragon=dragon,id=id,mode=mode,collisions={},anchored=hero.root.Anchored,
                evaluate=hero.humanoid.EvaluateStateMachine,platformStand=hero.humanoid.PlatformStand,
                autoRotate=hero.humanoid.AutoRotate,walkSpeed=hero.humanoid.WalkSpeed}
            for _,p in ipairs(hero.model:GetDescendants()) do if p:IsA('BasePart') then row.collisions[p]=p.CanCollide;p.CanCollide=false end end
            self.dragonLinks[slot]=row
        end
        -- A previous walking intent must not survive the period of linked physics.
        -- Physical flags are restored on release; voluntary movement is never replayed.
        hero.humanoid:Move(Vector3.new(),false)
        hero.humanoid.EvaluateStateMachine=false;hero.humanoid.PlatformStand=true
        hero.humanoid.AutoRotate=false;hero.humanoid.WalkSpeed=0;hero.root.Anchored=true
        hero.root.AssemblyLinearVelocity=Vector3.new();hero.root.AssemblyAngularVelocity=Vector3.new()
        local p=dragon.root.Position;local x,z=facing(dragon)
        local y=p.Y+(mode=='Mounted' and 3.2 or -2.4)
        if mode=='Captured' then local floor=self:dragonFloor(id);if floor then y=math.max(y,floor+self.offset.Y) end end
        local position=Vector3.new(p.X,y,p.Z)
        hero.model:PivotTo(CFrame.lookAt(position,position+Vector3.new(x,0,z)))
        hero.model:SetAttribute('DragonLink',mode);hero.model:SetAttribute('DragonId',id)
        return true
    end
    function World:dragonUnlink(slot,jump)
        local row=self.dragonLinks[slot];if not row then return false end
        self.dragonLinks[slot]=nil
        local a=row.hero;a.model:SetAttribute('DragonLink',nil);a.model:SetAttribute('DragonId',nil)
        self:resetLocomotion(slot,a)
        if a.root.Parent then
            a.humanoid:Move(Vector3.new(),false)
            a.root.Anchored=row.anchored;a.humanoid.EvaluateStateMachine=row.evaluate
            a.humanoid.PlatformStand=row.platformStand;a.humanoid.AutoRotate=row.autoRotate;a.humanoid.WalkSpeed=row.walkSpeed
            for p,value in pairs(row.collisions) do if p.Parent then p.CanCollide=a.humanoid.Health&gt;0 and value or false end end
            if a.root:CanSetNetworkOwnership() then a.root:SetNetworkOwner(nil) end
            if jump and a.humanoid.Health&gt;0 and not row.anchored and not row.platformStand then
                local velocity=row.dragon.root.Parent and row.dragon.root.AssemblyLinearVelocity or Vector3.new()
                a.root.AssemblyLinearVelocity=Vector3.new(velocity.X,18,velocity.Z)
            end
        end
        return true
    end
    function World:hold(id,held)
        if held then self:resetLocomotion(id) end
        local row=self.dragonLinks[id]
        if row then row.anchored=held;return end
        self._base.hold(self,id,held)
    end
    function World:move(id,x,z,runRequested)
        if self.dragonLinks[id] or self.dragonFlights[id] then return end
        previousMove(self,id,x,z,runRequested)
    end
    function World:setReaction(id,active)
        local row=self.dragonLinks[id]
        if row then
            if active then self:resetLocomotion(id,row.hero) end
            row.platformStand=active;row.autoRotate=not active;row.walkSpeed=active and 0 or self.config.WalkSpeed
            return
        end
        previousReaction(self,id,active)
    end
    function World:kill(id)
        self:resetLocomotion(id)
        self:dragonUnlink(id)
        for slot,row in pairs(self.dragonLinks) do if row.id==id then self:dragonUnlink(slot) end end
        self:stopDragon(id)
        self._base.kill(self,id)
    end
    function World:dragonMuzzle(id)
        local a=living(self,id);if not a then return nil end
        local p=self:position(id);local x,z=facing(a)
        local origin=Vector3.new(p.x,p.y+.25,p.z)+self.offset
        local reach=Vector3.new(x*2.8,0,z*2.8)
        local radius=self.config.DragonFlight and self.config.DragonFlight.fireRadius or 1
        local blocked=#Workspace:GetPartBoundsInRadius(origin,radius,self.dragonOverlap)&gt;0
            or Workspace:Spherecast(origin,radius,reach,self.ray)~=nil
        return {x=p.x+x*2.8,y=p.y+.25,z=p.z+z*2.8},{x=x,y=0,z=z},blocked
    end
    function World:dragonFire(id,position)
        local p=self.dragonFires[id]
        if not p then
            p=Instance.new('Part');p.Name='Fire_'..id;p.Shape=Enum.PartType.Ball;p.Size=Vector3.new(1.3,1.3,1.3)
            p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
            p.Material=Enum.Material.Neon;p.Color=Color3.fromRGB(255,174,55);p.Parent=self.dragonFireFolder
            self.dragonFires[id]=p
        end
        p.CFrame=CFrame.new(Vector3.new(position.x,position.y,position.z)+self.offset)
    end
    function World:removeDragonFire(id)
        local p=self.dragonFires[id];if p then p:Destroy();self.dragonFires[id]=nil end
    end
    function World:dragonFireTargets(from,to,radius,exclude)
        local origin=Vector3.new(from.x,from.y,from.z)+self.offset
        local delta=Vector3.new(to.x-from.x,to.y-from.y,to.z-from.z)
        local length=delta.Magnitude;local length2=length*length
        if #Workspace:GetPartBoundsInRadius(origin,radius,self.dragonOverlap)&gt;0 then return {},true end
        local wall=length&gt;0 and Workspace:Spherecast(origin,radius,delta,self.ray) or nil
        local limit=wall and math.min(1,wall.Distance/length) or 1
        local candidates={}
        for id in pairs(self.actors) do
            local a=living(self,id)
            if a and not exclude[id] then
                local p=a.root.Position-origin
                local raw=length2&gt;0 and (p.X*delta.X+p.Y*delta.Y+p.Z*delta.Z)/length2 or 0
                local expanded=radius+2
                local distance2=p.X*p.X+p.Y*p.Y+p.Z*p.Z
                local entry
                if distance2&lt;=expanded*expanded then entry=0
                elseif length2&gt;0 then
                    local dot=p.X*delta.X+p.Y*delta.Y+p.Z*delta.Z
                    local discriminant=dot*dot-length2*(distance2-expanded*expanded)
                    if discriminant&gt;=0 then entry=(dot-math.sqrt(discriminant))/length2 end
                end
                if entry and entry&gt;=0 and entry&lt;=limit and (not wall or raw&lt;=limit) then
                    candidates[#candidates+1]={id=id,t=entry}
                end
            end
        end
        table.sort(candidates,function(a,b) if a.t~=b.t then return a.t&lt;b.t end;return a.id&lt;b.id end)
        local result={};for _,row in ipairs(candidates) do result[#result+1]=row.id end
        return result,wall~=nil
    end
    function World:clearActors()
        for slot in pairs(self.dragonLinks) do self:dragonUnlink(slot) end
        for id in pairs(self.dragonFlights) do self:stopDragon(id) end
        for id in pairs(self.dragonFires) do self:removeDragonFire(id) end
        previousClear(self)
    end
    return World
end
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT32">
          <Properties>
            <string name="Name">EnemyCarry</string>
            <ProtectedString name="Source">-- Existing-body Pig pickup/throw. Reach, timing and ordinary damage are Roblox calibration.
-- Source throw profile17/raw4 is provenance; this module never creates projectile collateral damage.
local EnemyCarry={}
EnemyCarry.__index=EnemyCarry
local function finite(n) return type(n)=='number' and n==n and n&gt;-math.huge and n&lt;math.huge end

function EnemyCarry.new(director)
    return setmetatable({director=director,session=director.session,world=director.world,
        config=director.config.EnemyCarry,now=director.now or director.session.now,
        pending={},pendingBySlot={},states={},holders={}},EnemyCarry)
end

function EnemyCarry:_hero(slot,offline)
    if self.closed or self.director.result or self.session.state.status~='Active' then return nil end
    local h,c=self.session.state.heroes[slot],self.session.combat[slot]
    if not h or h.status~='Alive' or (not offline and not h.connected) or not h.actorId
        or not c or c.deathAt or c.reactionEnd or c.attack or self.world:hazard(slot) then return nil end
    return h,c
end

function EnemyCarry:_sameHero(row,offline)
    local h,c=self:_hero(row.slot,offline)
    return h and h.actorId==row.heroActorId and h.attempt==row.attempt
        and self.session.state.levelEpoch==row.levelEpoch and c==row.combat
        and (c.reactionEpoch or 0)==row.heroReactionEpoch
end

function EnemyCarry:_sameEnemy(row)
    local e=self.director.enemies[row.id]
    return e and e==row.enemy and not e.dead and e.actorId==row.enemyActorId
end

function EnemyCarry:_eligible(id,e,slot)
    return e.kind=='Pig' and not e.boss and not e.dead and not self.states[id]
        and not (e.reactionUntil and self.now&lt;e.reactionUntil) and not self.world:hazard(id)
        and self.world:canGrabEnemy(slot,id,self.config.range,self.config.height,self.config.facingDot)
end

function EnemyCarry:_nearest(slot)
    local origin=self.world:position(slot)
    if not origin then return nil end
    local selected,best=nil,math.huge
    for id,e in pairs(self.director.enemies) do
        if self:_eligible(id,e,slot) then
            local p=self.world:position(id)
            if p then
                local range=(p.x-origin.x)^2+(p.y-origin.y)^2+(p.z-origin.z)^2
                if range&lt;best or (range==best and (not selected or id&lt;selected)) then selected,best=id,range end
            end
        end
    end
    return selected
end

function EnemyCarry:_log(kind,row,data)
    data=data or {}
    data.enemyId=row.id;data.enemyActorId=row.enemyActorId;data.heroActorId=row.heroActorId
    self.session:_record(kind,row.slot,data)
end

function EnemyCarry:_remove(row,reason)
    if self.states[row.id]~=row then return end
    self.states[row.id]=nil
    if self.holders[row.slot]==row.id then self.holders[row.slot]=nil end
    self.world:releaseEnemy(row.id)
    local e=self.director.enemies[row.id]
    if row.mode=='Thrown' and e==row.enemy and e.reactionUntil==row.untilTime then
        if e.rawLife~=nil and reason=='FlightComplete' then self.director:_finishReaction(row.id,e)
        else e.reactionUntil=nil;e.heavyReaction=nil;self.world:setReaction(row.id,false) end
    end
    if row.mode=='Carried' then self:_log('EnemyDropped',row,{reason=reason}) end
end

function EnemyCarry:stateFor(id)
    local row=self.states[id]
    return row and row.mode or nil
end

function EnemyCarry:blocksEnemy(id)
    return self.states[id]~=nil
end

function EnemyCarry:interaction(slot)
    self.now=math.max(self.now,self.session.now,self.director.now or 0)
    local id=self.holders[slot];local row=id and self.states[id]
    if row and row.mode=='Carried' then
        return {available=self:_sameHero(row,false)==true and self:_sameEnemy(row)==true and not self.world:hazard(row.id),
            carrying=true,kind='EnemyCarry',label="THROW ENEMY"}
    end
    if not self:_hero(slot) or self.pendingBySlot[slot] then return {available=false,carrying=false} end
    return {available=self:_nearest(slot)~=nil,carrying=false,kind='EnemyCarry',label="GRAB"}
end

function EnemyCarry:_throw(row,now)
    if not self:_sameHero(row,false) or not self:_sameEnemy(row) then
        self:_remove(row,'HolderChanged');return 'NO_INTERACTION'
    end
    if self.world:hazard(row.id) then
        self.director:_kill(row.id);self:forgetEnemy(row.id);return 'NOT_ALIVE'
    end
    local h=self.session.state.heroes[row.slot]
    local code=self.session:_event('BeginAttack',row.slot,{connectionEpoch=h.connectionEpoch})
    if code~='OK' then return code end
    self.world:hold(row.slot,false)
    if not self.world:releaseEnemy(row.id,row.slot,self.config) then return 'CARRY_RELEASE_FAILED' end
    row.mode='Thrown';row.untilTime=now+self.config.reaction
    row.throwConnectionEpoch=h.connectionEpoch
    self.holders[row.slot]=nil
    local e=row.enemy
    e.windup=nil;e.lastMove=nil;e.reactionUntil=row.untilTime
    self.world:setReaction(row.id,true)
    local before=e.health
    -- The existing death callback may forget this very state. Do not recreate it afterward.
    self.director:applyThrowDamage(row.id,row.slot)
    row.enemyReactionEpoch=e.reactionEpoch or 0
    self:_log('EnemyThrown',row,{before=before,after=e.health,damage=self.config.throwDamage,
        sourceProfile=self.config.sourceProfile,sourceRawDamage=self.config.sourceRawDamage})
    return 'OK'
end

function EnemyCarry:interact(slot,now,action)
    if not finite(now) or now&lt;self.now then return 'INVALID_TIME' end
    self.now=now
    if self.closed or self.director.result or self.session.state.status~='Active' then return 'NO_INTERACTION' end
    local id=self.holders[slot];local held=id and self.states[id]
    if held and held.mode=='Carried' then
        if action~='Punch' then return 'HANDS_FULL' end
        return self:_throw(held,now)
    end
    if action~='Punch' then return 'NO_INTERACTION' end
    local h,c=self:_hero(slot)
    if not h then return 'NO_INTERACTION' end
    if self.pendingBySlot[slot] then return 'COOLDOWN' end
    id=self:_nearest(slot)
    if not id then return 'NO_INTERACTION' end
    local code=self.session:_event('BeginAttack',slot,{connectionEpoch=h.connectionEpoch})
    if code~='OK' then return code end
    self.world:hold(slot,false)
    local e=self.director.enemies[id]
    local row={id=id,slot=slot,enemy=e,enemyActorId=e.actorId,enemyReactionEpoch=e.reactionEpoch or 0,
        heroActorId=h.actorId,attempt=h.attempt,levelEpoch=self.session.state.levelEpoch,
        combat=c,heroReactionEpoch=c.reactionEpoch or 0,at=now+self.config.windup}
    row.expiresAt=row.at+self.config.window
    self.pending[#self.pending+1]=row;self.pendingBySlot[slot]=row
    e.engaged=true
    self:_log('EnemyGrabAccepted',row)
    return 'OK'
end

function EnemyCarry:_capture(row)
    if row.cancelled or self.now&gt;row.expiresAt or self.holders[row.slot]
        or not self:_sameHero(row,true) or not self:_sameEnemy(row)
        or (row.enemy.reactionEpoch or 0)~=row.enemyReactionEpoch
        or not self:_eligible(row.id,row.enemy,row.slot) then return end
    -- Director resolves expired reactions later in this tick. Normalize that
    -- old physics before World saves it, so a future drop cannot restore it.
    if row.enemy.reactionUntil and self.now&gt;=row.enemy.reactionUntil then
        if row.enemy.rawLife~=nil then self.director:_finishReaction(row.id,row.enemy)
        else row.enemy.reactionUntil=nil;self.world:setReaction(row.id,false) end
    end
    if not self.world:carryEnemy(row.id,row.slot) then return end
    row.mode='Carried';self.states[row.id]=row;self.holders[row.slot]=row.id
    row.enemy.windup=nil;row.enemy.lastMove=nil;row.enemy.reactionUntil=nil
    self.world:move(row.id,0,0)
    self:_log('EnemyGrabbed',row,{health=row.enemy.health,ownerUserId=row.enemy.ownerUserId})
end

function EnemyCarry:step(now)
    if not finite(now) or now&lt;self.now then return 'INVALID_TIME' end
    self.now=now
    if self.closed then return 'RUN_CLOSED' end
    if self.director.result or self.session.state.status~='Active' then self:close();return 'RUN_CLOSED' end
    local active={}
    for id in pairs(self.states) do active[#active+1]=id end
    table.sort(active)
    for _,id in ipairs(active) do
        local row=self.states[id]
        if row then
            local sameEnemy=self:_sameEnemy(row)
            local hazard=sameEnemy and self.world:hazard(id)
            if not sameEnemy then self:_remove(row,'EnemyChanged')
            elseif hazard then
                self.director:_kill(id);self:forgetEnemy(id)
                local hero=self.session.state.heroes[row.slot]
                if self.session.onHeroEnemyDefeated and row.mode=='Thrown' and now&lt;=row.untilTime
                    and (hazard=='Fall' or hazard=='Surface') and row.enemy.dead
                    and (row.enemy.reactionEpoch or 0)==row.enemyReactionEpoch
                    and hero and hero.connected and hero.connectionEpoch==row.throwConnectionEpoch then
                    self.session.onHeroEnemyDefeated(row.slot)
                end
            elseif row.mode=='Carried' then
                if not self:_sameHero(row,true) or (row.enemy.reactionEpoch or 0)~=row.enemyReactionEpoch then
                    self:_remove(row,'Interrupted')
                elseif not self.world:carryEnemy(id,row.slot) then self:_remove(row,'PhysicalLinkLost') end
            elseif (row.enemy.reactionEpoch or 0)~=row.enemyReactionEpoch then self:_remove(row,'EnemyInterrupted')
            elseif now&gt;=row.untilTime then self:_remove(row,'FlightComplete') end
        end
    end
    local future={}
    for _,row in ipairs(self.pending) do
        if row.cancelled or now&gt;=row.at then
            if self.pendingBySlot[row.slot]==row then self.pendingBySlot[row.slot]=nil end
            if not row.cancelled then self:_capture(row) end
        else future[#future+1]=row end
    end
    self.pending=future
    return 'OK'
end

function EnemyCarry:forgetEnemy(id)
    local row=self.states[id]
    if row then self:_remove(row,'EnemyReleased') end
    for _,pending in ipairs(self.pending) do
        if pending.id==id then
            pending.cancelled=true
            if self.pendingBySlot[pending.slot]==pending then self.pendingBySlot[pending.slot]=nil end
        end
    end
end

function EnemyCarry:close()
    if self.closed then return end
    self.closed=true
    local active={};for id in pairs(self.states) do active[#active+1]=id end
    for _,id in ipairs(active) do self:_remove(self.states[id],'RunClosed') end
    self.pending={};self.pendingBySlot={};self.holders={}
end

return EnemyCarry
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT33">
          <Properties>
            <string name="Name">FirstMinute</string>
            <ProtectedString name="Source">-- All entry metrics share the server join timestamp across group changes and restarts.
local FirstMinute = {}
FirstMinute.__index = FirstMinute

local starter = "FirstMinute"
local gameplay = "FirstMinuteGameplay"
local challenge = "FirstMinuteProgress"
local challenge120 = "EntryProgress120s"
local retention = "EntryRetention120s"
local manual120 = "EntryStart120s"
local windows = {[challenge120]=120, [manual120]=120}
local milestones = {"Joined", "Hero spawned", "First challenge engaged", "First challenge cleared"}
local labels = {
    [starter]={"Joined", "Pressed Start", "Hero spawned", "Damaged enemy", "Defeated enemy"},
    [gameplay]={"Joined", "Hero spawned", "Damaged enemy", "Defeated enemy"},
    [challenge]=milestones, [challenge120]=milestones,
    [manual120]={"Joined", "Pressed Start"},
    [retention]={"Joined", "Still here at 30s", "Still here at 60s", "Still here at 120s"},
}

function FirstMinute.new(clock, guid, log, reportError, schedule)
    return setmetatable({clock=clock, guid=guid, log=log, reportError=reportError or warn, schedule=schedule,
        visits={}, lastWarning={}}, FirstMinute)
end

function FirstMinute:_step(player, funnel, step)
    local visit = self.visits[player]
    if not visit or not visit[funnel] then return end
    if funnel ~= retention and self.clock() - visit.joined &gt; (windows[funnel] or 60) then return end
    local progress = visit[funnel]
    -- Roblox fills skipped steps automatically. Only submit a step after its actual predecessor.
    if step &gt; progress.observed + 1 then return end
    progress.observed = math.max(progress.observed, step)
    -- A later action can retry delivery of already observed steps, in order.
    while progress.sent &lt; progress.observed do
        local nextStep = progress.sent + 1
        if not pcall(self.log, player, funnel, visit.id, nextStep, labels[funnel][nextStep], visit.route) then
            local now = self.clock()
            if now - (self.lastWarning[funnel] or -math.huge) &gt;= 60 then
                self.lastWarning[funnel] = now
                self.reportError(("[BrickToads] Analytics delivery failed: %s step %d"):format(funnel, nextStep))
            end
            return
        end
        progress.sent = nextStep
    end
end

function FirstMinute:_measurePresence(player, visit)
    if self.visits[player] ~= visit then return end
    local elapsed = self.clock() - visit.joined
    if elapsed &gt;= 30 then self:_step(player, retention, 2) end
    if elapsed &gt;= 60 then self:_step(player, retention, 3) end
    if elapsed &gt;= 120 then self:_step(player, retention, 4) end
end

function FirstMinute:join(player)
    local existing = self.visits[player]
    if existing then return existing.route end
    local joined = self.clock()
    local ok, data = pcall(function() return player:GetJoinData() end)
    local route = ok and type(data) == "table" and data.LaunchData == "speeder" and "speeder" or "untagged"
    local visit = {joined=joined, id=self.guid(), route=route}
    self.visits[player] = visit
    for funnel in pairs(labels) do
        if funnel ~= manual120 or route == "untagged" then
            visit[funnel] = {observed=0, sent=0}
            self:_step(player, funnel, 1)
        end
    end
    if self.schedule then
        local function measure() self:_measurePresence(player, visit) end
        for _, threshold in ipairs({30, 60, 120}) do
            self.schedule(math.max(0, joined + threshold - self.clock()), measure)
        end
    end
    return route
end

function FirstMinute:leave(player)
    local visit = self.visits[player]
    if visit then self:_measurePresence(player, visit) end
    self.visits[player] = nil
end

function FirstMinute:startPressed(player)
    self:_step(player, starter, 2)
    self:_step(player, manual120, 2)
end

function FirstMinute:_challenge(player, step, route)
    local visit = self.visits[player]
    if visit and (not route or visit.route == route) then
        self:_step(player, challenge, step)
        self:_step(player, challenge120, step)
    end
end

function FirstMinute:spawned(player)
    self:_step(player, starter, 3)
    self:_step(player, gameplay, 2)
    self:_challenge(player, 2)
end

function FirstMinute:enemyHit(player, defeated)
    self:_step(player, starter, 4)
    self:_step(player, gameplay, 3)
    self:_challenge(player, 3, "untagged")
    if defeated then self:enemyDefeated(player) end
end

function FirstMinute:enemyDefeated(player)
    self:_step(player, starter, 5)
    self:_step(player, gameplay, 4)
    self:_challenge(player, 4, "untagged")
end

function FirstMinute:boarded(player)
    self:_challenge(player, 3, "speeder")
end

function FirstMinute:passedFirstWall(player)
    self:_challenge(player, 4, "speeder")
end

return FirstMinute
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT34">
          <Properties>
            <string name="Name">GameConfig</string>
            <ProtectedString name="Source">-- Original playable prototype calibration. Resource limits are canonical.
-- Enemy damage and spatial/timing values still need the full source transfer.
return function(base,level)
    local config=table.clone(base)
    config.Attacks=table.clone(base.Attacks)
    config.Impulses=table.clone(base.Impulses)
    -- Internal Club is never a permitted client attack name. Distances/times are calibrated.
    config.Attacks.Club={windup=.16,window=.16,cooldown=.7,reaction=.75,reach=9,width=3.5,height=4}
    config.Impulses[2]={horizontal=26,vertical=22}
    config.Impulses[20]={horizontal=26,vertical=22}
    config.WalkerClub={pickupRange=4.5,pickupHeight=3,npcDamage=2}
    config.Calibration='PLAYABLE_PROTOTYPE'
    config.Enemy={hearts=3,punchDamage=1,dashDamage=2,speed=9,range=5,windup=.65,cooldown=1.6,reaction=.35,attack='Dash'}
    -- Source standing28/2A and running40 effects; all seconds/studs are Roblox tuning.
    config.Attacks.PigJab={windup=.30,cooldown=.8,reaction=28/60,reach=6,width=3,height=4,recoveryPose=.20}
    config.Attacks.PigHeavy={windup=.55,cooldown=1.3,reaction=.75,reach=6,width=3,height=4,recoveryPose=.30}
    config.Attacks.PigRush={windup=.22,cooldown=1.4,reaction=.75,reach=6,width=3,height=4,recoveryPose=.35}
    config.Attacks.EnemyRunStrike=table.clone(config.Attacks.PigRush)
    config.Impulses[0]=table.clone(config.Impulses[18])
    config.Impulses[4]=table.clone(config.Impulses[22])
    config.Pig={rushAfterZone=3,rushSpeed=16,alignment=2,decisionInterval=.1,
        rushRoll=32,npcDamage={PigJab=1,PigHeavy=2,PigRush=2},
        npcProfile={PigJab=0,PigHeavy=2,PigRush=4}}
    config.Attacks.WalkerLight={windup=.40,cooldown=1.0,reaction=28/60,reach=7.5,width=3.25,height=4,recoveryPose=.20}
    config.Attacks.WalkerHeavy={windup=.65,cooldown=1.6,reaction=.75,reach=7.5,width=3.25,height=4,recoveryPose=.35}
    config.Walker={range=6.5,minRange=2.5,retreatSpeed=7,
        npcDamage={WalkerLight=1,WalkerHeavy=2},npcProfile={WalkerLight=0,WalkerHeavy=2}}
    -- Ordinary Dragon animation32 has base4/hero22, never the hero Dash finisher.
    config.Attacks.DragonHeadbutt={windup=.35,cooldown=1.25,reaction=.75,reach=6,width=3,height=4,recoveryPose=.25}
    config.Dragon={npcDamage={DragonHeadbutt=2,DragonFire=2},npcProfile={DragonHeadbutt=4,DragonFire=4}}
    config.Attacks.DragonFire={cooldown=.45,reaction=.75}
    config.DragonFlight={speed=10,altitude=1.5,liftSeconds=.4,liftHeight=4,turnSeconds=.3,
        disabledSeconds=6,mountRange=5,mountHeight=4,attackRange=5,
        captureWindup=.25,captureWindow=.3,captureSeconds=1.25,captureHeight=3,
        captureGeometry={reach=6,width=3,height=4},fireLife=2,fireSpeed=32,fireRadius=1}
    config.Boss={hits=3,interval=2.4,projectileSpeed=12,returnSpeed=26,projectileLife=12,aggroRange=45}
    config.BossQueue={inviteSeconds=10,connectSeconds=15}
    config.Groups={maxGroups=4,spacing=512}
    config.Level=level
    -- Studs, seconds and radians/second; not claimed original NES timing.
    config.HealingFlies={range=6,height=3,facingDot=.25,windup=.16,bobHeight=.25,bobSpeed=2}
    -- Original close Pig grab/throw; existing3HP damage is still prototype tuning.
    config.EnemyCarry={range=3.3,height=2.5,facingDot=.5,windup=.12,window=.2,reaction=.85,
        horizontal=26,vertical=16,throwDamage=config.Enemy.punchDamage,sourceProfile=17,sourceRawDamage=4}
    if level then
        config.Calibration='ORIGINAL_3D_ROUTE_STATIC_ROSTER'
        -- Main-route jump budget covers its5-stud gaps and2-stud rises with
        -- takeoff/landing room at16studs/s. The independent stand keeps42.
        config.JumpPower=50
        config.Movement={heroRunSpeed=24,enemyRunSpeed=16,runThresholdRatio=.75,npcRunDistance=12}
        config.SourceCombat={heavyProtection=28/60,npcLightReaction=1.05,npcHeavyReaction=.85}
        for _,action in ipairs({'HeroJab','HeroKick','HeroUppercut','HeroPowerPunch','HeroBoot','HeroElbow'}) do
            config.Attacks[action]=table.clone(config.Attacks.Punch)
            config.Attacks[action].reaction=action=='HeroJab' and 28/60 or .75
            config.Attacks[action].recoveryPose=.2
        end
        config.Impulses[19]={horizontal=24,vertical=20}
        config.Impulses[24]={horizontal=34,vertical=30}
        config.Impulses[28]={horizontal=9,vertical=-12}
        config.Impulses[1]=table.clone(config.Impulses[19])
        config.Impulses[3]=table.clone(config.Impulses[21])
        config.Impulses[6]=table.clone(config.Impulses[24])
        config.Impulses[10]=table.clone(config.Impulses[28])
        -- Source rope animations use ordinary7/13 and hero25/31. Geometry,
        -- reaction seconds and these physical responses remain Roblox tuning.
        config.Attacks.RopeStrike=table.clone(config.Attacks.HeroKick)
        config.Attacks.RopeBoot=table.clone(config.Attacks.HeroKick)
        -- Armed animation48 selects source collision index3 instead of2. The
        -- expanded 3D vertical contact budget is explicit physical calibration.
        config.Attacks.RopeClaw=table.clone(config.Attacks.RopeStrike)
        config.Attacks.RopeClaw.height=config.Attacks.RopeStrike.height+2
        config.Impulses[7]=table.clone(config.Impulses[19])
        config.Impulses[13]=table.clone(config.Impulses[22])
        config.Impulses[25]=table.clone(config.Impulses[24])
        config.Impulses[31]=table.clone(config.Impulses[22])
        config.Boss.interval=1.6
        config.Boss.ballInterval=8
        config.Boss.ballLife=20
        config.Boss.pickupRange=5.5
        config.Boss.rawLife=47
        config.Boss.throwDamage=16
    end
    return config
end
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT35">
          <Properties>
            <string name="Name">GameController</string>
            <ProtectedString name="Source">-- One group's runtime. Player identity comes from the server, never from payload fields.
local Controller={}
Controller.__index=Controller
local templates={['Mr. Green']=true,['Mr. Yellow']=true,['Mr. Brown']=true}
local roles={Hero=true,Enemy=true,Spectator=true}
local bossTypes={CausewayGuardian=true,BigBlag=true,RoboManus=true,GeneralSlaughter=true,Buzzball=true,DarkQueen=true}
local levelHooks={'contextualIntent','beforeHitImpulse','groundRunAllowed','canRunStrike','attackSelector','contextualAttack'}
local function campaignSeed(runId)
    local seed=1
    for index=1,#runId do seed=(seed*131+string.byte(runId,index))%2147483646 end
    return seed+1
end
local actionDenials={NOT_RUNNING=true,REACTION=true,COOLDOWN=true,HELD=true,THROWN=true}
local function variationMetadata(route)
    local value=route and route.variation
    return value and {version=value.version,seed=value.seed,sectionChoices=table.clone(value.sectionChoices)} or nil
end
local function exact(payload,allowed)
    if type(payload)~='table' then return false end
    local count=0
    for key in pairs(payload) do count+=1; if count&gt;4 or not allowed[key] then return false end end
    return true
end
function Controller.new(deps,world)
    deps=table.clone(deps)
    deps.Config=table.clone(deps.Config)
    if deps.Config.Development then deps.Config.Development=table.clone(deps.Config.Development) end
    local self=setmetatable({deps=deps,world=world,connections=deps.Registry.new(),players={},choices={},preferences={},viewChoices={},owners={},ownerSlots={},buckets={},notices={},
        baseLevel=deps.Config.Level,actionFeedback=setmetatable({},{__mode='k'}),actionSerial=setmetatable({},{__mode='k'})},Controller)
    if deps.SharedBossQueue then self.bossQueue=deps.SharedBossQueue
    elseif deps.BossQueue then
        self.bossQueue=deps.BossQueue.new(deps.Config.BossQueue,function(userId,context)
            return self:_bossEligible(userId,context)
        end)
    end
    return self
end
function Controller:_bossEligible(userId,context)
    if not self.current or self:_open() then return true end
    if self.ownerSlots[userId] then return false end
    local role=self.director:controlled(userId)
    return not role or role.status~='Alive' or role.template=='Boss'
end
function Controller:_bossSelection(player)
    if not self:_open() and self.ownerSlots[player.UserId] then return 'HERO_LOCKED' end
    local role=not self:_open() and self.director:controlled(player.UserId)
    if role and role.status=='Alive' then return 'ROLE_ACTIVE' end
    return 'OK'
end
function Controller:_heroes(players)
    local heroes={}
    for _,p in ipairs(self.connections:online(players)) do
        if (self.preferences[p.UserId] or 'Hero')=='Hero' then heroes[#heroes+1]=p end
    end
    return heroes
end
function Controller:_enemyName(player)
    self.director.ownerNames=self.director.ownerNames or {}
    self.director.ownerNames[player.UserId]=player.DisplayName..' @'..player.Name
    self.director.ownerConnections=self.director.ownerConnections or {}
    self.director.ownerConnections[player.UserId]=true
    local role=self.director:controlled(player.UserId)
    if role and role.status=='Alive' and self.world.enemyIdentity then
        self.world:enemyIdentity(role.enemyId,role.actorId,self.director.ownerNames[player.UserId])
    end
end
function Controller:join(player)
    local joined,previous=self.connections:join(player)
    if not joined then return end
    self.players[player.UserId]=player
    if previous then self.actionFeedback[previous]=nil;self.actionSerial[previous]=nil end
    self.actionFeedback[player]=nil
    if self.faulted then return end
    if self.director then self:_enemyName(player) end
    local slot=self.ownerSlots[player.UserId]
    if self.current and slot and self.current.state.status=='Active' and not self.director.result then
        if self.current.state.heroes[slot].connected then self.current:connection(slot,false,self.deps.clock()) end
        self.current:connection(slot,true,self.deps.clock())
    end
    if self.director and not self:_open() then
        local role=self.director:controlled(player.UserId)
        if role then
            if role.connected then self.director:connection(player.UserId,false) end
            self.director:connection(player.UserId,true)
            self:_enemyName(player)
        end
    end
end
function Controller:leave(player)
    local changed=self.connections:remove(player)
    if changed then self.players[player.UserId]=nil end
    if self.faulted then
        self.buckets[player]=nil;self.notices[player]=nil;self.actionFeedback[player]=nil;self.actionSerial[player]=nil
        return
    end
    if changed and self.director then
        self.director.ownerConnections=self.director.ownerConnections or {}
        self.director.ownerConnections[player.UserId]=false
    end
    local slot=self.ownerSlots[player.UserId]
    if changed and self.current and slot and self.current.state.status=='Active' and not self.director.result then
        self.current:connection(slot,false,self.deps.clock())
    end
    if changed and self.director and not self:_open() then self.director:connection(player.UserId,false) end
    self.buckets[player]=nil; self.notices[player]=nil;self.actionFeedback[player]=nil;self.actionSerial[player]=nil
end
function Controller:_open()
    if self.faulted or not self.current or self.current.state.status=='Lost' then return true end
    if not self.director or not self.director.result then return false end
    return self.director.result~='Won' or not self.campaignIndex
        or self.campaignIndex&gt;=self.deps.CampaignDefinition.count or self.finished==true
end

function Controller:_closeDirector(reason)
    local director=self.director
    if not director then return end
    if director.close then director:close(reason)
    else
        if director.cancelBossIntro then director:cancelBossIntro(reason) end
        for _,name in ipairs({'flies','carry','clubs','dragons'}) do
            local component=director[name]
            if component and component.close then component:close(reason) end
        end
    end
end

function Controller:_createDirector(at)
    local deps=self.deps
    for _,key in ipairs(levelHooks) do self.current[key]=self.baseSessionHooks[key] end
    if self.campaignIndex and self.campaignIndex&gt;1 then
        self.director=deps.CampaignDirector.new(self.current,self.world,deps.Combat,deps.Config,deps)
    else
        self.director=deps.Director.new(self.current,self.world,deps.Combat,deps.Config,deps.GuardianPattern,
            deps.HealingFlies,deps.EnemyCarry,deps.WalkerClubs,deps.DragonFlight,deps.BossIntro)
    end
    self.current.contextualAttack=function(slot,now,action)
        return self.director.interact and self.director:interact(slot,now,action) or 'NO_INTERACTION'
    end
    if deps.SourceCombat then deps.SourceCombat.bind(self.current,self.director,deps.Config) end
    for _,owner in pairs(self.players) do self:_enemyName(owner) end
    self.bossSlot=nil
    local definition=deps.Config.Level
    local bossId=self.campaignIndex and self.campaignIndex&gt;1
        and definition.boss and (definition.boss.kind or definition.boss.type)
        or ((not self.campaignIndex or self.campaignIndex==1) and 'CausewayGuardian' or nil)
    if self.bossQueue and bossId then
        self.bossSlot=self.current.state.runId..':'..bossId..':'..self.current.state.levelEpoch
        assert(self.bossQueue:register(self.bossSlot,bossId,{runId=self.current.state.runId,
            groupId=self.current.state.groupId,levelEpoch=self.current.state.levelEpoch},at)=='OK')
        self.director.bossGate=function(now) return self.bossQueue:start(self.bossSlot,now) end
    end
end

function Controller:_advanceCampaign(now)
    local nextIndex=self.campaignIndex+1
    local definition=self.deps.CampaignDefinition.build(nextIndex,self.campaignSeed)
    if self.bossQueue and self.bossSlot then self.bossQueue:close(self.bossSlot,now) end
    self:_closeDirector('LevelAdvanced')
    local rebuilt,reason=self.world:advanceGeometry(definition)
    assert(rebuilt==true,'Cannot build the next campaign stage: '..tostring(reason))
    local code=self.current:advanceLevel(definition.id,now,{prerequisitesMet=true})
    assert(code=='OK','Cannot advance the campaign: '..tostring(code))
    self.deps.Config.Level=definition
    self.deps.Config.Calibration=definition.calibration or self.deps.Config.Calibration
    self.campaignIndex=nextIndex
    self.actionFeedback=setmetatable({},{__mode='k'})
    self.notices={}
    self:_createDirector(now)
    self.current:_record('CampaignStageStarted',nil,{index=nextIndex,levelId=definition.id,mode=definition.mode})
end

function Controller:quarantine()
    self.faulted=true
    if self.director and self.director.cancelBossIntro then pcall(function() self.director:cancelBossIntro('Quarantine') end) end
    self.actionFeedback=setmetatable({},{__mode='k'})
    if self.bossQueue and self.bossSlot then pcall(function() self.bossQueue:close(self.bossSlot,self.deps.clock()) end) end
    for id in pairs(self.world.actors or {}) do
        pcall(function() self.world:move(id,0,0) end)
        if self.world.hold then pcall(function() self.world:hold(id,true) end) end
    end
end

function Controller:_actionContext(player)
    if not self.current or self:_open() then return nil end
    local slot=self.ownerSlots[player.UserId]
    local role=slot and self.current.state.heroes[slot] or self.director:controlled(player.UserId)
    if not role or role.status~='Alive' or not role.connected then return nil end
    if slot and self.current.combat[slot].deathAt then return nil end
    return role
end

function Controller:_actionOutcome(player,payload,code,now)
    if (payload.kind~='Attack' and payload.kind~='Jump') or not self.deps.Session.validIntent(payload) then return end
    local role=self:_actionContext(player)
    if not role then return end
    if code=='OK' then self.actionFeedback[player]=nil;return end
    if not actionDenials[code] then return end
    local id
    if self.deps.nextActionFeedbackId then id=self.deps.nextActionFeedbackId(player)
    else id=(self.actionSerial[player] or 0)+1;self.actionSerial[player]=id end
    local state=self.current.state
    self.actionFeedback[player]={id=id,code=code,kind=payload.kind,groupId=state.groupId,runId=state.runId,
        actorId=role.actorId,connectionEpoch=role.connectionEpoch,expiresAt=now+1.4}
end

function Controller:_feedbackSnapshot(player,view)
    local row=self.actionFeedback[player]
    if not row then return nil end
    local role=self:_actionContext(player)
    if not role or view~='Playing' or self.deps.clock()&gt;=row.expiresAt
        or row.runId~=self.current.state.runId or row.actorId~=role.actorId
        or row.connectionEpoch~=role.connectionEpoch then self.actionFeedback[player]=nil;return nil end
    return {id=row.id,code=row.code,kind=row.kind,groupId=row.groupId,runId=row.runId,
        actorId=row.actorId,expiresAt=row.expiresAt}
end
function Controller:startSpeederEntry(player,players)
    if not player.Parent or not self.connections:isCurrent(player) then return 'STALE_CONNECTION' end
    local online=self.connections:online(players)
    if #online~=1 or online[1]~=player then return 'NOT_ISOLATED' end
    for _,other in pairs(self.players) do
        if other~=player then return 'NOT_ISOLATED' end
    end
    if self.current then return 'RUN_ACTIVE' end
    if not self.deps.CampaignDefinition or not self.deps.CampaignDirector or not self.deps.CampaignModes then return 'UNAVAILABLE' end
    return self:_begin(player,players,true)
end
function Controller:releaseSpeederEntry(player,runId)
    if not player.Parent or not self.connections:isCurrent(player) then return 'STALE_CONNECTION' end
    if not self.current or self.current.state.runId~=runId then return 'WRONG_RUN' end
    local slot=self.ownerSlots[player.UserId]
    if not slot then return 'NOT_OWNER' end
    if self.releasedSpeederRunId==runId then return 'OK' end
    local modes=self.director and self.director.modes
    if not modes or not modes.definition.speederEntry then return 'NOT_SPEEDER_ENTRY' end
    if not modes:releaseSpeederEntry(slot) then return 'ENTRY_NOT_BOARDED' end
    self.releasedSpeederRunId=runId
    return 'OK'
end
function Controller:_begin(player,players,speederEntry)
    local online=self:_heroes(players)
    if #online==0 then return 'NO_HERO' end
    if online[1]~=player then return 'HOST_ONLY' end
    if not self:_open() then return 'RUN_ACTIVE' end
    local firstMinute=self.deps.FirstMinute
    if firstMinute and not speederEntry then firstMinute:startPressed(player) end
    local at=self.deps.clock()
    local runId=self.deps.guid()
    self.releasedSpeederRunId=nil
    local route
    local seed=self.deps.LevelVariation and self.deps.LevelVariation.seedFromId(runId) or campaignSeed(runId)
    if speederEntry then
        route=self.deps.CampaignDefinition.build(3,seed)
        route.speederEntry=true
        route.spawn=table.clone(route.course.mount)
        route.spawns={route.spawn}
        route.zones[1].enemies={}
    elseif self.deps.LevelVariation and self.baseLevel then
        route=self.deps.LevelVariation.build(self.baseLevel,seed)
    end
    if self.bossQueue and self.bossSlot then self.bossQueue:close(self.bossSlot,at) end
    self:_closeDirector('RunReplaced')
    self.world:clearActors(); self.ownerSlots={}; self.owners={}; self.viewChoices={}
    if route then
        local rebuilt,reason=self.world:rebuildLevel(route)
        assert(rebuilt==true,'Cannot rebuild the new run level: '..tostring(reason))
        self.deps.Config.Level=route
        self.deps.Config.Calibration=route.calibration or self.deps.Config.Calibration
    end
    self.actionFeedback=setmetatable({},{__mode='k'})
    local roster={}
    for index=1,math.min(3,#online) do
        local owner=online[index]
        local template=self.choices[owner.UserId] or 'Mr. Green'
        self.ownerSlots[owner.UserId]=index
        self.owners[index]={userId=owner.UserId,displayName=owner.DisplayName,username=owner.Name,template=template}
        self.world.names[index]=owner.DisplayName..' @'..owner.Name
        roster[index]={userId=index,template=template}
    end
    self.previousJournal=self.journal
    self.journal=self.deps.RunJournal and self.deps.RunJournal.new({runId=runId,groupId=self.deps.GroupId or 'combat-stand',
        build=self.deps.BuildId or 'unknown',rules='D01-D10-source-combat-v1'}) or nil
    self.current=self.deps.Session.new(self.deps.Core,self.deps.Combat,self.deps.Config,roster,runId,self.world,function(row)
        if self.journal then self.journal:record(row) end
        local spawned=row.kind=='CommitSpawn' and row.data.code=='OK'
        local boarded=speederEntry and row.kind=='CampaignMounted' and row.data.mode=='Speeder'
        local passedWall=speederEntry and row.kind=='SpeederFirstWallPassed'
        if firstMinute and (spawned or boarded or passedWall) then
            local owner=self.owners[row.userId]
            local p=owner and self.players[owner.userId]
            if p and self.connections:isCurrent(p) then
                if spawned then firstMinute:spawned(p)
                elseif boarded then firstMinute:boarded(p)
                else firstMinute:passedFirstWall(p) end
            end
        end
        if row.kind=='Hit' then self.world:cue(row.userId,row.data.blocked) end
    end,{groupId=self.deps.GroupId,levelId=speederEntry and route.id or (self.deps.GroupId and 'causeway')})
    if firstMinute then
        local session=self.current
        local function connectedHero(slot)
            if self.current~=session then return nil end
            local hero=session.state.heroes[slot]
            local owner=self.owners[slot]
            local p=owner and self.players[owner.userId]
            if hero and hero.connected and p and self.connections:isCurrent(p) then return p end
        end
        session.onHeroEnemyHit=function(slot,defeated)
            local p=connectedHero(slot)
            if p then firstMinute:enemyHit(p,defeated) end
        end
        session.onHeroEnemyDefeated=function(slot)
            local p=connectedHero(slot)
            if p then firstMinute:enemyDefeated(p) end
        end
    end
    local actorOwners={}
    for slot,owner in ipairs(self.owners) do actorOwners[slot]=owner.userId end
    self.current:_record('RunStarted',nil,{heroCount=#roster,owners=actorOwners,variation=variationMetadata(self.deps.Config.Level)})
    local development=self.deps.Config.Development
    if development and development.allowInfiniteLives==true and development.infiniteLives==true then
        assert(self.current:setInfiniteLives(true)=='OK','Cannot enable trusted Studio infinite lives')
    end
    self.current:step(self.deps.clock())
    self.campaignIndex=self.deps.CampaignDefinition and self.deps.CampaignDirector and (speederEntry and 3 or 1) or nil
    self.campaignSeed=seed
    self.baseSessionHooks={}
    for _,key in ipairs(levelHooks) do self.baseSessionHooks[key]=self.current[key] end
    local originalHit=self.current._hit
    self.current._hit=function(session,attacker,target,action,tuning)
        if type(target)=='number' and target&lt;0 then return self.director:hit(attacker,target,action,tuning) end
        return originalHit(session,attacker,target,action,tuning)
    end
    self:_createDirector(at)
    self.finished=false
    self.faulted=false
    return 'OK'
end
function Controller:controlledSlot(userId)
    local hero=self.ownerSlots[userId]
    if hero then return hero end
    local role=self.director and self.director:controlled(userId)
    if role and role.status=='Alive' then return role.enemyId end
end
function Controller:handle(player,payload,players)
    if not player.Parent or not self.connections:isCurrent(player) then return 'STALE_CONNECTION' end
    local at=self.deps.clock()
    local rate=self.deps.Config.MaxIntentRate
    local bucket=self.buckets[player] or {tokens=rate,last=at}
    bucket.tokens=math.min(rate,bucket.tokens+math.max(0,at-bucket.last)*rate); bucket.last=at; self.buckets[player]=bucket
    if bucket.tokens&lt;1 then return 'RATE_LIMIT' end
    bucket.tokens-=1
    if type(payload)~='table' or type(payload.kind)~='string' then return 'INVALID_INTENT' end
    if self.faulted and payload.kind~='Start' and payload.kind~='Sync' then return 'PARTY_FAULTED' end
    local code
    if payload.kind=='Sync' or payload.kind=='Start' then
        if not exact(payload,{kind=true}) then return 'INVALID_INTENT' end
        code=payload.kind=='Start' and self:_begin(player,players) or 'OK'
    elseif payload.kind=='SelectHero' then
        if not exact(payload,{kind=true,template=true}) or not templates[payload.template] then return 'INVALID_INTENT' end
        if not self:_open() then code='RUN_ACTIVE'
        else self.choices[player.UserId]=payload.template; code='OK' end
    elseif payload.kind=='SelectRole' then
        if not exact(payload,{kind=true,role=true}) or not roles[payload.role] then return 'INVALID_INTENT' end
        if not self:_open() then code='RUN_ACTIVE'
        else
            if self.bossQueue then self.bossQueue:cancel(player.UserId,at) end
            self.preferences[player.UserId]=payload.role; code='OK'
        end
    elseif payload.kind=='QueueBoss' then
        if not exact(payload,{kind=true,bossId=true}) or not bossTypes[payload.bossId] then return 'INVALID_INTENT' end
        code=self:_bossSelection(player)
        if code=='OK' then
            code=self.bossQueue and self.bossQueue:select(player.UserId,payload.bossId,at) or 'UNAVAILABLE'
            if code=='OK' then
                self.preferences[player.UserId]='Spectator'; self.viewChoices[player.UserId]='Spectating'
                if self.director then self:_enemyName(player) end
            end
        end
    elseif payload.kind=='CancelBossQueue' then
        if not exact(payload,{kind=true}) then return 'INVALID_INTENT' end
        code=self.bossQueue and self.bossQueue:cancel(player.UserId,at) or 'UNAVAILABLE'
    elseif payload.kind=='ReplyBoss' or payload.kind=='ConnectBoss' then
        local reply=payload.kind=='ReplyBoss'
        if not exact(payload,reply and {kind=true,offerId=true,accepted=true} or {kind=true,offerId=true})
            or type(payload.offerId)~='string' or #payload.offerId==0 or #payload.offerId&gt;160
            or (reply and type(payload.accepted)~='boolean') then return 'INVALID_INTENT' end
        code=self:_bossSelection(player)
        if code=='OK' then
            if not self.bossQueue then code='UNAVAILABLE'
            elseif reply then code=self.bossQueue:reply(player.UserId,payload.offerId,payload.accepted,at)
            else code=self.bossQueue:connect(player.UserId,payload.offerId,at) end
        end
    elseif payload.kind=='ChooseView' then
        if not exact(payload,{kind=true,runId=true,levelEpoch=true,view=true})
            or type(payload.runId)~='string' or #payload.runId==0 or #payload.runId&gt;160
            or type(payload.levelEpoch)~='number' or payload.levelEpoch&lt;1 or payload.levelEpoch&gt;1000000000 or payload.levelEpoch%1~=0
            or (payload.view~='Menu' and payload.view~='Spectating') then return 'INVALID_INTENT' end
        if self:_open() then code='RUN_CLOSED'
        elseif payload.runId~=self.current.state.runId then code='WRONG_RUN'
        elseif payload.levelEpoch~=self.current.state.levelEpoch then code='STALE_LEVEL'
        else
            local slot=self.ownerSlots[player.UserId]
            local hero=slot and self.current.state.heroes[slot]
            local enemy=self.director:controlled(player.UserId)
            if hero and hero.status~='Eliminated' then code='NOT_ELIMINATED'
            elseif hero then
                code=self.current:_clock(at)
                if code=='OK' and hero.view~=payload.view then
                    code=self.current:_event('ChooseView',slot,{view=payload.view,connectionEpoch=hero.connectionEpoch})
                end
            elseif enemy and enemy.status=='Alive' then code='ROLE_ACTIVE'
            else self.viewChoices[player.UserId]=payload.view; code='OK' end
        end
    elseif payload.kind=='ClaimEnemy' then
        if not exact(payload,{kind=true,runId=true,levelEpoch=true,enemyId=true})
            or type(payload.enemyId)~='number' or payload.enemyId%1~=0 or payload.enemyId&gt;=0 or payload.enemyId&lt;=-1000 then return 'INVALID_INTENT' end
        if self:_open() then code='RUN_CLOSED'
        elseif payload.runId~=self.current.state.runId then code='WRONG_RUN'
        elseif payload.levelEpoch~=self.current.state.levelEpoch then code='STALE_LEVEL'
        elseif self.ownerSlots[player.UserId] then code='HERO_LOCKED'
        else
            local queue=self.bossQueue and self.bossQueue:view(player.UserId,at)
            if queue and (queue.state=='Accepted' or queue.state=='Ready' or queue.state=='Active') then code='ROLE_RESERVED'
            else
                self:_enemyName(player)
                self.director.now=at
                code=self.director:claim(player.UserId,payload.enemyId)
                if code=='OK' then
                    if self.bossQueue then self.bossQueue:cancel(player.UserId,at) end
                    self.viewChoices[player.UserId]=nil
                end
            end
        end
    elseif self.current then
        local slot=self.ownerSlots[player.UserId]
        if self:_open() then code='RUN_CLOSED'
        elseif slot then
            code=self.current:intent(slot,payload,at)
            local accepted=self.current.combat[slot].attack
            local actor=self.current.state.heroes[slot].actorId
            if code=='OK' and payload.kind=='Attack' and accepted
                and accepted.actorId==actor and (accepted.inputAction or accepted.action)==payload.attack then
                self.director.now=at
                self.director:closeTargetForAttack(self.world:targets(slot,accepted.tuning or self.deps.Config.Attacks[accepted.action]))
            end
        elseif self.director:controlled(player.UserId) then
            code=self.director:command(player.UserId,payload,at,self.deps.Session.validIntent)
        else code='SPECTATOR' end
    else code='NO_RUN' end
    self:_actionOutcome(player,payload,code,at)
    if code=='OK' then self.notices[player]=nil else self.notices[player]=code end
    return code
end
function Controller:step(now,dt)
    if self.faulted then return end
    if self.bossQueue then self.bossQueue:step(now) end
    if not self.current or self.finished then return end
    self.director.now=now
    self.current:step(now); self.director:step(now,dt)
    if self.director.result=='Won' and self.campaignIndex and self.campaignIndex&lt;self.deps.CampaignDefinition.count then
        self.current:_record('CampaignStageCompleted',nil,{index=self.campaignIndex})
        self:_advanceCampaign(now)
        return
    end
    if self.bossQueue and self.bossSlot and (self.director.stage=='Exit' or self.director.result) then
        self.bossQueue:close(self.bossSlot,now)
    end
    if self.director.result then
        self.finished=true
        self.current:_record('RunResult',nil,{result=self.director.result})
        for _,id in ipairs(self.current.order) do
            self.world:move(id,0,0)
            if self.world.hold then self.world:hold(id,true) end
        end
        for id in pairs(self.director.enemies or {}) do self.world:move(id,0,0) end
    end
end
function Controller:snapshot(player,players)
    if not self.connections:isCurrent(player) then return nil end
    local online=self.connections:online(players)
    if self.faulted then
        local heroes=self:_heroes(players)
        local state=self.current and self.current.state or {}
        return {status='Faulted',fault=true,now=self.deps.clock(),
            runId=state.runId or ((self.deps.GroupId or 'combat-stand')..':faulted'),levelEpoch=state.levelEpoch or 1,
            heroes={},lobby={},level={stage='Faulted',objective="Party stopped. Start a new game."},
            online=#online,heroOnline=#heroes,host=heroes[1] and heroes[1].UserId,
            canStart=heroes[1]==player,canSelect=false,canChooseView=false,view='Menu',
            selectedTemplate=self.choices[player.UserId] or 'Mr. Green',preference=self.preferences[player.UserId] or 'Hero',
            enemyOffers={},enemyUnavailableReason='PARTY_FAULTED',interaction={available=false}}
    end
    local data=self.current and self.current:snapshot() or {status='Lobby',heroes={},now=self.deps.clock()}
    data.status=self.director and self.director.result or data.status
    data.level=self.director and self.director:snapshot() or {stage='Lobby',objective="Choose a hero and set out"}
    if self.campaignIndex then
        data.campaign={index=self.campaignIndex,count=self.deps.CampaignDefinition.count,
            complete=self.finished==true and self.director.result=='Won'}
        data.level.campaignIndex=self.campaignIndex;data.level.campaignCount=self.deps.CampaignDefinition.count
    end
    for _,hero in ipairs(data.heroes) do
        local owner=self.owners[hero.slot]
        for key,value in pairs(owner) do hero[key]=value end
    end
    data.lobby={}
    for _,owner in ipairs(online) do
        data.lobby[#data.lobby+1]={userId=owner.UserId,displayName=owner.DisplayName,username=owner.Name,
            template=self.choices[owner.UserId] or 'Mr. Green',preference=self.preferences[owner.UserId] or 'Hero'}
    end
    data.mine=self.ownerSlots[player.UserId]
    local heroes=self:_heroes(players)
    data.online=#online; data.heroOnline=#heroes; data.host=heroes[1] and heroes[1].UserId
    data.canStart=heroes[1]==player and self:_open()
    data.canSelect=self:_open()
    data.selectedTemplate=self.choices[player.UserId] or 'Mr. Green'
    data.preference=self.preferences[player.UserId] or 'Hero'
    data.enemyRole=self.director and self.director:controlled(player.UserId)
    data.cameraBounds=self.world.cameraBounds and self.world:cameraBounds() or nil
    if self:_open() then data.view='Menu'; data.canChooseView=false
    elseif data.mine then
        local hero=self.current.state.heroes[data.mine]
        data.view=hero.status=='Eliminated' and hero.view or 'Playing'
        data.canChooseView=hero.status=='Eliminated'
    elseif data.enemyRole and data.enemyRole.status=='Alive' then data.view='Playing'; data.canChooseView=false
    else
        data.view=self.viewChoices[player.UserId] or (data.enemyRole and 'Choice' or 'Spectating')
        data.canChooseView=true
    end
    data.enemyOffers={}
    if not self.current or self:_open() then data.enemyUnavailableReason='RUN_CLOSED'
    elseif data.mine then data.enemyUnavailableReason='HERO_LOCKED'
    elseif data.enemyRole then
        data.enemyUnavailableReason=data.enemyRole.status=='Alive' and 'ENEMY_ALREADY_OWNED' or 'ENEMY_LIFE_SPENT'
    else
        data.enemyOffers=self.director:available(player.UserId)
        if #data.enemyOffers==0 then data.enemyUnavailableReason='NO_ENEMY_AVAILABLE' end
    end
    data.notice=self.notices[player]
    data.interaction=data.mine and self.director and self.director.interaction and self.director:interaction(data.mine) or {available=false}
    data.weapon=data.mine and self.director and self.director.clubs and self.director.clubs:hasClub(data.mine) and 'WalkerClub' or nil
    data.feedback=self.journal and self.journal:feedback() or nil
    data.actionFeedback=self:_feedbackSnapshot(player,data.view)
    if self.bossQueue then
        data.bossQueue=self.bossQueue:view(player.UserId,self.deps.clock())
        data.bossQueue.available=self:_bossSelection(player)=='OK'
    end
    return data
end
return Controller
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT36">
          <Properties>
            <string name="Name">GameWorld</string>
            <ProtectedString name="Source">-- Original first-level presentation. Combat and hero physics stay in BaseWorld.
local World = {}

local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local function ownCompletedRig(actor)
    local root=actor.root
    if root.Parent and not root.Anchored then
        local allowed,reason=root:CanSetNetworkOwnership()
        assert(allowed,reason or 'Cannot assign server ownership')
        root:SetNetworkOwner(nil)
    end
end

local COLORS = {
    stone = Color3.fromRGB(71, 92, 89),
    dark = Color3.fromRGB(35, 54, 57),
    pale = Color3.fromRGB(159, 179, 151),
    moss = Color3.fromRGB(72, 115, 77),
    mint = Color3.fromRGB(134, 255, 194),
    amber = Color3.fromRGB(255, 184, 72),
    rust = Color3.fromRGB(178, 82, 47),
}

local function part(parent, name, size, frame, color, material, collidable)
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.CFrame = frame
    p.Color = color
    p.Material = material or Enum.Material.SmoothPlastic
    p.Anchored = true
    p.CanCollide = collidable == true
    p.CanTouch = false
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.Parent = parent
    return p
end

local function ball(parent, name, size, frame, color, material)
    local p = part(parent, name, size, frame, color, material, false)
    p.Shape = Enum.PartType.Ball
    return p
end

local function cosmetic(model, limb, name, size, offset, color, shape, material)
    local p = part(model, name, size, limb.CFrame * offset, color, material, false)
    if shape then p.Shape = shape end
    p.Anchored = false
    p.Massless = true
    p.CanQuery = false
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = limb
    weld.Part1 = p
    weld.Parent = p
    return p
end

local function label(parent, text, size, offset)
    local board = Instance.new("BillboardGui")
    board.Name = "WorldLabel"
    board.Size = UDim2.fromOffset(size or 240, 44)
    board.StudsOffset = offset or Vector3.new(0, 3, 0)
    board.AlwaysOnTop = false
    board.MaxDistance = 120
    board.Parent = parent
    local textLabel = Instance.new("TextLabel")
    textLabel.Name = "Text"
    textLabel.Size = UDim2.fromScale(1, 1)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = text
    textLabel.TextColor3 = Color3.fromRGB(226, 244, 211)
    textLabel.TextStrokeColor3 = Color3.fromRGB(20, 39, 37)
    textLabel.TextStrokeTransparency = 0.15
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextSize = 17
    textLabel.TextWrapped = true
    textLabel.Parent = board
    return textLabel
end

local function pointLight(parent, color, range, brightness)
    local light = Instance.new("PointLight")
    light.Color = color
    light.Range = range
    light.Brightness = brightness
    light.Shadows = false
    light.Parent = parent
    return light
end

local function hideRig(actor)
    for _,p in ipairs(actor.model:GetChildren()) do
        if p:IsA("BasePart") then p.Transparency = 1 end
    end
end

local function removeStandEyes(actor)
    -- The stand's small eye parts are also cosmetic and can be replaced safely.
    for _,p in ipairs(actor.model:GetChildren()) do
        if p.Name == "Eye" then p:Destroy() end
    end
end

local function toad(actor, template, appearance)
    removeStandEyes(actor)
    -- Canonical readiness uses the physical rig's original visible alpha.
    if appearance and appearance.attach(actor, template) then return end
    hideRig(actor)
    local palettes = {
        ["Mr. Green"] = {Color3.fromRGB(94, 159, 102), Color3.fromRGB(188, 209, 122), Color3.fromRGB(41, 85, 65)},
        ["Mr. Yellow"] = {Color3.fromRGB(210, 169, 61), Color3.fromRGB(246, 224, 143), Color3.fromRGB(118, 83, 41)},
        ["Mr. Brown"] = {Color3.fromRGB(160, 112, 86), Color3.fromRGB(224, 186, 129), Color3.fromRGB(86, 61, 61)},
    }
    local palette = palettes[template] or palettes["Mr. Green"]
    local skin, belly, accent = palette[1], palette[2], palette[3]
    local model = actor.model
    local torso, head = model.Torso, model.Head
    cosmetic(model, torso, "ToadBody", Vector3.new(2.3, 2.05, 1.55), CFrame.new(), skin, Enum.PartType.Ball)
    cosmetic(model, torso, "Belly", Vector3.new(1.65, 1.65, 0.32), CFrame.new(0, -0.08, -0.7), belly, Enum.PartType.Ball)
    cosmetic(model, head, "ToadHead", Vector3.new(2.5, 1.55, 1.55), CFrame.new(0, 0.08, -0.05), skin, Enum.PartType.Ball)
    cosmetic(model, head, "LowerMuzzle", Vector3.new(2.12, 0.5, 1.1), CFrame.new(0, -0.35, -0.36), belly, Enum.PartType.Ball)
    cosmetic(model, head, "Mouth", Vector3.new(1.3, 0.055, 0.045), CFrame.new(0, -0.28, -0.91), accent)
    for _,side in ipairs({-1, 1}) do
        local x = side * 0.75
        cosmetic(model, head, "EyeRidge", Vector3.new(0.98, 0.98, 0.9), CFrame.new(x, 0.6, -0.27), skin, Enum.PartType.Ball)
        cosmetic(model, head, "EyeWhite", Vector3.new(0.71, 0.75, 0.39), CFrame.new(x, 0.63, -0.67), Color3.fromRGB(251, 245, 203), Enum.PartType.Ball)
        cosmetic(model, head, "Iris", Vector3.new(0.3, 0.43, 0.15), CFrame.new(x, 0.64, -0.88), accent, Enum.PartType.Ball)
        cosmetic(model, head, "EyeShine", Vector3.new(0.09, 0.12, 0.05), CFrame.new(x - 0.06, 0.74, -0.96), Color3.new(1, 1, 1), Enum.PartType.Ball)
        cosmetic(model, head, "Brow", Vector3.new(0.82, 0.16, 0.37), CFrame.new(x, 1, -0.6) * CFrame.Angles(0, 0, side * 0.12), accent, Enum.PartType.Ball)
        cosmetic(model, head, "Nostril", Vector3.new(0.12, 0.1, 0.06), CFrame.new(side * 0.27, -0.02, -0.81), accent, Enum.PartType.Ball)
        local arm = model[side == -1 and "Left Arm" or "Right Arm"]
        local leg = model[side == -1 and "Left Leg" or "Right Leg"]
        cosmetic(model, arm, "UpperArm", Vector3.new(0.9, 1.7, 0.95), CFrame.new(0, 0.1, 0), skin, Enum.PartType.Ball)
        cosmetic(model, arm, "Palm", Vector3.new(0.94, 0.65, 0.85), CFrame.new(0, -0.8, -0.08), skin, Enum.PartType.Ball)
        cosmetic(model, leg, "Haunch", Vector3.new(1.15, 1.4, 1.2), CFrame.new(0, 0.3, 0.12), skin, Enum.PartType.Ball)
        cosmetic(model, leg, "Foot", Vector3.new(1.1, 0.44, 1.5), CFrame.new(0, -0.8, -0.36), skin, Enum.PartType.Ball)
        for finger = -1, 1 do
            cosmetic(model, arm, "Finger", Vector3.new(0.22, 0.55, 0.25), CFrame.new(finger * 0.29, -1.1, -0.18), belly, Enum.PartType.Ball)
            cosmetic(model, leg, "Toe", Vector3.new(0.26, 0.3, 0.67), CFrame.new(finger * 0.3, -0.82, -1.02), belly, Enum.PartType.Ball)
        end
        for spot = 1, 2 do
            cosmetic(model, torso, "ToadSpot", Vector3.new(0.28, 0.35, 0.12), CFrame.new(side * 0.93, 0.3 - spot * 0.43, -0.42), accent, Enum.PartType.Ball)
        end
    end
    model:SetAttribute("Template", template or "Mr. Green")
    model:SetAttribute("Appearance", "OriginalToad")
end

local function drone(actor, kind)
    hideRig(actor)
    removeStandEyes(actor)
    local m = actor.model
    cosmetic(m, m.Torso, "RustHull", Vector3.new(2.35, 1.85, 1.55), CFrame.new(), COLORS.rust)
    cosmetic(m, m.Torso, "ChestGrille", Vector3.new(1.4, 0.95, 0.15), CFrame.new(0, -0.15, -0.84), COLORS.dark)
    for n = -1, 1 do
        cosmetic(m, m.Torso, "Vent", Vector3.new(1.1, 0.08, 0.07), CFrame.new(0, n * 0.25 - 0.1, -0.95), COLORS.pale)
        local arm = m[n == -1 and "Left Arm" or "Right Arm"]
        local leg = m[n == -1 and "Left Leg" or "Right Leg"]
        cosmetic(m, arm, "ToolArm", Vector3.new(0.72, 1.8, 0.72), CFrame.new(), COLORS.dark)
        cosmetic(m, arm, "Clamp", Vector3.new(1.05, 0.52, 1.08), CFrame.new(0, -0.8, -0.18), COLORS.rust)
        cosmetic(m, leg, "Strut", Vector3.new(0.56, 1.7, 0.62), CFrame.new(), COLORS.pale)
        cosmetic(m, leg, "TrackFoot", Vector3.new(0.9, 0.45, 1.5), CFrame.new(0, -0.8, -0.15), COLORS.dark)
    end
    cosmetic(m, m.Head, "SensorHousing", Vector3.new(1.5, 0.86, 1.4), CFrame.new(), COLORS.dark)
    cosmetic(m, m.Head, "SingleOptic", Vector3.new(0.68, 0.5, 0.25), CFrame.new(0, 0.02, -0.77), COLORS.amber, Enum.PartType.Ball, Enum.Material.Neon)
    cosmetic(m, m.Head, "Antenna", Vector3.new(0.12, 0.95, 0.12), CFrame.new(0.6, 0.7, 0.22) * CFrame.Angles(0, 0, -0.25), COLORS.pale)
    cosmetic(m, m.Head, "AntennaTip", Vector3.new(0.23, 0.23, 0.23), CFrame.new(0.72, 1.13, 0.22), COLORS.amber, Enum.PartType.Ball, Enum.Material.Neon)
    -- Species silhouettes are original art; their shared combat remains prototype tuning.
    if kind == "Pig" then
        cosmetic(m, m.Head, "PigSnout", Vector3.new(1.5, 0.85, 1.1), CFrame.new(0, -0.05, -1), COLORS.rust, Enum.PartType.Ball)
        for _,side in ipairs({-1, 1}) do
            cosmetic(m, m.Head, "PigTusk", Vector3.new(0.22, 0.8, 0.25), CFrame.new(side * 0.66, -0.12, -1.35) * CFrame.Angles(0, 0, -side * 0.3), COLORS.pale)
            cosmetic(m, m.Head, "PigEar", Vector3.new(0.75, 0.8, 0.4), CFrame.new(side * 0.8, 0.85, 0), COLORS.rust)
        end
        cosmetic(m, m.Torso, "PigArmour", Vector3.new(2.85, 1.5, 1.7), CFrame.new(0, 0.1, 0.1), COLORS.rust, Enum.PartType.Ball)
    elseif kind == "Walker" then
        for _,side in ipairs({-1, 1}) do
            cosmetic(m, m.Torso, "WalkerShoulder", Vector3.new(1.25, 1.5, 1.7), CFrame.new(side * 1.65, 0.45, 0), COLORS.dark)
            cosmetic(m, m[side == -1 and "Left Leg" or "Right Leg"], "WalkerPiston", Vector3.new(0.9, 2.05, 0.9), CFrame.new(0, 0.1, 0.1), COLORS.amber)
        end
        cosmetic(m, m.Head, "WalkerCrest", Vector3.new(0.5, 1.5, 1.2), CFrame.new(0, 0.9, 0), COLORS.pale)
    elseif kind == "Dragon" then
        for _,side in ipairs({-1, 1}) do
            local offset=CFrame.new(side*2.3,.45,.45)*CFrame.Angles(0,0,side*.3)
            local wing=cosmetic(m,m.Torso,'DragonWing',Vector3.new(3.2,.28,2.1),offset,COLORS.moss)
            for _,joint in ipairs(wing:GetChildren()) do if joint:IsA('WeldConstraint') then joint:Destroy() end end
            local motor=Instance.new('Motor6D');motor.Name='DragonWingMotor';motor.Part0=m.Torso;motor.Part1=wing;motor.C0=offset;motor.Parent=wing
            actor.wingMotors=actor.wingMotors or {};actor.wingMotors[#actor.wingMotors+1]={joint=motor,base=offset,side=side}
            cosmetic(m, m.Head, "DragonHorn", Vector3.new(0.3, 1.4, 0.4), CFrame.new(side * 0.6, 0.9, 0.3) * CFrame.Angles(0.2, 0, -side * 0.2), COLORS.amber)
        end
        cosmetic(m, m.Torso, "DragonTail", Vector3.new(0.7, 0.65, 3.2), CFrame.new(0, -0.7, 2), COLORS.moss, Enum.PartType.Ball)
    end
end

local function boss(actor)
    hideRig(actor)
    removeStandEyes(actor)
    local m, root = actor.model, actor.root
    local function c(name, size, offset, color, shape, material)
        return cosmetic(m, root, name, size, offset, color, shape, material)
    end
    c("GuardianBase", Vector3.new(7.6, 1.5, 6.3), CFrame.new(0, -2.1, 0), COLORS.dark)
    c("GuardianDrum", Vector3.new(5.6, 4.8, 4.8), CFrame.new(0, -0.1, 0), COLORS.rust, Enum.PartType.Ball)
    c("GuardianCrown", Vector3.new(6.4, 1.15, 4.8), CFrame.new(0, 2.5, 0.2), COLORS.dark)
    c("FacePlate", Vector3.new(3.8, 2.7, 0.7), CFrame.new(0, 0.9, -2.1), COLORS.pale)
    c("ReactorEye", Vector3.new(1.45, 1.45, 0.5), CFrame.new(0, 1.12, -2.56), COLORS.amber, Enum.PartType.Ball, Enum.Material.Neon)
    c("CannonHousing", Vector3.new(2.3, 1.7, 2.5), CFrame.new(0, -0.85, -2.05), COLORS.dark)
    c("CannonMouth", Vector3.new(1.6, 1.15, 0.25), CFrame.new(0, -0.85, -3.4), COLORS.amber, Enum.PartType.Ball, Enum.Material.Neon)
    for _,side in ipairs({-1, 1}) do
        c("AnchorPylon", Vector3.new(1.25, 4.6, 1.7), CFrame.new(side * 3, -0.55, 0.4) * CFrame.Angles(0, 0, side * 0.15), COLORS.dark)
        c("ShieldCoil", Vector3.new(1.1, 2.4, 1.1), CFrame.new(side * 3.6, 1.1, 0), COLORS.mint, Enum.PartType.Cylinder, Enum.Material.Neon)
        c("CrownFin", Vector3.new(0.7, 2, 1.8), CFrame.new(side * 2.1, 3.65, 0.6) * CFrame.Angles(0, 0, -side * 0.2), COLORS.rust)
    end
    pointLight(root, COLORS.amber, 16, 1.5)
end

local function buildGeometry(self)
    self.geometry:ClearAllChildren()
    self.floors = {}
    local g = self.geometry
    local floor = part(g, "FloodedCauseway", Vector3.new(206, 3.4, 42), CFrame.new(21, -1.7, 0), COLORS.stone, Enum.Material.Slate, true)
    floor:SetAttribute("SurfaceId", "Causeway")
    self.floors[1] = floor
    -- Large stone surfaces support respawn checks; shallow insets are visual only.
    for x = -76, 120, 7 do
        for z = -14, 14, 7 do
            local shade = ((math.floor(x / 7) + math.floor(z / 7)) % 3) * 6
            part(g, "PavingStone", Vector3.new(6.7, 0.1, 6.7), CFrame.new(x, 0.025, z), Color3.fromRGB(81 + shade, 105 + shade, 98 + shade), Enum.Material.Slate)
        end
    end
    part(g, "SubmergedFoundation", Vector3.new(208, 7, 44), CFrame.new(21, -5.1, 0), COLORS.dark, Enum.Material.Rock)
    local marsh = part(g, "MarshWater", Vector3.new(440, 0.4, 230), CFrame.new(20, -7.8, 0), Color3.fromRGB(34, 101, 96), Enum.Material.Glass)
    marsh.Transparency = 0.3
    marsh.Reflectance = 0.25
    local mist = part(g, "WaterDepth", Vector3.new(440, 12, 230), CFrame.new(20, -14, 0), Color3.fromRGB(22, 54, 61), Enum.Material.SmoothPlastic)
    mist.Transparency = 0.15
    -- The optional side pool is visibly separated from the wide, safe central path.
    self.danger = part(g, "BitterBogPool", Vector3.new(15, 0.24, 6), CFrame.new(10, 0.14, 15.5), Color3.fromRGB(195, 113, 44), Enum.Material.Neon, true)
    self.danger.Transparency = 0.2
    self.danger:SetAttribute("Hazard", true)
    self.danger:SetAttribute("SurfaceId", "Causeway")
    for _,z in ipairs({11.9, 19.1}) do
        part(g, "PoolRim", Vector3.new(16, 0.5, 0.45), CFrame.new(10, 0.25, z), COLORS.dark, Enum.Material.Rock)
    end
    for _,x in ipairs({2, 18}) do
        part(g, "PoolRim", Vector3.new(0.5, 0.5, 7.6), CFrame.new(x, 0.25, 15.5), COLORS.dark, Enum.Material.Rock)
    end
    local warning = part(g, "BogWarning", Vector3.new(0.4, 2.6, 0.4), CFrame.new(-1, 1.3, 12.5), COLORS.pale, Enum.Material.Wood)
    label(warning, "DANGEROUS MARSH", 160, Vector3.new(0, 2, 0)).TextColor3 = COLORS.amber

    -- Broken parapets leave readable edges while keeping the route open.
    for x = -76, 118, 12 do
        for _,side in ipairs({-1, 1}) do
            local z = side * 20
            part(g, "ParapetFoot", Vector3.new(2.2, 1.7, 2), CFrame.new(x, 0.85, z), COLORS.stone, Enum.Material.Rock, true)
            if (math.floor(x / 12) + side) % 3 ~= 0 then
                part(g, "BrokenParapet", Vector3.new(7.6, 1.35, 1.1), CFrame.new(x + 4.4, 0.68, z), COLORS.dark, Enum.Material.Rock, true)
            end
            local lamp = ball(g, "WayLight", Vector3.new(0.55, 0.55, 0.55), CFrame.new(x, 1.95, z), COLORS.mint, Enum.Material.Neon)
            pointLight(lamp, COLORS.mint, 9, 0.55)
        end
    end

    -- A ruined aqueduct silhouette, using only native primitives.
    local function arch(x, name, intact)
        local model = Instance.new("Model")
        model.Name = name
        model.Parent = g
        for _,side in ipairs({-1, 1}) do
            part(model, "PillarFoot", Vector3.new(5, 1.4, 5), CFrame.new(x, 0.7, side * 17), COLORS.dark, Enum.Material.Rock)
            part(model, "MossPillar", Vector3.new(2.7, 10.5, 3.2), CFrame.new(x, 6.6, side * 17), COLORS.stone, Enum.Material.Rock)
            part(model, "Capital", Vector3.new(3.9, 1.1, 4), CFrame.new(x, 12, side * 17), COLORS.pale, Enum.Material.Rock)
            for n = 1, 3 do
                local z = side * (17 - n * 2.5)
                part(model, "ArchVoussoir", Vector3.new(2.8, 2.3, 3.1), CFrame.new(x, 12.1 + n * 1.4, z) * CFrame.Angles(side * 0.12, 0, 0), COLORS.stone, Enum.Material.Rock)
            end
        end
        if intact then
            part(model, "Keystone", Vector3.new(3.1, 2.8, 15), CFrame.new(x, 17.3, 0), COLORS.dark, Enum.Material.Rock)
            local seal = ball(model, "AncientSeal", Vector3.new(0.5, 2.4, 2.4), CFrame.new(x - 1.8, 17.3, 0), COLORS.mint, Enum.Material.Neon)
            pointLight(seal, COLORS.mint, 18, 1)
        end
    end
    arch(-75, "WelcomeRuin", true)
    arch(42, "BrokenAqueduct", false)
    arch(107, "ExitArch", true)

    -- Reeds, lily pads, fallen masonry and distant trunks frame the linear level.
    for n = 1, 48 do
        local x = -95 + (n * 37 % 239)
        local side = n % 2 == 0 and 1 or -1
        local z = side * (27 + (n * 11 % 35))
        local y = -6.8
        ball(g, "MarshIsland", Vector3.new(9 + n % 5, 1.1, 7), CFrame.new(x, y - 0.1, z), COLORS.moss, Enum.Material.Grass)
        for reed = 1, 3 do
            local height = 2.4 + (n + reed) % 4
            part(g, "Reed", Vector3.new(0.19, height, 0.24), CFrame.new(x + reed * 0.6 - 1.2, y + height / 2, z) * CFrame.Angles(0.08, 0, (reed - 2) * 0.13), Color3.fromRGB(102, 141, 79), Enum.Material.Grass)
            ball(g, "SeedHead", Vector3.new(0.4, 1.05, 0.4), CFrame.new(x + reed * 0.6 - 1.2, y + height, z), Color3.fromRGB(109, 84, 64))
        end
        if n % 4 == 0 then
            part(g, "FallenMasonry", Vector3.new(6, 3, 4), CFrame.new(x, -5.8, z + side * 3) * CFrame.Angles(0.2, n, 0.35), COLORS.dark, Enum.Material.Rock)
        end
    end
    for n = 1, 16 do
        local side = n % 2 == 0 and 1 or -1
        local x, z = -98 + n * 16, side * (62 + n % 3 * 8)
        local height = 13 + n % 5 * 3
        part(g, "DrownedTrunk", Vector3.new(2.6, height, 2.7), CFrame.new(x, height / 2 - 8, z) * CFrame.Angles(0, 0, side * 0.1), Color3.fromRGB(42, 66, 62), Enum.Material.Wood)
        ball(g, "Canopy", Vector3.new(21, 9, 17), CFrame.new(x, height - 7, z), Color3.fromRGB(41, 82, 70), Enum.Material.Grass)
    end

    local start = part(g, "StartSign", Vector3.new(1, 0.5, 1), CFrame.new(-63, 4.6, -15), COLORS.dark)
    start.Transparency = 1
    label(start, "FLOODED CAUSEWAY", 310, Vector3.new(0, 2.8, 0)).TextSize = 23
    label(start, "FORWARD  →", 200, Vector3.new(0, 0.8, 0)).TextColor3 = COLORS.mint

    self.gates = {}
    local function gate(x, title)
        local beam = part(g, "EncounterGate", Vector3.new(0.6, 7.5, 44), CFrame.new(x, 3.75, 0), COLORS.amber, Enum.Material.ForceField, true)
        beam.Transparency = 0.63
        local text = label(beam, title, 290, Vector3.new(0, 6, 0))
        local marker = ball(g, "ObjectiveBeacon", Vector3.new(1.8, 1.8, 1.8), CFrame.new(x, 11.4, 0), COLORS.amber, Enum.Material.Neon)
        local light = pointLight(marker, COLORS.amber, 17, 1.6)
        local record = {beam = beam, label = text, marker = marker, light = light}
        self.gates[#self.gates + 1] = record
        return record
    end
    gate(2, "I  ·  CLEAR THE CAUSEWAY")
    gate(52, "II  ·  FLOODED COURTYARD")
    self.exitGate = gate(108, "III  ·  CAUSEWAY GUARDIAN")
    local exitPad = part(g, "ExitPad", Vector3.new(12, 0.13, 20), CFrame.new(115, 0.09, 0), COLORS.mint, Enum.Material.Neon)
    exitPad.Transparency = 0.6
    self.exitPad = exitPad
    for x = -57, 101, 18 do
        local arrow = part(g, "RouteArrow", Vector3.new(2, 0.08, 0.45), CFrame.new(x, 0.12, 0), COLORS.pale, Enum.Material.Neon)
        arrow.Transparency = 0.45
        for _,side in ipairs({-1, 1}) do
            local wing = part(g, "RouteArrowWing", Vector3.new(1.15, 0.08, 0.3), CFrame.new(x + 0.45, 0.12, side * 0.35) * CFrame.Angles(0, side * 0.65, 0), COLORS.pale, Enum.Material.Neon)
            wing.Transparency = 0.45
        end
    end
end

local function gateState(gate, open)
    gate.beam.CanCollide = not open
    gate.beam.Transparency = open and 1 or 0.63
    gate.marker.Color = open and COLORS.mint or COLORS.amber
    gate.marker.Transparency = open and 0.75 or 0
    gate.light.Color, gate.light.Brightness = gate.marker.Color, open and 0.4 or 1.6
    gate.label.TextTransparency = open and 0.65 or 0
end

local function buildRoute(self, level)
    self.geometry:ClearAllChildren()
    self.allFloors, self.floors, self.gates = {}, {}, {}
    local g = self.geometry
    local function platform(data, zoneIndex, surfaceId)
        local p = part(g, "DistrictSupport", Vector3.new(data.w, data.h, data.d), CFrame.new(data.x, data.y, data.z),
            zoneIndex == 4 and COLORS.dark or COLORS.stone, Enum.Material.Slate, true)
        p:SetAttribute("SurfaceId", surfaceId)
        p:SetAttribute("ZoneIndex", zoneIndex)
        self.allFloors[#self.allFloors + 1] = p
        local top = data.y + data.h / 2
        -- Every paving stone belongs to one support; no decorative strip spans a gap.
        for x = data.x - data.w / 2 + 3.5, data.x + data.w / 2 - 3.5, 7 do
            for z = data.z - data.d / 2 + 3.5, data.z + data.d / 2 - 3.5, 7 do
                local tile = part(g, "RoutePaving", Vector3.new(6.5, 0.08, 6.5), CFrame.new(x, top + 0.04, z),
                    zoneIndex == 4 and COLORS.pale or Color3.fromRGB(91, 111, 103), Enum.Material.Slate)
                tile.Transparency = 0.28
            end
        end
        for _,side in ipairs({-1, 1}) do
            part(g, "PlatformEdge", Vector3.new(data.w, 0.18, 0.32), CFrame.new(data.x, top + 0.12, data.z + side * (data.d / 2 - 0.25)), COLORS.pale)
        end
        return top
    end
    local function gate(x, z, top, width, title)
        local beam = part(g, "DistrictGate", Vector3.new(0.7, 12, width + 8), CFrame.new(x, top + 6, z), COLORS.amber, Enum.Material.ForceField, true)
        local marker = ball(g, "DistrictBeacon", Vector3.new(1.7, 1.7, 1.7), CFrame.new(x, top + 14, z), COLORS.amber, Enum.Material.Neon)
        local result = {beam = beam, marker = marker, light = pointLight(marker, COLORS.amber, 20, 1.6),
            label = label(beam, title, 330, Vector3.new(0, 7.5, 0))}
        gateState(result, false)
        return result
    end
    for index, zone in ipairs(level.zones) do
        for _,data in ipairs(zone.platforms) do platform(data, index, zone.id) end
        for _,data in ipairs(zone.obstacles or {}) do
            if data.kind == 'StoneCover' then
                local cover = part(g, 'StoneCover', Vector3.new(data.w, data.h, data.d), CFrame.new(data.x, data.y, data.z), COLORS.stone, Enum.Material.Rock, true)
                -- A cover is physical support within its district, not a new
                -- respawn floor or an actor with its own life/ownership.
                cover:SetAttribute('SurfaceId', zone.id)
                cover:SetAttribute('ZoneIndex', index)
                part(g, 'CoverCrown', Vector3.new(data.w, .18, data.d), CFrame.new(data.x, data.y + data.h / 2, data.z), COLORS.pale, Enum.Material.Slate)
            end
        end
        local first, last = zone.platforms[1], zone.platforms[#zone.platforms]
        local x, y, z = first.x - first.w / 2 + 8, first.y + first.h / 2, first.z
        local sign = part(g, "DistrictSign", Vector3.new(0.8, 6, 0.8), CFrame.new(x, y + 3, z - first.d / 2 - 2), COLORS.dark, Enum.Material.Wood)
        label(sign, tostring(index) .. "  ·  " .. string.upper(zone.name), 350, Vector3.new(0, 5, 0)).TextSize = 21
        -- Large silhouettes identify districts from the moving camera without blocking jumps.
        for _,side in ipairs({-1, 1}) do
            local depth = z + side * (first.d / 2 + 4)
            if index == 1 or index == 2 then
                part(g, "AqueductTower", Vector3.new(5, 19 + index * 2, 5), CFrame.new(x + 13, y + 8, depth), COLORS.dark, Enum.Material.Rock)
                part(g, "TowerCrown", Vector3.new(8, 2, 8), CFrame.new(x + 13, y + 19, depth), COLORS.pale, Enum.Material.Slate)
            elseif index == 3 then
                local bowl = ball(g, "CourtyardBrazier", Vector3.new(4, 3, 4), CFrame.new(x + 24, y + 4, depth), COLORS.rust)
                ball(g, "BrazierGlow", Vector3.new(2, 3, 2), CFrame.new(x + 24, y + 6, depth), COLORS.amber, Enum.Material.Neon)
                pointLight(bowl, COLORS.amber, 22, 2)
            elseif index == 4 then
                part(g, "CliffNeedle", Vector3.new(6, 26, 7), CFrame.new(x + 11, y - 8, depth), COLORS.dark, Enum.Material.Rock)
                ball(g, "CliffMoss", Vector3.new(8, 3, 9), CFrame.new(x + 11, y + 5, depth), COLORS.moss, Enum.Material.Grass)
            elseif index == 5 then
                part(g, "ForgeChimney", Vector3.new(5, 24, 5), CFrame.new(x + 21, y + 10, depth), COLORS.rust, Enum.Material.Metal)
                local glow = part(g, "ForgeWindow", Vector3.new(3, 4, 0.3), CFrame.new(x + 21, y + 6, depth - side * 2.7), COLORS.amber, Enum.Material.Neon)
                pointLight(glow, COLORS.amber, 18, 1.8)
            else
                part(g, "BridgePylon", Vector3.new(3.5, 23, 4), CFrame.new(x + 15, y + 8, depth), COLORS.pale, Enum.Material.Slate)
                part(g, "BridgeBrace", Vector3.new(9, 2, 3), CFrame.new(x + 15, y + 19, depth), COLORS.dark)
            end
        end
        for _,gap in ipairs(zone.gaps or {}) do
            -- Marks stay entirely on the takeoff/landing edges, outside the empty air.
            local left, right = gap.minX, gap.maxX
            local before, after
            for _,data in ipairs(zone.platforms) do
                if math.abs(data.x + data.w / 2 - left) &lt; .01 then before = data end
                if math.abs(data.x - data.w / 2 - right) &lt; .01 then after = data end
            end
            for _,edge in ipairs({{x = left - .35, data = before}, {x = right + .35, data = after}}) do
                local data = edge.data
                if data then
                    local top = data.y + data.h / 2
                    part(g, "JumpEdge", Vector3.new(.45, .13, data.d - 1), CFrame.new(edge.x, top + .12, data.z), COLORS.amber, Enum.Material.Neon)
                    local marker = part(g, "JumpMarker", Vector3.new(1, .1, 1), CFrame.new(edge.x - 1, top + .15, data.z), COLORS.mint, Enum.Material.Neon)
                    label(marker, "JUMP  →", 210, Vector3.new(0, 3.2, 0)).TextColor3 = COLORS.amber
                end
            end
        end
        self.gates[index] = gate(zone.gateX, last.z, last.y + last.h / 2, last.d, tostring(index) .. "  ·  " .. zone.name)
    end
    local boss = level.boss
    platform(boss.platform, #level.zones + 1, "GuardianCourt")
    local bossTop = boss.platform.y + boss.platform.h / 2
    self.exitGate = gate(boss.gateX, boss.platform.z, bossTop, boss.platform.d, "CAUSEWAY GUARDIAN")
    self.exitPad = part(g, "ExitPad", Vector3.new(boss.pad.w, .13, boss.pad.d), CFrame.new(boss.pad.x, boss.pad.y, boss.pad.z), COLORS.mint, Enum.Material.Neon)
    self.exitPad.Transparency = .78
    for _,side in ipairs({-1, 1}) do
        local z = boss.platform.z + side * (boss.platform.d / 2 + 3)
        part(g, "GuardianObelisk", Vector3.new(5, 27, 5), CFrame.new(boss.position.x + 5, bossTop + 11, z), COLORS.dark, Enum.Material.Rock)
        local light = ball(g, "GuardianSigil", Vector3.new(3, 3, 3), CFrame.new(boss.position.x + 5, bossTop + 23, z), COLORS.mint, Enum.Material.Neon)
        pointLight(light, COLORS.mint, 24, 2)
    end
    local bounds = level.bounds
    local marsh = part(g, "RouteMarsh", Vector3.new(bounds.maxX - bounds.minX + 640, .4, 430),
        CFrame.new((bounds.minX + bounds.maxX) / 2, -9, (bounds.minZ + bounds.maxZ) / 2), Color3.fromRGB(34, 101, 96), Enum.Material.Glass)
    marsh.Transparency, marsh.Reflectance = .34, .25
    local depth = part(g, "MarshDepth", Vector3.new(bounds.maxX - bounds.minX + 640, 9, 430),
        CFrame.new((bounds.minX + bounds.maxX) / 2, -15, (bounds.minZ + bounds.maxZ) / 2), COLORS.dark)
    depth.Transparency = .22
    marsh.CanQuery=false;depth.CanQuery=false
    self:progress(1, false)
end

local function resetOrigins(self)
    local route=self.config.Level
    if route and route.campaignIndex and route.campaignIndex&gt;1 then
        self.origins={}
        for slot=1,3 do
            local p=route.spawns and route.spawns[slot] or route.spawn or {x=0,y=3,z=0}
            self.origins[slot]=Vector3.new(p.x,p.y,p.z+(route.spawns and 0 or (slot-2)*6))+self.offset
        end
        return
    end
    local first = self.config.Level and self.config.Level.zones[1].platforms[1]
    local y, z = first and first.y + first.h / 2 + 3 or 3, first and first.z or 0
    self.origins = {
        [1] = Vector3.new(-65, y, z - 7) + self.offset,
        [2] = Vector3.new(-65, y, z) + self.offset,
        [3] = Vector3.new(-65, y, z + 7) + self.offset,
    }
end

local function translateGeometry(self)
    for _,object in ipairs(self.geometry:GetDescendants()) do
        if object:IsA('BasePart') then object.CFrame += self.offset end
    end
end

local function layoutAttributes(self)
    local variation = self.config.Level and self.config.Level.variation
    self.folder:SetAttribute('LayoutSeed', variation and variation.seed)
    self.folder:SetAttribute('LayoutVersion', variation and variation.version)
end

-- The radii enclose the entire plant at maximum scale, including tilted blades.
local grassRadius, treeRadius = 2, 4.6
local bladeColors = {Color3.fromRGB(117,187,61), Color3.fromRGB(161,205,75), Color3.fromRGB(74,151,65)}
local function growPlants(parent, root, rng, tree)
    local scale = rng:NextNumber(.9, 1.05)
    local function piece(name, size, x, y, z, color, material, round, tilt)
        local frame = root * CFrame.new(x*scale,y*scale,z*scale) * CFrame.Angles(0,0,tilt or 0)
        local p = part(parent,name,size*scale,frame,color,material,false)
        if round then p.Shape=Enum.PartType.Ball end
        p.CanQuery=false
        p.CastShadow=false
    end
    -- A patch of moss and a fan of contrasting leaves read as grass from above.
    piece("GrassPatch",Vector3.new(3,.38,2),0,.14,0,Color3.fromRGB(83,141,57),Enum.Material.Grass,true)
    local patch = root
    for n=1,5 do
        root = patch * CFrame.Angles(0,n*math.pi*2/5,0)
        local height=rng:NextNumber(2.5,3.35)
        piece("GroundLeaf",Vector3.new(.60,height,.88),.74,height*.46,0,
            bladeColors[(n-1)%3+1],Enum.Material.SmoothPlastic,true,-.38)
    end
    if tree then
        root=patch
        piece("MarshTrunk",Vector3.new(1.05,5.6,1.15),0,2.7,0,Color3.fromRGB(119,80,47),Enum.Material.Wood,false,-.08)
        piece("MarshBough",Vector3.new(.62,2.8,.68),-.58,4.4,0,Color3.fromRGB(133,89,48),Enum.Material.Wood,false,.54)
        piece("MarshCrown",Vector3.new(4.5,3.6,4.15),-1.35,6,.15,Color3.fromRGB(65,139,69),Enum.Material.Grass,true)
        piece("MarshCrown",Vector3.new(4.45,4.55,4.65),.83,7.5,-.25,Color3.fromRGB(94,168,67),Enum.Material.Grass,true)
        piece("MarshCrown",Vector3.new(3.75,3.25,3.8),.48,8.9,.08,Color3.fromRGB(150,190,81),Enum.Material.Grass,true)
    end
end

function World:scatterPlants(route)
    local mode = route.mode or "Causeway"
    if mode ~= "Causeway" and mode ~= "Speeder" and mode ~= "Tubes" and mode ~= "Finale" then return end
    local rng = Random.new(route.variation and route.variation.seed or 1)
    local halfPassage = mode == "Speeder" and route.course.laneLimit or 8
    for zoneIndex,zone in ipairs(route.zones) do
        for _, floor in ipairs(zone.platforms) do
            local top = floor.y + floor.h / 2
            local road = mode == "Speeder"
            if (not road or floor.roadRise ~= nil) and (mode ~= "Tubes" or top &gt;= 0) then
                local spans = math.floor(floor.w / 14)
                for i=1,spans do
                    -- Trees occupy the far half so their crowns cannot hide the hero.
                    local side = i%2==1 and -1 or 1
                    local edge = side*floor.z + floor.d/2
                    local inner = math.max(halfPassage,side*floor.z+halfPassage)
                    local tree = side==-1 and not road and edge-inner &gt;= treeRadius*2+.5
                    local radius = tree and treeRadius or grassRadius
                    local low, high = inner+radius+.15, edge-radius-.15
                    if high &gt;= low then
                        local slotWidth=floor.w/spans
                        local x=floor.x-floor.w/2+(i-.5+rng:NextNumber(-.10,.10))*slotWidth
                        x=math.clamp(x,floor.x-floor.w/2+radius+2,floor.x+floor.w/2-radius-2)
                        local z=side*rng:NextNumber(low,math.min(high,low+3.5))
                        local clear=true
                        -- Keep vegetation off the sloped masonry and its landing.
                        local slope = 0
                        if mode=="Causeway" and zoneIndex%2==1 then slope=12 end
                        if mode=="Finale" and floor==zone.platforms[1] then slope=14 end
                        if slope&gt;0 and side==-1 and math.abs(x-floor.x)&lt;=slope+radius then clear=false end
                        if clear then
                            local surfaceY=top+(floor.roadRise or 0)*(x-floor.x)/floor.w
                            local root=(CFrame.new(x,surfaceY+.10,z)+self.offset)*CFrame.Angles(0,rng:NextNumber(0,2*math.pi),0)
                            growPlants(self.geometry,root,rng,tree)
                            -- A separate tuft beside each tree stays visible below its canopy.
                            if tree then
                                local dx = x &lt; floor.x and 6 or -6
                                local gx = x + dx
                                if math.abs(gx-floor.x)+grassRadius &lt;= floor.w/2-2
                                    and (slope==0 or math.abs(gx-floor.x)&gt;slope+grassRadius) then
                                    local tuft = CFrame.new(gx,top+.10,-(inner+grassRadius+.25))+self.offset
                                    growPlants(self.geometry,tuft*CFrame.Angles(0,rng:NextNumber(0,2*math.pi),0),rng,false)
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

-- Coordinates and edge openings are derived from the generated supports of this group.
local function buildSceneEdges(self,route)
    local g,offset=self.geometry,self.offset
    local course=route.course
    local surfaces={}
    for _,zone in ipairs(route.zones) do
        for _,p in ipairs(zone.platforms) do table.insert(surfaces,p) end
    end
    local arena=route.boss.platform
    table.insert(surfaces,arena)
    local function block(name,x,y,z,w,h,d,color,material,solid)
        local p=part(g,name,Vector3.new(w,h,d),CFrame.new(x,y,z)+offset,color,material,solid)
        p.CanQuery=solid
        return p
    end
    -- Keep the horizon inside this party's 512-stud lane, even with four groups.
    local bounds=route.bounds
    local midZ=(bounds.minZ+bounds.maxZ)/2
    local midX=(bounds.minX+bounds.maxX)/2
    local base=course and (bounds.minY or -40)-12 or -12
    if course then
        block("ValleyFloor",midX,base-3,midZ,bounds.maxX-bounds.minX+640,4,430,
            route.mode=="Ice" and Color3.fromRGB(96,143,161) or COLORS.dark,Enum.Material.Slate,false)
    end
    for n=0,math.ceil((bounds.maxX-bounds.minX+320)/72) do
        local x=bounds.minX-160+n*72
        for _,side in ipairs({-1,1}) do
            local wave=math.sin(n*2.13+side)
            local z=midZ+side*(151+9*wave)
            local h=48+24*wave
            local island=block("DistantRidgeline",x,base+4,z,128,h,74,
                route.mode=="Ice" and Color3.fromRGB(123,163,169) or Color3.fromRGB(73,99,91),
                Enum.Material.Rock,false)
            island.Shape=Enum.PartType.Ball
            island.CFrame*=CFrame.Angles(0,.17*wave,.09*wave)
            island.CastShadow=false
        end
    end
    for _,side in ipairs({-1,1}) do
        local x=side&lt;0 and bounds.minX-95 or bounds.maxX+95
        for n=-1,1 do
            local hill=block("FarBank",x+12*math.cos(n*2),base+3,midZ+n*87,64,42+n*6,128,
                Color3.fromRGB(77,105,96),Enum.Material.Rock,false)
            hill.Shape=Enum.PartType.Ball;hill.CastShadow=false
        end
    end
    local function cliff(p,color)
        local bottom=p.y-p.h/2
        block("ExposedRockFace",p.x,bottom-2,p.z,p.w-.2,4,p.d-.2,color,Enum.Material.Rock,false)
        block("LowerRockShelf",p.x,bottom-5.75,p.z,p.w*.92,3.5,p.d*.86,COLORS.dark,Enum.Material.Slate,false)
    end
    local function crest(x,top,z,length,width,height,surfaceId,zone,material,color)
        for _,side in ipairs({-1,1}) do
            local p=Instance.new("WedgePart")
            p.Name="WalkableCrest";p.Anchored=true;p.CanTouch=false
            p.Material=material;p.Color=color
            p.Size=Vector3.new(width,height,length)
            p.CFrame=CFrame.new(x+side*length/2,top+height/2,z)*CFrame.Angles(0,-side*math.pi/2,0)+offset
            p:SetAttribute("SurfaceId",surfaceId);p:SetAttribute("ZoneIndex",zone)
            p.Parent=g
        end
    end
    -- Subtract every adjoining floor from this edge before erecting its wall.
    -- A narrower link leaves an actual doorway instead of a wall across the route.
    local function closeEdge(p,axis,sign)
        local along=axis=="x" and "z" or "x"
        local depth=axis=="x" and "w" or "d"
        local width=axis=="x" and "d" or "w"
        local edge=p[axis]+sign*p[depth]/2
        local lo,hi=p[along]-p[width]/2,p[along]+p[width]/2
        local openings={}
        for _,q in ipairs(surfaces) do
            if q~=p and math.abs(q.y+q.h/2-p.y-p.h/2)&lt;=3
                and math.abs(edge+sign*.1-q[axis])&lt;=q[depth]/2 then
                local a,b=math.max(lo,q[along]-q[width]/2),math.min(hi,q[along]+q[width]/2)
                if b&gt;a then table.insert(openings,{a,b}) end
            end
        end
        table.sort(openings,function(a,b)return a[1]&lt;b[1] end)
        local function wall(a,b)
            if b-a&lt;.2 then return end
            local mid=(a+b)/2
            local x=axis=="x" and edge+sign*.4 or mid
            local z=axis=="z" and edge+sign*.4 or mid
            local w=axis=="x" and .8 or b-a
            local d=axis=="z" and .8 or b-a
            local top=p.y+p.h/2
            block("BoundaryMasonry",x,top+.9,z,w,3.8,d,COLORS.stone,Enum.Material.Slate,true)
            block("BoundaryCoping",x,top+2.85,z,w+.12,.25,d+.12,COLORS.pale,Enum.Material.Concrete,false)
            -- Low visible parapets keep the near side legible from the follow camera.
            local stop=block("ArenaBoundary",x,top+15,z,w,30,d,COLORS.stone,Enum.Material.Slate,true)
            stop.Transparency=1
        end
        local cursor=lo
        for _,opening in ipairs(openings) do
            wall(cursor,opening[1]);cursor=math.max(cursor,opening[2])
        end
        wall(cursor,hi)
    end
    local function enclosure(p)
        for _,axis in ipairs({"x","z"}) do
            closeEdge(p,axis,-1);closeEdge(p,axis,1)
        end
    end
    if not course then
        for index,zone in ipairs(route.zones) do
            for _,p in ipairs(zone.platforms) do
                cliff(p,COLORS.stone)
                if index==1 or index==3 or index==5 then
                    enclosure(p)
                    crest(p.x,p.y+p.h/2,p.z-p.d*.26,12,p.d*.38,2.8,zone.id,index,Enum.Material.Grass,COLORS.moss)
                end
            end
        end
    elseif route.mode=="Speeder" then
        -- Keep the rock foundation beneath the lowest edge of each sloping panel.
        for _,p in ipairs(course.platforms) do
            if p.roadRise then
                local bottom=p.y-p.h/2-math.abs(p.roadRise)/2
                block("RoadFoundation",p.x,bottom-5,p.z,p.w,10,p.d-.4,COLORS.rust,Enum.Material.Rock,false)
            end
        end
    elseif route.mode=="Surf" or route.mode=="Jet" then
        local dock=course.platforms[1]
        cliff(dock,COLORS.stone)
        closeEdge(dock,"x",-1)
        closeEdge(dock,"z",-1);closeEdge(dock,"z",1)
        -- The far end opens onto water or air for boarding.
        for _,side in ipairs({-1,1}) do
            for x=60,course.finishPoint.x-24,50 do
                local height=10+4*math.sin(x*.08+side)
                block("DistantBluff",x,-13+height/2,side*(course.laneLimit+24),40,height,10,
                    route.mode=="Surf" and COLORS.moss or COLORS.rust,Enum.Material.Rock,false)
            end
        end
    elseif route.mode=="Tubes" then
        for _,p in ipairs(course.platforms) do
            cliff(p,COLORS.stone)
            closeEdge(p,"z",-1);closeEdge(p,"z",1)
        end
    elseif route.mode=="Ice" or route.mode=="Finale" then
        for _,p in ipairs(course.platforms) do
            cliff(p,route.mode=="Ice" and Color3.fromRGB(96,161,181) or COLORS.dark)
            if route.mode=="Finale" then enclosure(p) end
        end
        if route.mode=="Finale" then
            local p=course.platforms[1]
            crest(p.x,p.y+p.h/2,p.z-p.d*.24,14,p.d*.35,3,route.id..":1",1,Enum.Material.Slate,COLORS.stone)
        end
    end
    if not course or route.boss.kind then
        cliff(arena,COLORS.dark)
        enclosure(arena)
        crest(arena.x,arena.y+arena.h/2,arena.z+arena.d*.31,12,arena.d*.18,2.5,
            course and route.id..":Arena" or "GuardianCourt",course and 1 or #route.zones+1,Enum.Material.Slate,COLORS.stone)
    end
end

local function buildLevelGeometry(self,route)
    if self.campaignWorld then self.campaignWorld:close();self.campaignWorld=nil end
    if route and route.campaignIndex and route.campaignIndex&gt;1 then
        assert(self.campaignWorldType,'Campaign world adapter is required')
        self.campaignWorld=self.campaignWorldType.new(self,route)
    else
        if self.baseFallY then self.config.FallY=self.baseFallY end
        if route then buildRoute(self,route) else buildGeometry(self) end
        translateGeometry(self)
    end
    if route then
        buildSceneEdges(self,route)
        self:scatterPlants(route)
    end
end

function World.new(BaseWorld, config, options)
    options = options or {}
    local worldName = options.name or "BrickToadsWorld"
    local offset = options.offset or {}
    local translation = Vector3.new(offset.x or 0, offset.y or 0, offset.z or 0)
    -- A newly created group must never replace an existing group's physical world.
    assert(not Workspace:FindFirstChild(worldName), "World already exists: " .. worldName)
    -- Remove only the untouched blank-place defaults in this playable runtime.
    for _,object in ipairs(Workspace:GetChildren()) do
        if (object.Name == "Baseplate" and object:IsA("BasePart"))
            or (object.Name == "SpawnLocation" and object:IsA("SpawnLocation")) then
            object:Destroy()
        end
    end
    local worldConfig = table.clone(config)
    worldConfig.FallY = config.FallY + translation.Y
    local self = BaseWorld.new(worldConfig)
    self.baseFallY=worldConfig.FallY
    self._base = BaseWorld
    self.characterAppearance = options.characterAppearance
    self.guardianAppearance = options.guardianAppearance
    self.castAppearance = options.castAppearance
    self.campaignWorldType = options.campaignWorld
    self.offset = translation
    setmetatable(self, {__index = function(_, key) return World[key] or BaseWorld[key] end})
    self.folder.Name = worldName
    self.folder:SetAttribute("LevelName", "Flooded Causeway")
    self.folder:SetAttribute("OriginalArt", true)
    self.enemyKinds = {}
    self.healingFlyFolder = Instance.new("Folder")
    self.healingFlyFolder.Name = "HealingFlies"
    self.healingFlyFolder.Parent = self.folder
    self.healingEffectFolder = Instance.new("Folder")
    self.healingEffectFolder.Name = "HealingEffects"
    self.healingEffectFolder.Parent = self.folder
    self.healingFlyVisuals, self.healingEffects = {}, {}
    self.enemyCarries = {}
    self.clubItemFolder = Instance.new('Folder')
    self.clubItemFolder.Name = 'ClubItems'
    self.clubItemFolder.Parent = self.folder
    self.clubItems, self.equippedClubs = {}, {}
    resetOrigins(self)
    buildLevelGeometry(self,config.Level)
    layoutAttributes(self)
    Lighting.ClockTime = 16.5
    Lighting.Brightness = 2.2
    Lighting.Ambient = Color3.fromRGB(80, 109, 111)
    Lighting.OutdoorAmbient = Color3.fromRGB(119, 142, 132)
    Lighting.ColorShift_Top = Color3.fromRGB(255, 220, 170)
    Lighting.GlobalShadows = true
    Lighting.FogColor = Color3.fromRGB(112, 155, 151)
    Lighting.FogStart = 150
    Lighting.FogEnd = 380
    local atmosphere = Lighting:FindFirstChild("CausewayAtmosphere") or Instance.new("Atmosphere")
    atmosphere.Name = "CausewayAtmosphere"
    atmosphere.Density = 0.24
    atmosphere.Offset = 0.12
    atmosphere.Color = Color3.fromRGB(178, 207, 186)
    atmosphere.Decay = Color3.fromRGB(84, 123, 126)
    atmosphere.Glare = 0.12
    atmosphere.Haze = 1.5
    atmosphere.Parent = Lighting
    self:stage("Approach")
    return self
end

function World:rebuildLevel(route)
    -- The caller must finish the old run's cleanup before any geometry or
    -- configuration changes; even a dead body still belongs to that old run.
    if next(self.actors) ~= nil then return false, 'ACTORS_PRESENT' end
    assert(type(route) == 'table' and type(route.zones) == 'table' and route.zones[1]
        and route.boss and route.bounds, 'A complete level route is required')
    self.config.Level = route
    self.blocked = false
    self.lastSupport, self.deathReason = {}, {}
    buildLevelGeometry(self,route)
    resetOrigins(self)
    layoutAttributes(self)
    self:stage('Approach')
    return true
end

function World:advanceGeometry(route)
    assert(type(route)=='table' and route.zones and route.boss and route.bounds,'A complete campaign route is required')
    if self.campaignModes then self.campaignModes:close('LevelTransition');self.campaignModes=nil end
    local remove={}
    for id,actor in pairs(self.actors) do
        if id&lt;0 then remove[#remove+1]=id
        else
            self:campaignRelease(id)
            if actor.humanoid.Health&gt;0 then self:hold(id,true) end
            self:resetLocomotion(id)
        end
    end
    for _,id in ipairs(remove) do
        local actor=self.actors[id]
        if self.guardianAppearance then self.guardianAppearance.detach(actor) end
        actor.model:Destroy();self.actors[id]=nil
    end
    for id in pairs(self.equippedClubs) do self:unequipClub(id) end
    self.healingFlyFolder:ClearAllChildren();self.healingEffectFolder:ClearAllChildren()
    self.clubItemFolder:ClearAllChildren()
    self.healingFlyVisuals,self.healingEffects,self.clubItems,self.equippedClubs={},{},{},{}
    self.enemyCarries={};self.enemyKinds={}
    self.config.Level=route;self.config.Calibration=route.calibration or self.config.Calibration
    self.blocked=false;self.lastSupport={};self.deathReason={}
    buildLevelGeometry(self,route);resetOrigins(self);layoutAttributes(self)
    self.transitionOrigins=table.clone(self.origins)
    self:stage(route.mode or 'Approach')
    return true
end

function World:finishLevelTransition()
    self.transitionOrigins=nil
    for id,actor in pairs(self.actors) do
        if id&gt;0 and actor.humanoid.Health&gt;0 then self:hold(id,false) end
    end
end

function World:campaignPose(id,point,mode,velocity,heading)
    local actor=self.actors[id]
    if not actor or not actor.root.Parent or actor.humanoid.Health&lt;=0 then return false end
    actor.campaignControl=true
    actor.campaignVelocity=velocity and Vector3.new(velocity.x or 0,velocity.y or 0,velocity.z or 0) or Vector3.new()
    actor.root.Anchored=true
    actor.humanoid.AutoRotate=false
    local position=Vector3.new(point.x,point.y,point.z)+self.offset
    local direction=velocity and Vector3.new(velocity.x or 0,0,velocity.z or 0)
    if mode=='Clinger'and type(heading)=='table'then
        local x,z=heading.x,heading.z
        if type(x)=='number'and type(z)=='number'and x==x and z==z and math.abs(x)&lt;=1 and math.abs(z)&lt;=1 then
            local facing=Vector3.new(x,0,z)
            if facing.Magnitude&gt;.001 then direction=facing end
        end
    end
    if not direction or direction.Magnitude&lt;.001 then direction=actor.root.CFrame.LookVector end
    actor.model:PivotTo(CFrame.lookAt(position,position+direction))
    actor.root.AssemblyLinearVelocity=Vector3.new()
    actor.root.AssemblyAngularVelocity=Vector3.new()
    actor.model:SetAttribute('CampaignMode',mode)
    return true
end

function World:campaignRelease(id)
    local actor=self.actors[id]
    if not actor or not actor.campaignControl then return end
    actor.campaignControl=nil
    actor.campaignVelocity=nil
    actor.model:SetAttribute('CampaignMode',nil)
    actor.root.Anchored=false
    actor.humanoid.AutoRotate=true
    actor.humanoid.PlatformStand=false
    ownCompletedRig(actor)
end

function World:placeActor(id,point)
    local actor=self.actors[id]
    if not actor or not actor.root.Parent or actor.humanoid.Health&lt;=0 then return false end
    local p=Vector3.new(point.x,point.y,point.z)+self.offset
    actor.model:PivotTo(CFrame.lookAt(p,p+actor.root.CFrame.LookVector))
    actor.root.AssemblyLinearVelocity=Vector3.new()
    actor.root.AssemblyAngularVelocity=Vector3.new()
    return true
end

function World:campaignGrounded(id)
    local actor=self.actors[id]
    if not actor or not actor.root.Parent then return false end
    local p=actor.root.Position
    local hit=Workspace:Raycast(p,Vector3.new(0,-3.7,0),self.ray)
    return hit~=nil and hit.Normal.Y&gt;.8 and not hit.Instance:GetAttribute('Hazard')
end

function World:campaignObject(id,kind,point,size,metadata)
    if self.campaignWorld then return self.campaignWorld:object(id,kind,point,size,metadata) end
end

function World:campaignRemove(id)
    if self.campaignWorld then self.campaignWorld:remove(id) end
end

function World:campaignStage(mode,detail)
    self.folder:SetAttribute('CampaignMode',mode)
    self.folder:SetAttribute('CampaignDetail',detail)
end

function World:campaignImpulse(id,velocity)
    local actor=self.actors[id]
    if not actor or actor.root.Anchored or actor.humanoid.Health&lt;=0 then return end
    actor.root.AssemblyLinearVelocity=Vector3.new(velocity.x or 0,velocity.y or 0,velocity.z or 0)
end

function World:campaignWalkSpeed(id,speed)
    if type(speed)~='number' or speed~=speed or speed&lt;0 or speed&gt;40 then return false end
    local actor=self.actors[id]
    if not actor then return false end
    actor.campaignWalkSpeed=speed
    if actor.locomotion then
        actor.locomotion.walkSpeed=speed
        if actor.locomotion.airSpeed~=nil then actor.locomotion.airSpeed=speed end
        if speed==0 then actor.locomotion.runRequested=false;actor.locomotion.groundRun=false end
    end
    if not actor.humanoid.PlatformStand then actor.humanoid.WalkSpeed=speed end
    return true
end

function World:courseRival(id,title)
    local actor=self.actors[id]
    if not actor then return end
    actor.model:SetAttribute('ResourceKind','CourseRival')
    actor.model:SetAttribute('Hearts',nil)
    local head=actor.model:FindFirstChild('Head')
    local torso=actor.model:FindFirstChild('Torso')
    if head then head.CanCollide=false end
    if torso then torso.Size=Vector3.new(2,2,2) end
    if actor.healthLabel then actor.healthLabel.Text=title or 'RACING RAT' end
end

function World:campaignClaw(id,equipped)
    local actor=self.actors[id]
    if not actor or not actor.root.Parent then return end
    local prior=actor.model:FindFirstChild('CampaignRavenClaw')
    if prior and not equipped then prior:Destroy();ownCompletedRig(actor);return end
    if prior or not equipped then return end
    local hand=actor.model:FindFirstChild('Right Arm')
    if not hand then return end
    local claw=part(actor.model,'CampaignRavenClaw',Vector3.new(.35,.35,3.8),hand.CFrame,Color3.fromRGB(230,218,176))
    claw.Anchored=false;claw.Massless=true;claw.CanQuery=false
    local joint=Instance.new('Motor6D');joint.Name='RavenClawGrip';joint.Part0=hand;joint.Part1=claw
    joint.C0=CFrame.new(0,-1.1,-1.3)*CFrame.Angles(.2,0,.15);joint.C1=CFrame.new();joint.Parent=claw
    ownCompletedRig(actor)
end

function World:campaignProjectileBlocked(from,to,radius)
    local origin=Vector3.new(from.x,from.y,from.z)+self.offset
    local destination=Vector3.new(to.x,to.y,to.z)+self.offset
    local delta=destination-origin
    if delta.Magnitude&lt;.001 then return false end
    radius=radius or .6
    local overlaps=OverlapParams.new()
    overlaps.FilterType=Enum.RaycastFilterType.Include
    overlaps.FilterDescendantsInstances={self.geometry}
    overlaps.RespectCanCollide=true
    for _,p in ipairs(Workspace:GetPartBoundsInBox(CFrame.new(origin),Vector3.new(radius*2,radius*2,radius*2),overlaps)) do
        if p.CanCollide then return true end
    end
    local hit=Workspace:Spherecast(origin,radius,delta,self.ray)
    return hit~=nil
end

function World:impulse(id,attacker,tuning,profile,impulseDirection)
    local actor=self.actors[id]
    if self.campaignModes and self.campaignModes.impulse and actor and actor.campaignControl then
        local direction
        if type(impulseDirection)=='table' and type(impulseDirection.x)=='number' and type(impulseDirection.z)=='number'
            and impulseDirection.x==impulseDirection.x and impulseDirection.z==impulseDirection.z
            and math.abs(impulseDirection.x)&lt;math.huge and math.abs(impulseDirection.z)&lt;math.huge then
            local scale=math.max(math.abs(impulseDirection.x),math.abs(impulseDirection.z))
            if scale&gt;0 then direction=Vector3.new(impulseDirection.x/scale,0,impulseDirection.z/scale).Unit end
        end
        local source=self.actors[attacker]
        if not direction and source then
            local look=source.root.CFrame.LookVector
            direction=Vector3.new(look.X,0,look.Z)
            direction=direction.Magnitude&gt;.001 and direction.Unit or Vector3.new(1,0,0)
        end
        if direction and self.campaignModes:impulse(id,{x=direction.X*tuning.horizontal,
            y=tuning.vertical,z=direction.Z*tuning.horizontal}) then return end
    end
    return self._base.impulse(self,id,attacker,tuning,profile,impulseDirection)
end

function World:bossTell(kind,point,radius,untilAt)
    if self.campaignWorld then
        local id='tell:'..kind..':'..tostring(untilAt)..':'..tostring(math.floor(point.x*2))..':'..tostring(math.floor(point.z*2))
        local floor={x=point.x,y=point.y-2.9,z=point.z}
        self.campaignWorld:object(id,'Telegraph',floor,{x=radius*2,y=.12,z=radius*2},
            {label='DODGE',alpha=.35,expiresAt=untilAt})
    end
end

function World:findSafe(uid)
    local target=self.transitionOrigins and self.transitionOrigins[uid]
    if not target and self.campaignModes and self.campaignModes.respawnPosition then
        local localPoint=self.campaignModes:respawnPosition(uid)
        if localPoint then target=Vector3.new(localPoint.x,localPoint.y,localPoint.z)+self.offset end
    end
    if not target then return self._base.findSafe(self,uid) end
    -- Only substitute the search origin; collision still excludes the real body.
    local actual=self.actors[uid]
    self.actors[uid]={root={Parent=true,Position=target},model=actual and actual.model}
    local ok,result=pcall(self._base.findSafe,self,uid)
    self.actors[uid]=actual
    if not ok then error(result) end
    return result
end

function World:spawn(uid, actorId, point, held, template)
    local previous=self.actors[uid]
    if not self.origins[uid] and uid &gt; 0 then self.origins[uid] = Vector3.new(-65, 3, (uid - 2) * 7) + self.offset end
    local ok = self._base.spawn(self, uid, actorId, point, held, template or "Mr. Green")
    if ok then
        if previous then self:resetLocomotion(uid,previous) end
        -- BaseWorld places a spawn without a safe point at absolute Y=3.
        -- Keep that emergency-spawn rule relative to this arena's elevation.
        if not point and self.offset.Y ~= 0 then
            local actor = self.actors[uid]
            local p = Vector3.new(actor.root.Position.X, 3 + self.offset.Y, actor.root.Position.Z)
            actor.model:PivotTo(CFrame.lookAt(p, p + Vector3.new(1, 0, 0)))
            self.origins[uid] = p
        end
        self.actors[uid].model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
        toad(self.actors[uid], template or "Mr. Green", self.characterAppearance)
        ownCompletedRig(self.actors[uid])
        local actor=self.actors[uid]
        actor.humanoid.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
        local ownerName=label(actor.root,actor.humanoid.DisplayName,220,Vector3.new(0,4.2,0))
        ownerName.AutoLocalize=false;ownerName.Parent.AutoLocalize=false
        ownerName.TextSize=14
        ownerName.Parent.Name='OwnerNameplate'
    end
    return ok
end

function World:spawnEnemy(id, kind, positionTable)
    if type(id) ~= "number" or id &gt;= 0 or id &lt;= -1000 or not positionTable then return false end
    local x, y, z = positionTable.x, positionTable.y, positionTable.z
    if type(x) ~= "number" or type(y) ~= "number" or type(z) ~= "number" then return false end
    local campaignBoss=self.campaignWorldType and self.campaignWorldType.bossNames[kind]
    local isBoss = string.lower(tostring(kind)) == "boss" or campaignBoss~=nil
    local position = Vector3.new(x, y, z) + self.offset
    self.origins[id] = position
    local speciesNames = {Pig = "Armored Boar", Walker = "Walking Guard", Dragon = "Winged Guard"}
    self.names[id] = campaignBoss or (isBoss and "Causeway Guardian" or speciesNames[kind]
        or (kind and (kind:gsub('(%l)(%u)','%1 %2'))) or "Rusty Guard")
    local previous=self.actors[id]
    if not self._base.spawn(self, id, id, nil, false, "Mr. Brown") then return false end
    if previous and self.guardianAppearance then self.guardianAppearance.detach(previous) end
    if previous then self:resetLocomotion(id,previous) end
    local actor = self.actors[id]
    actor.model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
    -- BaseWorld's ordinary spawn is deliberately y=3, so preserve the supplied
    -- translated position explicitly for local project/director callers.
    actor.model:PivotTo(CFrame.lookAt(position, position + Vector3.new(-1, 0, 0)))
    self.origins[id] = position
    actor.model:SetAttribute("EnemyKind", kind)
    actor.model:SetAttribute("Template", nil)
    actor.model:SetAttribute("Slot", nil)
    actor.humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    actor.humanoid.WalkSpeed = isBoss and 0 or 8
    self.enemyKinds[id] = isBoss and "Boss" or "Drone"
    actor.castRequestedKind=kind~='Boss' and kind or nil
    local importedCast=self.castAppearance and actor.castRequestedKind and self.castAppearance.attach(actor,kind)
    if importedCast then
        actor.model:SetAttribute('BossKind',campaignBoss and kind or nil)
    elseif self.campaignWorld and self.campaignWorldType.decorateActor and (campaignBoss or not speciesNames[kind]) then
        self.campaignWorldType.decorateActor(actor,kind)
        actor.model:SetAttribute('BossKind',campaignBoss and kind or nil)
    elseif isBoss then
        local imported=self.guardianAppearance and self.guardianAppearance.attach(actor)
        if not imported then boss(actor) end
    else drone(actor, kind) end
    local labelHeight=kind=="Walker" and 8.2 or (isBoss and 7.6 or 4.5)
    actor.healthLabel = label(actor.root, "♥ ♥ ♥", isBoss and 270 or 160, Vector3.new(0,labelHeight,0))
    actor.healthLabel.TextColor3 = isBoss and COLORS.amber or Color3.fromRGB(255, 164, 139)
    self:enemyHealth(id, 3, 3)
    -- The species art changes the assembly after BaseWorld pinned its basic rig.
    ownCompletedRig(actor)
    return true
end

function World:position(id)
    local a = self.actors[id]
    if not a or not a.root.Parent then return nil end
    local p = a.root.Position - self.offset
    return {x = p.X, y = p.Y, z = p.Z}
end

function World:cameraBounds()
    if self.campaignWorld then
        local b=self.config.Level.bounds
        return {minX=b.minX+self.offset.X,maxX=b.maxX+self.offset.X,
            minY=(b.minY or -40)+self.offset.Y,maxY=(b.maxY or 180)+self.offset.Y,
            minZ=b.minZ+self.offset.Z,maxZ=b.maxZ+self.offset.Z}
    end
    local minX,maxX,minZ,maxZ,top,bottom=math.huge,-math.huge,math.huge,-math.huge,-math.huge,math.huge
    for _,floor in ipairs(self.allFloors or self.floors) do
        minX=math.min(minX,floor.Position.X-floor.Size.X/2)
        maxX=math.max(maxX,floor.Position.X+floor.Size.X/2)
        minZ=math.min(minZ,floor.Position.Z-floor.Size.Z/2)
        maxZ=math.max(maxZ,floor.Position.Z+floor.Size.Z/2)
        top=math.max(top,floor.Position.Y+floor.Size.Y/2)
        bottom=math.min(bottom,floor.Position.Y+floor.Size.Y/2)
    end
    assert(minX&lt;maxX and minZ&lt;maxZ,'The current level has no camera bounds')
    if self.config.Level then
        local bounds=self.config.Level.bounds
        return {minX=bounds.minX+self.offset.X,maxX=bounds.maxX+self.offset.X,minY=bottom+7,maxY=top+52,
            minZ=bounds.minZ+self.offset.Z,maxZ=bounds.maxZ+self.offset.Z}
    end
    return {minX=minX-12,maxX=maxX+12,minY=top+7,maxY=top+52,minZ=minZ-28,maxZ=maxZ+28}
end

function World:enemyIdentity(id,actorId,ownerName)
    local actor=self.actors[id]
    if not actor or (self.enemyKinds[id]~='Drone' and self.enemyKinds[id]~='Boss') then return end
    -- A logical player role still uses server-driven Humanoid movement.
    ownCompletedRig(actor)
    actor.model:SetAttribute('ActorId',actorId)
    actor.model:SetAttribute('ControlledByPlayer',ownerName~=nil)
    if ownerName then
        local board=actor.root:FindFirstChild('OwnerNameplate')
        if board then board.Text.Text=ownerName
        else
            local text=label(actor.root,ownerName,220,Vector3.new(0,self.enemyKinds[id]=='Boss' and 10.2 or 5.7,0))
            text.AutoLocalize=false;text.Parent.AutoLocalize=false
            text.TextSize=14; text.TextColor3=COLORS.amber; text.Parent.Name='OwnerNameplate'
        end
    end
end

-- Modern route jump grace uses only this body's server-observed support. A
-- delayed packet may arrive just beyond an edge while its client still sees floor.
local function jumpSupportAt(world,position)
    local hit=Workspace:Raycast(position,Vector3.new(0,-3.4,0),world.ray)
    return hit~=nil and hit.Normal.Y&gt;=.95 and not hit.Instance:GetAttribute('Hazard')
        and hit.Instance:GetAttribute('SurfaceId')~=nil
end

local function hasJumpSupport(world,root)
    if jumpSupportAt(world,root.Position) then return true end
    -- This rig's root and physical torso have the same footprint. Its centre
    -- can pass an edge while the body still stands on it; cosmetic art must
    -- never enlarge the physical support test. Project the actual oriented
    -- half-extents horizontally, without adding a support margin.
    local cf,size=root.CFrame,root.Size
    local right=Vector3.new(cf.RightVector.X,0,cf.RightVector.Z)*(size.X/2)
    local forward=Vector3.new(cf.LookVector.X,0,cf.LookVector.Z)*(size.Z/2)
    for _,offset in ipairs({forward,-forward,right,-right,
        right+forward,right-forward,-right+forward,-right-forward}) do
        if jumpSupportAt(world,root.Position+offset) then return true end
    end
    return false
end

local function sampleJumpSupport(world,actor,now)
    local root,humanoid=actor.root,actor.humanoid
    local state=actor.routeJumpSupport
    if not state then state={consumed=false}; actor.routeJumpSupport=state end
    local velocity=root.AssemblyLinearVelocity
    local grounded=false
    if humanoid.FloorMaterial~=Enum.Material.Air and velocity.Y&lt;=1 then
        grounded=hasJumpSupport(world,root)
    end
    if state.consumed then
        -- FloorMaterial can retain its old value until the next physics step.
        -- A jump is rearmed only after observed upward flight and a real landing.
        if humanoid.FloorMaterial==Enum.Material.Air and
            (velocity.Y&gt;1 or root.Position.Y&gt;(state.launchY or root.Position.Y)+.1) then state.airborne=true end
        if grounded and state.airborne then state.consumed=false; state.airborne=false end
    end
    if grounded and not state.consumed then state.groundedAt=now; state.groundedY=root.Position.Y end
    return state,grounded
end

local function locomotionWalkSpeed(world,id)
    local actor=world.actors[id]
    if actor and actor.campaignWalkSpeed~=nil then return actor.campaignWalkSpeed end
    if world.enemyKinds[id]=='Boss' then return 0 end
    return world.enemyKinds[id]=='Drone' and world.config.Enemy.speed or world.config.WalkSpeed
end

local function locomotionRunSpeed(world,id)
    local actor=world.actors[id]
    if actor and actor.campaignWalkSpeed~=nil then return actor.campaignWalkSpeed end
    return world.enemyKinds[id]=='Drone' and world.config.Movement.enemyRunSpeed or world.config.Movement.heroRunSpeed
end

local function locomotionCanRun(world,id,a)
    return a and a.root.Parent and a.humanoid.Health&gt;0 and not a.root.Anchored and not a.humanoid.PlatformStand
        and world.enemyKinds[id]~='Boss' and id&gt;-1000 and not world.enemyCarries[id]
        and not (world.dragonLinks and world.dragonLinks[id]) and not (world.dragonFlights and world.dragonFlights[id])
        and not a.model:GetAttribute('DragonLink') and not a.model:GetAttribute('DragonFlight')
        and a.model:GetAttribute('EnemyKind')~='Dragon' and not a.model:GetAttribute('CarryingEnemy')
end

local function locomotionGrounded(world,a)
    return a.humanoid.FloorMaterial~=Enum.Material.Air and a.root.AssemblyLinearVelocity.Y&lt;=1
        and hasJumpSupport(world,a.root)
end

local function locomotionFresh(world,row)
    return row and row.at and Workspace:GetServerTimeNow()&lt;row.at+(world.config.MoveTimeout or .35)
end

local function locomotionQualifies(world,id,a,row)
    if not row or not row.runRequested or row.airSpeed or not locomotionFresh(world,row)
        or not locomotionCanRun(world,id,a) or not locomotionGrounded(world,a) then return false end
    local v=a.root.AssemblyLinearVelocity
    return v.X*row.x+v.Z*row.z&gt;=locomotionRunSpeed(world,id)*world.config.Movement.runThresholdRatio
end

function World:resetLocomotion(id,actorReference)
    if not self.config.Movement then return end
    local a=actorReference or self.actors[id]
    if not a then return end
    local walk=a.locomotion and a.locomotion.walkSpeed or locomotionWalkSpeed(self,id)
    a.locomotion=nil
    a.model:SetAttribute('MovementMode','Idle')
    if a.root.Parent then
        a.humanoid:Move(Vector3.new(),false)
        a.humanoid.WalkSpeed=a.humanoid.PlatformStand and 0 or walk
    end
end

function World:isRunning(id)
    local modeActor=self.campaignModes and self.campaignModes.actors and self.campaignModes.actors[id]
    local body=self.actors[id]
    if body and body.campaignControl and modeActor then
        if self.campaignModes.isRunning then return self.campaignModes:isRunning(id) end
        local mode=self.campaignModes.mode
        if mode=='Rope' or modeActor.mounted or modeActor.medium=='Water' or modeActor.finished
            or not modeActor.grounded or not modeActor.input.run then return false end
        local v=modeActor.velocity
        local cap=self.config.Movement and self.config.Movement.heroRunSpeed or 24
        return v.x*v.x+v.z*v.z&gt;=(cap*.75)^2
    end
    if not self.config.Movement then return false end
    local a=self.actors[id]
    return a~=nil and locomotionQualifies(self,id,a,a.locomotion) or false
end

function World:movementMode(id)
    local modeActor=self.campaignModes and self.campaignModes.actors and self.campaignModes.actors[id]
    local controlled=self.actors[id]
    if controlled and controlled.campaignControl and modeActor then
        if modeActor.medium=='Water' then return 'Swim' end
        if self.campaignModes.mode=='Rope' then return 'Rope' end
        if self.campaignModes.mode=='Clinger'and not modeActor.finished then return 'Ride' end
        if modeActor.mounted then return 'Ride' end
        if not modeActor.grounded then return 'Air' end
        if self:isRunning(id) then return 'Run' end
        return modeActor.velocity.x^2+modeActor.velocity.z^2&gt;1 and 'Walk' or 'Idle'
    end
    local a=self.actors[id]
    if not a or not a.root.Parent or a.humanoid.Health&lt;=0 or a.root.Anchored or a.humanoid.PlatformStand then return 'Idle' end
    if not self.config.Movement then return 'Idle' end
    local row=a.locomotion
    if not locomotionGrounded(self,a) or (row and row.airSpeed) then return 'Air' end
    if self:isRunning(id) then return 'Run' end
    if locomotionFresh(self,row) then
        local v=a.root.AssemblyLinearVelocity
        if v.X*row.x+v.Z*row.z&gt;0 then return 'Walk' end
    end
    return 'Idle'
end

function World:move(id,x,z,runRequested)
    if self.campaignModes and self.campaignModes:move(id,x,z,runRequested) then return end
    if self.enemyCarries[id] then return end
    local a=self.actors[id]
    if not self.config.Movement then
        if a and a.campaignWalkSpeed~=nil and not a.humanoid.PlatformStand then a.humanoid.WalkSpeed=a.campaignWalkSpeed
        elseif a and self.enemyKinds[id]=='Drone' and not a.humanoid.PlatformStand then a.humanoid.WalkSpeed=self.config.Enemy.speed end
        return self._base.move(self,id,x,z)
    end
    if not a or not a.root.Parent or a.humanoid.Health&lt;=0 or a.root.Anchored or a.humanoid.PlatformStand then
        self:resetLocomotion(id);return
    end
    local length=math.sqrt(x*x+z*z)
    if length&gt;1 then x,z=x/length,z/length end
    local row=a.locomotion or {walkSpeed=locomotionWalkSpeed(self,id)}
    a.locomotion=row
    local grounded=locomotionGrounded(self,a)
    if row.airSpeed and grounded and not (a.routeJumpSupport and a.routeJumpSupport.consumed) then row.airSpeed=nil end
    if not grounded and not row.airSpeed then row.airSpeed=row.groundRun and locomotionRunSpeed(self,id) or row.walkSpeed end
    row.x,row.z=x,z
    row.runRequested=runRequested==true and length&gt;0 and locomotionCanRun(self,id,a) or false
    row.at=length&gt;0 and Workspace:GetServerTimeNow() or nil
    a.humanoid.WalkSpeed=row.airSpeed or (row.runRequested and locomotionRunSpeed(self,id) or row.walkSpeed)
    self._base.move(self,id,x,z)
    row.groundRun=locomotionQualifies(self,id,a,row)
    a.model:SetAttribute('MovementMode',self:movementMode(id))
end

function World:hazard(id)
    local controlled=self.actors[id]
    if controlled and controlled.campaignControl and controlled.root.Parent and controlled.humanoid.Health&gt;0 then
        -- The mode owns rope/vehicle/swim coordinates and its swept hazards.
        -- The first route's absolute fall plane is unrelated to that space.
        return nil
    end
    local reason=self._base.hazard(self,id)
    if not self.config.Level then return reason end
    local actor=self.actors[id]
    if actor then
        if reason or actor.root.Anchored or actor.humanoid.PlatformStand then
            actor.routeJumpSupport=nil;self:resetLocomotion(id)
        else
            local support,grounded=sampleJumpSupport(self,actor,Workspace:GetServerTimeNow())
            local row=actor.locomotion
            if self.config.Movement and row then
                if row.airSpeed and grounded and not support.consumed then row.airSpeed=nil end
                if not grounded and not row.airSpeed then
                    row.airSpeed=row.groundRun and locomotionRunSpeed(self,id) or row.walkSpeed
                end
                if row.at and not locomotionFresh(self,row) then self:move(id,0,0,false)
                else
                    row.groundRun=locomotionQualifies(self,id,actor,row)
                    actor.humanoid.WalkSpeed=row.airSpeed or (row.runRequested and locomotionRunSpeed(self,id) or row.walkSpeed)
                end
                actor.model:SetAttribute('MovementMode',self:movementMode(id))
            end
        end
    end
    return reason
end

function World:jump(id)
    if self.campaignModes and self.campaignModes:jump(id) then return end
    if not self.config.Level then return self._base.jump(self,id) end
    local actor=self.actors[id]
    if not actor or not actor.root.Parent or actor.humanoid.Health&lt;=0 or actor.root.Anchored
        or actor.humanoid.PlatformStand then return end
    if self:hazard(id) then return end
    local now=Workspace:GetServerTimeNow()
    local state,grounded=sampleJumpSupport(self,actor,now)
    if state.consumed then return end
    local grace=state.groundedAt and now-state.groundedAt&gt;=0 and now-state.groundedAt&lt;=.20
        and state.groundedY-actor.root.Position.Y&lt;=3.5
    -- Native edge hangs can report Climbing/Air while this rig's rotated
    -- footprint still overlaps its safe floor. Accept one deliberate dismount;
    -- climbing never refreshes ground history or rearms a consumed jump.
    local climbingSupport=actor.humanoid:GetState()==Enum.HumanoidStateType.Climbing
        and actor.root.AssemblyLinearVelocity.Y&lt;=1 and hasJumpSupport(self,actor.root)
    if not grounded and not grace and not climbingSupport then return end
    local power=actor.humanoid.JumpPower or self.config.JumpPower
    if type(power)~='number' or power&lt;=0 or power~=power or power==math.huge then return end
    if self.config.Movement then
        local row=actor.locomotion or {walkSpeed=locomotionWalkSpeed(self,id),x=0,z=0}
        local running=self:isRunning(id)
        actor.locomotion=row
        row.airSpeed=row.airSpeed or (running and locomotionRunSpeed(self,id) or row.walkSpeed)
        row.groundRun=false
        actor.humanoid.WalkSpeed=row.airSpeed
        actor.model:SetAttribute('MovementMode','Air')
    end
    state.consumed=true; state.airborne=false; state.launchY=actor.root.Position.Y
    local velocity=actor.root.AssemblyLinearVelocity
    actor.root.AssemblyLinearVelocity=Vector3.new(velocity.X,power,velocity.Z)
    actor.humanoid.Jump=true
end

function World:setReaction(id,active)
    if active then self:resetLocomotion(id) end
    local carried = self.enemyCarries[id]
    if carried then
        -- Reaction deadlines may expire while the body is held or in flight.
        -- Remember the requested eventual state without unfreezing it early.
        carried.platformStand = active
        carried.autoRotate = not active
        carried.walkSpeed = active and 0 or locomotionWalkSpeed(self,id)
        return
    end
    self._base.setReaction(self,id,active)
    local actor=self.actors[id]
    if actor and (self.enemyKinds[id]=='Drone' or actor.campaignWalkSpeed~=nil) then
        actor.humanoid.WalkSpeed=active and 0 or locomotionWalkSpeed(self,id)
    end
end

function World:face(id, targetId)
    local a, b = self.actors[id], self.actors[targetId]
    if not a or not b or not a.root.Parent or not b.root.Parent then return end
    local p, q = a.root.Position, b.root.Position
    local flat = Vector3.new(q.X - p.X, 0, q.Z - p.Z)
    if flat.Magnitude &gt; 0.05 then a.root.CFrame = CFrame.lookAt(p, p + flat) end
end

function World:aim(id,x,z)
    local actor=self.actors[id]
    if actor and actor.root.Parent and actor.humanoid.Health&gt;0 and x*x+z*z&gt;0 then
        local position=actor.root.Position
        actor.root.CFrame=CFrame.lookAt(position,position+Vector3.new(x,0,z))
    end
end

local function moveEnemySafely(self, id, targetId, speed, away)
    if self.enemyCarries[id] then return end
    local a, b = self.actors[id], self.actors[targetId]
    if not a or not b or not a.root.Parent or not b.root.Parent or a.root.Anchored
        or a.humanoid.PlatformStand or a.humanoid.Health &lt;= 0 then return end
    local delta = b.root.Position - a.root.Position
    if away then delta = -delta end
    local flat = Vector3.new(delta.X, 0, delta.Z)
    a.humanoid.WalkSpeed = speed or 8
    local direction = flat.Magnitude &gt; 0.2 and flat.Unit or Vector3.new()
    if direction.Magnitude &gt; 0 then
        local ahead = a.root.Position + direction * 3
        local side = Vector3.new(-direction.Z, 0, direction.X) * 0.85
        for _,offset in ipairs({Vector3.new(), side, -side}) do
            local support = Workspace:Raycast(ahead + offset + Vector3.new(0, 1, 0), Vector3.new(0, -6, 0), self.ray)
            if not support or support.Normal.Y &lt; 0.95 or support.Instance:GetAttribute("Hazard")
                or not support.Instance:GetAttribute("SurfaceId") then
                direction = Vector3.new()
                break
            end
        end
    end
    -- Stop voluntary movement at an unsafe edge. External impulses and gravity
    -- remain untouched, so combat can still knock a mechanical enemy off.
    if self.config.Movement then
        local requested=(speed or 8)&gt;=self.config.Movement.enemyRunSpeed
        self:move(id,direction.X,direction.Z,requested)
        if direction.Magnitude&gt;0 then a.humanoid.WalkSpeed=speed or 8 end
    else a.humanoid:Move(direction, false) end
end

function World:enemyMove(id, targetId, speed)
    moveEnemySafely(self,id,targetId,speed,false)
end

function World:enemyRetreat(id, targetId, speed)
    moveEnemySafely(self,id,targetId,speed,true)
end

function World:enemyHealth(id, raw, maximum)
    local a = self.actors[id]
    if not a then return end
    maximum = math.max(1, tonumber(maximum) or 3)
    local hearts = math.clamp(math.ceil(math.max(0, tonumber(raw) or 0) / maximum * 3), 0, 3)
    a.model:SetAttribute("Hearts", hearts)
    a.model:SetAttribute("HealthRaw", raw)
    a.model:SetAttribute("HealthMax", maximum)
    if self.enemyKinds[id]=='Boss' and self.guardianAppearance then
        self.guardianAppearance.health(a,raw,maximum,self.presentationTime or 0)
    end
    if a.healthLabel then
        local campaignBoss=a.model:GetAttribute('BossKind')
        if campaignBoss then
            a.healthLabel.Text=(self.names[id] or campaignBoss)..'  '..tostring(math.max(0,raw))..' / '..tostring(maximum)
            return
        end
        local symbols = {}
        for n = 1, 3 do symbols[n] = n &lt;= hearts and "♥" or "♡" end
        a.healthLabel.Text = (self.enemyKinds[id] == "Boss" and "GUARDIAN  ·  " or "") .. table.concat(symbols, " ")
    end
end

function World:bossShot(mode)
    local actor=self.actors[-99]
    if actor and self.guardianAppearance then
        self.guardianAppearance.shot(actor,mode,self.presentationTime or 0)
    end
end

function World:progress(zoneIndex, complete)
    if self.campaignWorld then
        self.folder:SetAttribute('ZoneIndex',zoneIndex)
        return
    end
    local level = self.config.Level
    if not level then return end
    zoneIndex = math.clamp(zoneIndex, 1, #level.zones + 1)
    self.zoneIndex = zoneIndex
    self.floors = {}
    for _,floor in ipairs(self.allFloors) do
        if floor:GetAttribute("ZoneIndex") &lt;= zoneIndex then self.floors[#self.floors + 1] = floor end
    end
    local completed = zoneIndex - (complete and 0 or 1)
    for index,gate in ipairs(self.gates) do gateState(gate, index &lt;= completed) end
    self.folder:SetAttribute("ZoneIndex", zoneIndex)
    self.folder:SetAttribute("ZoneName", level.zones[zoneIndex] and level.zones[zoneIndex].name or "Causeway Guardian")
end

function World:noSafe(enabled)
    if not self.config.Level then return self._base.noSafe(self, enabled) end
    self.blocked = enabled
    for _,floor in ipairs(self.allFloors) do floor.CanCollide = not enabled end
end

function World:reached(heroId, box)
    local actor = self.actors[heroId]
    if not actor or not actor.root.Parent or actor.humanoid.Health &lt;= 0 then return false end
    local p = actor.root.Position - self.offset
    return p.X &gt;= box.minX and p.X &lt;= box.maxX and p.Y &gt;= box.minY and p.Y &lt;= box.maxY
        and p.Z &gt;= box.minZ and p.Z &lt;= box.maxZ
end

function World:groundPosition(position)
    local origin = Vector3.new(position.x, position.y, position.z) + self.offset + Vector3.new(0, 16, 0)
    local hit = Workspace:Raycast(origin, Vector3.new(0, -96, 0), self.ray)
    if not hit or hit.Normal.Y &lt; .95 or hit.Instance:GetAttribute("Hazard")
        or not hit.Instance:GetAttribute("SurfaceId") then return nil end
    local p = hit.Position + Vector3.new(0, 1.2, 0) - self.offset
    return {x = p.X, y = p.Y, z = p.Z}
end

function World:stage(name)
    if self.campaignWorld then self.campaignWorld:stage(name);return end
    self.stageName = name
    self.folder:SetAttribute("Stage", name)
    if self.config.Level then
        local open = name == "Exit" or name == "Won"
        gateState(self.exitGate, open)
        self.exitGate.label.Text = name == "Won" and "CAUSEWAY CLEARED!" or (open and "EXIT  →  STAND ON THE SEAL" or "CAUSEWAY GUARDIAN")
        self.exitGate.label.TextColor3 = open and COLORS.mint or COLORS.amber
        self.exitPad.Transparency = open and .12 or .78
        return
    end
    local progress = ({Approach = 0, Courtyard = 1, BossReady = 1, Boss = 2, Exit = 3, Won = 3, Lost = -1})[name] or 0
    for index, gate in ipairs(self.gates) do
        local open = progress &gt;= index
        gate.beam.CanCollide = not open
        gate.beam.Transparency = open and 1 or 0.63
        gate.marker.Color = open and COLORS.mint or COLORS.amber
        gate.marker.Transparency = open and 0.75 or 0
        gate.light.Color = gate.marker.Color
        gate.light.Brightness = open and 0.4 or 1.6
        gate.label.TextTransparency = open and 0.65 or 0
    end
    if name == "Exit" or name == "Won" then
        self.exitGate.label.Text = name == "Won" and "CAUSEWAY CLEARED!" or "EXIT  →  STAND ON THE SEAL"
        self.exitGate.label.TextColor3 = COLORS.mint
        self.exitGate.label.TextTransparency = 0
    else
        self.exitGate.label.Text = "III  ·  CAUSEWAY GUARDIAN"
        self.exitGate.label.TextColor3 = Color3.fromRGB(226, 244, 211)
    end
    self.exitPad.Transparency = progress &gt;= 3 and 0.12 or 0.78
end

function World:atExit(heroId)
    if self.config.Level then return self:reached(heroId, self.config.Level.boss.exit) end
    local a = self.actors[heroId]
    local p = a and a.root.Parent and a.root.Position - self.offset
    return a ~= nil and a.root.Parent ~= nil and a.humanoid.Health &gt; 0
        and p.X &gt;= 108 and math.abs(p.Z) &lt;= 10
end

function World:projectile(id, positionTable, reflected, mode)
    if type(id) ~= "number" or id &gt; -1000 or not positionTable then return false end
    local p = Vector3.new(positionTable.x, positionTable.y, positionTable.z) + self.offset
    local a = self.actors[id]
    if not a then
        local model = Instance.new("Model")
        model.Name = "BogBolt_" .. tostring(-id)
        local root = ball(model, "HumanoidRootPart", Vector3.new(1.55, 1.55, 1.55), CFrame.new(p), COLORS.amber, Enum.Material.Neon)
        root.CanQuery = false
        local halo = ball(model, "BoltAura", Vector3.new(2.1, 2.1, 2.1), CFrame.new(p), COLORS.amber, Enum.Material.ForceField)
        halo.Transparency = 0.55
        local humanoid = Instance.new("Humanoid")
        humanoid.Name = "Humanoid"
        humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
        humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        humanoid.BreakJointsOnDeath = false
        humanoid.RequiresNeck = false
        humanoid.Parent = model
        model.PrimaryPart = root
        model:SetAttribute("ActorId", id)
        model:SetAttribute("Projectile", true)
        model.Parent = self.actorFolder
        a = {model = model, root = root, humanoid = humanoid, halo = halo, cue = 0}
        a.light = pointLight(root, COLORS.amber, 10, 1.2)
        self.actors[id] = a
    end
    local color, size = reflected and COLORS.mint or COLORS.amber, 1.55
    if mode == "Bullet" then color, size = Color3.fromRGB(255, 91, 66), 1.25
    elseif mode == "Heavy" then color, size = Color3.fromRGB(255, 151, 55), 2.6
    elseif mode == "Ground" or mode == "Carried" then color, size = Color3.fromRGB(255, 220, 71), 2.4
    elseif mode == "Thrown" then color, size = COLORS.mint, 2.4 end
    if mode=='StolenLife' or mode=='ReturningLife' then color,size=COLORS.mint,1.2
    elseif mode=='RavenClaw' then color,size=Color3.fromRGB(230,218,176),1.3
    elseif mode=='DeadRaven' then color,size=Color3.fromRGB(40,43,68),2 end
    a.root.CFrame = CFrame.new(p)
    a.halo.CFrame = CFrame.new(p)
    a.root.Size = Vector3.new(size, size, size)
    if mode=='StolenLife' or mode=='ReturningLife' then a.root.Size=Vector3.new(2.1,.55,.55)
    elseif mode=='RavenClaw' then a.root.Size=Vector3.new(.4,.4,3.6) end
    local haloSize = mode and size * 1.35 or 2.1
    a.halo.Size = Vector3.new(haloSize, haloSize, haloSize)
    if mode=='RavenClaw' or mode=='DeadRaven' then a.halo.Transparency=1 end
    a.root.Color = color
    a.halo.Color = color
    a.light.Color = color
    a.model:SetAttribute("Reflected", reflected == true)
    a.model:SetAttribute("ProjectileMode", mode)
    a.model:SetAttribute("Pickup", mode == "Ground")
    a.model:SetAttribute("Carried", mode == "Carried")
    if mode == "Ground" and not a.pickupLabel then
        a.pickupLabel = label(a.root, "BALL  ·  PICK UP", 190, Vector3.new(0, 2.7, 0))
        a.pickupLabel.TextColor3 = Color3.fromRGB(255, 220, 71)
    end
    if a.pickupLabel then a.pickupLabel.Parent.Enabled = mode == "Ground" end
    return true
end

function World:removeProjectile(id)
    local a = self.actors[id]
    if a and id &lt;= -1000 then
        a.model:Destroy()
        self.actors[id] = nil
    end
end

local function livingBody(world, id)
    local actor = world.actors[id]
    return actor and actor.root.Parent and actor.model.Parent == world.actorFolder
        and actor.humanoid.Health &gt; 0 and actor or nil
end

local function flatFacing(root)
    local look = root.CFrame.LookVector
    local length = math.sqrt(look.X*look.X + look.Z*look.Z)
    if length &lt; .000001 then return nil end
    return look.X/length, look.Z/length
end

function World:canGrabEnemy(heroId, enemyId, range, height, facingDot)
    local hero, enemy = livingBody(self, heroId), livingBody(self, enemyId)
    if not hero or not enemy or heroId == enemyId or self.enemyKinds[enemyId] ~= 'Drone'
        or self.enemyCarries[enemyId] or hero.model:GetAttribute('CarryingEnemy') ~= nil
        or hero.root.Anchored or hero.humanoid.PlatformStand or enemy.root.Anchored
        or hero.humanoid.FloorMaterial == Enum.Material.Air
        or math.abs(hero.root.AssemblyLinearVelocity.Y) &gt; 1 then return false end
    local support = Workspace:Raycast(hero.root.Position, Vector3.new(0,-3.4,0), self.ray)
    if not support or support.Normal.Y &lt; .95 or support.Instance:GetAttribute('Hazard')
        or support.Instance:GetAttribute('SurfaceId') == nil then return false end
    local delta = enemy.root.Position - hero.root.Position
    if delta.Magnitude &gt; range or math.abs(delta.Y) &gt; height then return false end
    local x,z = flatFacing(hero.root)
    if not x then return false end
    local horizontal = math.sqrt(delta.X*delta.X + delta.Z*delta.Z)
    if horizontal &gt; .000001 and (x*delta.X + z*delta.Z)/horizontal &lt; facingDot then return false end
    return Workspace:Raycast(hero.root.Position, delta, self.ray) == nil
end

function World:carryEnemy(enemyId, heroId)
    local enemy, hero = livingBody(self, enemyId), livingBody(self, heroId)
    if not enemy or not hero or hero.root.Anchored or hero.humanoid.PlatformStand then return false end
    local carried = self.enemyCarries[enemyId]
    if carried and (carried.mode ~= 'Carried' or carried.actor ~= enemy or carried.holder ~= hero) then return false end
    local x,z = flatFacing(hero.root)
    if not x then return false end
    if not carried then
        if enemy.root.Anchored or self.enemyKinds[enemyId] ~= 'Drone'
            or hero.model:GetAttribute('CarryingEnemy') ~= nil then return false end
        self:resetLocomotion(enemyId,enemy)
        self:resetLocomotion(heroId,hero)
        carried = {actor = enemy, holder = hero, holderId = heroId, mode = 'Carried', collisions = {},
            platformStand = enemy.humanoid.PlatformStand, autoRotate = enemy.humanoid.AutoRotate,
            walkSpeed = enemy.humanoid.WalkSpeed, anchored = enemy.root.Anchored,
            evaluateStateMachine = enemy.humanoid.EvaluateStateMachine}
        -- PlatformStand alone still lets Humanoid rewrite torso collision.
        -- Stop evaluation before disabling the parts so the carried body stays inert.
        enemy.humanoid.EvaluateStateMachine = false
        for _,p in ipairs(enemy.model:GetDescendants()) do
            if p:IsA('BasePart') then carried.collisions[p] = p.CanCollide; p.CanCollide = false end
        end
        self.enemyCarries[enemyId] = carried
        hero.cosmeticActionEvent={action='PickupEnemy'}
        enemy.humanoid:Move(Vector3.new(),false)
    end
    enemy.humanoid.EvaluateStateMachine = false
    enemy.root.Anchored = true
    enemy.humanoid.PlatformStand, enemy.humanoid.AutoRotate, enemy.humanoid.WalkSpeed = true, false, 0
    enemy.root.AssemblyLinearVelocity, enemy.root.AssemblyAngularVelocity = Vector3.new(), Vector3.new()
    local origin = hero.root.Position
    local held = Vector3.new(origin.X+x*1.75, origin.Y+3.4, origin.Z+z*1.75)
    enemy.model:PivotTo(CFrame.lookAt(held, Vector3.new(held.X+x,held.Y,held.Z+z)) * CFrame.Angles(0,0,math.pi/2))
    enemy.model:SetAttribute('CarryMode','Carried')
    enemy.model:SetAttribute('HeldBy',heroId)
    hero.model:SetAttribute('CarryingEnemy',enemyId)
    return true
end

function World:releaseEnemy(enemyId, throwerId, tuning)
    local carried = self.enemyCarries[enemyId]
    if not carried then return false end
    local x,z
    if throwerId ~= nil then
        local thrower = livingBody(self,throwerId)
        tuning = tuning or self.config.EnemyCarry
        if carried.mode ~= 'Carried' or thrower ~= carried.holder or not thrower
            or throwerId ~= carried.holderId or thrower.root.Anchored or thrower.humanoid.PlatformStand
            or type(tuning) ~= 'table' or type(tuning.horizontal) ~= 'number' or type(tuning.vertical) ~= 'number'
            or tuning.horizontal ~= tuning.horizontal or tuning.vertical ~= tuning.vertical
            or math.abs(tuning.horizontal) == math.huge or math.abs(tuning.vertical) == math.huge
            or tuning.horizontal &lt; 0 then return false end
        x,z = flatFacing(thrower.root)
        if not x then return false end
    end
    local enemy = carried.actor
    if enemy.root.Parent then enemy.humanoid.EvaluateStateMachine = carried.evaluateStateMachine end
    if carried.holder.model:GetAttribute('CarryingEnemy') == enemyId then
        carried.holder.model:SetAttribute('CarryingEnemy',nil)
    end
    enemy.model:SetAttribute('HeldBy',nil)
    if carried.mode == 'Carried' then
        for p,collidable in pairs(carried.collisions) do if p.Parent then p.CanCollide = collidable end end
        if enemy.root.Parent then
            enemy.root.Anchored = carried.anchored
            local allowed = enemy.root:CanSetNetworkOwnership()
            if allowed then enemy.root:SetNetworkOwner(nil) end
        end
    end
    if throwerId ~= nil then
        carried.mode = 'Thrown'
        carried.holder.cosmeticActionEvent={action='Throw'}
        enemy.model:SetAttribute('CarryMode','Thrown')
        enemy.root.AssemblyLinearVelocity = Vector3.new(x*tuning.horizontal,tuning.vertical,z*tuning.horizontal)
        enemy.root.AssemblyAngularVelocity = Vector3.new()
        return true
    end
    enemy.model:SetAttribute('CarryMode',nil)
    if enemy.root.Parent then
        enemy.humanoid.PlatformStand, enemy.humanoid.AutoRotate, enemy.humanoid.WalkSpeed =
            carried.platformStand, carried.autoRotate, carried.walkSpeed
    end
    self.enemyCarries[enemyId] = nil
    return true
end

-- New mechanical leg-club art. Ground items and equipment have separate lifetimes.
local function clubArt(parent, name, frame, arm)
    local model = Instance.new('Model')
    model.Name = name
    model:SetAttribute('ItemKind','WalkerClub')
    local art = {model=model,parts={}}
    local function piece(name, size, offset, color, material)
        local p = part(model,name,size,frame*offset,color,material or Enum.Material.Metal,false)
        p.CanQuery = false
        if arm then
            p.Anchored, p.Massless = false, true
            local weld = Instance.new('WeldConstraint')
            weld.Part0, weld.Part1, weld.Parent = arm, p, p
        end
        art.parts[#art.parts+1] = {part=p,offset=offset}
        return p
    end
    art.root = piece('Grip',Vector3.new(.48,.7,.55),CFrame.new(),COLORS.dark)
    piece('PistonShaft',Vector3.new(.4,2.3,.48),CFrame.new(0,-1.3,0),COLORS.pale)
    piece('UpperCollar',Vector3.new(.62,.3,.65),CFrame.new(0,-.5,0),COLORS.rust)
    piece('LowerCollar',Vector3.new(.62,.35,.65),CFrame.new(0,-2.25,0),COLORS.rust)
    piece('MechanicalFoot',Vector3.new(.95,.6,1.7),CFrame.new(0,-2.68,-.42),COLORS.dark)
    piece('ImpactPlate',Vector3.new(1.06,.19,1.85),CFrame.new(0,-3.04,-.42),COLORS.pale)
    piece('PowerStrip',Vector3.new(.12,1.5,.07),CFrame.new(0,-1.25,-.28),COLORS.mint,Enum.Material.Neon)
    model.PrimaryPart = art.root
    model.Parent = parent
    return art
end

function World:clubItem(id, position)
    local item = self.clubItems[id]
    if not position then
        if item then item.model:Destroy();self.clubItems[id]=nil end
        return
    end
    local physical = Vector3.new(position.x,position.y,position.z)+self.offset
    local frame = CFrame.new(physical)*CFrame.Angles(0,0,math.pi/2)
    if not item then
        item = clubArt(self.clubItemFolder,'ClubItem_'..tostring(id),frame)
        item.model:SetAttribute('ClubId',id)
        local text=label(item.root,"CLUB  ·  PICK UP",190,Vector3.new(0,1.4,0))
        text.TextColor3,text.TextSize,text.Parent.MaxDistance=COLORS.mint,14,45
        pointLight(item.root,COLORS.mint,7,.4)
        self.clubItems[id]=item
    end
    for _,piece in ipairs(item.parts) do piece.part.CFrame=frame*piece.offset end
end

function World:canPickupClub(heroId, position, range, height)
    local hero = livingBody(self,heroId)
    if not hero or heroId&lt;=0 or hero.root.Anchored or hero.humanoid.PlatformStand
        or hero.model:GetAttribute('CarryingEnemy')~=nil
        or hero.humanoid.FloorMaterial==Enum.Material.Air
        or math.abs(hero.root.AssemblyLinearVelocity.Y)&gt;1 then return false end
    local support=Workspace:Raycast(hero.root.Position,Vector3.new(0,-3.4,0),self.ray)
    if not support or support.Normal.Y&lt;.95 or support.Instance:GetAttribute('Hazard')
        or support.Instance:GetAttribute('SurfaceId')==nil then return false end
    local destination=Vector3.new(position.x,position.y,position.z)+self.offset
    local delta=destination-hero.root.Position
    return delta.Magnitude&lt;=range and math.abs(delta.Y)&lt;=height
        and Workspace:Raycast(hero.root.Position,delta,self.ray)==nil
end

function World:equipClub(id, heroId)
    local hero=livingBody(self,heroId)
    local arm=hero and hero.model:FindFirstChild('Right Arm')
    if not hero or heroId&lt;=0 or not arm then return false end
    local equipped=self.equippedClubs[id]
    if equipped then return equipped.owner==hero and equipped.heroId==heroId and equipped.model.Parent==hero.model end
    if hero.model:GetAttribute('EquippedClub')~=nil then return false end
    local grip=arm.CFrame*CFrame.new(0,-1.05,0)
    local appearance=hero.appearance
    if appearance and appearance.profile=='CanonicalNESHero' and appearance.ownerModel==hero.model
        and appearance.model and appearance.model.Parent==hero.model then
        local hand=appearance.model:FindFirstChild('RightHand')
        local wrist=hand and hand:FindFirstChild('RightWristRigAttachment')
        if hand and hand:IsA('BasePart') and wrist and wrist:IsA('Attachment') then
            -- The visible hand moves independently of its hidden R6 fallback.
            -- Use the palm centre; the wrist rotation corrects imported axes.
            arm,grip=hand,hand.CFrame*wrist.CFrame.Rotation
        end
    end
    local art=clubArt(hero.model,'EquippedClub_'..tostring(id),grip,arm)
    art.model:SetAttribute('ClubId',id)
    art.owner,art.heroId=hero,heroId
    self.equippedClubs[id]=art
    hero.model:SetAttribute('EquippedClub',id)
    ownCompletedRig(hero)
    return true
end

function World:unequipClub(id)
    local equipped=self.equippedClubs[id]
    if not equipped then return false end
    local owner=equipped.owner
    if owner.model:GetAttribute('EquippedClub')==id then
        owner.model:SetAttribute('EquippedClub',nil)
        owner.model:SetAttribute('ClubSwing',nil)
        if owner.poseMotors and not owner.model:GetAttribute('CarryingEnemy') then
            local right=owner.poseMotors['Right Shoulder']
            if right then right.joint.C0=right.base end
        end
    end
    equipped.model:Destroy()
    self.equippedClubs[id]=nil
    ownCompletedRig(owner)
    return true
end

function World:clubSwing(id, heroId)
    local equipped=self.equippedClubs[id]
    local hero=livingBody(self,heroId)
    if not equipped or equipped.owner~=hero or equipped.heroId~=heroId
        or hero.model:GetAttribute('EquippedClub')~=id then return false end
    equipped.swingUntil=(self.presentationTime or 0)+.28
    equipped.model:SetAttribute('Swinging',true)
    hero.model:SetAttribute('ClubSwing',true)
    hero.cosmeticActionEvent={action='Club'}
    return true
end

-- Collectibles are presentation only: they never enter the combat actor table.
function World:healingFly(id, position)
    local fly = self.healingFlyVisuals[id]
    if not position then
        if fly then fly.model:Destroy(); self.healingFlyVisuals[id] = nil end
        return
    end
    local physical = Vector3.new(position.x, position.y, position.z) + self.offset
    if not fly then
        local model = Instance.new("Model")
        model.Name = "HealingFly_" .. tostring(id)
        model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
        model:SetAttribute("CollectibleId", id)
        model:SetAttribute("CollectibleKind", "HealingFly")
        model:SetAttribute("CanCatch", true)
        fly = {model = model, parts = {}, wings = {}}
        local function piece(name, size, offset, color, shape, material)
            local p = part(model, name, size, CFrame.new(physical) * offset, color, material, false)
            p.CanQuery = false
            if shape then p.Shape = shape end
            fly.parts[#fly.parts + 1] = {part = p, offset = offset}
            return p
        end
        fly.root = piece("FlyBody", Vector3.new(.85,.65,1.1), CFrame.new(), COLORS.mint,
            Enum.PartType.Ball, Enum.Material.Neon)
        piece("FlyHead", Vector3.new(.65,.6,.55), CFrame.new(0,.07,-.65), COLORS.moss, Enum.PartType.Ball)
        for _,side in ipairs({-1,1}) do
            piece("FlyEye", Vector3.new(.2,.25,.2), CFrame.new(side*.24,.18,-.89), COLORS.amber,
                Enum.PartType.Ball, Enum.Material.Neon)
            local offset = CFrame.new(side*.66,.24,.04) * CFrame.Angles(0,side*.35,side*.25)
            local wing = piece(side&lt;0 and "LeftWing" or "RightWing", Vector3.new(1.05,.1,.72), offset,
                Color3.fromRGB(209,245,230), Enum.PartType.Ball)
            wing.Transparency = .3
            fly.wings[#fly.wings + 1] = {part = wing, offset = offset, side = side}
        end
        local aura = piece("HealingAura", Vector3.new(1.7,1.7,1.7), CFrame.new(), COLORS.mint,
            Enum.PartType.Ball, Enum.Material.ForceField)
        aura.Transparency = .84
        pointLight(fly.root, COLORS.mint, 7, .55)
        local text = label(fly.root, "FLY  ·  HEAL", 170, Vector3.new(0,1.6,0))
        text.TextSize = 13
        text.TextColor3 = COLORS.mint
        text.Parent.MaxDistance = 38
        model.PrimaryPart = fly.root
        if self.castAppearance then
            local mount=piece('Torso',Vector3.new(.1,.1,.1),CFrame.new(),COLORS.mint)
            mount.Transparency=1
            local cosmeticActor={model=model,root=fly.root}
            fly.castActor=cosmeticActor
            if self.castAppearance.attach(cosmeticActor,'HealingFly') and self.castAppearance.addFallback then
                self.castAppearance.addFallback(cosmeticActor,fly.root)
            end
        end
        model.Parent = self.healingFlyFolder
        self.healingFlyVisuals[id] = fly
    end
    for _,piece in ipairs(fly.parts) do piece.part.CFrame = CFrame.new(physical) * piece.offset end
end

function World:canCatchFly(heroSlot, position, range, height, facingDot)
    local actor = self.actors[heroSlot]
    if not actor or not actor.root.Parent then return false end
    local physical = Vector3.new(position.x, position.y, position.z) + self.offset
    local delta = physical - actor.root.Position
    if math.abs(delta.Y) &gt; height or delta.Magnitude &gt; range then return false end
    local horizontal = math.sqrt(delta.X*delta.X + delta.Z*delta.Z)
    if horizontal &lt; .000001 then return true end
    local look = actor.root.CFrame.LookVector
    local lookLength = math.sqrt(look.X*look.X + look.Z*look.Z)
    return lookLength &gt; .000001
        and (look.X*delta.X + look.Z*delta.Z) / (lookLength*horizontal) &gt;= facingDot
end

function World:catchFly(heroSlot, flyId)
    local fly, actor = self.healingFlyVisuals[flyId], self.actors[heroSlot]
    if not fly then return false end
    local destination = fly.root.Position
    self:healingFly(flyId, nil)
    if not actor or not actor.root.Parent then return true end
    actor.cosmeticActionEvent={action='Tongue'}
    local head = actor.model:FindFirstChild("Head") or actor.root
    local mouth = (head.CFrame * CFrame.new(0,-.28,-.94)).Position
    local delta = destination - mouth
    local midpoint = Vector3.new((mouth.X+destination.X)/2, (mouth.Y+destination.Y)/2, (mouth.Z+destination.Z)/2)
    local model = Instance.new("Model")
    model.Name = "HealingCatch_" .. tostring(heroSlot)
    model:SetAttribute("CollectibleId", flyId)
    local tongue = part(model, "Tongue", Vector3.new(.13,.13,math.max(delta.Magnitude,.1)),
        CFrame.lookAt(midpoint, destination), Color3.fromRGB(255,145,158), Enum.Material.Neon, false)
    tongue.CanQuery = false
    local flash = ball(model, "HealingFlash", Vector3.new(.7,.7,.7), CFrame.new(mouth), COLORS.mint, Enum.Material.Neon)
    flash.CanQuery = false
    flash.Transparency = .35
    model.Parent = self.healingEffectFolder
    self.healingEffects[model] = (self.presentationTime or 0) + .22
    return true
end

-- Original Pig silhouettes for the trusted strike state, not NES frame timing.
local pigPoses = {
    PigJab = {
        Windup = {left=.9,right=-.25,leftRoll=.2,rightRoll=-.35,hip=.1},
        Recovery = {left=.45,right=1.85,leftRoll=.12,rightRoll=-.15,hip=0},
    },
    PigHeavy = {
        Windup = {left=2.25,right=2.25,leftRoll=-.5,rightRoll=.5,hip=.35},
        Recovery = {left=1.35,right=1.35,leftRoll=-.25,rightRoll=.25,hip=.15},
    },
    PigRush = {
        Windup = {left=-.65,right=-.65,leftRoll=-.55,rightRoll=.55,hip=.55},
        Recovery = {left=1.65,right=1.65,leftRoll=-.3,rightRoll=.3,hip=.35},
    },
}

-- The Walker's mechanical legs distinguish a light kick from the heavy launch.
local walkerPoses = {
    WalkerLight = {
        Windup = {left=.25,right=.55,leftRoll=-.2,rightRoll=.2,leftHip=.15,rightHip=-.9},
        Recovery = {left=.5,right=.6,leftRoll=-.15,rightRoll=.15,leftHip=0,rightHip=1.1},
    },
    WalkerHeavy = {
        Windup = {left=1.1,right=1.1,leftRoll=-.4,rightRoll=.4,leftHip=.8,rightHip=.8},
        Recovery = {left=1.65,right=1.65,leftRoll=-.25,rightRoll=.25,leftHip=-.25,rightHip=-.25},
    },
}

-- The generic grounded run strike reuses each family's original heavy silhouette.
-- These poses only present the server-selected action; they never choose damage.
pigPoses.EnemyRunStrike=pigPoses.PigRush
walkerPoses.EnemyRunStrike=walkerPoses.WalkerHeavy

local dragonPoses = {
    DragonHeadbutt = {
        Windup = {left=-.4,right=-.4,leftRoll=-.3,rightRoll=.3,hip=-.15,neck=-.55},
        Recovery = {left=.8,right=.8,leftRoll=-.5,rightRoll=.5,hip=.2,neck=.45},
    },
}

local heroPoses = {
    HeroJab={Windup={left=.3,right=-.3,leftRoll=.1,rightRoll=-.2,hip=0},
        Recovery={left=.4,right=1.9,leftRoll=.1,rightRoll=-.1,hip=0}},
    HeroUppercut={Windup={left=.7,right=-.7,leftRoll=.2,rightRoll=-.4,hip=.15},
        Recovery={left=.6,right=2.7,leftRoll=.1,rightRoll=-.2,hip=-.2}},
    HeroElbow={Windup={left=2.3,right=2.3,leftRoll=-.4,rightRoll=.4,hip=-.15},
        Recovery={left=1.2,right=1.2,leftRoll=-.2,rightRoll=.2,hip=.25}},
    HeroPowerPunch={Windup={left=.8,right=-1,leftRoll=.2,rightRoll=-.6,hip=.25},
        Recovery={left=.5,right=2.3,leftRoll=.1,rightRoll=-.1,hip=-.3}},
    HeroKick={Windup={left=.8,right=.8,leftRoll=-.2,rightRoll=.2,leftHip=.1,rightHip=-.6},
        Recovery={left=.5,right=.5,leftRoll=-.1,rightRoll=.1,leftHip=0,rightHip=1.2}},
    HeroBoot={Windup={left=1.1,right=1.1,leftRoll=-.4,rightRoll=.4,leftHip=.3,rightHip=-1},
        Recovery={left=.4,right=.4,leftRoll=-.2,rightRoll=.2,leftHip=-.2,rightHip=1.6}},
    Dash={Windup={left=-.5,right=-.5,leftRoll=-.4,rightRoll=.4,hip=.2},
        Recovery={left=1.6,right=1.6,leftRoll=-.2,rightRoll=.2,hip=.25}},
}

function World:updatePresentation(session, dt, enemies, director)
    if self.campaignWorld then self.campaignWorld:step(session.now) end
    dt = math.clamp(tonumber(dt) or 0, 0, 0.1)
    self.presentationTime = (self.presentationTime or 0) + dt
    for id,equipped in pairs(self.equippedClubs) do
        if equipped.swingUntil and self.presentationTime&gt;=equipped.swingUntil then
            equipped.swingUntil=nil
            equipped.model:SetAttribute('Swinging',false)
            if equipped.owner.model:GetAttribute('EquippedClub')==id then equipped.owner.model:SetAttribute('ClubSwing',nil) end
        end
    end
    for model,expiresAt in pairs(self.healingEffects) do
        if self.presentationTime &gt;= expiresAt then model:Destroy(); self.healingEffects[model] = nil end
    end
    for _,fly in pairs(self.healingFlyVisuals) do
        for _,wing in ipairs(fly.wings) do
            wing.part.CFrame = CFrame.new(fly.root.Position) * wing.offset
                * CFrame.Angles(0,0,math.sin(self.presentationTime*32)*.35*wing.side)
        end
        if fly.castActor and self.castAppearance then
            if not fly.castActor.castAppearance and self.castAppearance.attach(fly.castActor,'HealingFly') then
                if self.castAppearance.addFallback then self.castAppearance.addFallback(fly.castActor,fly.root) end
            end
            self.castAppearance.update(fly.castActor,{kind='HealingFly',actorId='fly:'..tostring(fly.model:GetAttribute('CollectibleId')),
                levelEpoch=session.state and session.state.levelEpoch,now=session.now,dt=dt,speed=0,mode='Fly'})
        end
    end
    local blend = 1 - math.exp(-dt * 18)
    for id, actor in pairs(self.actors) do
        if id &gt; -1000 and actor.root.Parent and self.enemyKinds[id] ~= "Boss" then
            if not actor.poseMotors then
                actor.poseMotors = {}
                for _,joint in ipairs(actor.model:GetDescendants()) do
                    if joint:IsA("Motor6D") and (joint.Name=='RootJoint' or joint.Name == "Left Shoulder" or joint.Name == "Right Shoulder"
                        or joint.Name == "Left Hip" or joint.Name == "Right Hip"
                        or (joint.Name=='Neck' and enemies and enemies[id] and enemies[id].kind=='Dragon')) then
                        actor.poseMotors[joint.Name] = {joint = joint, base = joint.C0}
                    end
                end
            end
            if actor.wingMotors then
                local e=enemies and enemies[id]
                local flying=actor.model:GetAttribute('DragonFlight') and actor.humanoid.Health&gt;0 and not (e and e.reactionUntil)
                for _,wing in ipairs(actor.wingMotors) do
                    local stroke=flying and math.sin(self.presentationTime*10)*.45*wing.side or 0
                    wing.joint.C0=wing.joint.C0:Lerp(wing.base*CFrame.Angles(0,0,stroke),blend)
                end
            end
            local combat = session and session.combat and session.combat[id]
            local enemy = enemies and enemies[id]
            local reacting = (combat and combat.reactionEnd ~= nil) or (enemy and enemy.reactionUntil ~= nil)
            local carryingEnemy = actor.model:GetAttribute('CarryingEnemy') ~= nil
            local dragonLink=actor.model:GetAttribute('DragonLink')
            local beingCarried = self.enemyCarries[id] and self.enemyCarries[id].mode == 'Carried'
            local club=self.equippedClubs[actor.model:GetAttribute('EquippedClub')]
            if club and club.owner~=actor then club=nil end
            local pig = enemy and enemy.kind == 'Pig'
            local poses = pig and pigPoses or (enemy and enemy.kind=='Walker' and walkerPoses)
                or (enemy and enemy.kind=='Dragon' and dragonPoses)
                or (combat and session.sourceCombat and heroPoses)
            local actionState=enemy or combat
            local windup=enemy and enemy.windup or (combat and combat.attack)
            local primaryAction,primaryPhase
            if poses then
                actor.attackPoseUntil,actor.attackPoseAction = nil,nil
                local dead = actor.humanoid.Health&lt;=0 or (enemy and enemy.dead) or (combat and combat.deathAt~=nil)
                if not dead and not reacting and not carryingEnemy and not beingCarried then
                    if windup and poses[windup.action] then
                        primaryAction,primaryPhase = windup.action,'Windup'
                    elseif poses[actionState.lastStrikeAction] and type(actionState.strikeRecoveryUntil)=='number'
                        and session and type(session.now)=='number' and session.now&lt;actionState.strikeRecoveryUntil then
                        primaryAction,primaryPhase = actionState.lastStrikeAction,'Recovery'
                    elseif pig and enemy.rushing then primaryAction,primaryPhase = 'PigRush','Running' end
                end
            else
                local attack = (combat and combat.attack) or (enemy and enemy.windup)
                if attack then
                    actor.attackPoseUntil = self.presentationTime + 0.17
                    actor.attackPoseAction = attack.action or 'Punch'
                end
            end
            if poses or actor.primaryPresentationActive then
                actor.model:SetAttribute('PrimaryAttack',primaryAction)
                actor.model:SetAttribute('AttackPhase',primaryPhase)
                actor.primaryPresentationActive = poses~=nil and poses~=false
            end
            local attacking = actor.attackPoseUntil and self.presentationTime &lt; actor.attackPoseUntil
            local velocity = actor.campaignVelocity or actor.root.AssemblyLinearVelocity
            local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
            local movementMode=self.config.Movement and self:movementMode(id)
            if movementMode then actor.model:SetAttribute('MovementMode',movementMode) end
            local walking = not actor.root.Anchored and actor.humanoid.Health &gt; 0
                and actor.humanoid.FloorMaterial ~= Enum.Material.Air
            if self.config.Movement then walking=movementMode=='Walk' or movementMode=='Run' end
            local running = primaryPhase=='Running' or (movementMode=='Run' and not primaryAction)
            actor.walkPhase = (actor.walkPhase or 0) + dt * math.min(speed, 20) * (running and 1.3 or .8)
            local stride = walking and math.sin(actor.walkPhase) * math.clamp(speed / 12, 0, 1) * (running and .75 or .5) or 0
            local primaryPose = primaryAction and poses[primaryAction][primaryPhase]
            for name, motor in pairs(actor.poseMotors) do
                local shoulder = string.find(name, "Shoulder", 1, true) ~= nil
                local left = string.find(name, "Left", 1, true) ~= nil
                local angle = stride * (left and 1 or -1) * (shoulder and -1 or 1)
                local roll = 0
                if name=='RootJoint' then
                    angle=movementMode=='Swim' and -.95 or 0
                elseif name=='Neck' then
                    angle=primaryPose and primaryPose.neck or 0
                elseif shoulder and carryingEnemy then
                    angle, roll = 2.65, left and -.2 or .2
                elseif dragonLink=='Mounted' then
                    angle=shoulder and .55 or 1.2;roll=left and -.2 or .2
                elseif dragonLink=='Captured' then
                    angle=shoulder and 2.5 or .35;roll=left and -.2 or .2
                elseif beingCarried then
                    angle, roll = shoulder and 1.3 or .45, left and -.3 or .3
                elseif shoulder and reacting then
                    angle, roll = 0.65, left and -0.25 or 0.25
                elseif movementMode=='Rope' then
                    local striking=combat and combat.strikeRecoveryUntil and session.now&lt;combat.strikeRecoveryUntil
                    local armed=actor.model:FindFirstChild('CampaignRavenClaw')~=nil
                    angle=shoulder and (striking and armed and not left and 1.8 or 2.8)
                        or (striking and not left and 1.85 or .25)
                    roll=shoulder and (left and -.15 or .15) or 0
                elseif movementMode=='Ride' then
                    angle=shoulder and .65 or 1.1;roll=left and -.12 or .12
                elseif movementMode=='Swim' then
                    angle=shoulder and (1.2+math.sin(self.presentationTime*8+(left and 0 or math.pi))*.7)
                        or math.sin(self.presentationTime*8+(left and math.pi or 0))*.45
                elseif shoulder and club and not left then
                    angle,roll=club.swingUntil and 1.95 or .65,club.swingUntil and -.55 or .25
                elseif running then
                    angle = shoulder and (-.55-stride*.6) or (stride*1.2+.2)
                    roll = left and -.18 or .18
                elseif primaryPose then
                    angle = shoulder and (left and primaryPose.left or primaryPose.right)
                        or (left and primaryPose.leftHip or primaryPose.rightHip) or primaryPose.hip
                    roll = shoulder and (left and primaryPose.leftRoll or primaryPose.rightRoll) or 0
                elseif shoulder and attacking then
                    angle = actor.attackPoseAction == "Dash" and 1.5 or (left and 0.45 or 1.95)
                end
                motor.joint.C0 = motor.joint.C0:Lerp(motor.base * CFrame.Angles(angle, 0, roll), blend)
            end
            if self.characterAppearance then
                -- Accepted server state only. Source-stream commands remain
                -- inert; this context drives cosmetic joints after R6 fallback.
                local visualState=(actor.humanoid.Health&lt;=0 or (enemy and enemy.dead) or (combat and combat.deathAt~=nil)) and 'Dead'
                    or (reacting and 'Reaction') or (carryingEnemy and 'Carrying') or (beingCarried and 'Carried')
                    or (dragonLink=='Mounted' and 'DragonMounted') or (dragonLink=='Captured' and 'DragonCaptured')
                    or (movementMode=='Swim' and 'Swim') or (movementMode=='Ride' and 'Ride')
                    or (movementMode=='Rope' and 'Rope') or (club and 'Club')
                    or ((movementMode=='Air' or actor.humanoid.FloorMaterial==Enum.Material.Air and not actor.campaignControl) and 'Air')
                    or (walking and math.abs(velocity.Z)&gt;math.abs(velocity.X)*1.3 and 'DepthWalk') or nil
                local blocked=((actor.root.Anchored or actor.humanoid.PlatformStand) and not actor.campaignControl
                    and not visualState and 'Paused') or nil
                if combat and actor.visualReactionEpoch~=combat.reactionEpoch then
                    actor.visualReactionEpoch=combat.reactionEpoch;actor.visualReactionAt=session.now
                end
                if actor.cosmeticActionEvent and actor.seenCosmeticActionEvent~=actor.cosmeticActionEvent then
                    actor.seenCosmeticActionEvent=actor.cosmeticActionEvent
                    actor.visualAction={action=actor.cosmeticActionEvent.action,actorId=actor.model:GetAttribute('ActorId'),
                        at=session.now,tuning={windup=0}}
                end
                if actor.visualAction and session.now-actor.visualAction.at&gt;2 then actor.visualAction=nil end
                local rideDeckY
                if visualState=='Ride' and self.campaignWorld and self.campaignWorld.world==self then
                    local rider=self.campaignModes and self.campaignModes.actors and self.campaignModes.actors[id]
                    local objects=self.campaignWorld.objects
                    local row=objects and (objects['vehicle-'..tostring(id)] or objects['clinger-'..tostring(id)])
                    local mount=row and row.courseAppearance
                    if rider and rider.actorId==actor.model:GetAttribute('ActorId') and mount and mount.skin
                        and mount.model.Parent==self.geometry and mount.skin.Parent==mount.model
                        and row.part.Parent==self.geometry then
                        local y=mount.deckWorldY
                        if type(y)=='number' and y==y and math.abs(y)&lt;math.huge then rideDeckY=y end
                    end
                end
                self.characterAppearance.update(actor,{
                    enabled=combat~=nil and not enemy and session.sourceCombat and true or false,
                    actorId=actor.model:GetAttribute('ActorId'),now=session and session.now,dt=dt,
                    body=actor.model,levelEpoch=session.state and session.state.levelEpoch,
                    dashResult=actor.dashPresentationResult,
                    rideDeckY=rideDeckY,
                    attack=combat and combat.attack,recoveryAction=combat and combat.lastStrikeAction,
                    recoveryUntil=combat and combat.strikeRecoveryUntil,reactionEpoch=combat and combat.reactionEpoch,
                    blocked=blocked,visualState=visualState,verticalSpeed=velocity.Y,holding=carryingEnemy,
                    visualAction=actor.visualAction,reaction={heavy=combat and combat.heavyReaction==true,
                        startedAt=actor.visualReactionAt},
                    grounded=actor.campaignControl and (movementMode=='Walk' or movementMode=='Run' or movementMode=='Idle')
                        or not actor.campaignControl and actor.humanoid.FloorMaterial~=Enum.Material.Air,
                    mode=movementMode or (walking and 'Walk' or 'Idle'),speed=speed,
                    fearIntro=self.bossIntroState and self.bossIntroState.heroActors
                        and self.bossIntroState.heroActors[id]==actor.model:GetAttribute('ActorId') and {
                            id=self.bossIntroState.id,actorId=self.bossIntroState.heroActors[id],
                            counter=self.bossIntroState.counter,frameId=self.bossIntroState.fearFrame} or nil,
                })
            end
        end
    end
    if self.guardianAppearance then
        for id,actor in pairs(self.actors) do
            if self.enemyKinds[id]=='Boss' then self.guardianAppearance.update(actor,self.presentationTime) end
        end
    end
    if self.castAppearance then
        for _,actor in pairs(self.actors) do
            if actor.castRequestedKind and not actor.castAppearance and actor.root.Parent then
                self.castAppearance.attach(actor,actor.castRequestedKind)
            end
        end
        for id,actor in pairs(self.actors) do if actor.castAppearance and actor.root.Parent then
            local enemy=enemies and enemies[id]
            local machine=director and director.campaignEnemies
            local state=machine and machine.states[id]
            local dragons=director and (director.dragons or director.ordinary and director.ordinary.dragons)
            local flight=dragons and dragons.states[id]
            local bossState=director and director.boss
            local isBoss=bossState and id==-99
            local rawAttack=isBoss and bossState.attack or state and state.attack or enemy and enemy.windup
            if rawAttack and actor.castAttackSource~=rawAttack then
                actor.castAttackSource=rawAttack
                local tuning=rawAttack.move or rawAttack.tuning or self.config.Attacks[rawAttack.action] or {}
                actor.castAttack={name=rawAttack.name or rawAttack.action,
                    actorId=actor.model:GetAttribute('ActorId') or tostring(id),
                    levelEpoch=session.state and session.state.levelEpoch,
                    start=(rawAttack.tellAt or rawAttack.at or session.now)-(tuning.tell or tuning.windup or 0)}
            elseif not rawAttack then actor.castAttackSource=nil end
            local velocity=actor.campaignVelocity or actor.root.AssemblyLinearVelocity
            local mode=actor.model:GetAttribute('CampaignMode') or self:movementMode(id) or 'Idle'
            if type(mode)=='string' then mode=mode:gsub('^Enemy','') end
            local sourceState
            if actor.castAppearance.kind=='Dragon' then
                if flight and flight.mode=='Disabled' then mode='Disabled';sourceState='HeavyDisabled'
                elseif flight and flight.mode=='Approach' then mode='Fly';sourceState='Approach'
                elseif actor.model:GetAttribute('DragonFlight') then mode='Fly' end
            end
            local phase=isBoss and bossState.state or state and state.mode
                or enemy and enemy.windup and 'Tell' or enemy and enemy.strikeRecoveryUntil
                    and session.now&lt;enemy.strikeRecoveryUntil and 'Recovery' or 'Ready'
            if not rawAttack and phase~='Recovery' then actor.castAttack=nil end
            local reacting=enemy and enemy.reactionUntil~=nil or isBoss and phase=='Reaction'
            local reactionProgress
            if reacting then
                local epoch=enemy and enemy.reactionEpoch or 0
                if not actor.castReacting or actor.castReactionEpoch~=epoch then
                    actor.castReactionAt=session.now;actor.castReactionEpoch=epoch
                end
                local untilAt=enemy and enemy.reactionUntil
                if type(untilAt)=='number' then
                    reactionProgress=math.clamp((session.now-actor.castReactionAt)/math.max(.001,untilAt-actor.castReactionAt),0,1)
                end
            else actor.castReactionAt=nil end
            actor.castReacting=reacting==true
            self.castAppearance.update(actor,{kind=actor.castAppearance.kind,
                actorId=actor.model:GetAttribute('ActorId') or tostring(id),levelEpoch=session.state and session.state.levelEpoch,
                now=session.now,dt=dt,speed=Vector3.new(velocity.X,0,velocity.Z).Magnitude,
                mode=mode,sourceState=sourceState,
                phase=phase,attack=actor.castAttack,dead=actor.humanoid.Health&lt;=0 or enemy and enemy.dead,
                reacting=reacting,reactionHeavy=enemy and enemy.heavyReaction==true
                    or isBoss and bossState.heavyReaction==true or flight and flight.mode=='Disabled',
                reactionProgress=reactionProgress,
                carried=self.enemyCarries[id] and self.enemyCarries[id].mode=='Carried'})
        end end
    end
end

function World:clearActors()
    if self.campaignModes then self.campaignModes:close('RunClosed');self.campaignModes=nil end
    self.transitionOrigins=nil
    for id in pairs(self.equippedClubs) do self:unequipClub(id) end
    for id in pairs(self.enemyCarries) do self:releaseEnemy(id) end
    for id,actor in pairs(self.actors) do self:resetLocomotion(id,actor) end
    if self.guardianAppearance then
        for _,actor in pairs(self.actors) do self.guardianAppearance.detach(actor) end
    end
    self._base.clearActors(self)
    self.enemyKinds = {}
    self.healingFlyFolder:ClearAllChildren()
    self.healingEffectFolder:ClearAllChildren()
    self.healingFlyVisuals, self.healingEffects = {}, {}
    self.clubItemFolder:ClearAllChildren()
    self.clubItems,self.equippedClubs={},{}
    resetOrigins(self)
    if self.config.Level then self:progress(1, false) end
    self:stage("Approach")
end

return World
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT37">
          <Properties>
            <string name="Name">GuardianAppearance</string>
            <ProtectedString name="Source">-- Cosmetic canonical Guardian skin on the existing server-owned R6 actor.
-- Attach before the caller pins completed-assembly ownership. Nothing here
-- changes gameplay health, aim, projectiles, collisions or the physical rig.
local Appearance={}
local PROFILE='CanonicalBossWalker'
local TEMPLATE='BossWalkerGuardian'
local MOUNT='GuardianMountRigAttachment'
local MUZZLE='MuzzleRigAttachment'
local NAMES={'GuardianChassis','GuardianLeftCannon','GuardianRightCannon'}
local HIDDEN={HumanoidRootPart=true,Torso=true,Head=true,['Left Arm']=true,['Right Arm']=true,
    ['Left Leg']=true,['Right Leg']=true,Eye=true}
-- Source recoil counter 7; conversion to seconds and the 3D displacement,
-- flash and hurt-color timing are explicit authored Roblox presentation.
local RECOIL_SECONDS=7/60
local RECOIL_STUDS=.25
local FLASH_SECONDS=.065
local HURT_SECONDS=.16
local HURT_COLOR=Color3.fromRGB(255,190,160)
local EPSILON=1e-4

local function finite(value)
    return type(value)=='number' and value==value and value&gt;-math.huge and value&lt;math.huge
end

local function positiveSize(size)
    for _,value in ipairs({size.X,size.Y,size.Z}) do
        assert(finite(value) and value&gt;0,'Invalid mesh dimensions')
    end
end

local function finiteFrame(frame)
    local values={frame:GetComponents()}
    assert(#values==12,'Invalid attachment frame')
    for _,value in ipairs(values) do assert(finite(value),'Nonfinite frame') end
    return frame
end

local function rootAxes(frame)
    local values={finiteFrame(frame):GetComponents()}
    for i=4,12 do
        local identity=(i==4 or i==8 or i==12) and 1 or 0
        assert(math.abs(values[i]-identity)&lt;EPSILON,'Attachment must use root axes')
    end
    return frame.Position
end

local function uploadedId(value)
    return type(value)=='string' and value:match('^rbxassetid://%d+$') and tonumber(value:sub(14))&gt;0
end

local function validatePart(part,index)
    assert(part:IsA('MeshPart'),'Expected an uploaded MeshPart')
    assert(uploadedId(part.MeshId),'Missing uploaded mesh')
    positiveSize(part.Size)
    -- MeshSize is read-only and not available in every native test/API surface.
    -- Whenever the engine exposes it, reject empty or invalid imported geometry.
    local hasMeshSize,meshSize=pcall(function() return part.MeshSize end)
    if hasMeshSize and meshSize~=nil then positiveSize(meshSize) end
    assert(finite(part.Transparency) and part.Transparency&gt;=0 and part.Transparency&lt;1,'Invisible mesh')
    finiteFrame(part.CFrame)
    local mount,muzzle,surfaces
    surfaces=0
    for _,child in ipairs(part:GetChildren()) do
        assert(#child:GetChildren()==0,'Nested template content is forbidden')
        if child:IsA('Attachment') then
            finiteFrame(child.CFrame)
            if child.Name==MOUNT then assert(not mount,'Duplicate mount');mount=child
            elseif child.Name==MUZZLE and index&gt;1 then assert(not muzzle,'Duplicate muzzle');muzzle=child
            else error('Unexpected attachment') end
        else
            assert(child:IsA('SurfaceAppearance'),'Unexpected mesh content')
            surfaces+=1;assert(surfaces&lt;=1,'Duplicate surface appearance')
        end
    end
    assert(mount,'Missing mount attachment')
    local position=rootAxes(part.CFrame*mount.CFrame)
    if index==1 then
        assert(math.abs(position.X)&lt;EPSILON and math.abs(position.Y)&lt;EPSILON and math.abs(position.Z)&lt;EPSILON,
            'Chassis mount must be root origin')
    else
        assert(index==2 and position.X&lt; -EPSILON or index==3 and position.X&gt;EPSILON,'Cannon mount has wrong side')
        assert(muzzle,'Missing muzzle attachment')
        local muzzlePosition=rootAxes(part.CFrame*muzzle.CFrame)
        assert(muzzlePosition.Z&lt;position.Z-EPSILON,'Muzzle must face forward of mount')
    end
end

local function validateTemplate(template)
    assert(template:IsA('Model'),'Boss resource must be a Model')
    local found,parts={},{}
    for _,child in ipairs(template:GetChildren()) do
        assert(not found[child.Name],'Duplicate template child');found[child.Name]=true
        local index=table.find(NAMES,child.Name)
        if index then
            validatePart(child,index);parts[index]=child
        elseif child.Name=='AppearanceProfile' then
            assert(child:IsA('StringValue') and child.Value==PROFILE,'Unknown appearance profile')
            assert(#child:GetChildren()==0,'Nested metadata content')
        elseif child.Name=='AppearanceScale' then
            assert(child:IsA('NumberValue') and child.Value==1,'Appearance scale must be one')
            assert(#child:GetChildren()==0,'Nested metadata content')
        elseif child.Name=='SourceAssetId' then
            assert(child:IsA('StringValue') and type(child.Value)=='string' and child.Value:match('^%d+$')
                and tonumber(child.Value)&gt;0,'Invalid source asset identity')
            assert(#child:GetChildren()==0,'Nested metadata content')
        elseif child.Name=='SourceGlbSha256' or child.Name=='AssetManifestSha256' then
            assert(child:IsA('StringValue') and type(child.Value)=='string' and #child.Value==64
                and child.Value:match('^%x+$'),'Invalid source fingerprint')
            assert(#child:GetChildren()==0,'Nested metadata content')
        else error('Unexpected template object') end
    end
    assert(found.AppearanceProfile and found.AppearanceScale,'Missing appearance metadata')
    for index=1,3 do assert(parts[index],'Expected three canonical meshes') end
    return parts
end

local function nonphysical(part)
    part.Anchored=false;part.Massless=true
    part.CanCollide=false;part.CanTouch=false;part.CanQuery=false
end

local function validOwner(actor,state)
    if actor.model~=state.ownerModel or actor.root~=state.root or not state.ownerModel.Parent
        or state.model.Parent~=state.ownerModel or not state.root:IsDescendantOf(state.ownerModel) then return false end
    for _,row in ipairs(state.rows) do
        if row.part.Parent~=state.model or row.motor.Parent~=row.part or row.motor.Part0~=state.root
            or row.motor.Part1~=row.part then return false end
        if row.surface and row.surface.Parent~=row.part then return false end
        if row.flash and (row.flash.Parent~=state.model or row.weld.Parent~=row.flash
            or row.weld.Part0~=row.part or row.weld.Part1~=row.flash) then return false end
    end
    return true
end

function Appearance.detach(actor)
    local state=actor and actor.guardianAppearance
    if not state then return end
    actor.guardianAppearance=nil
    -- Restore values even if a consumer retains a reference to the old skin.
    for _,row in ipairs(state.rows) do
        if row.part.Parent==state.model then
            row.part.Color=row.color;row.part.Transparency=row.transparency
        end
        if row.surface and row.surface.Parent==row.part then row.surface.Color=row.surfaceColor end
        if row.flash and row.flash.Parent==state.model then row.flash.Transparency=1 end
    end
    state.model:Destroy()
    for part,transparency in pairs(state.hidden) do
        if part.Parent and part:IsDescendantOf(state.ownerModel) then part.Transparency=transparency end
    end
end

function Appearance.update(actor,now)
    local state=actor and actor.guardianAppearance
    if not state then return end
    if not validOwner(actor,state) then Appearance.detach(actor);return end
    if not finite(now) then return end
    local hurt=state.hurtAt and now-state.hurtAt
    local tint=hurt and hurt&gt;=0 and math.max(0,1-hurt/HURT_SECONDS)*.65 or 0
    for _,row in ipairs(state.rows) do
        local elapsed=row.shotAt and now-row.shotAt
        local recoil=elapsed and elapsed&gt;=0 and math.max(0,1-elapsed/RECOIL_SECONDS)*RECOIL_STUDS or 0
        -- C0's base is authored in root mount axes; C1 retains the importer's
        -- Y180 rest rotation. A +Z delta therefore recoils away from -Z fire.
        row.motor.C0=row.base*CFrame.new(0,0,recoil)
        row.part.Color=tint&gt;0 and row.color:Lerp(HURT_COLOR,tint) or row.color
        row.part.Transparency=row.transparency
        -- PBR ColorMap tint is separate from the underlying MeshPart color.
        if row.surface then row.surface.Color=tint&gt;0 and row.surfaceColor:Lerp(HURT_COLOR,tint) or row.surfaceColor end
        if row.flash then row.flash.Transparency=elapsed and elapsed&gt;=0 and elapsed&lt;FLASH_SECONDS and 0 or 1 end
    end
end

function Appearance.shot(actor,mode,now)
    local state=actor and actor.guardianAppearance
    if not state then return false end
    if not validOwner(actor,state) then Appearance.detach(actor);return false end
    -- Only accepted GuardianPattern projectile creation calls this API. Generic
    -- boss cues include blocked melee and cannot be treated as successful shots.
    if (mode~='Bullet' and mode~='Heavy') or not finite(now) then return false end
    state.shotSerial+=1
    local index=state.shotSerial%2==1 and 2 or 3
    state.rows[index].shotAt=now
    Appearance.update(actor,now)
    return true
end

function Appearance.health(actor,current,maximum,now)
    local state=actor and actor.guardianAppearance
    if not state then return end
    if not validOwner(actor,state) then Appearance.detach(actor);return end
    if not finite(current) or not finite(maximum) or maximum&lt;=0 or not finite(now) then return end
    local normalized=math.clamp(current/maximum,0,1)
    -- Initialization often reports 3/3 then 47/47. Compare fractions so those
    -- two representations of full health never create a fabricated damage cue.
    if state.normalizedHealth and normalized&lt;state.normalizedHealth then state.hurtAt=now end
    state.normalizedHealth=normalized
    Appearance.update(actor,now)
end

function Appearance.attach(actor,templates)
    if not actor or not actor.model or not actor.model:IsA('Model') or not actor.model.Parent
        or not actor.root or not actor.root:IsA('BasePart') or not actor.root:IsDescendantOf(actor.model) then
        return false,'INVALID_GUARDIAN_ACTOR'
    end
    templates=templates or game:GetService('ServerStorage'):FindFirstChild('BrickToadsBossTemplates')
    local template=templates and templates:FindFirstChild(TEMPLATE)
    if not template then return false,'NO_BOSS_RESOURCE' end
    -- Scan original content before cloning: no unsafe Scripts, hidden/nested
    -- colliders, untagged models or partial imports can reach a live assembly.
    local valid,validationError=pcall(validateTemplate,template)
    if not valid then return false,'INVALID_BOSS_RESOURCE: '..tostring(validationError) end
    local previous=actor.guardianAppearance
    if previous and previous.sourceTemplate==template and validOwner(actor,previous) then return true end
    local clone
    local prepared,state=pcall(function()
        clone=assert(template:Clone(),'Uncloneable boss resource')
        local parts=validateTemplate(clone)
        clone.Name=TEMPLATE..'Appearance'
        local result={model=clone,ownerModel=actor.model,root=actor.root,sourceTemplate=template,
            profile=PROFILE,rows={},hidden={},shotSerial=0}
        for index,part in ipairs(parts) do
            local mount=part:FindFirstChild(MOUNT)
            local base=part.CFrame*mount.CFrame
            local row={part=part,base=base,color=part.Color,transparency=part.Transparency}
            for _,child in ipairs(part:GetChildren()) do
                if child:IsA('SurfaceAppearance') then row.surface=child;row.surfaceColor=child.Color end
            end
            part.CFrame=actor.root.CFrame*part.CFrame
            nonphysical(part)
            local motor=Instance.new('Motor6D');motor.Name='GuardianAppearance'..part.Name
            motor.Part0=actor.root;motor.Part1=part;motor.C0=base;motor.C1=mount.CFrame;motor.Parent=part
            row.motor=motor
            if index&gt;1 then
                local muzzle=part:FindFirstChild(MUZZLE)
                local flash=Instance.new('Part');flash.Name=part.Name..'MuzzleFlash'
                flash.Size=Vector3.new(.44,.44,.55);flash.Shape=Enum.PartType.Ball
                flash.Material=Enum.Material.Neon;flash.Color=Color3.fromRGB(255,224,128)
                flash.Transparency=1;flash.CFrame=part.CFrame*muzzle.CFrame;nonphysical(flash)
                local weld=Instance.new('WeldConstraint');weld.Name='GuardianMuzzleFlashWeld'
                weld.Part0=part;weld.Part1=flash;weld.Parent=flash;flash.Parent=clone
                row.flash,row.weld=flash,weld
            end
            result.rows[index]=row
        end
        return result
    end)
    if not prepared then
        if clone then clone:Destroy() end
        return false,'INVALID_BOSS_RESOURCE: '..tostring(state)
    end
    -- Only a complete validated replacement may retire the previous appearance.
    if previous then Appearance.detach(actor) end
    for _,part in ipairs(actor.model:GetChildren()) do
        if part:IsA('BasePart') and HIDDEN[part.Name] then state.hidden[part]=part.Transparency end
    end
    clone.Parent=actor.model
    actor.guardianAppearance=state
    for part in pairs(state.hidden) do part.Transparency=1 end
    return true
end

return Appearance
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT38">
          <Properties>
            <string name="Name">GuardianPattern</string>
            <ProtectedString name="Source">-- Original 3D tuning around the source's ground-ball pickup/throw guardian chain.
-- Authority and ordinary attack validation belong to Session/Director, never the client.
local GuardianPattern={}
GuardianPattern.__index=GuardianPattern

local function finite(n) return type(n)=='number' and n==n and n&gt;-math.huge and n&lt;math.huge end
local function point(p) return type(p)=='table' and finite(p.x) and finite(p.y) and finite(p.z) end
local function copy(p) return {x=p.x,y=p.y,z=p.z} end
local function distance(a,b)
    if not point(a) or not point(b) then return math.huge end
    return math.sqrt((a.x-b.x)^2+(a.y-b.y)^2+(a.z-b.z)^2)
end
local function towards(a,b,amount)
    local d=distance(a,b)
    if d==0 then return copy(b) end
    local t=math.min(1,amount/d)
    return {x=a.x+(b.x-a.x)*t,y=a.y+(b.y-a.y)*t,z=a.z+(b.z-a.z)*t}
end
local function segmentDistance(a,b,p)
    if not point(p) then return math.huge end
    local x,y,z=b.x-a.x,b.y-a.y,b.z-a.z
    local length=x*x+y*y+z*z
    local t=length&gt;0 and math.clamp(((p.x-a.x)*x+(p.y-a.y)*y+(p.z-a.z)*z)/length,0,1) or 0
    return distance({x=a.x+t*x,y=a.y+t*y,z=a.z+t*z},p)
end
local function ids(projectiles)
    local result={}
    for id in pairs(projectiles) do result[#result+1]=id end
    table.sort(result,function(a,b) return a&gt;b end)
    return result
end

function GuardianPattern.new(director)
    local now=director.now or 0; local cfg=director.config.Boss
    local self=setmetatable({director=director,world=director.world,session=director.session,config=cfg,
        now=now,carriers={},nextShot=director.nextShot or now+(cfg.initial or 1.8),
        nextBall=now+(cfg.ballInterval or 8)},GuardianPattern)
    director.nextShot=self.nextShot
    local boss=director.enemies[-99]
    if boss and boss.rawLife==nil then boss.rawLife=math.max(0,47-16*(director.bossHits or 0)) end
    return self
end

function GuardianPattern:_active()
    local d=self.director; local boss=d.enemies[-99]
    return d.stage=='Boss' and not d.result and self.session.state.status=='Active' and boss and not boss.dead
end

function GuardianPattern:_hero(slot,held)
    local h=self.session.state.heroes[slot]; local combat=self.session.combat[slot]
    if not h or h.status~='Alive' or h.connected~=true or not combat or combat.deathAt then return nil end
    if held and (held.actorId~=h.actorId or held.attempt~=h.attempt or held.connectionEpoch~=h.connectionEpoch) then return nil end
    if not point(self.world:position(slot)) then return nil end
    return h
end

function GuardianPattern:_render(id,p)
    self.world:projectile(id,p.position,false,p.mode)
end
function GuardianPattern:_log(kind,slot,data)
    if self.session._record then self.session:_record(kind,slot,data,self.now) end
end

function GuardianPattern:_remove(id)
    local p=self.director.projectiles[id]
    if not p then return end
    if p.holder and self.carriers[p.holder]==id then self.carriers[p.holder]=nil end
    self.director.projectiles[id]=nil
    self.world:removeProjectile(id)
end

function GuardianPattern:_clear()
    for _,id in ipairs(ids(self.director.projectiles)) do self:_remove(id) end
    table.clear(self.carriers)
end

function GuardianPattern:_drop(id,p)
    if p.holder and self.carriers[p.holder]==id then self.carriers[p.holder]=nil end
    p.holder=nil; p.actorId=nil; p.attempt=nil; p.connectionEpoch=nil
    local ground=self.world:groundPosition(p.position)
    if not point(ground) or self.now&gt;=p.expiresAt then self:_remove(id); return end
    p.mode='Ground'; p.position=copy(ground); p.direction=nil
    self:_render(id,p)
end

function GuardianPattern:_carried(slot)
    local id=self.carriers[slot]; local p=id and self.director.projectiles[id]
    if not p or p.mode~='Carried' or p.holder~=slot then self.carriers[slot]=nil; return nil end
    if self.now&gt;=p.expiresAt or not self:_hero(slot,p) then self:_drop(id,p); return nil end
    return id,p
end

function GuardianPattern:_ground(slot)
    local position=self.world:position(slot); local selected,best=nil,math.huge
    for _,id in ipairs(ids(self.director.projectiles)) do
        local p=self.director.projectiles[id]
        if p.mode=='Ground' and self.now&lt;p.expiresAt and math.abs(position.y-p.position.y)&lt;=3.5 then
            local range=distance(position,p.position)
            if range&lt;=(self.config.pickupRange or 5.5) and range&lt;best then selected,best=id,range end
        end
    end
    return selected,selected and self.director.projectiles[selected]
end

function GuardianPattern:_spawn(mode,aim,target)
    local origin=self.world:position(-99)
    if not point(origin) then return false end
    local destination
    if target then
        local h=self.session.state.heroes[target]
        local combat=self.session.combat[target]
        local position=self.world:position(target)
        if not h or h.status~='Alive' or not combat or combat.deathAt or not point(position) then return false end
        destination=copy(position)
    elseif aim then
        local length=math.sqrt(aim.x^2+aim.z^2)
        destination={x=origin.x+aim.x/length*self.config.aggroRange,y=origin.y,
            z=origin.z+aim.z/length*self.config.aggroRange}
    end
    if not destination then return false end
    if mode=='Heavy' then
        destination=self.world:groundPosition(destination)
        if not point(destination) then return false end
        destination=copy(destination)
    end
    local d=self.director; local id
    repeat
        d.serial=math.max(0,d.serial or 0)+1; id=-1000-d.serial
    until not d.projectiles[id]
    local p={mode=mode,position=towards(origin,destination,5),direction=destination,target=target,
        created=self.now,expiresAt=self.now+(self.config.ballLife or 20)}
    d.projectiles[id]=p
    if target and not d.enemies[-99].ownerUserId and self.world.face then self.world:face(-99,target) end
    self.world:cue(-99,true); self:_render(id,p)
    if self.world.bossShot then self.world:bossShot(mode) end
    self:_log(mode=='Heavy' and 'BossWarning' or 'BossShot',-99,{projectileId=id,mode=mode,target=target})
    return true
end

function GuardianPattern:fire(aim,target)
    if not self:_active() then return 'NOT_ALIVE' end
    local boss=self.director.enemies[-99]
    if boss.ownerUserId and boss.connected==false then return 'OFFLINE' end
    self.now=math.max(self.now,self.director.now or self.now)
    if self.now&lt;self.nextShot then return 'COOLDOWN' end
    if aim and (type(aim)~='table' or not finite(aim.x) or not finite(aim.z) or aim.x^2+aim.z^2&lt;=0) then return 'INVALID_AIM' end
    if not self:_spawn('Bullet',aim,target) then return 'NO_TARGET' end
    self.nextShot=self.now+self.config.interval; self.director.nextShot=self.nextShot
    return 'OK'
end

function GuardianPattern:hit(attacker,target,action)
    if self.director.projectiles[target] then return false end
    if target==-99 and self:_active() then
        self.world:cue(-99,true)
        self:_log('BossShielded',-99,{attacker=attacker,action=action})
        return true
    end
    return false
end

function GuardianPattern:interaction(slot)
    if not self:_active() then return {available=false,carrying=false} end
    self.now=math.max(self.now,self.director.now or self.now)
    local carried=self:_carried(slot)
    if not self:_hero(slot) then return {available=false,carrying=false} end
    if carried then return {available=true,label="THROW BALL",carrying=true} end
    if self:_ground(slot) then return {available=true,label="PICK UP BALL",carrying=false} end
    return {available=false,carrying=false}
end

function GuardianPattern:interact(slot,now)
    if not finite(now) or now&lt;0 then return 'INVALID_TIME' end
    if not self:_active() then return 'NO_INTERACTION' end
    self.now=math.max(self.now,now,self.director.now or now)
    local id,p=self:_carried(slot)
    local h=self:_hero(slot)
    if not h then return 'NO_INTERACTION' end
    if p then
        -- BeginAttack is the authoritative shield transition. Failure keeps the
        -- ball carried; neither its flight nor the hold release has happened yet.
        local result=self.session:_event('BeginAttack',slot,{connectionEpoch=h.connectionEpoch})
        if result~='OK' then return result end
        self.world:hold(slot,false)
        self.carriers[slot]=nil
        p.mode='Thrown'; p.holder=nil; p.actorId=nil; p.attempt=nil; p.connectionEpoch=nil
        p.target=-99; p.direction=nil; p.created=self.now; p.expiresAt=self.now+(self.config.ballLife or 20)
        self:_render(id,p)
        self:_log('GuardianBallThrown',slot,{projectileId=id,target=-99})
        return 'OK'
    end
    id,p=self:_ground(slot)
    if not p then return 'NO_INTERACTION' end
    p.mode='Carried'; p.holder=slot; p.actorId=h.actorId; p.attempt=h.attempt; p.connectionEpoch=h.connectionEpoch
    self.carriers[slot]=id
    local position=self.world:position(slot)
    p.position={x=position.x,y=position.y+2,z=position.z}
    self:_render(id,p)
    self:_log('GuardianBallPickedUp',slot,{projectileId=id})
    return 'OK'
end

function GuardianPattern:_impact(id)
    if not self:_active() then return end
    local d=self.director; local boss=d.enemies[-99]
    local before=boss.rawLife
    d.bossHits=(d.bossHits or 0)+1
    boss.rawLife=math.max(0,boss.rawLife-16)
    boss.health=math.max(0,(self.config.hits or 3)-d.bossHits)
    self.world:enemyHealth(-99,boss.health,self.config.hits or 3); self.world:cue(-99,false)
    self:_log('BossHit',-99,{actorId=boss.actorId,projectileId=id,before=before,after=boss.rawLife,hits=d.bossHits})
    self:_remove(id)
    if boss.rawLife==0 then d:_kill(-99); self:_clear() end
end

function GuardianPattern:step(now,dt)
    if not finite(now) or now&lt;0 or (dt~=nil and (not finite(dt) or dt&lt;0)) then return 'INVALID_TIME' end
    if now&lt;self.now then return 'TIME_REVERSED' end
    self.now=now; dt=dt or 0
    if not self:_active() then self:_clear(); return 'OK' end
    local d=self.director; local boss=d.enemies[-99]
    for slot in pairs(self.carriers) do self:_carried(slot) end
    -- The finite special-shot deadline belongs to the server, including while a
    -- human owner is idle/offline. It does not supply ordinary human commands.
    if now&gt;=self.nextBall then
        local target=d:_nearest(self.world:position(-99))
        if target then self:_spawn('Heavy',nil,target) end
        self.nextBall=now+(self.config.ballInterval or 8)
    end
    if not boss.ownerUserId and now&gt;=self.nextShot then
        local target,range=d:_nearest(self.world:position(-99))
        if target and range&lt;=self.config.aggroRange then self:fire(nil,target) end
    end
    for _,id in ipairs(ids(d.projectiles)) do
        if not self:_active() then self:_clear(); break end
        local p=d.projectiles[id]
        if p then
            if now&gt;=p.expiresAt then self:_remove(id)
            elseif p.mode=='Carried' then
                local position=self.world:position(p.holder)
                p.position={x=position.x,y=position.y+2,z=position.z}; self:_render(id,p)
            elseif p.mode~='Ground' then
                local destination=p.mode=='Thrown' and self.world:position(-99) or p.direction
                if not point(destination) then self:_remove(id)
                else
                    local before=p.position
                    local speed=p.mode=='Thrown' and self.config.returnSpeed or self.config.projectileSpeed
                    p.position=towards(before,destination,speed*dt)
                    self:_render(id,p)
                    if p.mode=='Thrown' and segmentDistance(before,p.position,destination)&lt;2.5 then
                        self:_impact(id)
                    elseif p.mode=='Heavy' then
                        if distance(p.position,destination)&lt;.1 then
                            p.mode='Ground'; p.position=copy(destination); p.direction=nil; self:_render(id,p)
                        end
                    elseif p.mode=='Bullet' then
                        local hit=false
                        for _,slot in ipairs(self.session.order) do
                            local h=self.session.state.heroes[slot]; local combat=self.session.combat[slot]
                            if h.status=='Alive' and not combat.deathAt and segmentDistance(before,p.position,self.world:position(slot))&lt;2.3 then
                                self.session:_hit(-99,slot,'Dash'); hit=true; break
                            end
                        end
                        if hit or distance(p.position,destination)&lt;.1 then self:_remove(id) end
                    end
                end
            end
        end
    end
    return 'OK'
end

return GuardianPattern
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT39">
          <Properties>
            <string name="Name">HealingFlies</string>
            <ProtectedString name="Source">-- Source-backed food arithmetic; flight, reach and timing are Roblox calibration.
-- No remote accepts an item, target position or heal amount from the client.
local HealingFlies={}
HealingFlies.__index=HealingFlies
local function finite(n) return type(n)=='number' and n==n and n&gt;-math.huge and n&lt;math.huge end

function HealingFlies.new(session,world,config)
    local self=setmetatable({session=session,world=world,config=config.HealingFlies,rows={},byId={},
        pending={},pendingBySlot={},now=session.now,consumed=0},HealingFlies)
    for zoneIndex,zone in ipairs(config.Level and config.Level.zones or {}) do
        for _,point in ipairs(zone.flies or {}) do
            assert(type(point.id)=='string' and not self.byId[point.id],'Fly IDs must be unique')
            local row={id=point.id,zone=zoneIndex,x=point.x,y=point.y,z=point.z}
            self.rows[#self.rows+1]=row;self.byId[row.id]=row
        end
    end
    return self
end

function HealingFlies:_position(row)
    return {x=row.x,y=row.y+math.sin(self.now*self.config.bobSpeed+row.zone)*self.config.bobHeight,z=row.z}
end

function HealingFlies:activate(zoneIndex)
    if self.closed then return end
    for _,row in ipairs(self.rows) do
        if row.zone==zoneIndex and not row.consumed then
            row.active=true;self.world:healingFly(row.id,self:_position(row))
        end
    end
end

function HealingFlies:_hero(slot,offline)
    if self.closed or self.session.state.status~='Active' then return nil end
    local h,c=self.session.state.heroes[slot],self.session.combat[slot]
    if not h or h.status~='Alive' or (not offline and not h.connected) or not h.actorId
        or not c or c.deathAt or c.reactionEnd or c.attack or self.world:hazard(slot) then return nil end
    return h,c
end

function HealingFlies:_reachable(slot,row)
    return row.active and not row.consumed and self.world:canCatchFly(slot,self:_position(row),
        self.config.range,self.config.height,self.config.facingDot)
end

function HealingFlies:_nearest(slot)
    local origin=self.world:position(slot)
    if not origin then return nil end
    local selected,best=nil,math.huge
    for _,row in ipairs(self.rows) do
        if self:_reachable(slot,row) then
            local p=self:_position(row)
            local range=(origin.x-p.x)^2+(origin.y-p.y)^2+(origin.z-p.z)^2
            if range&lt;best then selected,best=row,range end
        end
    end
    return selected
end

function HealingFlies:interaction(slot)
    self.now=math.max(self.now,self.session.now)
    if not self:_hero(slot) or self.pendingBySlot[slot] then return {available=false} end
    return {available=self:_nearest(slot)~=nil,label="CATCH FLY",kind='HealingFly',carrying=false}
end

function HealingFlies:interact(slot,now)
    if not finite(now) or now&lt;self.now then return 'INVALID_TIME' end
    self.now=now
    local h,c=self:_hero(slot)
    if not h then return 'NO_INTERACTION' end
    if self.pendingBySlot[slot] then return 'COOLDOWN' end
    local row=self:_nearest(slot)
    if not row then return 'NO_INTERACTION' end
    local code=self.session:_event('BeginAttack',slot,{connectionEpoch=h.connectionEpoch})
    if code~='OK' then return code end
    self.world:hold(slot,false)
    local pending={slot=slot,row=row,actorId=h.actorId,attempt=h.attempt,
        levelEpoch=self.session.state.levelEpoch,at=now+self.config.windup,combat=c,reactionEpoch=c.reactionEpoch or 0}
    self.pending[#self.pending+1]=pending;self.pendingBySlot[slot]=pending
    return 'OK'
end

function HealingFlies:_catch(pending)
    local h,c=self:_hero(pending.slot,true)
    if not h or h.actorId~=pending.actorId or h.attempt~=pending.attempt
        or c~=pending.combat or (c.reactionEpoch or 0)~=pending.reactionEpoch
        or self.session.state.levelEpoch~=pending.levelEpoch or not self:_reachable(pending.slot,pending.row) then return end
    local before=c.rawLife
    local after=math.min(47,before+8)
    local code=self.session:_event('SetHealth',pending.slot,{health=self.session.Combat.hearts(after)})
    if code~='OK' then return end
    c.rawLife=after;pending.row.consumed=true;pending.row.active=false;self.consumed+=1
    self.world:catchFly(pending.slot,pending.row.id)
    self.session:_record('FlyCaught',pending.slot,{flyId=pending.row.id,before=before,after=after})
end

function HealingFlies:step(now)
    if not finite(now) or now&lt;self.now then return 'INVALID_TIME' end
    self.now=now
    if self.closed then return 'RUN_CLOSED' end
    if self.session.state.status~='Active' then self:close();return 'RUN_CLOSED' end
    local future={}
    for _,pending in ipairs(self.pending) do
        if now&gt;=pending.at then
            self.pendingBySlot[pending.slot]=nil
            self:_catch(pending)
        else future[#future+1]=pending end
    end
    self.pending=future
    for _,row in ipairs(self.rows) do
        if row.active then self.world:healingFly(row.id,self:_position(row)) end
    end
    return 'OK'
end

function HealingFlies:snapshot()
    local active=0
    for _,row in ipairs(self.rows) do if row.active then active+=1 end end
    return {active=active,consumed=self.consumed,total=#self.rows}
end

function HealingFlies:close()
    if self.closed then return end
    self.closed=true;self.pending={};self.pendingBySlot={}
    for _,row in ipairs(self.rows) do
        row.active=false;self.world:healingFly(row.id,nil)
    end
end

return HealingFlies
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT40">
          <Properties>
            <string name="Name">LevelDefinition</string>
            <ProtectedString name="Source">-- Original Brick Toads geography; static actor order is derived from upstream level1_cfg.
-- Primary: feos-tas/DisAssemble, Battletoads/data/levels_cfgs1.asm.
-- Thirteen ordinary actor records: nine pigs, two walkers, two dragons.
-- This does not assert a verified natural-play total or completed NES AI/animation parity.
local function floor(x,y,z,w,d) return {x=x,y=y,z=z,w=w,h=2,d=d} end
local sourceLife={15,15,31,31,31,31,31,31,31,47,31,31,15}
local function enemy(id,kind,x,y,z) return {id=id,kind=kind,x=x,y=y,z=z,rawLife=sourceLife[-id]} end
local function exit(x,z,y) return {minX=x-6,maxX=x+2,minY=(y or 3)-2,maxY=(y or 3)+6,minZ=z-13,maxZ=z+13} end
return {
    id='causeway-1',name="Flooded Causeway",
    source='https://github.com/feos-tas/DisAssemble/blob/master/Battletoads/data/levels_cfgs1.asm',
    calibration='ORIGINAL_3D_ROUTE_STATIC_ROSTER',
    zones={
        {id='Floodgate',name="Flooded Gate",gateX=4,exit=exit(2,0),
            objective="Clear the gate and reach the aqueduct",
            platforms={floor(-39,-1,0,86,52)},
            enemies={enemy(-1,'Pig',-35,3,-8),enemy(-2,'Pig',-25,3,8),enemy(-3,'Walker',-8,3,0)}},
        {id='Aqueduct',name="Broken Aqueduct",gateX=124,exit=exit(122,0),
            objective="Jump the gap and defeat the far patrol",
            platforms={floor(26,-1,0,44,38),floor(88.5,-1,0,71,38)},
            gaps={{minX=48,maxX=53,minZ=-19,maxZ=19}},
            enemies={enemy(-4,'Pig',20,3,-7),enemy(-5,'Pig',38,3,7),enemy(-6,'Walker',94,3,0)}},
        {id='Courtyard',name="Stone Courtyard",gateX=236,exit=exit(234,0),
            objective="Clear the courtyard before the cliffs",
            flies={{id='courtyard-fly-1',x=178,y=4.5,z=-5},{id='courtyard-fly-2',x=184,y=4.5,z=5}},
            platforms={floor(180,-1,0,112,56)},
            enemies={enemy(-7,'Pig',155,3,-10),enemy(-8,'Pig',201,3,11)}},
        {id='Cliffs',name="Cliffs and Ledges",gateX=360,exit=exit(358,-6,5),
            objective="Climb the ledges and pass the winged patrol",
            platforms={floor(253,-1,0,34,18),floor(287.5,1,6,27,18),floor(318.5,3,0,27,18),floor(348,1,-6,24,22)},
            gaps={{minX=270,maxX=274},{minX=301,maxX=305},{minX=332,maxX=336}},
            enemies={enemy(-9,'Dragon',287,5,6),enemy(-10,'Dragon',320,7,0)}},
        {id='Watchforge',name="Watchforge",gateX=486,exit=exit(484,0),
            objective="Defeat the last ground patrol",
            platforms={floor(423,-1,0,126,52)},
            enemies={enemy(-11,'Pig',386,3,-10),enemy(-12,'Pig',414,3,10),enemy(-13,'Pig',454,3,0)}},
        {id='Longbridge',name="Long Bridge",gateX=590,exit=exit(588,0),
            objective="Jump the chasm and reach the Guardian",
            flies={{id='bridge-fly-1',x=548,y=4.5,z=-5},{id='bridge-fly-2',x=554,y=4.5,z=5},
                {id='bridge-fly-3',x=568,y=4.5,z=-5},{id='bridge-fly-4',x=574,y=4.5,z=5}},
            platforms={floor(508,-1,0,44,26),floor(562.5,-1,0,55,26)},
            gaps={{minX=530,maxX=535,minZ=-13,maxZ=13}},enemies={}},
    },
    boss={position={x=628,y=3,z=0},platform=floor(641,-1,0,102,70),gateX=668,
        exit={minX=670,maxX=690,minY=1,maxY=10,minZ=-12,maxZ=12},pad={x=680,y=.09,z=0,w=16,d=24}},
    -- Measured Roblox-scale tuning, not claims about NES timing or distances.
    bounds={minX=-90,maxX=700,minZ=-90,maxZ=90},
}
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT41">
          <Properties>
            <string name="Name">LevelDirector</string>
            <ProtectedString name="Source">-- Original prototype encounters. All decisions run on the server.
-- Enemy arithmetic/timing are provisional; hero damage/shields use the tested Session.
local Director={}
Director.__index=Director
local function finite(n) return type(n)=='number' and n==n and n&gt;-math.huge and n&lt;math.huge end
local function distance(a,b)
    if not a or not b then return math.huge end
    return math.sqrt((a.x-b.x)^2+(a.y-b.y)^2+(a.z-b.z)^2)
end
local function towards(a,b,amount)
    local d=distance(a,b)
    if d==0 then return table.clone(a) end
    local t=math.min(1,amount/d)
    return {x=a.x+(b.x-a.x)*t,y=a.y+(b.y-a.y)*t,z=a.z+(b.z-a.z)*t}
end
local objectives={Approach="Defeat the patrol by the old gate",Courtyard="Clear the inner courtyard",
    BossReady="Assigning Guardian: waiting for the invited player",BossIntro="The Guardian approaches",
    Boss="Strike three projectiles back at the Guardian",Exit="The path is open — reach the glowing gate",
    Won="Causeway cleared",Lost="Team eliminated"}

function Director.new(session,world,Combat,config,GuardianPattern,HealingFlies,EnemyCarry,WalkerClubs,DragonFlight,BossIntro)
    local profile=config.Attacks[config.Enemy.attack]
    local self=setmetatable({session=session,world=world,config=config,Combat=Combat,enemies={},projectiles={},byUserId={},ownerNames={},
        stage='Approach',now=session.now or 0,bossHits=0,serial=0,route=config.Level,GuardianPattern=GuardianPattern,BossIntro=BossIntro,
        strikeProfile={reach=config.Enemy.range+1,width=profile.width,height=profile.height,
            windup=config.Enemy.windup,cooldown=config.Enemy.cooldown,recoveryPose=.17},random=math.random},Director)
    if self.route then
        self.flies=HealingFlies and HealingFlies.new(session,world,config)
        self.carry=EnemyCarry and EnemyCarry.new(self)
        self.clubs=WalkerClubs and WalkerClubs.new(self)
        self.dragons=DragonFlight and config.DragonFlight and DragonFlight.new(self)
        self:_enterZone(1)
    else self:_wave('Approach',{{id=-1,x=-24,z=-6},{id=-2,x=-18,z=7}}) end
    return self
end
function Director:_health(id,e)
    if e.rawLife~=nil and not e.boss then
        e.health=self.config.Enemy.hearts*e.rawLife/e.maxRawLife
        self.world:enemyHealth(id,e.rawLife,e.maxRawLife)
    else self.world:enemyHealth(id,e.health,e.boss and self.config.Boss.hits or self.config.Enemy.hearts) end
end
function Director:_log(kind,id,data)
    if self.session._record then self.session:_record(kind,id,data,self.now) end
end
function Director:_resetLocomotion(id,e)
    if e then e.runApproach=nil;e.rushing=nil end
    if self.config.Movement and self.world.resetLocomotion then
        self.world:resetLocomotion(id,self.world.actors and self.world.actors[id])
    end
end
function Director:_finishReaction(id,e)
    if e~=self.enemies[id] or e.dead or not e.reactionUntil or self.now&lt;e.reactionUntil then return false end
    if e.rawLife~=nil then
        local before=e.rawLife
        e.rawLife=(self.Combat.recoverEnemy or self.Combat.recover)(e.rawLife);self:_health(id,e)
        self:_log('EnemyRecovery',id,{actorId=e.actorId,before=before,after=e.rawLife})
    end
    e.reactionUntil=nil;e.heavyReaction=nil;self.world:setReaction(id,false)
    return true
end
function Director:_wave(stage,roster)
    self.stage=stage; self.world:stage(stage)
    for _,r in ipairs(roster) do
        local previous=self.enemies[r.id]
        if previous and previous.ownerUserId then
            self.retiredOwners=self.retiredOwners or {}
            self.retiredOwners[previous.ownerUserId]=previous
        end
        assert(self.world:spawnEnemy(r.id,r.kind or 'Drone',{x=r.x,y=r.y or 3,z=r.z}),'Enemy spawn failed')
        local actorId=self.session.state.runId..':enemy:'..self.session.state.levelEpoch..':'..r.id
        if r.spawnSerial~=nil then
            assert(type(r.spawnSerial)=='number' and r.spawnSerial&gt;=1 and r.spawnSerial%1==0,'Invalid enemy spawn serial')
            actorId=actorId..':spawn:'..r.spawnSerial
        end
        self.enemies[r.id]={health=self.config.Enemy.hearts,nextAttack=self.now,engaged=false,
            actorId=actorId,zoneIndex=self.zoneIndex,kind=r.kind,
            trajectory=r.trajectory,allowedDrop=r.allowedDrop,sourceProfile=r.sourceProfile,
            name=r.name or ({Pig="Marsh Raider",Walker="Long-legged Guard",Dragon="Winged Scout"})[r.kind]
                or (r.kind and (r.kind:gsub('(%l)(%u)','%1 %2'))) or "Rusty Guard"}
        local e=self.enemies[r.id]
        if self.config.SourceCombat and r.rawLife~=nil then
            assert(type(r.rawLife)=='number' and r.rawLife&gt;=0 and r.rawLife&lt;=255 and r.rawLife%1==0,'Invalid source Life')
            e.rawLife=r.rawLife;e.maxRawLife=math.floor(r.rawLife/16)*16+15
        end
        self.world:enemyIdentity(r.id,actorId)
        self:_health(r.id,e)
        self:_log('EnemySpawned',r.id,{actorId=actorId,kind=e.kind,rawLife=e.rawLife,health=e.health})
    end
end
function Director:_enterZone(index)
    self.zoneIndex=index
    if self.flies then self.flies:activate(index) end
    self.world:progress(index,false)
    self:_wave('Route',self.route.zones[index].enemies)
end
function Director:_zoneReached()
    local volume=self.route.zones[self.zoneIndex].exit
    for _,id in ipairs(self.session.order) do
        local hero=self.session.state.heroes[id]
        if hero.status=='Alive' and not self.session.combat[id].deathAt and self.world:reached(id,volume) then return true end
    end
    return false
end
function Director:interaction(slot)
    local carry=self.carry and self.carry:interaction(slot)
    if carry and carry.carrying then return carry end
    if self.guardian and self.stage=='Boss' then
        local interaction=self.guardian:interaction(slot)
        if interaction.available then return interaction end
    end
    local fly=self.flies and self.flies:interaction(slot)
    if fly and fly.available then return fly end
    local dragon=self.dragons and self.dragons:interaction(slot)
    if dragon and (dragon.available or dragon.carrying) then return dragon end
    local club=self.clubs and self.clubs:interaction(slot)
    if club and club.available then return club end
    return carry or {available=false}
end
function Director:interact(slot,now,attack)
    self.now=now
    if self.carry and self.carry:interaction(slot).carrying then return self.carry:interact(slot,now,attack) end
    if self.guardian and self.stage=='Boss' then
        if attack~='Punch' then return self.guardian:interaction(slot).carrying and 'HANDS_FULL' or 'NO_INTERACTION' end
        local result=self.guardian:interact(slot,now)
        if result=='OK' and self.clubs then self.clubs:drop(slot,'GuardianBall') end
        if result~='NO_INTERACTION' then return result end
    end
    if attack~='Punch' then return 'NO_INTERACTION' end
    if self.flies then
        local result=self.flies:interact(slot,now)
        if result~='NO_INTERACTION' then return result end
    end
    if self.dragons then
        local result=self.dragons:interact(slot,now,attack)
        if result~='NO_INTERACTION' then return result end
    end
    if self.clubs then
        local result=self.clubs:interact(slot,now,attack)
        if result~='NO_INTERACTION' then return result end
    end
    return self.carry and self.carry:interact(slot,now,attack) or 'NO_INTERACTION'
end
function Director:claim(userId,enemyId)
    if self.retiredOwners and self.retiredOwners[userId] then return 'ENEMY_LIFE_SPENT' end
    local owned=self.byUserId[userId]
    if owned then
        if self.enemies[owned].dead then return 'ENEMY_LIFE_SPENT' end
        if owned==enemyId then return 'OK' end
        return 'ENEMY_ALREADY_OWNED'
    end
    if self.result or self.session.state.status~='Active' then return 'RUN_CLOSED' end
    if enemyId==-99 then return 'UNKNOWN_ENEMY' end
    local e=self.enemies[enemyId]
    if not e then return 'UNKNOWN_ENEMY' end
    if not e.dead and self.world:hazard(enemyId) then self:_kill(enemyId) end
    if e.dead then return 'ENEMY_DEAD' end
    if e.ownerUserId then return 'ENEMY_OCCUPIED' end
    if e.engaged then return 'ENEMY_ENGAGED' end
    e.ownerUserId=userId; e.connected=true; e.connectionEpoch=1; e.lastSeq=0; e.rushing=nil
    self:_resetLocomotion(enemyId,e)
    self.byUserId[userId]=enemyId
    self.world:move(enemyId,0,0)
    self.world:enemyIdentity(enemyId,e.actorId,self.ownerNames[userId])
    self:_log('EnemyClaimed',enemyId,{actorId=e.actorId,ownerUserId=userId,rawLife=e.rawLife,health=e.health})
    return 'OK'
end
function Director:connection(userId,connected)
    local retired=self.retiredOwners and self.retiredOwners[userId]
    if retired then
        if type(connected)~='boolean' then return 'INVALID_CONNECTION' end
        if retired.connected==connected then return 'NO_CHANGE' end
        retired.connected=connected;retired.connectionEpoch=(retired.connectionEpoch or 0)+1
        return 'OK'
    end
    local id=self.byUserId[userId]; local e=id and self.enemies[id]
    if not e then return 'UNKNOWN_ENEMY' end
    if type(connected)~='boolean' then return 'INVALID_CONNECTION' end
    if e.connected==connected then return 'NO_CHANGE' end
    e.connected=connected; e.connectionEpoch+=1; e.lastSeq=0; e.lastMove=nil
    self:_resetLocomotion(id,e)
    self.world:move(id,0,0)
    self:_log('EnemyConnection',id,{actorId=e.actorId,ownerUserId=userId,connected=connected,connectionEpoch=e.connectionEpoch})
    return 'OK'
end
function Director:controlled(userId)
    local id=self.byUserId[userId]; local e=self.retiredOwners and self.retiredOwners[userId] or id and self.enemies[id]
    if not e then return nil end
    return {enemyId=id,actorId=e.actorId,attempt=1,connectionEpoch=e.connectionEpoch,
        connected=e.connected,status=e.dead and 'Dead' or 'Alive',hearts=e.health,
        maxHearts=e.boss and self.config.Boss.hits or self.config.Enemy.hearts,
        template=e.boss and 'Boss' or 'Sentry',kind=e.kind,name=e.name,carryState=self.carry and self.carry:stateFor(id),dragonMode=self.dragons and self.dragons.states[id] and self.dragons.states[id].mode,
        movementKind=self.campaignEnemies and self.campaignEnemies:movementKind(id,e) or nil,
        reactionEpoch=e.reactionEpoch or 0,movementMode=self.world.movementMode and self.world:movementMode(id) or nil}
end
function Director:available(userId)
    local offers={}
    if self.byUserId[userId] or self.result or self.session.state.status~='Active' then return offers end
    for id,e in pairs(self.enemies) do
        if not e.boss and not e.dead and not e.engaged and not e.ownerUserId and not self.world:hazard(id) then
            offers[#offers+1]={enemyId=id,actorId=e.actorId,kind=e.kind,name=e.name,hearts=e.health,maxHearts=self.config.Enemy.hearts}
        end
    end
    table.sort(offers,function(a,b) return a.enemyId&gt;b.enemyId end)
    return offers
end
function Director:closeTargetForAttack(targetIds)
    for _,id in ipairs(targetIds) do
        local e=self.enemies[id]
        if e and not e.dead and not (e.reactionUntil and self.now&lt;e.reactionUntil) then e.engaged=true; return end
        local h=self.session.state.heroes[id]
        local c=self.session.combat[id]
        if h and h.status=='Alive' and not c.deathAt and not c.reactionEnd then return end
        local ball=self.projectiles[id]
        if (ball and not ball.reflected) or (id==-99 and self.stage=='Boss') then return end
    end
end
function Director:command(userId,payload,now,validator)
    local id=self.byUserId[userId]; local e=id and self.enemies[id]
    if not e then return 'UNKNOWN_ENEMY' end
    if type(validator)~='function' or not validator(payload) then return 'INVALID_INTENT' end
    if self.retiredOwners and self.retiredOwners[userId] then return 'STALE_ACTOR' end
    if payload.kind~='Move' and payload.kind~='Jump' and payload.kind~='Attack' then return 'INVALID_INTENT' end
    if payload.kind=='Attack' and payload.attack~='Punch' then return 'INVALID_INTENT' end
    if e.boss and payload.kind=='Jump' then return 'INVALID_INTENT' end
    if payload.runId~=self.session.state.runId then return 'WRONG_RUN' end
    if self.result or self.session.state.status~='Active' then return 'RUN_CLOSED' end
    if not e.connected then return 'OFFLINE' end
    if e.dead then return 'NOT_ALIVE' end
    if e.boss and self.world:hazard(id) then self:_kill(id); return 'NOT_ALIVE' end
    if payload.actorId~=e.actorId or payload.attempt~=1 or payload.levelEpoch~=self.session.state.levelEpoch then return 'STALE_ACTOR' end
    if payload.connectionEpoch~=e.connectionEpoch then return 'STALE_CONNECTION' end
    if payload.seq&lt;=e.lastSeq then return 'STALE_SEQUENCE' end
    if not finite(now) or now&lt;0 then return 'INVALID_TIME' end
    if now&lt;self.now then return 'TIME_REVERSED' end
    self.now=now; e.lastSeq=payload.seq
    if self.carry and self.carry:blocksEnemy(id) then
        return self.carry:stateFor(id)=='Carried' and 'HELD' or 'THROWN'
    end
    if e.boss then
        if self.stage~='Boss' then return 'RUN_CLOSED' end
        if payload.kind=='Move' then
            local length=math.sqrt(payload.x^2+payload.z^2)
            if length&gt;0 then
                e.aim={x=payload.x/length,z=payload.z/length}
                if self.world.aim then self.world:aim(id,e.aim.x,e.aim.z) end
            end
        else
            if now&lt;self.nextShot then return 'COOLDOWN' end
            if self.guardian then return self.guardian:fire(e.aim) end
            self:_shoot(nil,e.aim); self.nextShot=now+self.config.Boss.interval
        end
        return 'OK'
    end
    if e.reactionUntil then return 'REACTION' end
    if self.campaignEnemies and self.campaignEnemies:owns(id,e) then
        return self.campaignEnemies:command(id,e,payload,now)
    end
    if self.dragons and e.kind=='Dragon' then
        local code=self.dragons:enemyCommand(id,e,payload,now)
        if code then return code end
    end
    if payload.kind=='Move' then
        e.lastMove=now; self.world:move(id,payload.x,payload.z,payload.run)
    elseif payload.kind=='Jump' then self.world:jump(id)
    else
        if e.windup or now&lt;e.nextAttack then return 'COOLDOWN' end
        self:_beginStrike(id,e)
    end
    return 'OK'
end
function Director:_strikeTarget(id,profile)
    for _,target in ipairs(self.world:targets(id,profile)) do
        local enemy=self.enemies[target]
        local hero=self.session.state.heroes[target]
        local combat=self.session.combat[target]
        if enemy and not enemy.dead and not enemy.reactionUntil then return target end
        if hero and hero.status=='Alive' and combat and not combat.deathAt
            and (not combat.reactionEnd or combat.recover==true) then return target end
    end
end
function Director:_beginStrike(id,e,target)
    if self.dragons and e.kind=='Dragon' and self.dragons:beginCapture(id,e,target) then return end
    local action=self.config.Enemy.attack
    local tuning=self.strikeProfile
    local running=self.config.Movement and not e.boss and e.kind~='Dragon' and self.world.isRunning
        and self.world:isRunning(id)==true
    local sourceRush=e.kind=='Pig' and e.rushing and (not self.config.Movement or running)
    local sourceFamily=self.route and ((e.kind=='Pig' and self.config.Pig) or (e.kind=='Walker' and self.config.Walker))
    if running and not sourceRush then
        action='EnemyRunStrike';tuning=self.config.Attacks[action]
    elseif self.route and e.kind=='Dragon' and self.config.Dragon then
        action='DragonHeadbutt';tuning=self.config.Attacks[action]
    elseif sourceFamily then
        local light=e.kind=='Pig' and 'PigJab' or 'WalkerLight'
        local heavy=e.kind=='Pig' and 'PigHeavy' or 'WalkerHeavy'
        target=target or self:_strikeTarget(id,self.config.Attacks[light])
        local combat=target and self.session.combat[target]
        local ordinary=target and self.enemies[target]
        if not combat and ordinary and ordinary.rawLife~=nil then combat=ordinary end
        -- Prototype enemy3HP is not raw source Life; an unknown target uses jab.
        action=sourceRush and 'PigRush' or (combat and combat.rawLife%16&lt;4 and heavy or light)
        tuning=self.config.Attacks[action]
    end
    e.engaged=true; e.rushing=nil; e.runApproach=nil; e.strikeRecoveryUntil=nil
    e.windup={at=self.now+tuning.windup,action=action,tuning=self.Combat.captureAttack(self.config,action,tuning)}
    self.world:move(id,0,0,false); self.world:cue(id,true)
    self:_log('EnemyAttackAccepted',id,{actorId=e.actorId,action=action,ownerUserId=e.ownerUserId,effectAt=e.windup.at})
end
function Director:_resolveStrike(id,e)
    local pending=e.windup
    e.windup=nil; e.nextAttack=self.now+pending.tuning.cooldown
    e.lastStrikeAction=pending.action; e.strikeRecoveryUntil=self.now+pending.tuning.recoveryPose
    local landed=false
    for _,target in ipairs(self.world:targets(id,pending.tuning)) do
        local hit=false
        if self.enemies[target] then hit=self:hit(id,target,pending.action,pending.tuning)
        elseif self.session.state.heroes[target] then hit=self.session:_hit(id,target,pending.action,pending.tuning) end
        if hit then landed=true;break end
    end
    if not landed then self:_log('EnemyAttackMiss',id,{actorId=e.actorId,action=pending.action}) end
end
function Director:_boss()
    if self.bossIntro or self.enemies[-99] then return end
    local controller=self.bossGate and self.bossGate(self.now) or {state='NPC'}
    if controller.state=='Waiting' then
        self.stage='BossReady'; self.world:stage('BossReady'); return
    end
    if self.clubs then self.clubs:bossIntro() end
    if self.route and self.BossIntro then
        -- Drop carried bodies and pending captures through their normal release
        -- path. Carry remains available after this single intro transition.
        if self.carry then
            local released={}
            for id,row in pairs(self.carry.states) do if row.mode=='Carried' then released[id]=true end end
            for _,row in ipairs(self.carry.pending) do released[row.id]=true end
            for id in pairs(released) do self.carry:forgetEnemy(id) end
        end
        self.bossController=controller
        self.stage='BossIntro';self.world:stage('BossIntro')
        self.bossIntro=self.BossIntro.new(self)
        return
    end
    self:_activateBoss(controller)
end
function Director:cancelBossIntro(reason)
    if self.bossIntro then return self.bossIntro:cancel(reason) end
end
function Director:_activateBoss(controller)
    if self.enemies[-99] then return end
    self.stage='Boss'; self.world:stage('Boss')
    local position=self.route and self.route.boss.position or {x=82,y=3,z=0}
    assert(self.world:spawnEnemy(-99,'Boss',position),'Boss spawn failed')
    local actorId=self.session.state.runId..':boss:'..self.session.state.levelEpoch
    local e={boss=true,actorId=actorId,health=self.config.Boss.hits,rawLife=self.route and self.config.Boss.rawLife,
        zoneIndex=self.zoneIndex,name="Causeway Guardian",aim={x=-1,z=0}}
    self.enemies[-99]=e
    if controller.state=='Human' then
        e.ownerUserId=controller.userId
        e.connected=self.ownerConnections==nil or self.ownerConnections[controller.userId]~=false
        e.connectionEpoch=1; e.lastSeq=0
        self.byUserId[controller.userId]=-99
    end
    self.world:enemyIdentity(-99,actorId,e.ownerUserId and self.ownerNames[e.ownerUserId])
    self.world:enemyHealth(-99,self.config.Boss.hits,self.config.Boss.hits)
    self:_log('BossAssigned',-99,{actorId=actorId,ownerUserId=e.ownerUserId,rawLife=e.rawLife,health=e.health})
    self.nextShot=self.now+1.8
    if self.route then
        assert(self.GuardianPattern,'Modern guardian pattern is required')
        self.guardian=self.GuardianPattern.new(self)
    end
end
function Director:isTarget(id)
    return self.enemies[id]~=nil or self.projectiles[id]~=nil or id==-99
end
function Director:_kill(id,cause)
    local e=self.enemies[id]
    if not e or e.dead then return end
    if self.carry then self.carry:forgetEnemy(id) end
    if self.dragons then self.dragons:forgetEnemy(id) end
    if self.campaignEnemies then self.campaignEnemies:forgetEnemy(id) end
    self:_resetLocomotion(id,e)
    e.dead=true; e.windup=nil; e.rushing=nil; e.strikeRecoveryUntil=nil; e.health=0
    if self.clubs and e.kind=='Walker' then self.clubs:walkerDefeated(id,self.world:position(id),cause) end
    if e.rawLife~=nil then e.rawLife=0 end
    self:_health(id,e)
    self.world:kill(id)
    self:_log('EnemyDeath',id,{actorId=e.actorId,cause=cause or 'Unknown',ownerUserId=e.ownerUserId,position=self.world:position(id)})
    if e.boss then
        self.stage='Exit'; self.world:stage('Exit')
    end
end
local function reportHeroEnemyHit(session,slot,enemy,damaged)
    if session.onHeroEnemyHit and session.state.heroes[slot] and (damaged or enemy.dead) then
        session.onHeroEnemyHit(slot,enemy.dead==true)
    end
end
function Director:hit(attacker,target,action,tuning)
    if self.result then return false end
    if self.guardian and (self.projectiles[target] or target==-99) then return self.guardian:hit(attacker,target,action) end
    local ball=self.projectiles[target]
    if ball then
        if ball.reflected then return false end
        ball.reflected=true
        ball.reflectedAt=self.now
        self.world:projectile(target,ball.position,true)
        self.world:cue(attacker,false)
        return true
    end
    if target==-99 then
        if self.stage~='Boss' then return false end
        self.world:cue(-99,true)
        local profile=action=='Dash' and 22 or 18
        local responses=tuning and tuning.responses or self.config.Impulses
        local impulse=responses and responses[profile]
        if impulse then self.world:impulse(-99,attacker,impulse,profile,tuning and tuning.impulseDirection) end
        return true
    end
    local e=self.enemies[target]
    if e and e.rawLife~=nil and self.carry and self.carry:blocksEnemy(target) then return false end
    if e and e.rawLife~=nil then self:_finishReaction(target,e) end
    if not e or e.dead or (e.rawLife==nil and e.reactionUntil and self.now&lt;e.reactionUntil) then return false end
    if self.carry then self.carry:forgetEnemy(target) end
    if self.campaignEnemies and self.campaignEnemies:owns(target,e) then self.campaignEnemies:onHit(target) end
    self:_resetLocomotion(target,e)
    e.reactionEpoch=(e.reactionEpoch or 0)+1
    e.engaged=true; e.windup=nil; e.rushing=nil; e.strikeRecoveryUntil=nil
    local family=(self.config.Pig and self.config.Pig.npcDamage[action] and self.config.Pig)
        or (self.config.Walker and self.config.Walker.npcDamage[action] and self.config.Walker)
        or (self.config.Dragon and self.config.Dragon.npcDamage[action] and self.config.Dragon)
    local runStrike=action=='EnemyRunStrike'
    local damage=(runStrike and self.config.Enemy.dashDamage) or (family and family.npcDamage[action]) or (action=='Club' and self.config.WalkerClub.npcDamage
        or (action=='Dash' and self.config.Enemy.dashDamage or self.config.Enemy.punchDamage))
    local before=e.rawLife or e.health
    local npc=not e.ownerUserId and not e.boss
    local source=e.rawLife~=nil and self.Combat.hitEnemy(e.rawLife,action,npc)
    if source then e.rawLife=source.rawLife else e.health=math.max(0,e.health-(npc and math.max(2,damage) or damage)) end
    -- This cosmetic receipt comes from the actual successful effect result,
    -- never a later target-Life read. Captured tuning identifies one accepted
    -- server attack; body/actor/epoch prevent it crossing a replacement.
    if action=='Dash' and source and source.profile==3 and type(tuning)=='table' then
        local hero=self.session.state.heroes[attacker]
        local actor=self.world.actors[attacker]
        if hero and hero.status=='Alive' and actor and actor.model and actor.model.Parent
            and actor.model:GetAttribute('ActorId')==hero.actorId then
            actor.dashPresentationResult={branch='DashLowLifeTail',profile=source.profile,tuning=tuning,
                body=actor.model,actorId=hero.actorId,levelEpoch=self.session.state.levelEpoch,at=self.now}
        end
    end
    self:_health(target,e)
    self.world:cue(target,false)
    self:_log('EnemyHit',target,{actorId=e.actorId,attacker=attacker,target=target,action=action,
        before=before,after=e.rawLife or e.health,sourceRaw=source~=false and source~=nil,
        profile=source and source.profile or nil,dying=source and source.dying,position=self.world:position(target)})
    local handled=self.campaignEnemies and self.campaignEnemies.afterHit and self.campaignEnemies:afterHit(target,e,attacker,action)
    if not handled and ((source and source.dying) or (not source and e.health==0)) then self:_kill(target,'Combat')
    elseif not handled then
        local policy=tuning and tuning.sourceCombat or self.config.SourceCombat
        local reaction=source and (source.heavyReaction and policy.npcHeavyReaction
            or policy.npcLightReaction) or ((tuning and tuning.reaction) or (family and self.config.Attacks[action].reaction)
            or (runStrike and self.config.Attacks[action].reaction)
            or (action=='Club' and self.config.Attacks.Club.reaction or self.config.Enemy.reaction)
        )
        e.heavyReaction=source and source.heavyReaction or nil
        e.reactionUntil=self.now+reaction
        if self.dragons then self.dragons:hitEnemy(target,source and source.heavyReaction) end
        self.world:move(target,0,0); self.world:setReaction(target,true)
        local profile=source and source.profile or (runStrike and 4) or (family and family.npcProfile[action] or (action=='Club' and 2 or (action=='Dash' and 22 or 18)))
        local responses=tuning and tuning.responses or self.config.Impulses
        local impulse=responses and responses[profile]
        if impulse then self.world:impulse(target,attacker,impulse,profile,tuning and tuning.impulseDirection) end
    end
    reportHeroEnemyHit(self.session,attacker,e,(e.rawLife or e.health)&lt;before)
    return true
end
function Director:applyThrowDamage(id,heroSlot)
    local e=self.enemies[id]
    if self.result or self.session.state.status~='Active' or not e or e.dead or e.kind~='Pig' then return false end
    local before=e.health
    local npc=not e.ownerUserId and not e.boss
    local source=e.rawLife~=nil and self.Combat.hitEnemy(e.rawLife,'EnemyThrow',npc)
    local damage=self.config.EnemyCarry.throwDamage
    if source then e.rawLife=source.rawLife else e.health=math.max(0,e.health-(npc and math.max(2,damage) or damage)) end
    e.reactionEpoch=(e.reactionEpoch or 0)+1
    self:_health(id,e);self.world:cue(id,false)
    self.session:_record('EnemyThrowDamage',heroSlot,{enemyId=id,before=before,after=e.health,
        sourceProfile=self.config.EnemyCarry.sourceProfile,sourceRawDamage=self.config.EnemyCarry.sourceRawDamage})
    if (source and source.dying) or (not source and e.health==0) then self:_kill(id,'Combat') end
    reportHeroEnemyHit(self.session,heroSlot,e,e.health&lt;before)
    return true
end
function Director:_nearest(position,standingEligibility)
    local selected,best=nil,math.huge
    for _,id in ipairs(self.session.order) do
        local h=self.session.state.heroes[id]
        local c=self.session.combat[id]
        if h.status=='Alive' and not c.deathAt and not (c.hitProtectedUntil and self.now&lt;c.hitProtectedUntil)
            and (not standingEligibility or not c.reactionEnd or c.recover==true) then
            local d=distance(position,self.world:position(id))
            if d&lt;best then selected,best=id,d end
        end
    end
    return selected,best
end
function Director:_enemies(dt)
    local living=0
    for id,e in pairs(self.enemies) do
        if not e.dead then
            local hazard=self.world:hazard(id)
            if hazard then self:_kill(id,hazard)
            else
                if not (self.dragons and self.dragons:isMounted(id)) then living+=1 end
                local carried=self.carry and self.carry:blocksEnemy(id)
                if carried then self:_resetLocomotion(id,e); e.strikeRecoveryUntil=nil end
                if not carried and e.reactionUntil and self.now&gt;=e.reactionUntil then
                    self:_finishReaction(id,e)
                end
                if self.campaignEnemies and self.campaignEnemies:owns(id,e) then
                    self.campaignEnemies:enemyStep(id,e,dt)
                elseif self.dragons and e.kind=='Dragon' then
                    self.dragons:enemyStep(id,e,dt)
                elseif not carried and not e.reactionUntil then
                    if e.windup then
                        self.world:move(id,0,0)
                        if self.now&gt;=e.windup.at then self:_resolveStrike(id,e) end
                    elseif e.ownerUserId then
                        if e.lastMove and self.now-e.lastMove&gt;=(self.config.MoveTimeout or .35) then
                            e.lastMove=nil; self.world:move(id,0,0)
                        end
                    else
                        local walker=self.route and e.kind=='Walker' and self.config.Walker
                        local standing=walker or (self.route and e.kind=='Pig' and self.config.Pig)
                            or (self.route and e.kind=='Dragon' and self.config.Dragon)
                        local target,range=self:_nearest(self.world:position(id),standing~=nil and standing~=false)
                        local attackRange=walker and walker.range or self.config.Enemy.range
                        if walker and self.config.Movement and self.world.isRunning and self.world:isRunning(id) then
                            attackRange=math.min(attackRange,self.config.Attacks.EnemyRunStrike.reach)
                        end
                        -- Validate the approach before either melee or movement:
                        -- a newly invalid target cannot preserve an old running hop.
                        if e.rushing then
                            local a,b=self.world:position(id),target and self.world:position(target)
                            local c=target and self.session.combat[target]
                            local alignment=self.config.Pig.alignment
                            if not a or not b or math.abs(a.z-b.z)&gt;alignment or math.abs(a.y-b.y)&gt;alignment
                                or (c and c.reactionEnd) then self:_resetLocomotion(id,e) end
                        end
                        if target and walker and range&lt;walker.minRange then
                            e.runApproach=nil
                            self.world:enemyRetreat(id,target,walker.retreatSpeed)
                        elseif target and range&lt;=attackRange and self.now&gt;=e.nextAttack then
                            self.world:face(id,target); self:_beginStrike(id,e,target)
                        elseif target and range&gt;attackRange*.8 then
                            local speed=self.config.Enemy.speed
                            if walker and self.config.Movement then
                                if range&gt;self.config.Movement.npcRunDistance then e.runApproach=true end
                                if e.runApproach then speed=self.config.Movement.enemyRunSpeed end
                            end
                            if self.route and self.config.Pig and e.kind=='Pig' then
                                local pig=self.config.Pig
                                local a,b=self.world:position(id),self.world:position(target)
                                local c=self.session.combat[target]
                                local aligned=a and b and math.abs(a.z-b.z)&lt;=pig.alignment and math.abs(a.y-b.y)&lt;=pig.alignment
                                if not aligned or (c and c.reactionEnd) then e.rushing=nil
                                elseif range&gt;self.config.Enemy.range and self.zoneIndex&gt;=pig.rushAfterZone
                                    and self.now&gt;=e.nextAttack and not e.rushing and self.now&gt;=(e.nextRushCheck or 0) then
                                    e.nextRushCheck=self.now+pig.decisionInterval
                                    if self.random(1,pig.rushRoll)==1 then e.rushing=true end
                                end
                                if e.rushing then speed=pig.rushSpeed end
                            end
                            self.world:enemyMove(id,target,speed)
                        else e.rushing=nil;e.runApproach=nil; self.world:move(id,0,0,false) end
                    end
                end
            end
        end
    end
    if living&gt;0 and self.route then self.world:progress(self.zoneIndex,false) end
    if living==0 then
        if self.route then
            self.world:progress(self.zoneIndex,true)
            if self:_zoneReached() then
                if self.zoneIndex&lt;#self.route.zones then self:_enterZone(self.zoneIndex+1)
                else self.zoneIndex=#self.route.zones+1;self.world:progress(self.zoneIndex,false);self:_boss() end
            end
        elseif self.stage=='Approach' then self:_wave('Courtyard',{{id=-3,x=22,z=-7},{id=-4,x=30,z=6}})
        elseif self.stage=='Courtyard' then self:_boss() end
    end
end
function Director:_shoot(target,aim)
    local origin=self.world:position(-99)
    if not origin then return end
    local destination=aim and {x=origin.x+aim.x*self.config.Boss.aggroRange,y=origin.y,z=origin.z+aim.z*self.config.Boss.aggroRange}
        or self.world:position(target)
    if not origin or not destination then return end
    if target then self.world:face(-99,target) end
    self.world:cue(-99,true)
    self.serial+=1
    local id=-1000-self.serial
    local start=towards(origin,destination,5)
    self.projectiles[id]={position=start,direction=destination,created=self.now,target=target,reflected=false}
    self.world:projectile(id,start,false)
end
function Director:_projectiles(dt)
    if self.guardian then self.guardian:step(self.now,dt);return end
    local boss=self.enemies[-99]
    if self.stage=='Boss' and boss and not boss.ownerUserId and self.now&gt;=self.nextShot then
        local target,range=self:_nearest(self.world:position(-99))
        if target and range&lt;=self.config.Boss.aggroRange then
            self:_shoot(target)
        end
        self.nextShot=self.now+self.config.Boss.interval
    end
    local remove={}
    for id,p in pairs(self.projectiles) do
        if self.stage~='Boss' then break end
        local destination=p.reflected and self.world:position(-99) or p.direction
        if not destination or self.now-(p.reflectedAt or p.created)&gt;self.config.Boss.projectileLife then remove[#remove+1]=id
        else
            local speed=p.reflected and self.config.Boss.returnSpeed or self.config.Boss.projectileSpeed
            p.position=towards(p.position,destination,speed*dt)
            self.world:projectile(id,p.position,p.reflected)
            if p.reflected and self.stage=='Boss' and distance(p.position,destination)&lt;2.5 then
                self.bossHits+=1; self.world:cue(-99,false)
                boss.health=self.config.Boss.hits-self.bossHits
                self.world:enemyHealth(-99,self.config.Boss.hits-self.bossHits,self.config.Boss.hits)
                remove[#remove+1]=id
                if self.bossHits&gt;=self.config.Boss.hits then
                    self:_kill(-99)
                end
            elseif not p.reflected then
                local hit=false
                for _,hero in ipairs(self.session.order) do
                    if self.session.state.heroes[hero].status=='Alive' and distance(p.position,self.world:position(hero))&lt;2.3 then
                        self.session:_hit(-99,hero,'Dash'); hit=true; break
                    end
                end
                if hit or distance(p.position,destination)&lt;.1 then remove[#remove+1]=id end
            end
        end
    end
    for _,id in ipairs(remove) do self.projectiles[id]=nil; self.world:removeProjectile(id) end
    if self.stage=='Exit' then
        for id in pairs(self.projectiles) do self.world:removeProjectile(id) end
        self.projectiles={}
    end
end
function Director:step(now,dt)
    if self.result then
        self:cancelBossIntro('RunEnded')
        if self.flies then self.flies:close() end
        if self.carry then self.carry:close() end
        if self.clubs then self.clubs:close() end
        if self.dragons then self.dragons:close() end
        return
    end
    self.now=now
    if self.carry then self.carry:step(now) end
    if self.clubs then self.clubs:step(now) end
    if self.flies then self.flies:step(now) end
    if self.dragons then self.dragons:step(now,dt) end
    if self.session.state.status=='Lost' then
        self:cancelBossIntro('RunEnded')
        self.result='Lost'; self.stage='Lost'; self.world:stage('Lost')
        if self.guardian then self.guardian:step(now,0) end
        if self.dragons then self.dragons:close() end
        return
    end
    if self.stage=='Approach' or self.stage=='Courtyard' or self.stage=='Route' then self:_enemies(dt) end
    if self.dragons and self.stage~='Route' and self.stage~='Approach' and self.stage~='Courtyard' then
        for id,e in pairs(self.enemies) do
            if e.kind=='Dragon' and not e.dead then
                local hazard=self.world:hazard(id)
                if hazard then self:_kill(id,hazard)
                else self:_finishReaction(id,e);self.dragons:enemyStep(id,e,dt) end
            end
        end
    end
    if self.stage=='BossReady' then self:_boss() end
    if self.stage=='BossIntro' and self.bossIntro and self.bossIntro:step(now)=='Complete' then
        self:_activateBoss(self.bossController)
    end
    if self.stage=='Boss' and self.world:hazard(-99) then self:_kill(-99) end
    if self.stage=='Boss' or next(self.projectiles) then self:_projectiles(math.min(math.max(dt or 0,0),.1)) end
    if self.stage=='Exit' then
        for _,id in ipairs(self.session.order) do
            if self.session.state.heroes[id].status=='Alive' and not self.session.combat[id].deathAt and self.world:atExit(id) then
                self.result='Won'; self.stage='Won'; self.world:stage('Won')
                if self.flies then self.flies:close() end
                if self.carry then self.carry:close() end
                if self.clubs then self.clubs:close() end
                if self.dragons then self.dragons:close() end
                break
            end
        end
    end
end
function Director:snapshot()
    local enemies={}
    for id,e in pairs(self.enemies) do
        enemies[#enemies+1]={id=id,hearts=e.health,maxHearts=e.boss and self.config.Boss.hits or self.config.Enemy.hearts,
            dead=e.dead==true,attacking=e.windup~=nil,zoneIndex=e.zoneIndex,kind=e.kind,
            reactionEpoch=e.reactionEpoch or 0,movementMode=self.world.movementMode and self.world:movementMode(id) or nil,
            carryState=self.carry and self.carry:stateFor(id),dragonMode=self.dragons and self.dragons.states[id] and self.dragons.states[id].mode}
    end
    table.sort(enemies,function(a,b) return a.id&gt;b.id end)
    local zone=self.route and self.route.zones[self.zoneIndex]
    local objective=objectives[self.stage]
    if self.route and self.stage=='Route' then objective=zone.objective
    elseif self.route and self.stage=='Boss' then objective="Dodge. Pick up a heavy ball and throw it at the Guardian." end
    local variation=self.route and self.route.variation
    return {stage=self.stage,objective=objective,enemies=enemies,bossHits=self.bossHits,
        bossMax=self.config.Boss.hits,result=self.result,zoneIndex=self.zoneIndex,zoneCount=self.route and #self.route.zones,
        zoneName=zone and zone.name,bossMechanic=self.route and 'PickupThrow',bossRawLife=self.enemies[-99] and self.enemies[-99].rawLife,
        healingFlies=self.flies and self.flies:snapshot(),bossIntro=self.bossIntro and self.bossIntro:snapshot(),
        variation=variation and {version=variation.version,seed=variation.seed,sectionChoices=table.clone(variation.sectionChoices)}}
end
return Director
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT42">
          <Properties>
            <string name="Name">LevelVariation</string>
            <ProtectedString name="Source">-- Original authored sections, not copied NES layouts or player navigation assistance.
local Variation={}
local MODULUS=2147483647

local function floor(width,depth,z,top)
    return {w=width,d=depth,z=z or 0,top=top or 0}
end

-- Studs and heights are authored Roblox calibration. Every required crossing
-- keeps the walk16/Jump50 budget: 2.5 takeoff lead plus .5 landing inset.
local SECTIONS={
    {
        {platforms={floor(86,52)}},
        {platforms={floor(94,48,-4)}},
        {platforms={floor(80,56,4)}},
    },
    {
        {platforms={floor(44,38),floor(71,38)},gaps={5}},
        {platforms={floor(50,40,-3),floor(69,36,3)},gaps={5}},
        {platforms={floor(42,36,4),floor(76,42,-4,2)},gaps={4}},
    },
    {
        {platforms={floor(112,56)}},
        {platforms={floor(100,52,-4)}},
        {platforms={floor(124,60,4)}},
    },
    {
        {platforms={floor(34,18),floor(27,18,6,2),floor(27,18,0,4),floor(24,22,-6,2)},gaps={4,4,4}},
        {platforms={floor(40,22,-4),floor(30,20,3,2),floor(28,22,-3,2),floor(30,24,4)},gaps={4,4,4}},
        {platforms={floor(32,20,4),floor(32,22,-4),floor(36,20,4,2),floor(28,22,-4)},gaps={5,4,5}},
    },
    {
        {platforms={floor(126,52)}},
        {platforms={floor(114,48,-4)}},
        {platforms={floor(134,56,4)}},
    },
    {
        {platforms={floor(44,26),floor(55,26)},gaps={5}},
        {platforms={floor(48,30,-2),floor(58,30,2)},gaps={4}},
        {platforms={floor(40,28,3),floor(64,28,-3)},gaps={5}},
    },
}

local function left(p) return p.x-p.w/2 end
local function right(p) return p.x+p.w/2 end
local function top(p) return p.y+p.h/2 end

local function copy(value,seen)
    if type(value)~='table' then return value end
    seen=seen or {}
    if seen[value] then return seen[value] end
    local result={};seen[value]=result
    for k,v in pairs(value) do result[copy(k,seen)]=copy(v,seen) end
    return result
end

function Variation.seedFromId(runId)
    assert(type(runId)=='string' and #runId&gt;0,'A nonempty server run ID is required')
    local hash=17
    for i=1,#runId do hash=(hash*131+string.byte(runId,i))%MODULUS end
    return hash%(MODULUS-1)+1
end

local function mappedPoint(point,oldPlatforms,newPlatforms)
    for i,old in ipairs(oldPlatforms) do
        if point.x&gt;=left(old) and point.x&lt;=right(old)
            and point.z&gt;=old.z-old.d/2 and point.z&lt;=old.z+old.d/2 then
            local new=newPlatforms[i]
            point.x=left(new)+(point.x-left(old))/old.w*new.w
            point.z=new.z+(point.z-old.z)/old.d*new.d
            point.y=top(new)+point.y-top(old)
            return
        end
    end
    error('Canonical actor/item has no corresponding floor: '..tostring(point.id))
end

local function addCover(zone,choice)
    zone.obstacles={}
    if choice==1 then return end
    local p=zone.platforms[1]
    local width,depth,height=6+choice,4,3
    local side=choice==2 and -1 or 1
    for _,direction in ipairs({side,-side}) do for _,fraction in ipairs({.25,.5,.75}) do
        local x=left(p)+p.w*fraction
        local z=p.z+direction*(p.d/2-depth/2-1)
        local clear=math.abs(z)-depth/2&gt;=12
        for _,points in ipairs({zone.enemies,zone.flies or {}}) do for _,point in ipairs(points) do
            if math.abs(point.x-x)&lt;=width/2+2.2 and math.abs(point.z-z)&lt;=depth/2+1.2 then clear=false end
        end end
        if clear then
            zone.obstacles[1]={kind='StoneCover',x=x,y=top(p)+height/2,z=z,w=width,h=height,d=depth}
            return
        end
    end end
end

function Variation.build(baseLevel,seed)
    assert(type(seed)=='number' and seed==seed and seed%1==0 and seed&gt;=1 and seed&lt;MODULUS,'Seed must be an integer in1..2147483646')
    assert(type(baseLevel)=='table' and type(baseLevel.zones)=='table' and #baseLevel.zones==6,'The six-zone canonical route is required')
    local route=copy(baseLevel)
    local choices={}
    local state,cursor=seed,-82
    for zi,zone in ipairs(route.zones) do
        -- Products stay below 2^53, so this integer RNG is stable in Luau's doubles.
        state=(state*48271)%MODULUS
        local choice=state%3+1
        choices[zi]=choice
        local section=SECTIONS[zi][choice]
        local old=baseLevel.zones[zi]
        assert(#old.platforms==#section.platforms,'Canonical floor correspondence changed')
        local platforms,gaps={},{}
        for i,data in ipairs(section.platforms) do
            if i&gt;1 then
                local previous=platforms[i-1]
                local from=cursor
                cursor+=section.gaps[i-1]
                gaps[#gaps+1]={minX=from,maxX=cursor,
                    minZ=math.max(previous.z-previous.d/2,data.z-data.d/2),
                    maxZ=math.min(previous.z+previous.d/2,data.z+data.d/2)}
            end
            local p=copy(old.platforms[i])
            p.x=cursor+data.w/2;p.y=data.top-p.h/2;p.z=data.z;p.w=data.w;p.d=data.d
            platforms[i]=p;cursor+=p.w
        end
        zone.platforms=platforms;zone.gaps=gaps;zone.gateX=cursor
        for _,point in ipairs(zone.enemies) do mappedPoint(point,old.platforms,platforms) end
        for _,point in ipairs(zone.flies or {}) do mappedPoint(point,old.platforms,platforms) end
        local oldLast,newLast=old.platforms[#old.platforms],platforms[#platforms]
        local dx,dz,dy=cursor-right(oldLast),newLast.z-oldLast.z,top(newLast)-top(oldLast)
        zone.exit.minX+=dx;zone.exit.maxX+=dx
        zone.exit.minZ+=dz;zone.exit.maxZ+=dz
        zone.exit.minY+=dy;zone.exit.maxY+=dy
        if zi==1 or zi==3 or zi==5 then addCover(zone,choice) end
    end
    local last=baseLevel.zones[6].platforms
    local delta=cursor-right(last[#last])
    route.boss.position.x+=delta;route.boss.platform.x+=delta;route.boss.gateX+=delta
    route.boss.exit.minX+=delta;route.boss.exit.maxX+=delta;route.boss.pad.x+=delta
    route.bounds.maxX+=delta
    route.variation={version=1,seed=seed,sectionChoices=choices}
    return route
end

return Variation
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT43">
          <Properties>
            <string name="Name">MatchHub</string>
            <ProtectedString name="Source">-- Current-Player authority and routing for independent local playable groups.
local MatchHub={}
MatchHub.__index=MatchHub

local function identifier(value)
    return type(value)=='string' and #value&gt;0 and #value&lt;=160
end
local function exact(payload,allowed)
    if type(payload)~='table' then return false end
    for key in pairs(payload) do if not allowed[key] then return false end end
    return true
end
local function active(controller)
    return not controller.faulted and controller.current~=nil and not controller:_open()
end

-- The Hub registry owns connection tombstones. Group registries own only routed
-- membership, so the same current Player can return after an observer transfer.
local function groupRegistry(hub,groupId)
    local registry={current={},arrivals=setmetatable({},{__mode='k'}),serial=0}
    function registry:join(player)
        if not hub.connections:isCurrent(player) or hub.routes[player.UserId]~=groupId then return false end
        local previous=self.current[player.UserId]
        if previous==player then return false end
        self.serial+=1; self.arrivals[player]=self.serial; self.current[player.UserId]=player
        return true,previous
    end
    function registry:isCurrent(player)
        return hub.connections:isCurrent(player) and hub.routes[player.UserId]==groupId and self.current[player.UserId]==player
    end
    function registry:remove(player)
        if self.current[player.UserId]~=player then return false end
        self.current[player.UserId]=nil
        return true
    end
    function registry:online(players)
        local online,seen={},{}
        for _,player in ipairs(players) do
            if self:isCurrent(player) and not seen[player] then
                online[#online+1]=player; seen[player]=true
            end
        end
        table.sort(online,function(a,b) return self.arrivals[a]&lt;self.arrivals[b] end)
        return online
    end
    return registry
end

function MatchHub.new(deps,worldFactory)
    assert(type(worldFactory)=='function','World factory is required')
    local configured=deps.Config.Groups and deps.Config.Groups.maxGroups or 4
    assert(type(configured)=='number' and configured&gt;=1 and configured%1==0,'Invalid group capacity')
    local self=setmetatable({deps=deps,worldFactory=worldFactory,maxGroups=math.min(4,configured),
        connections=deps.Registry.new(),groups={},order={},routes={},requests={},
        entryLanes={},entrySerial=0,readyPlayers=setmetatable({},{__mode='k'}),
        buckets=setmetatable({},{__mode='k'}),notices=setmetatable({},{__mode='k'}),
        envelopes=setmetatable({},{__mode='k'}),snapshotSeq=setmetatable({},{__mode='k'}),
        actionSerial=setmetatable({},{__mode='k'}),queueDepth=0,pendingQuarantines={}},MatchHub)
    self.queue=deps.BossQueue.new(deps.Config.BossQueue,function(userId,context)
        return self:_queueEligible(userId,context)
    end)
    -- Eligibility can quarantine a faulty group, but it must not close that
    -- group's slot while BossQueue is iterating its entries or filling a slot.
    for _,name in ipairs({'register','select','cancel','reply','connect','step','start','close','view'}) do
        local method=self.queue[name]
        self.queue[name]=function(queue,...)
            self.queueDepth+=1
            local results=table.pack(pcall(method,queue,...))
            self.queueDepth-=1
            if self.queueDepth==0 then self:_flushQuarantines() end
            if not results[1] then error(results[2],0) end
            return table.unpack(results,2,results.n)
        end
    end
    self:_create()
    return self
end

-- Server-only control. No remote intent routes to this method.
function MatchHub:setInfiniteLives(enabled)
    if type(enabled)~='boolean' then return 'INVALID_OPTION' end
    local development=self.deps.Config.Development
    if not development or development.allowInfiniteLives~=true then return 'DEVELOPMENT_ONLY' end
    development.infiniteLives=enabled
    for _,group in pairs(self.groups) do
        self:_guard(group,function()
            local c=group.controller
            c.deps.Config.Development.infiniteLives=enabled
            if active(c) then assert(c.current:setInfiniteLives(enabled)=='OK') end
        end)
    end
    return 'OK'
end

function MatchHub:_flushQuarantines()
    if self.flushingQuarantines then return end
    self.flushingQuarantines=true
    while next(self.pendingQuarantines) do
        local pending=self.pendingQuarantines
        self.pendingQuarantines={}
        for group in pairs(pending) do
            if group.controller.quarantine then pcall(function() group.controller:quarantine() end) end
        end
    end
    self.flushingQuarantines=false
end

function MatchHub:_guard(group,callback)
    local ok,result=xpcall(callback,debug.traceback)
    if ok then return result,true end
    group.controller.faulted=true
    self.pendingQuarantines[group]=true
    if self.queueDepth==0 then self:_flushQuarantines() end
    local notify=self.deps.warn or warn
    if notify then pcall(notify,'[BrickToads '..group.id..'] '..tostring(result)) end
    return 'PARTY_FAULTED',false
end

function MatchHub:_create(entryOwner)
    local index=#self.order+1; local id='group-'..index
    if entryOwner then
        index=self.maxGroups+1
        while self.entryLanes[index] do index+=1 end
        self.entrySerial+=1; id='speeder-'..self.entrySerial
        self.entryLanes[index]=true
    end
    local world=self.worldFactory(index,id)
    local controllerDeps=table.clone(self.deps)
    controllerDeps.GroupId=id
    if entryOwner then
        -- No human boss can transfer into someone else's private ride.
        controllerDeps.BossQueue=nil; controllerDeps.SharedBossQueue=nil
    else controllerDeps.SharedBossQueue=self.queue end
    controllerDeps.Registry={new=function() return groupRegistry(self,id) end}
    controllerDeps.nextActionFeedbackId=function(player)
        self.actionSerial[player]=(self.actionSerial[player] or 0)+1
        return self.actionSerial[player]
    end
    local group={id=id,name=entryOwner and "Copper Rush" or ("Team "..index),world=world,
        entryOwner=entryOwner,entryPending=entryOwner~=nil,worldIndex=index}
    group.controller=self.deps.Controller.new(controllerDeps,world)
    self.groups[id]=group
    if entryOwner then self.entryLanes[index]=group else self.order[#self.order+1]=id end
    return group
end

-- Each private world lasts for its owner's visit. Group IDs stay unique even
-- when another rider reuses the same physical lane.
function MatchHub:_releaseEntry(group)
    if not group or not group.entryOwner or self.groups[group.id]~=group then return end
    if self.routes[group.entryOwner]==group.id then self.routes[group.entryOwner]=nil end
    self.groups[group.id]=nil
    self:_guard(group,function()
        group.controller:_closeDirector('EntryClosed')
        group.world:clearActors()
        if group.world.campaignWorld then group.world.campaignWorld:close() end
    end)
    group.world.folder:Destroy()
    self.entryLanes[group.worldIndex]=nil
end

function MatchHub:_startEntry(player,group)
    if not group or not group.entryPending or group.startingEntry or group.entryOwner~=player.UserId
        or not self.readyPlayers[player] or not group.controller.connections:isCurrent(player) then
        return 'OK'
    end
    local now=self.deps.clock()
    if group.entryRetryAt and now&lt;group.entryRetryAt then return 'ENTRY_PENDING' end
    group.startingEntry=true
    local code,ok=self:_guard(group,function()
        local result=group.controller:startSpeederEntry(player,{player})
        assert(result~='UNAVAILABLE','Speeder entry has no campaign configuration')
        return result
    end)
    group.startingEntry=nil
    if code=='OK' or not ok then
        group.entryPending=false
        group.entryStartFault=not ok
    else
        group.entryRetryAt=now+1
    end
    self.notices[player]=code~='OK' and code or nil
    return code
end

-- A queued boss may already own its matching active guardian. That existing
-- assignment is the only living-role exception when validating its own slot.
function MatchHub:_livingRole(userId,context)
    local function hasRole(group)
        local c=group.controller
        local living,ok=self:_guard(group,function()
            if active(c) then
                local slot=c.ownerSlots[userId]
                local hero=slot and c.current.state.heroes[slot]
                if hero and hero.status~='Eliminated' then return true end
                local role=c.director:controlled(userId)
                if role and role.status=='Alive' then
                    local matchingBoss=role.template=='Boss' and context and context.groupId==group.id
                        and context.runId==c.current.state.runId and context.levelEpoch==c.current.state.levelEpoch
                    if not matchingBoss then return true end
                end
            end
            return false
        end)
        return ok and living
    end
    local own=self.groups[self.routes[userId]]
    if own and own.entryOwner==userId and hasRole(own) then return own end
    for _,id in ipairs(self.order) do
        if hasRole(self.groups[id]) then return self.groups[id] end
    end
end

function MatchHub:_queueEligible(userId,context)
    local target=context and self.groups[context.groupId]
    if target and target.entryOwner then return false end
    if target then
        local ownsHero,ok=self:_guard(target,function()
            return active(target.controller) and target.controller.ownerSlots[userId]~=nil
        end)
        if not ok or ownsHero then return false end
    end
    local living=self:_livingRole(userId,context)
    -- The role scan itself can discover a broken target. Do not grant an
    -- invitation/acceptance just because its now-faulted roles were skipped.
    if target and target.controller.faulted then return false end
    return living==nil
end

function MatchHub:members(groupId,players)
    local members={}
    for _,player in ipairs(self.connections:online(players)) do
        if self.routes[player.UserId]==groupId then members[#members+1]=player end
    end
    return members
end

function MatchHub:selected(player)
    if not self.connections:isCurrent(player) then return nil end
    return self.groups[self.routes[player.UserId]]
end

function MatchHub:join(player,entryRoute)
    local joined,previous=self.connections:join(player)
    if not joined then return false end
    local userId=player.UserId
    local group=self.groups[self.routes[userId]]
    local createdEntry
    if previous and group then self:_guard(group,function() group.controller:leave(previous) end) end
    if entryRoute=='speeder' and not (group and group.entryPending) then
        -- Preserve heroes and human boss reservations on reconnect. An idle
        -- lobby or a spectator preference does not override a new ad entry.
        local living=self:_livingRole(userId,nil)
        local queue=self.queue:view(userId,self.deps.clock())
        if living then group=living
        elseif queue.state~='Accepted' and queue.state~='Ready' and queue.state~='Active' then
            if queue.state~='None' then self.queue:cancel(userId,self.deps.clock()) end
            self:_releaseEntry(group)
            group=self:_create(userId)
            createdEntry=group
        end
    end
    if not self.connections:isCurrent(player) then
        self:_releaseEntry(createdEntry)
        return false
    end
    group=group or self.groups[self.order[1]]
    self.routes[userId]=group.id
    self:_guard(group,function() group.controller:join(player) end)
    self:_startEntry(player,group)
    return true
end

function MatchHub:leave(player)
    if not self.connections:remove(player) then return false end
    local group=self.groups[self.routes[player.UserId]]
    if group then self:_guard(group,function() group.controller:leave(player) end) end
    self:_releaseEntry(group)
    self.readyPlayers[player]=nil
    if self.deps.Transfer then self.deps.Transfer:remove(player) end
    self.actionSerial[player]=nil;self.snapshotSeq[player]=nil;self.envelopes[player]=nil
    self.buckets[player]=nil; self.notices[player]=nil
    return true
end

function MatchHub:_switchReason(userId,targetId,now)
    if targetId and self.routes[userId]==targetId then return nil end
    if self:_livingRole(userId,nil) then return 'ROLE_ACTIVE' end
    local queue=self.queue:view(userId,now)
    if queue.state=='Accepted' or queue.state=='Ready' or queue.state=='Active' then return 'ROLE_RESERVED' end
end

function MatchHub:_move(player,target,now)
    local previous=self.groups[self.routes[player.UserId]]
    if previous==target then return end
    if previous then self:_guard(previous,function() previous.controller:leave(player) end) end
    self:_releaseEntry(previous)
    self.routes[player.UserId]=target.id
    local queue=self.queue:view(player.UserId,now)
    if queue.state~='None' then
        target.controller.preferences[player.UserId]='Spectator'
        target.controller.viewChoices[player.UserId]='Spectating'
    end
    self:_guard(target,function() target.controller:join(player) end)
end

function MatchHub:_rate(player,now)
    local rate=self.deps.Config.MaxIntentRate
    local bucket=self.buckets[player] or {tokens=rate,last=now}
    bucket.tokens=math.min(rate,bucket.tokens+math.max(0,now-bucket.last)*rate)
    bucket.last=math.max(bucket.last,now); self.buckets[player]=bucket
    if bucket.tokens&lt;1 then return false end
    bucket.tokens-=1
    return true
end

function MatchHub:_offerGroup(userId,offerId,now)
    local view=self.queue:view(userId,now)
    if view.offerId~=offerId then return nil end
    for _,id in ipairs(self.order) do
        local group=self.groups[id]
        if group.controller.bossSlot==view.slotId then return group end
    end
end

function MatchHub:handle(player,payload,players)
    if player.Parent and type(payload)=='table' and payload.kind=='EntryReady' then
        if not exact(payload,{kind=true}) then return 'INVALID_INTENT' end
        -- PlayerAdded may still be routing this exact instance, so retain a
        -- readiness signal that arrives before the initial snapshot.
        self.readyPlayers[player]=true
        return self:_startEntry(player,self:selected(player))
    end
    if not player.Parent or not self.connections:isCurrent(player) then return 'STALE_CONNECTION' end
    local function done(code)
        self.notices[player]=code~='OK' and code or nil
        return code
    end
    local now=self.deps.clock()
    if not self:_rate(player,now) then return done('RATE_LIMIT') end
    if type(payload)~='table' or type(payload.kind)~='string' then return done('INVALID_INTENT') end
    local selected=self:selected(player)
    if not selected then return done('MISSING_GROUP') end
    if payload.groupId==nil then
        if payload.kind~='Sync' or self.envelopes[player] then return done('MISSING_GROUP') end
    elseif not identifier(payload.groupId) then return done('INVALID_INTENT')
    elseif payload.groupId~=selected.id then return done('WRONG_GROUP') end
    self.envelopes[player]=true
    if selected.entryPending and payload.kind~='Sync' then return done('ENTRY_PENDING') end

    if payload.kind=='RideReady' then
        if not exact(payload,{kind=true,groupId=true,runId=true}) or not identifier(payload.runId)
            or selected.entryOwner~=player.UserId then return done('INVALID_INTENT') end
        local c=selected.controller
        if c.faulted then return done('PARTY_FAULTED') end
        if not c.current or c.current.state.runId~=payload.runId then return done('STALE_RUN') end
        return done(self:_guard(selected,function() return c:releaseSpeederEntry(player,payload.runId) end))
    elseif payload.kind=='Start' and selected.entryStartFault then
        if not exact(payload,{kind=true,groupId=true}) then return done('INVALID_INTENT') end
        local fresh=self:_create(player.UserId)
        if not self.connections:isCurrent(player) or self:selected(player)~=selected then
            self:_releaseEntry(fresh)
            return 'STALE_CONNECTION'
        end
        self:_move(player,fresh,now)
        return done(self:_startEntry(player,fresh))
    elseif payload.kind=='CreateGroup' then
        if not exact(payload,{kind=true,groupId=true,requestId=true}) or not identifier(payload.requestId) then return done('INVALID_INTENT') end
        local requests=self.requests[player.UserId]
        if requests and requests[payload.requestId] then return done('OK') end
        local reason=self:_switchReason(player.UserId,nil,now)
        if reason then return done(reason) end
        if #self.order&gt;=self.maxGroups then
            return done(self.deps.Transfer and self.deps.Transfer:request(player,payload.requestId) or 'GROUP_LIMIT')
        end
        local group=self:_create()
        if not requests then requests={}; self.requests[player.UserId]=requests end
        requests[payload.requestId]=group.id
        self:_move(player,group,now)
        return done('OK')
    elseif payload.kind=='JoinGroup' then
        if not exact(payload,{kind=true,groupId=true,targetGroupId=true}) or not identifier(payload.targetGroupId) then return done('INVALID_INTENT') end
        local target=self.groups[payload.targetGroupId]
        if not target or (target.entryOwner and target.entryOwner~=player.UserId) then return done('UNKNOWN_GROUP') end
        local reason=self:_switchReason(player.UserId,target.id,now)
        if reason then return done(reason) end
        self:_move(player,target,now)
        return done('OK')
    elseif payload.kind=='ReplyBoss' or payload.kind=='ConnectBoss' then
        local reply=payload.kind=='ReplyBoss'
        if not exact(payload,reply and {kind=true,groupId=true,offerId=true,accepted=true}
            or {kind=true,groupId=true,offerId=true}) or not identifier(payload.offerId)
            or (reply and type(payload.accepted)~='boolean') then return done('INVALID_INTENT') end
        local target=self:_offerGroup(player.UserId,payload.offerId,now)
        if not target then return done('STALE_OFFER') end
        local result
        if reply then result=self.queue:reply(player.UserId,payload.offerId,payload.accepted,now)
        else result=self.queue:connect(player.UserId,payload.offerId,now) end
        if result=='OK' and (not reply or payload.accepted) then self:_move(player,target,now) end
        return done(result)
    end

    local c=selected.controller
    if payload.kind=='ClaimEnemy' or payload.kind=='QueueBoss' or (payload.kind=='SelectRole' and payload.role=='Hero') then
        local owned=self:_livingRole(player.UserId,nil)
        if owned and owned~=selected then return done('ROLE_ACTIVE') end
    elseif payload.kind=='Start' then
        local open,readOk=self:_guard(selected,function() return c:_open() end)
        if not readOk then return done('PARTY_FAULTED') end
        if open then
            local heroes,heroesOk=self:_guard(selected,function() return c:_heroes(self:members(selected.id,players)) end)
            if not heroesOk then return done('PARTY_FAULTED') end
            for _,candidate in ipairs(heroes) do
                if self:_livingRole(candidate.UserId,nil) then return done('ROLE_ACTIVE') end
                local queue=self.queue:view(candidate.UserId,now)
                if queue.state=='Accepted' or queue.state=='Ready' or queue.state=='Active' then return done('ROLE_RESERVED') end
            end
        end
    end
    local inner={}
    for key,value in pairs(payload) do if key~='groupId' then inner[key]=value end end
    return done(self:_guard(selected,function() return c:handle(player,inner,self:members(selected.id,players)) end))
end

function MatchHub:snapshot(player,players)
    if not player.Parent then return nil end
    local selected=self:selected(player)
    if not selected then return nil end
    local members=self:members(selected.id,players)
    local data,ok=self:_guard(selected,function() return selected.controller:snapshot(player,members) end)
    if not ok then data=self.deps.Controller.snapshot(selected.controller,player,members) end
    if not data then return nil end
    local now=self.deps.clock()
    data.groupId=selected.id; data.groupName=selected.name
    if selected.entryPending then data.entryPending=true end
    data.worldName=selected.world.folder and selected.world.folder.Name or selected.world.name
    data.groups={}
    for _,id in ipairs(self.order) do
        local group=self.groups[id]; local c=group.controller
        local reason=self:_switchReason(player.UserId,id,now)
        local summary,readOk=self:_guard(group,function()
            if c.faulted then return {status='Faulted',heroes=0} end
            return {status=c.director and c.director.result or (c.current and c.current.state.status or 'Lobby'),
                heroes=c.current and #c.current.order or 0}
        end)
        if not readOk then summary={status='Faulted',heroes=0} end
        data.groups[#data.groups+1]={id=id,name=group.name,
            status=summary.status,heroes=summary.heroes,players=#self:members(id,players),canJoin=reason==nil,reason=reason}
    end
    data.canCreateGroup=(#self.order&lt;self.maxGroups or self.deps.Transfer~=nil) and self:_switchReason(player.UserId,nil,now)==nil
    if self.deps.Transfer then data.serverTransfer=self.deps.Transfer:snapshot(player) end
    data.notice=self.notices[player]
    local queue=data.bossQueue
    if queue then
        queue.available=queue.available and self:_queueEligible(player.UserId,nil)
        if queue.offerId then
            local target=self:_offerGroup(player.UserId,queue.offerId,now)
            if target then queue.groupId=target.id; queue.groupName=target.name end
        end
    end
    self.snapshotSeq[player]=(self.snapshotSeq[player] or 0)+1
    data.snapshotSeq=self.snapshotSeq[player];data.serverNow=now
    return data
end

function MatchHub:controlledSlot(userId)
    local group=self.groups[self.routes[userId]]
    if not group or group.controller.faulted then return nil end
    local slot,ok=self:_guard(group,function() return group.controller:controlledSlot(userId) end)
    if ok and slot then return slot,group.world end
end

function MatchHub:step(now,dt)
    self.queue:step(now)
    local function tick(group)
        local controller=group.controller
        if not controller.faulted then
            self:_guard(group,function()
                controller:step(now,dt)
                if controller.current and group.world.updatePresentation then
                    group.world:updatePresentation(controller.current,dt,controller.director.enemies,controller.director)
                end
            end)
        end
    end
    for _,id in ipairs(self.order) do tick(self.groups[id]) end
    for _,group in pairs(self.entryLanes) do
        if group~=true then tick(group) end
    end
end

return MatchHub
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT44">
          <Properties>
            <string name="Name">RunJournal</string>
            <ProtectedString name="Source">-- Bounded private evidence and an allowlisted view of the same server records.
local Journal={}
Journal.__index=Journal
local public={Hit=true,EnemyHit=true,AttackMiss=true,EnemyAttackMiss=true,CommitSpawn=true,
    RelocateToSafety=true,EnemyDeath=true,EnemyClaimed=true,FlyCaught=true,ClubEquipped=true,
    ClubDropped=true,ClubSwingHit=true,EnemyGrabbed=true,EnemyThrown=true,EnemyDropped=true,
    DragonMounted=true,DragonCaptured=true,DragonReleased=true,DragonFireHit=true,
    RunResult=true,GuardianBallPickedUp=true,GuardianBallThrown=true,BossHit=true,BossShielded=true,BossWarning=true,
    LifeStolen=true,StolenLifeRecovered=true,RavenClawPickedUp=true,CampaignGroupStopped=true,
    CampaignGroupRewound=true,CampaignBombDefused=true}
local function finite(v) return type(v)=='number' and v==v and v&gt;-math.huge and v&lt;math.huge end
local function text(v)
    if type(v)~='string' then return nil end
    local length=math.min(#v,160)
    while length&lt;#v and length&gt;0 do
        local byte=string.byte(v,length+1)
        if byte&lt;128 or byte&gt;=192 then break end
        length-=1
    end
    local result=string.sub(v,1,length)
    return utf8.len(result) and result or '[invalid-utf8]'
end
local function copy(v)
    if type(v)~='table' then return v end
    local result={};for k,value in pairs(v) do result[k]=copy(value) end;return result
end
local function sanitize(v,depth,budget,seen)
    local kind=type(v)
    if kind=='string' then return text(v) end
    if kind=='number' then return finite(v) and v or nil end
    if kind=='boolean' then return v end
    if kind~='table' or depth&gt;=3 or seen[v] then return nil end
    seen[v]=true
    local result,count={},0
    for key,value in pairs(v) do
        if count&gt;=16 or budget.count&gt;=64 then break end
        count+=1;budget.count+=1
        if (type(key)=='string' and #key&lt;=48 and utf8.len(key)) or (finite(key) and key&gt;=1 and key&lt;=16 and key%1==0) then
            result[key]=sanitize(value,depth+1,budget,seen)
        end
    end
    seen[v]=nil
    return result
end

function Journal.new(context,capacity)
    capacity=capacity or 256
    assert(finite(capacity) and capacity&gt;=1 and capacity&lt;=256 and capacity%1==0,'Invalid journal capacity')
    assert(type(context)=='table' and text(context.runId) and text(context.groupId),'Journal identity required')
    return setmetatable({context={runId=text(context.runId),groupId=text(context.groupId),
        build=text(context.build) or 'unknown',rules=text(context.rules) or 'unknown'},
        capacity=capacity,rows={},keys={},seen={},next=1,count=0,seq=0,dropped=0,invalid=0,duplicates=0,
        publicRows={},lastNow=0},Journal)
end

function Journal:record(row)
    if type(row)~='table' or type(row.kind)~='string' or #row.kind&gt;48 or not row.kind:match('^[A-Za-z][A-Za-z0-9_]*$')
        or (row.data~=nil and type(row.data)~='table')
        or not finite(row.now) or row.now&lt;0 or (row.runId~=nil and row.runId~=self.context.runId)
        or (row.groupId~=nil and row.groupId~=self.context.groupId) then
        self.invalid+=1;return false,'INVALID_RECORD'
    end
    local data=sanitize(row.data or {},0,{count=0},{}) or {}
    local key=type(data.eventId)=='string' and row.kind..':'..data.eventId or nil
    if key and self.seen[key] then self.duplicates+=1;return false,'DUPLICATE' end
    self.seq+=1
    local event={seq=self.seq,kind=row.kind,now=row.now,late=row.now&lt;self.lastNow,data=data}
    for _,name in ipairs({'levelEpoch','userId','attempt','respawns','rawLife','revision','shieldUntil'}) do
        if finite(row[name]) then event[name]=row[name] end
    end
    event.actorId=text(row.actorId) or text(data.actorId)
    event.shieldKind=text(row.shieldKind);event.status=text(row.status);event.view=text(row.view)
    if type(row.connected)=='boolean' then event.connected=row.connected end
    self.lastNow=math.max(self.lastNow,row.now)
    if self.count==self.capacity then
        self.dropped+=1
        local oldKey=self.keys[self.next];if oldKey then self.seen[oldKey]=nil end
    else self.count+=1 end
    self.rows[self.next]=event;self.keys[self.next]=key
    if key then self.seen[key]=true end
    self.next=self.next%self.capacity+1
    if public[event.kind] and (data.code==nil or data.code=='OK') then
        local item={seq=event.seq,now=event.now,kind=event.kind,slot=event.userId,
            actorId=event.actorId or text(data.actorId),levelEpoch=event.levelEpoch,attempt=event.attempt,
            action=text(data.action),result=text(data.result),target=finite(data.target) and data.target or nil,
            attacker=finite(data.attacker) and data.attacker or nil,blocked=data.blocked==true}
        self.publicRows[#self.publicRows+1]=item
        if #self.publicRows&gt;12 then table.remove(self.publicRows,1) end
    end
    return true
end

function Journal:snapshot()
    local result=copy(self.context)
    result.schema=1;result.latestSeq=self.seq;result.dropped=self.dropped;result.invalid=self.invalid
    result.duplicates=self.duplicates;result.events={}
    local first=self.count&lt;self.capacity and 1 or self.next
    for i=1,self.count do result.events[i]=copy(self.rows[(first+i-2)%self.capacity+1]) end
    return result
end

function Journal:feedback()
    return {latestSeq=self.seq,events=copy(self.publicRows)}
end

return Journal
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT45">
          <Properties>
            <string name="Name">SourceCombat</string>
            <ProtectedString name="Source">-- Source-state action choice. Public controls never carry target, Life or profile.
local SourceCombat={}

function SourceCombat.bind(session,director,config)
    if not config.SourceCombat then return false end
    session.sourceCombat=config.SourceCombat
    session.groundRunAllowed=function(slot)
        if director.carry and director.carry:interaction(slot).carrying then return false end
        if director.guardian and director.guardian:interaction(slot).carrying then return false end
        if director.dragons and director.dragons.heroes[slot] then return false end
        return true
    end
    session.canRunStrike=function(slot)
        return config.Movement~=nil and session.groundRunAllowed(slot) and session.world.isRunning~=nil
            and session.world:isRunning(slot)==true
    end
    session.attackSelector=function(slot,input)
        director.now=session.now
        for _,target in ipairs(session.world:targets(slot,config.Attacks[input])) do
            local enemy=director.enemies[target]
            local hero=session.state.heroes[target]
            local combat=session.combat[target]
            local raw,heavy,kind
            if enemy and enemy.boss and director.selectBossAction then
                local selected=director:selectBossAction(target,input)
                if selected then return selected end
            end
            if enemy and not enemy.boss and not enemy.dead and enemy.rawLife~=nil
                and not (director.carry and director.carry:blocksEnemy(target)) then
                director:_finishReaction(target,enemy)
                raw=enemy.rawLife;heavy=enemy.reactionUntil~=nil and enemy.heavyReaction==true;kind=enemy.kind
            elseif hero and hero.status=='Alive' and combat and not combat.deathAt
                and not (combat.hitProtectedUntil and session.now&lt;combat.hitProtectedUntil) then
                session:_finishReaction(target)
                if combat.hitProtectedUntil and session.now&lt;combat.hitProtectedUntil then continue end
                raw=combat.rawLife;heavy=combat.reactionEnd~=nil and combat.heavyReaction==true
            end
            if raw~=nil then
                if input=='Dash' then return heavy and 'HeroBoot' or 'Dash' end
                if heavy then return raw&lt;8 and 'HeroBoot' or 'HeroKick' end
                if raw&lt;4 then return 'HeroPowerPunch' end
                if raw%16&lt;4 then return kind=='Dragon' and 'HeroElbow' or 'HeroUppercut' end
                return 'HeroJab'
            end
        end
        return input=='Dash' and 'Dash' or 'HeroJab'
    end
    return true
end

return SourceCombat
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT46">
          <Properties>
            <string name="Name">StudioGodMode</string>
            <ProtectedString name="Source">-- The bootstrap supplies IsStudio; neither saved attributes nor clients grant access.
local StudioGodMode={}
function StudioGodMode.attach(config,isStudio,storage)
    local allowed=isStudio==true
    if allowed and storage:GetAttribute('BrickToadsGodMode')==nil then
        storage:SetAttribute('BrickToadsGodMode',true)
    end
    config.Development={allowInfiniteLives=allowed,
        infiniteLives=allowed and storage:GetAttribute('BrickToadsGodMode')==true}
    local policy={}
    function policy:bind(hub)
        if not allowed then return end
        self.connection=storage:GetAttributeChangedSignal('BrickToadsGodMode'):Connect(function()
            local enabled=storage:GetAttribute('BrickToadsGodMode')==true
            config.Development.infiniteLives=enabled
            assert(hub:setInfiniteLives(enabled)=='OK','Cannot apply Studio infinite lives')
        end)
    end
    return policy
end
return StudioGodMode
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT47">
          <Properties>
            <string name="Name">WalkerClubs</string>
            <ProtectedString name="Source">-- One source-backed Walker leg-club per combat death. Geometry/timing/NPC HP are Roblox calibration.
-- Only validated primary intents reach this module; no packet chooses an item, target or damage.
local WalkerClubs={}
WalkerClubs.__index=WalkerClubs
local function finite(n) return type(n)=='number' and n==n and n&gt;-math.huge and n&lt;math.huge end
local function point(p) return type(p)=='table' and finite(p.x) and finite(p.y) and finite(p.z) end
local function copy(p) return {x=p.x,y=p.y,z=p.z} end

function WalkerClubs.new(director)
    return setmetatable({director=director,session=director.session,world=director.world,
        config=director.config.WalkerClub,attack=director.config.Attacks.Club,
        now=director.now or director.session.now,items={},sources={},equipment={},pending={},pendingBySlot={}},WalkerClubs)
end

function WalkerClubs:_active()
    return not self.closed and not self.director.result and self.session.state.status=='Active'
end

function WalkerClubs:_hero(slot,offline)
    if not self:_active() then return nil end
    local h,c=self.session.state.heroes[slot],self.session.combat[slot]
    if not h or h.status~='Alive' or (not offline and not h.connected) or not h.actorId
        or not c or c.deathAt or c.reactionEnd or c.attack or self.world:hazard(slot) then return nil end
    return h,c
end

function WalkerClubs:_log(kind,slot,data)
    self.session:_record(kind,slot,data)
end

function WalkerClubs:walkerDefeated(id,position,cause)
    local e=self.director.enemies[id]
    if not self:_active() or cause~='Combat' or not e or e.kind~='Walker'
        or type(e.actorId)~='string' or self.sources[e.actorId] then return nil end
    local itemId='walker-club:'..e.actorId
    local item={id=itemId,sourceActorId=e.actorId,state='Lost'}
    self.sources[e.actorId]=itemId;self.items[itemId]=item
    local ground=point(position) and self.world:groundPosition(position)
    if not point(ground) then return nil end
    item.state='Ground';item.position=copy(ground)
    self.world:clubItem(itemId,item.position)
    self:_log('WalkerClubCreated',nil,{itemId=itemId,enemyId=id,enemyActorId=e.actorId,position=copy(ground)})
    return itemId
end

function WalkerClubs:_sameOwner(slot,row)
    local h,c=self.session.state.heroes[slot],self.session.combat[slot]
    return h and h.actorId==row.actorId and h.attempt==row.attempt
        and self.session.state.levelEpoch==row.levelEpoch and c==row.combat
end

function WalkerClubs:_sync(slot)
    local row=self.equipment[slot]
    if not row then return nil end
    -- Read the current position only after identity matches: a replacement actor
    -- must never supply a fresh safe drop position for the previous weapon.
    if self:_sameOwner(slot,row) then
        local position=self.world:position(slot)
        if point(position) then row.lastPosition=copy(position) end
        local h,c=self.session.state.heroes[slot],self.session.combat[slot]
        if h.status=='Alive' and not c.deathAt and not self.world:hazard(slot)
            and (c.heavyReactionEpoch or 0)==row.heavyReactionEpoch then return row end
    end
    self:drop(slot,'OwnerChangedOrHeavyReaction')
    return nil
end

function WalkerClubs:hasClub(slot)
    return not self.closed and self:_sync(slot)~=nil
end

function WalkerClubs:_nearest(slot)
    local position=self.world:position(slot)
    if not point(position) then return nil end
    local selected,best=nil,math.huge
    for id,item in pairs(self.items) do
        if item.state=='Ground' and point(item.position)
            and self.world:canPickupClub(slot,item.position,self.config.pickupRange,self.config.pickupHeight) then
            local p=item.position
            local range=(p.x-position.x)^2+(p.y-position.y)^2+(p.z-position.z)^2
            if range&lt;best or (range==best and (not selected or id&lt;selected.id)) then selected,best=item,range end
        end
    end
    return selected
end

function WalkerClubs:interaction(slot)
    self.now=math.max(self.now,self.session.now,self.director.now or 0)
    if not self:_active() then return {available=false,carrying=false,equipped=false} end
    local row=self:_sync(slot)
    if row then
        return {available=self:_hero(slot)~=nil,kind='WalkerClub',label="CLUB HIT",carrying=false,equipped=true}
    end
    return {available=self:_hero(slot)~=nil and self:_nearest(slot)~=nil,
        kind='WalkerClub',label="PICK UP CLUB",carrying=false,equipped=false}
end

function WalkerClubs:_swing(slot,row,now,h,c)
    if self.pendingBySlot[slot] then return 'COOLDOWN' end
    local code=self.session:_event('BeginAttack',slot,{connectionEpoch=h.connectionEpoch})
    if code~='OK' then return code end
    self.world:hold(slot,false)
    local pending={slot=slot,item=row.item,equipment=row,actorId=h.actorId,attempt=h.attempt,
        levelEpoch=self.session.state.levelEpoch,combat=c,reactionEpoch=c.reactionEpoch or 0,
        at=now+self.attack.windup}
    pending.expiresAt=pending.at+self.attack.window
    self.pending[#self.pending+1]=pending;self.pendingBySlot[slot]=pending
    c.nextAttack=math.max(c.nextAttack or 0,now+self.attack.cooldown)
    self.director.now=now
    self.director:closeTargetForAttack(self.world:targets(slot,self.attack))
    self.world:clubSwing(row.item.id,slot)
    self:_log('ClubSwingAccepted',slot,{itemId=row.item.id,sourceEnemyProfile=2,sourceHeroProfile=20})
    return 'OK'
end

function WalkerClubs:interact(slot,now,action)
    if not finite(now) or now&lt;self.now then return 'INVALID_TIME' end
    self.now=now
    if not self:_active() or action~='Punch' then return 'NO_INTERACTION' end
    local row=self:_sync(slot)
    local h,c=self:_hero(slot)
    if not h then return 'NO_INTERACTION' end
    if row then return self:_swing(slot,row,now,h,c) end
    local item=self:_nearest(slot)
    if not item then return 'NO_INTERACTION' end
    local origin=self.world:position(slot)
    if not self.world:equipClub(item.id,slot) then return 'CLUB_EQUIP_FAILED' end
    local x,z=item.position.x-origin.x,item.position.z-origin.z
    if x*x+z*z&gt;0 then self.world:aim(slot,x,z) end
    item.state='Equipped';item.slot=slot
    self.equipment[slot]={item=item,actorId=h.actorId,attempt=h.attempt,levelEpoch=self.session.state.levelEpoch,
        combat=c,heavyReactionEpoch=c.heavyReactionEpoch or 0,lastPosition=copy(self.world:position(slot))}
    self.world:clubItem(item.id,nil)
    self:_log('ClubEquipped',slot,{itemId=item.id})
    return 'OK'
end

function WalkerClubs:drop(slot,reason)
    local row=self.equipment[slot]
    if not row then return false end
    if self:_sameOwner(slot,row) then
        local position=self.world:position(slot)
        if point(position) then row.lastPosition=copy(position) end
    end
    self.equipment[slot]=nil
    local pending=self.pendingBySlot[slot]
    if pending then pending.cancelled=true;self.pendingBySlot[slot]=nil end
    local item=row.item
    self.world:unequipClub(item.id)
    item.slot=nil;item.state='Lost';item.position=nil
    local ground=point(row.lastPosition) and self.world:groundPosition(row.lastPosition)
    if point(ground) then item.state='Ground';item.position=copy(ground);self.world:clubItem(item.id,item.position)
    else self.world:clubItem(item.id,nil) end
    self:_log('ClubDropped',slot,{itemId=item.id,reason=reason,supported=item.state=='Ground',position=item.position})
    return true
end

function WalkerClubs:bossIntro()
    if self.bossIntroduced or self.closed then return end
    self.bossIntroduced=true
    local owners={};for slot in pairs(self.equipment) do owners[#owners+1]=slot end
    table.sort(owners)
    for _,slot in ipairs(owners) do self:drop(slot,'BossIntro') end
end

function WalkerClubs:_resolve(pending)
    local slot=pending.slot
    local h,c=self:_hero(slot,true)
    if pending.cancelled or self.now&gt;pending.expiresAt or not h or h.actorId~=pending.actorId
        or h.attempt~=pending.attempt or self.session.state.levelEpoch~=pending.levelEpoch
        or c~=pending.combat or (c.reactionEpoch or 0)~=pending.reactionEpoch
        or self.equipment[slot]~=pending.equipment or pending.equipment.item~=pending.item then return end
    for _,target in ipairs(self.world:targets(slot,self.attack)) do
        if self.session:_hit(slot,target,'Club') then
            self:_log('ClubSwingHit',slot,{itemId=pending.item.id,target=target});break
        end
    end
end

function WalkerClubs:step(now)
    if not finite(now) or now&lt;self.now then return 'INVALID_TIME' end
    self.now=now
    if self.closed then return 'RUN_CLOSED' end
    if not self:_active() then self:close();return 'RUN_CLOSED' end
    local owners={};for slot in pairs(self.equipment) do owners[#owners+1]=slot end
    table.sort(owners)
    for _,slot in ipairs(owners) do self:_sync(slot) end
    local future={}
    for _,pending in ipairs(self.pending) do
        if pending.cancelled or now&gt;=pending.at then
            if self.pendingBySlot[pending.slot]==pending then self.pendingBySlot[pending.slot]=nil end
            if not pending.cancelled then self:_resolve(pending) end
        else future[#future+1]=pending end
    end
    self.pending=future
    return 'OK'
end

function WalkerClubs:close()
    if self.closed then return end
    self.closed=true;self.pending={};self.pendingBySlot={};self.equipment={}
    for id,item in pairs(self.items) do
        self.world:unequipClub(id);self.world:clubItem(id,nil);item.state='Lost';item.slot=nil;item.position=nil
    end
end

return WalkerClubs
</ProtectedString>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="BT48">
        <Properties>
          <string name="Name">CombatRuntime</string>
        </Properties>
        <Item class="ModuleScript" referent="BT49">
          <Properties>
            <string name="Name">Combat</string>
            <ProtectedString name="Source">-- Source arithmetic is independent from the stand's physical and UI calibration.
local Combat = {}
-- Trusted server actions; public input validation remains in Session.
-- Pig animation40 does not satisfy the hero Dash animation16 finisher condition.
local fixedProfiles = {Punch=18,Club=20,PigJab=18,PigHeavy=20,PigRush=22,WalkerLight=18,WalkerHeavy=20,DragonHeadbutt=22,DragonFire=22,
    HeroJab=18,HeroKick=19,HeroUppercut=20,HeroPowerPunch=21,HeroBoot=24,HeroElbow=28,EnemyRunStrike=22,RopeStrike=25,RopeBoot=31,RopeClaw=25}
local ordinaryProfiles={Punch=0,HeroJab=0,HeroKick=1,HeroUppercut=2,HeroPowerPunch=3,HeroBoot=6,HeroElbow=10,
    Club=2,PigJab=0,PigHeavy=2,PigRush=4,WalkerLight=0,WalkerHeavy=2,DragonHeadbutt=4,DragonFire=4,EnemyThrow=17,EnemyRunStrike=4,RopeStrike=7,RopeBoot=13,RopeClaw=7}
local ordinaryDamage={[0]=2,[1]=8,[2]=16,[3]=255,[4]=16,[6]=255,[7]=8,[10]=8,[13]=16,[17]=4}
local heroDamage={[18]=4,[19]=8,[20]=16,[21]=255,[22]=16,[24]=255,[25]=255,[28]=8,[31]=16}
local function life(value,maximum)
    maximum=maximum or 47
    assert(type(value) == "number" and value == value and value &gt;= 0
        and value &lt;= maximum and value % 1 == 0, "raw Life outside its integer range")
end

function Combat.damage(old, damage)
    life(old,255)
    assert(damage == 2 or damage == 4 or damage == 8 or damage == 16 or damage == 255, "unsupported damage profile")
    if old &lt; damage then return 0, true end
    local result = old - damage
    if math.floor(result / 16) ~= math.floor(old / 16) then
        result = math.floor(result / 16) * 16 + 15
    end
    return result, false
end

function Combat.hit(old, action, shield)
    life(old)
    assert(fixedProfiles[action] ~= nil or action == "Dash", "unsupported action")
    assert(shield == nil or shield == "Normal" or shield == "Emergency", "unsupported shield")
    local profile = fixedProfiles[action] or (old &lt; 16 and 21 or 22)
    local damage = assert(heroDamage[profile],'unsupported hero damage profile')
    local raw, dying = Combat.damage(old, damage)
    if shield then raw, dying = old, false end
    return {
        rawLife=raw, dying=dying, profile=profile, rawDamage=damage,
        impulse=shield ~= "Emergency", blocked=shield ~= nil,
        recover=profile == 18 and not dying and shield == nil,
        heavyReaction=profile ~= 18,
    }
end

function Combat.hitEnemy(old,action,computerControlled)
    life(old,255)
    local profile=ordinaryProfiles[action]
    if action=='Dash' then profile=old&lt;16 and 3 or 4 end
    assert(profile~=nil,'unsupported ordinary-target action')
    local damage=ordinaryDamage[profile]
    if computerControlled then
        -- One life band is 16 units. Even a spaced jab removes half a band.
        damage=math.max(8,damage)
    end
    local raw,dying=Combat.damage(old,damage)
    return {rawLife=raw,dying=dying,profile=profile,rawDamage=damage,
        heavyReaction=profile~=0,recover=not dying}
end

function Combat.captureAttack(config,action,tuning)
    local result=table.clone(tuning or config.Attacks[action])
    local original=config.Attacks[action]
    if result.reaction==nil and original then result.reaction=original.reaction end
    result.deathDelay=config.DeathDelay
    result.sourceCombat=config.SourceCombat and table.clone(config.SourceCombat) or nil
    result.responses={}
    for profile,impulse in pairs(config.Impulses or {}) do
        local response=table.clone(impulse)
        response.profile=profile;result.responses[profile]=response
    end
    return result
end

function Combat.recover(raw)
    life(raw)
    return math.floor(raw / 8) * 8 + 7
end

function Combat.recoverEnemy(raw)
    life(raw,255)
    return math.floor(raw / 8) * 8 + 7
end

function Combat.hearts(raw)
    life(raw)
    return 5 * raw / 47
end

return Combat
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT50">
          <Properties>
            <string name="Name">Session</string>
            <ProtectedString name="Source">-- Synchronous coordinator: World methods must not yield or partially commit a failed spawn.
local Session = {}
Session.__index = Session
local common = {kind=true,runId=true,actorId=true,attempt=true,levelEpoch=true,connectionEpoch=true,seq=true}
local extras = {Attack={attack=true},Move={x=true,z=true,run=true},Jump={}}
local function finite(n) return type(n)=="number" and n==n and n&gt;-math.huge and n&lt;math.huge end
local function integer(n) return finite(n) and n&gt;=1 and n&lt;=1000000000 and n%1==0 end
local function valid(p)
    if type(p)~="table" or not extras[p.kind] then return false end
    local count=0
    for k,v in pairs(p) do
        count=count+1
        if count&gt;(p.kind=='Move' and 10 or 9) or not (common[k] or extras[p.kind][k]) or type(v)=="table" then return false end
    end
    if type(p.runId)~="string" or #p.runId&gt;160 or type(p.actorId)~="string" or #p.actorId&gt;160
        or not integer(p.attempt) or not integer(p.levelEpoch) or not integer(p.connectionEpoch)
        or not integer(p.seq) then return false end
    if p.kind=="Attack" then return p.attack=="Punch" or p.attack=="Dash" end
    if p.kind=="Move" then return finite(p.x) and finite(p.z) and p.x*p.x+p.z*p.z&lt;=1.01
        and (p.run==nil or type(p.run)=='boolean') end
    return true
end

-- The ordinary-enemy controller uses the same untrusted intent schema.
Session.validIntent=valid

function Session.new(Core, Combat, Config, roster, runId, world, logger, context)
    context=context or {}
    local self=setmetatable({Core=Core,Combat=Combat,config=Config,world=world,logger=logger,
        state=Core.new(runId,context.groupId or "combat-stand",roster,context.levelId or "stand-1"),now=0,serial=0,
        order={},combat={},lastSeq={},nextSpawn={},lastMove={},buckets={},logs={}},Session)
    for _,member in ipairs(roster) do
        local uid=member.userId
        self.order[#self.order+1]=uid
        self.combat[uid]={rawLife=47,nextAttack=0}
    end
    return self
end

function Session:_clock(now)
    if not finite(now) or now&lt;0 then return "INVALID_TIME" end
    if now&lt;self.now then return "TIME_REVERSED" end
    self.now=now
    return "OK"
end

function Session:_resetLocomotion(uid)
    if self.config.Movement and self.world.resetLocomotion then
        self.world:resetLocomotion(uid,self.world.actors and self.world.actors[uid])
    end
end

function Session:_record(kind, uid, data, at)
    local h=self.state.heroes[uid]
    local row={kind=kind,userId=uid,now=at or self.now,runId=self.state.runId,groupId=self.state.groupId,
        levelEpoch=self.state.levelEpoch,revision=self.state.revision,
        actorId=h and h.actorId,attempt=h and h.attempt,respawns=h and h.respawns,
        infiniteLives=h and h.infiniteLives==true,
        rawLife=self.combat[uid] and self.combat[uid].rawLife,status=h and h.status,view=h and h.view,
        connected=h and h.connected,shieldKind=h and h.shield and h.shield.kind,
        shieldUntil=h and h.shield and h.shield.deadline,data=data}
    self.logs[#self.logs+1]=row
    if #self.logs&gt;self.config.MaxLogEntries then table.remove(self.logs,1) end
    if self.logger then
        local ok=pcall(self.logger,row)
        if not ok then self.loggerFailures=(self.loggerFailures or 0)+1 end
    end
end

function Session:_event(kind, uid, fields)
    self.serial=self.serial+1
    local h=self.state.heroes[uid]
    local e={id="s-"..self.serial,runId=self.state.runId,expectedRevision=self.state.revision,
        now=self.now,kind=kind,userId=uid}
    if kind=="Death" or kind=="SetHealth" or kind=="BeginAttack" or kind=="ExpireShield"
        or kind=="RelocateToSafety" then
        e.actorId=h.actorId; e.attempt=h.attempt; e.levelEpoch=self.state.levelEpoch
    end
    for k,v in pairs(fields or {}) do e[k]=v end
    local state,code,ack=self.Core.apply(self.state,e)
    self.state=state
    self:_record(kind,uid,{code=code,eventId=e.id})
    return code,ack
end

-- Server-only development control; client intents cannot name this event or option.
function Session:setInfiniteLives(enabled)
    if type(enabled)~="boolean" then return "INVALID_OPTION" end
    if type(self.config.Development)~="table" or self.config.Development.allowInfiniteLives~=true then
        return "DEVELOPMENT_ONLY"
    end
    if self.state.status~="Active" then return "RUN_CLOSED" end
    for _,uid in ipairs(self.order) do
        local h=self.state.heroes[uid]
        if h.status~="Eliminated" and h.infiniteLives~=enabled then
            assert(self:_event("SetInfiniteLives",uid,{enabled=enabled})=="OK")
        end
    end
    return "OK"
end

function Session:_spawn(uid)
    local h=self.state.heroes[uid]
    if not h.connected or self.now&lt;(self.nextSpawn[uid] or 0) then return end
    local point=self.world:findSafe(uid)
    if not point and h.status=="AwaitingInitial" then
        self.nextSpawn[uid]=self.now+self.config.SpawnRetry
        return
    end
    local code=self:_event("ReserveSpawn",uid,{connectionEpoch=h.connectionEpoch})
    if code~="OK" then return end
    local token=self.state.heroes[uid].pending.token
    self.serial=self.serial+1
    local actorId=self.state.runId..":actor:"..self.serial
    local safe=point~=nil
    local ok,spawned=pcall(function()
        if safe and not self.world:isSafe(point,uid) then return false end
        return self.world:spawn(uid,actorId,point,not safe,h.template)
    end)
    if not ok or not spawned then
        self:_event("AbortSpawn",uid,{token=token})
        self.nextSpawn[uid]=self.now+self.config.SpawnRetry
        self:_record("SpawnFailed",uid,{error=ok and "rejected" or tostring(spawned)})
        return
    end
    code=self:_event("CommitSpawn",uid,{token=token,actorId=actorId,safe=safe})
    assert(code=="OK","Synchronous spawn commit violated its reservation: "..code)
    self.combat[uid]={rawLife=47,nextAttack=self.now}
    self.lastSeq[uid]=0; self.lastMove[uid]=nil; self.nextSpawn[uid]=nil
    self:_resetLocomotion(uid)
    self.world:hold(uid,not safe)
end

function Session:_die(uid, reason)
    local h=self.state.heroes[uid]
    if h.status~="Alive" then return end
    if self:_event("Death",uid)~="OK" then return end
    self.combat[uid]={rawLife=0,nextAttack=self.now}
    self.lastMove[uid]=nil
    self:_resetLocomotion(uid)
    self.world:kill(uid)
    self:_record("ConfirmedDeath",uid,{reason=reason,actorId=h.actorId,observed=self.world:observe(uid)})
end

function Session:_finishReaction(uid)
    local c=self.combat[uid]
    if not c or not c.reactionEnd or c.deathAt or self.now&lt;c.reactionEnd then return false end
    if c.recover then
        c.rawLife=self.Combat.recover(c.rawLife)
        assert(self:_event('SetHealth',uid,{health=self.Combat.hearts(c.rawLife)})=='OK')
    elseif self.sourceCombat and c.heavyReaction==true then
        c.hitProtectedUntil=c.reactionEnd+(c.reactionProtectionSeconds or self.sourceCombat.heavyProtection)
    end
    c.reactionEnd=nil;c.recover=nil;c.heavyReaction=nil;c.reactionProtectionSeconds=nil;self.world:setReaction(uid,false)
    return true
end

function Session:connection(uid, connected, now)
    if not self.state.heroes[uid] then return "UNKNOWN_HERO" end
    local code=self:_clock(now); if code~="OK" then return code end
    if type(connected)~="boolean" then return "INVALID_CONNECTION" end
    local h=self.state.heroes[uid]
    code=self:_event("Connection",uid,{connectionEpoch=h.connectionEpoch,connected=connected})
    if code=="OK" then
        self.lastSeq[uid]=0; self.buckets[uid]=nil; self.lastMove[uid]=nil
        self:_resetLocomotion(uid)
        self.world:move(uid,0,0)
    end
    return code
end

-- The controller has authenticated the completed exit and installed the next
-- geometry. Moving a living body is not a spawn and cannot spend a reserve.
function Session:advanceLevel(levelId, now, options)
    options=options or {}
    if self.state.status~='Active' then return 'RUN_CLOSED' end
    if options.prerequisitesMet~=true then return 'EXIT_NOT_READY' end
    if type(levelId)~='string' or #levelId==0 or #levelId&gt;160 then return 'INVALID_LEVEL' end
    if levelId==self.state.levelId then return 'SAME_LEVEL' end
    local code=self:_clock(now);if code~='OK' then return code end
    local source,points
    points={}
    for _,uid in ipairs(self.order) do
        local hero=self.state.heroes[uid]
        if hero.status=='Alive' then
            if not self.combat[uid].deathAt then source=source or uid end
            local point=self.world:findSafe(uid)
            if not point or not self.world:isSafe(point,uid) then return 'UNSAFE_DESTINATION' end
            points[uid]=point
        end
    end
    if not source then return 'NO_SURVIVOR' end
    local hero=self.state.heroes[source]
    code=self:_event('AdvanceLevel',source,{actorId=hero.actorId,attempt=hero.attempt,
        levelEpoch=self.state.levelEpoch,levelId=levelId,destinationSafe=true,prerequisitesMet=true})
    if code~='OK' then return code end
    self.lastSeq={};self.lastMove={};self.buckets={};self.nextSpawn={}
    for _,uid in ipairs(self.order) do
        local member=self.state.heroes[uid]
        self.lastSeq[uid]=0
        if member.status=='Alive' then
            assert(self.world:relocate(uid,points[uid])==true,'Synchronous level relocation failed')
            local previous=self.combat[uid]
            if previous.deathAt then
                -- A different survivor can finish while this accepted lethal
                -- reaction is still playing. Preserve its original deadline.
                previous.attack=nil;previous.nextAttack=now
                assert(self:_event('SetHealth',uid,{health=self.Combat.hearts(previous.rawLife)})=='OK')
            else
                self.combat[uid]={rawLife=47,nextAttack=now}
                self.world:setReaction(uid,false)
            end
        else
            -- Awaiting respawns retain their pending resource obligation; an
            -- eliminated owner never receives a body at a level boundary.
            self.combat[uid]={rawLife=0,nextAttack=now}
        end
        self:_resetLocomotion(uid)
    end
    if self.world.finishLevelTransition then self.world:finishLevelTransition() end
    self:_record('LevelAdvanced',source,{levelId=levelId})
    return 'OK'
end

function Session:intent(uid, p, now)
    local h=self.state.heroes[uid]
    if not h then return "UNKNOWN_HERO" end
    if not valid(p) then return "INVALID_INTENT" end
    if p.runId~=self.state.runId then return "WRONG_RUN" end
    if self.state.status~="Active" then return "RUN_CLOSED" end
    if not h.connected then return "OFFLINE" end
    if h.status~="Alive" then return "NOT_ALIVE" end
    if p.actorId~=h.actorId or p.attempt~=h.attempt or p.levelEpoch~=self.state.levelEpoch then return "STALE_ACTOR" end
    if p.connectionEpoch~=h.connectionEpoch then return "STALE_CONNECTION" end
    if p.seq&lt;=(self.lastSeq[uid] or 0) then return "STALE_SEQUENCE" end
    local code=self:_clock(now); if code~="OK" then return code end
    local b=self.buckets[uid] or {tokens=self.config.MaxIntentRate,last=now}
    b.tokens=math.min(self.config.MaxIntentRate,b.tokens+(now-b.last)*self.config.MaxIntentRate)
    b.last=now; self.buckets[uid]=b
    self.lastSeq[uid]=p.seq
    if b.tokens&lt;1 then return "RATE_LIMIT" end
    b.tokens=b.tokens-1
    local c=self.combat[uid]
    if self.sourceCombat then self:_finishReaction(uid) end
    if self.contextualIntent then
        local result=self.contextualIntent(uid,p,now)
        if result~='NO_INTERACTION' then return result end
    end
    if c.reactionEnd or c.deathAt then return "REACTION" end
    if p.kind=="Move" then
        self.lastMove[uid]=now
        local run=p.run
        if self.groundRunAllowed and not self.groundRunAllowed(uid) then run=false end
        self.world:move(uid,p.x,p.z,run)
    elseif p.kind=="Jump" then
        self.world:jump(uid)
    else
        if now&lt;c.nextAttack or c.attack then return "COOLDOWN" end
        local running=self.config.Movement and (self.canRunStrike and self.canRunStrike(uid)
            or (not self.canRunStrike and self.world.isRunning and self.world:isRunning(uid)))==true
        if not running and self.contextualAttack then
            local interaction=self.contextualAttack(uid,now,p.attack)
            if interaction~='NO_INTERACTION' then
                if interaction=='OK' then
                    self:_resetLocomotion(uid)
                    c.nextAttack=math.max(c.nextAttack,now+self.config.Attacks[p.attack].cooldown)
                    self:_record('InteractionAccepted',uid,{action=p.attack,seq=p.seq})
                end
                return interaction
            end
        end
        if self.config.Movement and p.attack=='Dash' and not running then return 'NOT_RUNNING' end
        code=self:_event("BeginAttack",uid,{connectionEpoch=h.connectionEpoch})
        if code~="OK" then return code end
        self.world:hold(uid,false)
        local input=running and 'Dash' or p.attack
        local action=self.attackSelector and self.attackSelector(uid,input) or input
        local cfg=self.config.Attacks[action]
        assert(cfg,'Unknown trusted action')
        c.nextAttack=now+cfg.cooldown
        c.attack={action=action,inputAction=p.attack,tuning=self.Combat.captureAttack(self.config,action,cfg),actorId=h.actorId,at=now+cfg.windup,
            untilTime=now+cfg.windup+cfg.window,order=self.serial}
        if running then self.world:move(uid,0,0,false);self.lastMove[uid]=nil end
        self:_record("AttackAccepted",uid,{action=action,inputAction=p.attack,seq=p.seq})
    end
    return "OK"
end

-- Invader health-bar links are trusted server objects, not public attack inputs.
-- The source subtracts/adds eight directly; returning at &gt;= $30 consumes the
-- object without changing Life. Tokens are bound to this exact hero body.
-- main5713-5715 masks Life with $38; main5635-5648 skips subtraction when
-- that result is below7. Thus raw0..7 do not enter SBC8 (main5656-5659).
function Session:_stealLife(attacker,target)
    local h,c=self.state.heroes[target],self.combat[target]
    if self.state.status~='Active' or not h or h.status~='Alive' or not c or c.deathAt
        or not h.actorId or c.rawLife&lt;8 or c.rawLife&gt;47
        or h.shield and self.now&lt;h.shield.deadline
        or c.hitProtectedUntil and self.now&lt;c.hitProtectedUntil then return nil end
    local before=c.rawLife;local after=before-8
    if self:_event('SetHealth',target,{health=self.Combat.hearts(after)})~='OK' then return nil end
    c.rawLife=after
    local token={slot=target,combat=c,actorId=h.actorId,attempt=h.attempt,runId=self.state.runId,levelEpoch=self.state.levelEpoch}
    self.stolenLifeTokens=self.stolenLifeTokens or {};self.stolenLifeTokens[token]=true
    self:_record('LifeStolen',target,{attacker=attacker,before=before,after=after})
    return token
end
function Session:_discardStolenLife(token)
    if self.stolenLifeTokens then self.stolenLifeTokens[token]=nil end
end
function Session:_recoverStolenLife(token)
    if not self.stolenLifeTokens or not self.stolenLifeTokens[token] then return false end
    self.stolenLifeTokens[token]=nil
    local h,c=self.state.heroes[token.slot],self.combat[token.slot]
    if self.state.status~='Active' or self.state.runId~=token.runId or self.state.levelEpoch~=token.levelEpoch
        or not h or h.status~='Alive' or h.actorId~=token.actorId or h.attempt~=token.attempt
        or c~=token.combat or c.deathAt or c.rawLife+8&gt;=48 then return false end
    local before=c.rawLife;local after=before+8
    if self:_event('SetHealth',token.slot,{health=self.Combat.hearts(after)})~='OK' then return false end
    c.rawLife=after;self:_record('StolenLifeRecovered',token.slot,{before=before,after=after})
    return true
end

function Session:_hit(attacker, target, action, tuning)
    local h=self.state.heroes[target]
    local c=self.combat[target]
    if not h or target==attacker or h.status~="Alive" or c.deathAt then return false end
    if self.sourceCombat then self:_finishReaction(target) end
    if c.reactionEnd and not self.sourceCombat then return false end
    if self.sourceCombat and c.hitProtectedUntil and self.now&lt;c.hitProtectedUntil then return false end
    local shield=h.shield and self.now&lt;h.shield.deadline and h.shield.kind or nil
    local before=c.rawLife
    local result=self.Combat.hit(before,action,shield)
    local cfg=tuning or self.config.Attacks[action]
    if not result.blocked then
        local code=self:_event("SetHealth",target,{health=self.Combat.hearts(result.rawLife)})
        if code~="OK" then return false end
        c.rawLife=result.rawLife
    end
    if result.impulse then
        if self.beforeHitImpulse then self.beforeHitImpulse(target) end
        self:_resetLocomotion(target)
        -- Pending contextual actions must still see an interrupt after recovery
        -- has cleared reactionEnd during a later (possibly long) server step.
        c.reactionEpoch=(c.reactionEpoch or 0)+1
        if result.heavyReaction then c.heavyReactionEpoch=(c.heavyReactionEpoch or 0)+1 end
        c.attack=nil
        c.recover=result.recover
        c.heavyReaction=result.heavyReaction
        local policy=cfg.sourceCombat or self.sourceCombat
        c.reactionProtectionSeconds=policy and policy.heavyProtection or nil
        c.reactionEnd=self.now+cfg.reaction
        c.deathAt=result.dying and self.now+(cfg.deathDelay or self.config.DeathDelay) or nil
        self.world:move(target,0,0)
        self.world:setReaction(target,true)
        local impulse=cfg.responses and cfg.responses[result.profile] or self.config.Impulses[result.profile]
        self.world:impulse(target,attacker,impulse,result.profile,cfg.impulseDirection)
    end
    self:_record("Hit",target,{attacker=attacker,action=action,profile=result.profile,
        before=before,after=c.rawLife,blocked=result.blocked,impulse=result.impulse,
        dying=result.dying,observed=self.world:observe(target)})
    return true
end

function Session:step(now)
    local code=self:_clock(now); if code~="OK" then return code end
    if self.state.status~="Active" then return "RUN_CLOSED" end
    -- Previous-frame deaths spawn here; a new death cannot respawn twice in this step.
    for _,uid in ipairs(self.order) do
        local h=self.state.heroes[uid]
        if h.status=="AwaitingInitial" or h.status=="AwaitingRespawn" then self:_spawn(uid) end
    end
    for _,uid in ipairs(self.order) do
        local h=self.state.heroes[uid]
        if h.status=="Alive" and h.shield then
            if h.shield.kind=="Emergency" then
                local point=self.world:findSafe(uid)
                if point and self.world:isSafe(point,uid) and self.world:relocate(uid,point) then
                    assert(self:_event("RelocateToSafety",uid,{safe=true})=="OK")
                    self.world:hold(uid,false)
                end
            end
            h=self.state.heroes[uid]
            if h.shield and now&gt;=h.shield.deadline then
                assert(self:_event("ExpireShield",uid)=="OK")
                self.world:hold(uid,false)
                if self.state.heroes[uid].retryReady then self:_spawn(uid) end
            end
        elseif h.status=="Alive" and h.retryReady then
            self:_spawn(uid)
        end
        local c=self.combat[uid]
        if self.state.heroes[uid].status=="Alive" then
            if c.deathAt and now&gt;=c.deathAt then
                self:_die(uid,"CombatUnderflow")
            elseif c.reactionEnd and not c.deathAt and now&gt;=c.reactionEnd then
                self:_finishReaction(uid)
            end
        end
    end
    local due={}
    for _,uid in ipairs(self.order) do
        local a=self.combat[uid].attack
        if a and now&gt;=a.at then due[#due+1]={uid=uid,attack=a} end
    end
    table.sort(due,function(a,b)
        if a.attack.at~=b.attack.at then return a.attack.at&lt;b.attack.at end
        return a.attack.order&lt;b.attack.order
    end)
    for _,entry in ipairs(due) do
        local uid,a=entry.uid,entry.attack
        local h=self.state.heroes[uid]
        if self.combat[uid].attack==a then
            self.combat[uid].attack=nil
            if h.status=="Alive" and h.actorId==a.actorId and now&lt;=a.untilTime then
                self.combat[uid].lastStrikeAction=a.action
                self.combat[uid].strikeRecoveryUntil=now+((a.tuning and a.tuning.recoveryPose) or .17)
                local landed=false
                for _,target in ipairs(self.world:targets(uid,a.tuning or self.config.Attacks[a.action])) do
                    if self:_hit(uid,target,a.action,a.tuning) then landed=true;break end
                end
                if not landed then self:_record('AttackMiss',uid,{action=a.action}) end
            else self:_record("AttackExpired",uid,{action=a.action}) end
        end
    end
    for _,uid in ipairs(self.order) do
        local h=self.state.heroes[uid]
        if h.status=="Alive" then
            if self.lastMove[uid] and now-self.lastMove[uid]&gt;=self.config.MoveTimeout then
                self.world:move(uid,0,0,false); self.lastMove[uid]=nil
            end
            local reason=self.world:hazard(uid)
            local held=h.shield and h.shield.kind=="Emergency" and now&lt;h.shield.deadline
            if reason and (not held or reason=="ActorMissing") then self:_die(uid,reason) end
        end
    end
    return "OK"
end

function Session:snapshot()
    local heroes={}
    local infiniteLives=false
    for _,uid in ipairs(self.order) do
        local h=self.state.heroes[uid]
        local c=self.combat[uid]
        if h.infiniteLives==true and h.status~="Eliminated" then infiniteLives=true end
        heroes[#heroes+1]={slot=uid,actorId=h.actorId,attempt=h.attempt,
            connectionEpoch=h.connectionEpoch,connected=h.connected,status=h.status,view=h.view,
            hearts=self.Combat.hearts(c.rawLife),rawLife=c.rawLife,respawns=h.respawns,
            infiniteLives=h.infiniteLives==true,
            shield=h.shield and h.shield.kind,shieldUntil=h.shield and h.shield.deadline,
            dying=c.deathAt~=nil,reactionEpoch=c.reactionEpoch or 0,
            movementMode=self.world.movementMode and self.world:movementMode(uid) or nil}
    end
    return {runId=self.state.runId,levelEpoch=self.state.levelEpoch,status=self.state.status,
        now=self.now,heroes=heroes,infiniteLives=infiniteLives,calibration=self.config.Calibration}
end

return Session
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT51">
          <Properties>
            <string name="Name">Config</string>
            <ProtectedString name="Source">-- All spatial/timing values below are stand calibration, not measured NES units.
return {
    Calibration = "EXPERIMENTAL_STAND_ONLY",
    WalkSpeed = 16,
    JumpPower = 42,
    MoveTimeout = 0.35,
    SpawnRetry = 0.5,
    DeathDelay = 0.8,
    FallY = -35,
    MaxIntentRate = 40,
    SnapshotInterval = 0.1,
    MaxLogEntries = 256,
    Impulses = {
        [18] = {horizontal=9, vertical=0},
        [21] = {horizontal=34, vertical=27},
        [22] = {horizontal=32, vertical=18},
    },
    Attacks = {
        Punch = {windup=0.10, window=0.12, cooldown=0.55, reaction=28/60,
            reach=6, width=3, height=4},
        Dash = {windup=0.18, window=0.14, cooldown=1.0, reaction=0.75,
            reach=8, width=3, height=4},
    },
}
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT52">
          <Properties>
            <string name="Name">ConnectionRegistry</string>
            <ProtectedString name="Source">-- Authority belongs to the current Player object, not merely its UserId.
local Registry = {}
Registry.__index = Registry

function Registry.new()
    return setmetatable({
        -- Tombstones prevent repeated add/remove events reviving an old object.
        -- Values contain no Player reference; departed objects can be collected.
        _seen = setmetatable({}, {__mode = "k"}),
        _current = {},
        _serial = 0,
    }, Registry)
end

function Registry:join(player)
    if self._seen[player] then return false, nil end
    local userId = player.UserId
    assert(userId ~= nil, "Connection requires Player.UserId")
    local previous = self._current[userId]
    if previous then self._seen[previous].active = false end
    self._serial = self._serial + 1
    self._seen[player] = {userId = userId, arrival = self._serial, active = true}
    self._current[userId] = player
    return true, previous
end

function Registry:isCurrent(player)
    local entry = self._seen[player]
    return entry ~= nil and entry.active and rawequal(self._current[entry.userId], player)
end

function Registry:remove(player)
    if not self:isCurrent(player) then return false end
    local entry = self._seen[player]
    entry.active = false
    self._current[entry.userId] = nil
    return true
end

function Registry:online(players)
    local result, included = {}, {}
    for _, player in ipairs(players) do
        if self:isCurrent(player) and not included[player] then
            included[player] = true
            result[#result + 1] = player
        end
    end
    table.sort(result, function(a, b)
        return self._seen[a].arrival &lt; self._seen[b].arrival
    end)
    return result
end

return Registry
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT53">
          <Properties>
            <string name="Name">RobloxWorld</string>
            <ProtectedString name="Source">-- Original stand geometry and server-owned physical bodies. No ROM assets or client positions.
local World = {}
World.__index = World
local Workspace = game:GetService("Workspace")
local function part(parent, name, size, frame, color, anchored)
    local p=Instance.new("Part")
    p.Name=name; p.Size=size; p.CFrame=frame; p.Anchored=anchored
    p.Color=color; p.Material=Enum.Material.SmoothPlastic
    p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
    p.Parent=parent
    return p
end
local function joint(parent, name, a, b, c0, c1)
    local m=Instance.new("Motor6D")
    m.Name=name; m.Part0=a; m.Part1=b; m.C0=c0; m.C1=c1; m.Parent=parent
end
local function own(root)
    if not root.Anchored then
        local allowed,reason=root:CanSetNetworkOwnership()
        assert(allowed,reason or "Cannot assign server ownership")
        root:SetNetworkOwner(nil)
    end
end
local function body(actorId, position, color, displayName)
    local model=Instance.new("Model"); model.Name="Actor_"..actorId
    local root=part(model,"HumanoidRootPart",Vector3.new(2,2,1),CFrame.new(),color,true)
    root.Transparency=1; root.CanCollide=false; root.RootPriority=127
    local torso=part(model,"Torso",Vector3.new(2,2,1),CFrame.new(),color,false)
    local head=part(model,"Head",Vector3.new(2,1,1),CFrame.new(0,1.5,0),color,false)
    local la=part(model,"Left Arm",Vector3.new(1,2,1),CFrame.new(-1.5,0,0),color,false)
    local ra=part(model,"Right Arm",Vector3.new(1,2,1),CFrame.new(1.5,0,0),color,false)
    local ll=part(model,"Left Leg",Vector3.new(1,2,1),CFrame.new(-0.5,-2,0),color,false)
    local rl=part(model,"Right Leg",Vector3.new(1,2,1),CFrame.new(0.5,-2,0),color,false)
    for _,limb in ipairs({la,ra,ll,rl}) do limb.CanCollide=false end
    joint(root,"RootJoint",root,torso,CFrame.new(),CFrame.new())
    joint(torso,"Neck",torso,head,CFrame.new(0,1,0),CFrame.new(0,-0.5,0))
    joint(torso,"Left Shoulder",torso,la,CFrame.new(-1,0.5,0),CFrame.new(0.5,0.5,0))
    joint(torso,"Right Shoulder",torso,ra,CFrame.new(1,0.5,0),CFrame.new(-0.5,0.5,0))
    joint(torso,"Left Hip",torso,ll,CFrame.new(-0.5,-1,0),CFrame.new(0,1,0))
    joint(torso,"Right Hip",torso,rl,CFrame.new(0.5,-1,0),CFrame.new(0,1,0))
    for _,x in ipairs({-0.55,0.55}) do
        local eye=part(model,"Eye",Vector3.new(0.35,0.35,0.25),CFrame.new(x,1.75,-0.58),Color3.new(1,1,0.8),false)
        eye.CanCollide=false; eye.Massless=true
        local weld=Instance.new("WeldConstraint"); weld.Part0=head; weld.Part1=eye; weld.Parent=eye
    end
    local humanoid=Instance.new("Humanoid")
    humanoid.Name="Humanoid"; humanoid.DisplayName=displayName
    humanoid.BreakJointsOnDeath=false; humanoid.MaxHealth=100; humanoid.Health=100
    humanoid.HealthDisplayType=Enum.HumanoidHealthDisplayType.AlwaysOff
    humanoid.HipHeight=0; humanoid.UseJumpPower=true; humanoid.Parent=model
    model.PrimaryPart=root
    model:PivotTo(CFrame.lookAt(position,position+Vector3.new(1,0,0)))
    model:SetAttribute("ActorId",actorId)
    return {model=model,root=root,humanoid=humanoid,cue=0}
end

function World.new(config)
    local folder=Instance.new("Folder"); folder.Name="CombatStandWorld"; folder.Parent=Workspace
    local geometry=Instance.new("Folder"); geometry.Name="Geometry"; geometry.Parent=folder
    local actors=Instance.new("Folder"); actors.Name="Actors"; actors.Parent=folder
    local self=setmetatable({config=config,folder=folder,geometry=geometry,actorFolder=actors,
        actors={},origins={},lastSupport={},deathReason={},names={},floors={},blocked=false},World)
    local floor=part(geometry,"MainPlatform",Vector3.new(72,2,36),CFrame.new(0,-1,0),Color3.fromRGB(64,83,99),true)
    floor:SetAttribute("SurfaceId","Main"); self.floors[#self.floors+1]=floor
    local island=part(geometry,"Island",Vector3.new(16,2,16),CFrame.new(56,-1,0),Color3.fromRGB(73,98,112),true)
    island:SetAttribute("SurfaceId","Island"); self.floors[#self.floors+1]=island
    part(geometry,"PhysicalWall",Vector3.new(2,7,36),CFrame.new(-35,3.5,0),Color3.fromRGB(114,128,140),true)
    self.danger=part(geometry,"DangerSurface",Vector3.new(10,0.2,6),CFrame.new(-8,0.1,12),Color3.fromRGB(220,85,70),true)
    self.danger:SetAttribute("Hazard",true); self.danger:SetAttribute("SurfaceId","Main")
    local ray=RaycastParams.new(); ray.FilterType=Enum.RaycastFilterType.Include
    ray.FilterDescendantsInstances={geometry}; ray.RespectCanCollide=true; self.ray=ray
    local overlap=OverlapParams.new(); overlap.FilterType=Enum.RaycastFilterType.Include
    overlap.FilterDescendantsInstances={geometry,actors}; overlap.RespectCanCollide=true; self.overlap=overlap
    return self
end

function World:isSafe(point, uid)
    if self.blocked or not point or not point.surface or not point.surface.Parent or not point.surface.CanCollide then return false end
    local p=point.position
    for _,offset in ipairs({Vector3.new(),Vector3.new(-1.9,0,-0.9),Vector3.new(-1.9,0,0.9),
        Vector3.new(1.9,0,-0.9),Vector3.new(1.9,0,0.9)}) do
        local hit=Workspace:Raycast(p+offset+Vector3.new(0,1,0),Vector3.new(0,-6,0),self.ray)
        if not hit or hit.Instance~=point.surface or hit.Normal.Y&lt;0.95 or hit.Instance:GetAttribute("Hazard") then return false end
    end
    local actor=self.actors[uid]
    for _,p2 in ipairs(Workspace:GetPartBoundsInBox(CFrame.new(p),Vector3.new(4.1,5.8,2.1),self.overlap)) do
        if p2.CanCollide and not (actor and p2:IsDescendantOf(actor.model)) then return false end
    end
    return true
end

function World:findSafe(uid)
    if self.blocked then return nil end
    local actor=self.actors[uid]
    local origin=actor and actor.root.Parent and actor.root.Position or self.origins[uid] or Vector3.new(-18+uid*6,3,0)
    local points={}
    for _,floor in ipairs(self.floors) do
        local same=self.deathReason[uid]=="Fall" or not self.lastSupport[uid]
            or floor:GetAttribute("SurfaceId")==self.lastSupport[uid]
        if floor.CanCollide and same then
            local minX,maxX=floor.Position.X-floor.Size.X/2+2.2,floor.Position.X+floor.Size.X/2-2.2
            local minZ,maxZ=floor.Position.Z-floor.Size.Z/2+1.2,floor.Position.Z+floor.Size.Z/2-1.2
            -- An upright body cannot fit on a support smaller than its safe footprint.
            if minX&lt;=maxX and minZ&lt;=maxZ then
                local y=floor.Position.Y+floor.Size.Y/2+3
                local function add(x,z) points[#points+1]={position=Vector3.new(x,y,z),surface=floor} end
                add(math.clamp(origin.X,minX,maxX),math.clamp(origin.Z,minZ,maxZ))
                for x=minX,maxX,4.5 do for z=minZ,maxZ,3 do add(x,z) end end
            end
        end
    end
    table.sort(points,function(a,b)
        local da=(a.position-origin).Magnitude; local db=(b.position-origin).Magnitude
        if da~=db then return da&lt;db end
        if a.position.X~=b.position.X then return a.position.X&lt;b.position.X end
        return a.position.Z&lt;b.position.Z
    end)
    for _,point in ipairs(points) do if self:isSafe(point,uid) then return point end end
    return nil
end

function World:spawn(uid, actorId, point, held, template)
    if point and not self:isSafe(point,uid) then return false end
    local origin=self.origins[uid] or Vector3.new(-18+uid*6,3,0)
    local position=point and point.position or Vector3.new(origin.X,3,origin.Z)
    local colors={["Mr. Green"]=Color3.fromRGB(81,160,88),["Mr. Yellow"]=Color3.fromRGB(201,179,64),["Mr. Brown"]=Color3.fromRGB(144,108,76)}
    local prepared
    local ok,err=pcall(function()
        prepared=body(actorId,position,colors[template],self.names[uid] or ("P"..uid))
        prepared.model:SetAttribute("Slot",uid)
        prepared.humanoid.WalkSpeed=self.config.WalkSpeed; prepared.humanoid.JumpPower=self.config.JumpPower
        prepared.model.Parent=self.actorFolder
        prepared.root.Anchored=held
        own(prepared.root)
    end)
    if not ok then
        if prepared then prepared.model:Destroy() end
        warn("[BT-STAND] physical spawn failed: "..tostring(err))
        return false
    end
    local old=self.actors[uid]
    self.actors[uid]=prepared; self.origins[uid]=position
    if not held then self.deathReason[uid]=nil end
    if old then old.model:Destroy() end
    return true
end

function World:hold(uid, held)
    local a=self.actors[uid]; if not a or not a.root.Parent then return end
    a.root.Anchored=held
    if held then
        a.root.AssemblyLinearVelocity=Vector3.new(); a.root.AssemblyAngularVelocity=Vector3.new()
        a.humanoid:Move(Vector3.new(),false)
    else own(a.root) end
end
function World:move(uid, x, z)
    local a=self.actors[uid]
    if a and a.humanoid.Health&gt;0 and not a.root.Anchored and not a.humanoid.PlatformStand then
        a.humanoid:Move(Vector3.new(x,0,z),false)
    end
end
function World:jump(uid)
    local a=self.actors[uid]
    if a and a.humanoid.Health&gt;0 and not a.root.Anchored and not a.humanoid.PlatformStand
        and a.humanoid.FloorMaterial~=Enum.Material.Air then a.humanoid.Jump=true end
end
function World:setReaction(uid, active)
    local a=self.actors[uid]; if not a then return end
    a.humanoid.PlatformStand=active
    a.humanoid.AutoRotate=not active
    a.humanoid.WalkSpeed=active and 0 or self.config.WalkSpeed
end
function World:targets(uid, cfg)
    local a=self.actors[uid]; if not a then return {} end
    local candidates={}
    for id,b in pairs(self.actors) do
        if id~=uid and b.root.Parent and b.humanoid.Health&gt;0 then
            local localP=a.root.CFrame:PointToObjectSpace(b.root.Position)
            local delta=b.root.Position-a.root.Position
            if -localP.Z&gt;=0 and -localP.Z&lt;=cfg.reach and math.abs(localP.X)&lt;=cfg.width and math.abs(localP.Y)&lt;=cfg.height then
                local blocker=Workspace:Raycast(a.root.Position,delta,self.ray)
                if not blocker then candidates[#candidates+1]={id=id,distance=delta.Magnitude} end
            end
        end
    end
    table.sort(candidates,function(a2,b2)
        if a2.distance~=b2.distance then return a2.distance&lt;b2.distance end
        return a2.id&lt;b2.id
    end)
    local result={}; for _,candidate in ipairs(candidates) do result[#result+1]=candidate.id end
    return result
end
function World:impulse(uid, attacker, cfg, profile, impulseDirection)
    assert((self.config.Impulses and self.config.Impulses[profile]==cfg) or (cfg and cfg.profile==profile),"Unbound response profile")
    local a=self.actors[uid]
    if not a or a.root.Anchored then return end
    local horizontal
    if type(impulseDirection)=='table' then
        local x,z=impulseDirection.x,impulseDirection.z
        if type(x)=='number' and x==x and math.abs(x)&lt;math.huge
            and type(z)=='number' and z==z and math.abs(z)&lt;math.huge then
            local scale=math.max(math.abs(x),math.abs(z))
            if scale&gt;0 then horizontal=Vector3.new(x/scale,0,z/scale).Unit end
        end
    end
    if not horizontal then
        local b=self.actors[attacker]
        if not b then return end
        local facing=b.root.CFrame.LookVector
        horizontal=Vector3.new(facing.X,0,facing.Z)
        if horizontal.Magnitude&lt;0.001 then horizontal=Vector3.new(1,0,0) else horizontal=horizontal.Unit end
    end
    a.root:ApplyImpulse((horizontal*cfg.horizontal+Vector3.new(0,cfg.vertical,0))*a.root.AssemblyMass)
end
function World:hazard(uid)
    local a=self.actors[uid]
    if not a or not a.root.Parent then return "ActorMissing" end
    if a.humanoid.Health&lt;=0 then return "EngineDeath" end
    local p=a.root.Position
    if p.Y&lt;self.config.FallY then self.deathReason[uid]="Fall"; return "Fall" end
    for _,offset in ipairs({Vector3.new(),Vector3.new(-0.7,0,-0.35),Vector3.new(0.7,0,0.35)}) do
        local hit=Workspace:Raycast(p+offset,Vector3.new(0,-3.4,0),self.ray)
        if hit then
            self.lastSupport[uid]=hit.Instance:GetAttribute("SurfaceId") or self.lastSupport[uid]
            if hit.Instance:GetAttribute("Hazard") then self.deathReason[uid]="Surface"; return "Surface" end
        end
    end
    return nil
end
function World:kill(uid)
    local a=self.actors[uid]; if not a then return end
    self.origins[uid]=a.root.Position
    a.root.Anchored=false; a.humanoid.Health=0
    for _,p in ipairs(a.model:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide=false end end
end
function World:relocate(uid, point)
    if not self:isSafe(point,uid) then return false end
    local a=self.actors[uid]
    a.model:PivotTo(CFrame.lookAt(point.position,point.position+Vector3.new(1,0,0)))
    a.root.AssemblyLinearVelocity=Vector3.new(); a.root.AssemblyAngularVelocity=Vector3.new()
    self.origins[uid]=point.position; self.deathReason[uid]=nil
    return true
end
function World:observe(uid)
    local a=self.actors[uid]; if not a or not a.root.Parent then return {} end
    local p,v=a.root.Position,a.root.AssemblyLinearVelocity
    return {position={p.X,p.Y,p.Z},velocity={v.X,v.Y,v.Z},held=a.root.Anchored}
end
function World:cue(uid, blocked)
    local a=self.actors[uid]; if not a then return end
    a.cue=a.cue+1; local token=a.cue
    local h=a.model:FindFirstChild("Feedback") or Instance.new("Highlight")
    h.Name="Feedback"; h.FillTransparency=0.35; h.OutlineTransparency=0
    h.FillColor=blocked and Color3.fromRGB(90,175,255) or Color3.fromRGB(255,170,70)
    h.Parent=a.model
    task.delay(0.18,function() if self.actors[uid]==a and a.cue==token then h:Destroy() end end)
end
function World:noSafe(enabled)
    self.blocked=enabled
    for _,floor in ipairs(self.floors) do floor.CanCollide=not enabled end
    self.danger.CanCollide=not enabled
end
function World:pose(uid, x, y, z, yaw)
    local a=assert(self.actors[uid],"No actor")
    a.model:PivotTo(CFrame.new(x,y,z)*CFrame.Angles(0,math.rad(yaw),0))
    a.root.AssemblyLinearVelocity=Vector3.new(); a.root.AssemblyAngularVelocity=Vector3.new()
end
function World:clearActors()
    for _,a in pairs(self.actors) do a.model:Destroy() end
    self.actors={}; self.origins={}; self.lastSupport={}; self.deathReason={}
    self:noSafe(false)
end
return World
</ProtectedString>
