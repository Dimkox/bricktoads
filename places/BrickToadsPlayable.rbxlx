    {Key="LEFT/RIGHT: swim · UP/DOWN: dive or rise",Source="LEFT/RIGHT: swim · UP/DOWN: dive or rise",Values={ ["en-us"]="LEFT/RIGHT: swim · UP/DOWN: dive or rise",["ru"]="ВЛЕВО/ВПРАВО: плыть · ВВЕРХ/ВНИЗ: глубина"}},
    {Key="MOVE: steer · JUMP: flap upward",Source="MOVE: steer · JUMP: flap upward",Values={ ["en-us"]="MOVE: steer · JUMP: flap upward",["ru"]="ДВИЖЕНИЕ: управление · ПРЫЖОК: взмах вверх"}},
    {Key="FLAP",Source="FLAP",Values={ ["en-us"]="FLAP",["ru"]="ВЗМАХ"}},
    {Key="FLAP · SPACE",Source="FLAP · SPACE",Values={ ["en-us"]="FLAP · SPACE",["ru"]="ВЗМАХ · ПРОБЕЛ"}},
    {Key="Rope kick",Source="Rope kick",Values={ ["en-us"]="Rope kick",["ru"]="Удар на тросе"}},
    {Key="Board surf",Source="Board surf",Values={ ["en-us"]="Board surf",["ru"]="Сесть на доску"}},
    {Key="Defeat the patrol before boarding",Source="Defeat the patrol before boarding",Values={ ["en-us"]="Defeat the patrol before boarding",["ru"]="Победите патруль перед посадкой"}},
    {Key="DODGE",Source="DODGE",Values={["en-us"]="DODGE",["ru"]="УВОРАЧИВАЙТЕСЬ"}},

    {Key="Rival",Source="Rival",Values={["en-us"]="Rival",["ru"]="Соперник"}},
    {Key="RACE",Source="RACE",Values={["en-us"]="RACE",["ru"]="ГОНКА"}},
    {Key="Rival · move and jump",Source="Rival · move and jump",Values={["en-us"]="Rival · move and jump",["ru"]="Соперник · движение и прыжок"}},
    {Key="Racing Rat",Source="Racing Rat",Values={["en-us"]="Racing Rat",["ru"]="Гоночная крыса"}},
    {Key="RACING RAT",Source="RACING RAT",Values={["en-us"]="RACING RAT",["ru"]="ГОНОЧНАЯ КРЫСА"}},
    {Key="Raven claw strike",Source="Raven claw strike",Values={["en-us"]="Raven claw strike",["ru"]="Удар когтем ворона"}},
    {Key="Bomb {count:int}/{maximum:int} · rival ~{seconds:int} s",Source="Bomb {count:int}/{maximum:int} · rival ~{seconds:int} s",Values={["en-us"]="Bomb {count:int}/{maximum:int} · rival ~{seconds:int} s",["ru"]="Бомба {count:int}/{maximum:int} · соперник ~{seconds:int} с"}},
    {Key="RACE: move and jump · punches can stun you",Source="RACE: move and jump · punches can stun you",Values={["en-us"]="RACE: move and jump · punches can stun you",["ru"]="ГОНКА: движение и прыжок · удары оглушают"}},
    {Key="SCRIPTED FLIGHT · ATTACK: drop one obstacle",Source="SCRIPTED FLIGHT · ATTACK: drop one obstacle",Values={["en-us"]="SCRIPTED FLIGHT · ATTACK: drop one obstacle",["ru"]="ПОЛЁТ ПО МАРШРУТУ · АТАКА: сбросить преграду"}},
    {Key="DROP OBSTACLE",Source="DROP OBSTACLE",Values={["en-us"]="DROP OBSTACLE",["ru"]="СБРОСИТЬ ПРЕГРАДУ"}},
    {Key="MOVE · JUMP: race to the bomb",Source="MOVE · JUMP: race to the bomb",Values={["en-us"]="MOVE · JUMP: race to the bomb",["ru"]="ДВИЖЕНИЕ · ПРЫЖОК: к бомбе"}},
    {Key="AIM · ATTACK: defend the wall",Source="AIM · ATTACK: defend the wall",Values={["en-us"]="AIM · ATTACK: defend the wall",["ru"]="ПРИЦЕЛ · АТАКА: защищайте стену"}},
    {Key="LIFE STOLEN",Source="LIFE STOLEN",Values={["en-us"]="LIFE STOLEN",["ru"]="ЗДОРОВЬЕ УКРАДЕНО"}},
    {Key="LIFE RECOVERED",Source="LIFE RECOVERED",Values={["en-us"]="LIFE RECOVERED",["ru"]="ЗДОРОВЬЕ ВОЗВРАЩЕНО"}},
    {Key="RAVEN CLAW EQUIPPED",Source="RAVEN CLAW EQUIPPED",Values={["en-us"]="RAVEN CLAW EQUIPPED",["ru"]="КОГОТЬ ВОРОНА ПОДОБРАН"}},
    {Key="CRASH · GROUP STOPPED",Source="CRASH · GROUP STOPPED",Values={["en-us"]="CRASH · GROUP STOPPED",["ru"]="АВАРИЯ · ГРУППА ОСТАНОВЛЕНА"}},
    {Key="CHECKPOINT · READY",Source="CHECKPOINT · READY",Values={["en-us"]="CHECKPOINT · READY",["ru"]="КОНТРОЛЬНАЯ ТОЧКА · ГОТОВО"}},
    {Key="BOMB DEFUSED",Source="BOMB DEFUSED",Values={["en-us"]="BOMB DEFUSED",["ru"]="БОМБА ОБЕЗВРЕЖЕНА"}},

    {Key="Raven",Source="Raven",Values={["en-us"]="Raven",["ru"]="Ворон"}},
    {Key="Large Raven",Source="Large Raven",Values={["en-us"]="Large Raven",["ru"]="Большой ворон"}},
    {Key="Retro Blaster",Source="Retro Blaster",Values={["en-us"]="Retro Blaster",["ru"]="Ретро-бластер"}},
    {Key="Saturn Toadtrap",Source="Saturn Toadtrap",Values={["en-us"]="Saturn Toadtrap",["ru"]="Сатурнская жаболовка"}},
    {Key="Invader",Source="Invader",Values={["en-us"]="Invader",["ru"]="Похититель"}},
    {Key="Rocket Rat",Source="Rocket Rat",Values={["en-us"]="Rocket Rat",["ru"]="Ракетная крыса"}},
    {Key="Snowman",Source="Snowman",Values={["en-us"]="Snowman",["ru"]="Снеговик"}},
    {Key="Sentry Drone",Source="Sentry Drone",Values={["en-us"]="Sentry Drone",["ru"]="Сторожевой дрон"}},
    {Key="Gas Turret",Source="Gas Turret",Values={["en-us"]="Gas Turret",["ru"]="Газовая турель"}},
    {Key="Slug",Source="Slug",Values={["en-us"]="Slug",["ru"]="Слизень"}},
    {Key="Robot",Source="Robot",Values={["en-us"]="Robot",["ru"]="Робот"}},
    {Key="Electrofish",Source="Electrofish",Values={["en-us"]="Electrofish",["ru"]="Электрорыба"}},
    {Key="Hammerfish",Source="Hammerfish",Values={["en-us"]="Hammerfish",["ru"]="Рыба-молот"}},
    {Key="Shark",Source="Shark",Values={["en-us"]="Shark",["ru"]="Акула"}},
    {Key="Duck",Source="Duck",Values={["en-us"]="Duck",["ru"]="Утка"}},
    {Key="Hordhead",Source="Hordhead",Values={["en-us"]="Hordhead",["ru"]="Хордхед"}},
    {Key="Swellcheeks",Source="Swellcheeks",Values={["en-us"]="Swellcheeks",["ru"]="Надувные щёки"}},
    {Key="Flying Head",Source="Flying Head",Values={["en-us"]="Flying Head",["ru"]="Летающая голова"}},
}}
return Catalog
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="BT52">
        <Properties>
          <string name="Name">TextLocalization</string>
          <ProtectedString name="Source">-- Standard Roblox table/translator adapter. Engine services are injected for native contracts.
local Localization={}
Localization.__index=Localization

local function formatEnglish(source,args)
    return (source:gsub('{([%w_]+):?[%w_]*}',function(name)
        local value=type(args)=='table' and args[name]
        return value~=nil and tostring(value) or '{'..name..'}'
    end))
end

function Localization.new(catalog,service,create)
    local native=create('LocalizationTable')
    native.Name='BrickToadsText'
    native.SourceLocaleId='en-us'
    local entries,bySource={},{}
    for _,entry in ipairs(catalog.entries) do
        local values=table.clone(entry.Values)
        -- Roblox uses ru-ru for the selected client locale; ru also remains a
        -- valid language entry for translation maintenance and regional fallback.
        if values.ru then values['ru-ru']=values.ru end
        entries[#entries+1]={Key=entry.Key,Source=entry.Source,Values=values}
        bySource[entry.Source]=entry.Key
    end
    native:SetEntries(entries)
    native.Parent=service
    return setmetatable({native=native,service=service,bySource=bySource},Localization)
end

function Localization:locale()
    local locale=self.service.RobloxLocaleId
    return type(locale)=='string' and locale~='' and string.lower(locale:gsub('_','-')) or 'en-us'
end

function Localization:text(source,args)
    if type(source)~='string' then return '' end
    local key=self.bySource[source]
    if key then
        local locale=self:locale()
        if self.translatorLocale~=locale then
            local ok,translator=pcall(self.native.GetTranslator,self.native,locale)
            self.translator=ok and translator or nil
            self.translatorLocale=ok and locale or nil
        end
        if self.translator then
            local ok,text=pcall(self.translator.FormatByKey,self.translator,key,args or {})
            if ok and type(text)=='string' then return text end
        end
    end
    -- Missing/unsupported translations and a temporarily unavailable translator
    -- always retain readable English rather than an empty label or another locale.
    return formatEnglish(source,args)
end

function Localization:groupName(name,id)
    local index=type(id)=='string' and id:match('^group%-(%d+)$')
    if index then return self:text('Team {index:int}',{index=tonumber(index)}) end
    return self:text(name or 'Team')
end

function Localization:bind(root)
    root.RootLocalizationTable=self.native
    root.AutoLocalize=true
end

function Localization:bindWorld(workspace)
    local function apply(object)
        if not object:IsA('BillboardGui') then return end
        local parent=object.Parent
        while parent and parent~=workspace do
            if parent:GetAttribute('OriginalArt')==true then
                if object.Name=='OwnerNameplate' then object.AutoLocalize=false
                else self:bind(object) end
                return
            end
            parent=parent.Parent
        end
    end
    for _,object in ipairs(workspace:GetDescendants()) do apply(object) end
    self.worldConnection=workspace.DescendantAdded:Connect(apply)
end

function Localization:destroy()
    if self.worldConnection then self.worldConnection:Disconnect() end
    self.native:Destroy()
end

return Localization
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
