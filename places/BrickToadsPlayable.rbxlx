        [6]={Body={.3},Head={.18},Jaw={.25},LeftArm={1.45,0,-.2},RightArm={1.85,0,.15},LeftLeg={.6},RightLeg={-.4}},
        [7]={Body={-.25},Head={-.3},Jaw={.2},LeftArm={.6,0,-.3},RightArm={.6,0,.3}},
