      <Item class="ModuleScript" referent="BT66">
        <Properties>
          <string name="Name">TextLocalization</string>
          <ProtectedString name="Source">-- Standard Roblox table/translator adapter. Engine services are injected for native contracts.
local Localization={}
Localization.__index=Localization

local function formatEnglish(source,args)
    return (source:gsub('{([%w_]+):?[%w_]*}',function(name)
        local value=type(args)=='table' and args[name]
        return value~=nil and tostring(value) or '{'..name..'}'
    end))
end

function Localization.new(catalog,service,create)
    local native=create('LocalizationTable')
    native.Name='BrickToadsText'
    native.SourceLocaleId='en-us'
    local entries,bySource={},{}
    for _,entry in ipairs(catalog.entries) do
        local values=table.clone(entry.Values)
        -- Roblox uses ru-ru for the selected client locale; ru also remains a
        -- valid language entry for translation maintenance and regional fallback.
        if values.ru then values['ru-ru']=values.ru end
        entries[#entries+1]={Key=entry.Key,Source=entry.Source,Values=values}
        bySource[entry.Source]=entry.Key
    end
    native:SetEntries(entries)
    native.Parent=service
    return setmetatable({native=native,service=service,bySource=bySource},Localization)
end

function Localization:locale()
    local locale=self.service.RobloxLocaleId
    return type(locale)=='string' and locale~='' and string.lower(locale:gsub('_','-')) or 'en-us'
end

function Localization:text(source,args)
    if type(source)~='string' then return '' end
    local key=self.bySource[source]
    if key then
        local locale=self:locale()
        if self.translatorLocale~=locale then
            local ok,translator=pcall(self.native.GetTranslator,self.native,locale)
            self.translator=ok and translator or nil
            self.translatorLocale=ok and locale or nil
        end
        if self.translator then
            local ok,text=pcall(self.translator.FormatByKey,self.translator,key,args or {})
            if ok and type(text)=='string' then return text end
        end
    end
    -- Missing/unsupported translations and a temporarily unavailable translator
    -- always retain readable English rather than an empty label or another locale.
    return formatEnglish(source,args)
end

function Localization:groupName(name,id)
    local index=type(id)=='string' and id:match('^group%-(%d+)$')
    if index then return self:text('Team {index:int}',{index=tonumber(index)}) end
    return self:text(name or 'Team')
end

function Localization:bind(root)
    root.RootLocalizationTable=self.native
    root.AutoLocalize=true
end

function Localization:bindWorld(workspace)
    local function apply(object)
        if not object:IsA('BillboardGui') then return end
        local parent=object.Parent
        while parent and parent~=workspace do
            if parent:GetAttribute('OriginalArt')==true then
                if object.Name=='OwnerNameplate' then object.AutoLocalize=false
                else self:bind(object) end
                return
            end
            parent=parent.Parent
        end
    end
    for _,object in ipairs(workspace:GetDescendants()) do apply(object) end
    self.worldConnection=workspace.DescendantAdded:Connect(apply)
end

function Localization:destroy()
    if self.worldConnection then self.worldConnection:Disconnect() end
    self.native:Destroy()
end

return Localization
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterGui" referent="BT67">
    <Properties>
      <string name="Name">StarterGui</string>
      <token name="ScreenOrientation">2</token>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="BT68">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="BT69">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="BT70">
        <Properties>
          <string name="Name">BrickToads</string>
        </Properties>
        <Item class="ModuleScript" referent="BT71">
          <Properties>
            <string name="Name">BossQueuePanel</string>
            <ProtectedString name="Source">-- Private queue presentation. Joining never creates a body; the server owns the offer and role.
local BossQueuePanel = {}
BossQueuePanel.__index = BossQueuePanel
local bosses={
    {id='CausewayGuardian',name='Causeway Guardian'}, {id='BigBlag',name='Big Blag'},
    {id='RoboManus',name='Robo-Manus'}, {id='GeneralSlaughter',name='General Slaughter'},
    {id='Buzzball',name='Buzzball'}, {id='DarkQueen',name='Dark Queen'},
}
local function sourceText(source,args)
    return (source:gsub('{([%w_]+):?[%w_]*}',function(key) return tostring(args and args[key] or '') end))
end

local function make(className, name, parent, properties)
    local item = Instance.new(className)
    item.Name = name
    for key, value in pairs(properties or {}) do item[key] = value end
    item.Parent = parent
    return item
end

local function position(item, x, y, width, height)
    item.Position, item.Size = UDim2.fromOffset(x, y), UDim2.fromOffset(width, height)
end

function BossQueuePanel.new(menuParent, hudParent, sendIntent, colors, translate, groupName)
    local self = setmetatable({menuParent = menuParent, hudParent = hudParent,
        sendIntent = sendIntent, colors = colors, compact = false, translate=translate, groupName=groupName}, BossQueuePanel)
    self.card = make("Frame", "BossQueue", menuParent, {
        BackgroundColor3 = colors.panel, BorderSizePixel = 0, LayoutOrder = 7, Visible = false,
    })
    make("UICorner", "Corner", self.card, {CornerRadius = UDim.new(0, 14)})
    local function text(name, size, color, bold)
        return make("TextLabel", name, self.card, {
            BackgroundTransparency = 1, Text = "", TextColor3 = color,
            Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham, TextSize = size,
            TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
            TextWrapped = true,
        })
    end
    self.heading = text("Heading", 12, colors.yellow, true)
    self.heading.Text = "BOSS QUEUE"
    self.name = make('TextButton','BossChoice',self.card,{
        BackgroundTransparency=1,TextColor3=colors.text,TextSize=19,Font=Enum.Font.GothamBold,
        TextXAlignment=Enum.TextXAlignment.Left,TextWrapped=true,AutoButtonColor=false,
    })
    self.name.Text = "Causeway Guardian"
    self.art = require(game:GetService("ReplicatedStorage").BrickToads.ArcadeArt)
    self.portrait = self.art.portrait(self.card, bosses[1].id)
    self.selectedBoss=1
    self.name.Activated:Connect(function()
        if not self.pending and self.queue and self.queue.state=='None' then
            self.selectedBoss=self.selectedBoss%#bosses+1;self:_draw()
        end
    end)
    self.status = text("QueueStatus", 13, colors.yellow, true)
    self.status.TextXAlignment = Enum.TextXAlignment.Right
    self.detail = text("Detail", 13, colors.muted, false)
    self.note = text("RoleNote", 12, colors.muted, false)
    self.note.Text = "Tap the boss name to choose. Joining the queue does not assign a role immediately."
    local function action(name, callback)
        local item = make("TextButton", name, self.card, {
            BackgroundColor3 = colors.card, BorderSizePixel = 0, Text = "",
            TextColor3 = colors.text, Font = Enum.Font.GothamBold, TextSize = 14,
            TextWrapped = true, AutoButtonColor = false,
        })
        make("UICorner", "Corner", item, {CornerRadius = UDim.new(0, 10)})
        item.Activated:Connect(callback)
        return item
    end
    self.primary = action("QueueAction", function() self:_activate(true) end)
    self.secondary = action("DeclineInvitation", function() self:_activate(false) end)
    return self
end

function BossQueuePanel:_remaining()
    return math.max(0, math.ceil((tonumber(self.queue and self.queue.deadline) or 0) - workspace:GetServerTimeNow()))
end

function BossQueuePanel:_activate(primary)
    if not self.card.Visible or self.pending or not self.queue then return end
    local state, packet = self.queue.state, nil
    if state == "Invited" and self.queue.offerId and self:_remaining() &gt; 0 then
        packet = {kind = "ReplyBoss", offerId = self.queue.offerId, accepted = primary}
    elseif primary and state == "None" and self.queue.available == true then
        packet = {kind = "QueueBoss", bossId = bosses[self.selectedBoss].id}
    elseif primary and (state == "Queued" or state == "Accepted" or state == "Ready") then
        packet = {kind = "CancelBossQueue"}
    end
    if not packet then return end
    self.pending, self.pendingAt = state, os.clock()
    self.sendIntent(packet)
    self:_draw()
end

function BossQueuePanel:update(data, hero)
    local old = self.queue
    if data and self.groupId ~= data.groupId then
        self.pending, self.ackOffer, self.expiredOffer = nil, nil, nil
    end
    self.groupId = data and data.groupId
    self.queue = data and data.bossQueue
    local queue, active = self.queue, data and data.status == "Active"
    local livingEnemy = data and data.enemyRole and data.enemyRole.status ~= "Dead"
    local eligibleContext = data ~= nil and (not active or (not hero and not livingEnemy))
    self.card.Visible = queue ~= nil and eligibleContext
    self.compact = active == true and data.view ~= "Menu"
    self.card.Parent = self.compact and self.hudParent or self.menuParent
    if not queue or not old or old.state ~= queue.state or old.offerId ~= queue.offerId then
        self.pending = nil
    end
    if not queue or queue.offerId ~= self.ackOffer then
        self.ackOffer, self.ackCount, self.ackAt = queue and queue.offerId, 0, nil
        self.expiredOffer = nil
    end
    self:step()
end

function BossQueuePanel:_draw()
    local queue = self.queue
    if not queue then return end
    local state, colors = queue.state, self.colors
    local T=self.translate or sourceText
    local selected=bosses[self.selectedBoss]
    for _,boss in ipairs(bosses) do if queue.bossId==boss.id then selected=boss end end
    self.art.setPortrait(self.portrait, selected.id)
    self.name.Text=T(selected.name)..(state=='None' and '  ›' or '')
    self.name.Active=state=='None' and not self.pending
    self.name.Selectable=self.name.Active
    local seconds = self:_remaining()
    local timed = state == "Invited" or state == "Accepted"
    local enabled, primaryText = false, "Unavailable"
    self.secondary.Visible = state == "Invited"
    if state == "Queued" then
        self.status.Text = queue.position and T("Queued · #{position:int}", {position=queue.position}) or T("Queued")
        self.detail.Text = "Choosing a regular enemy leaves the queue."
        primaryText, enabled = "Leave queue", true
    elseif state == "Invited" then
        self.status.Text = T("Invitation · {seconds:int} s", {seconds=seconds})
        local target = queue.groupName and ((self.groupName and self.groupName(queue.groupName,queue.groupId) or queue.groupName) .. " · ") or ""
        self.detail.Text = self.compact and (target .. T("Accept before time runs out."))
            or (target .. T("Accept the invitation before time runs out."))
        primaryText, enabled = "Accept", seconds &gt; 0
    elseif state == "Accepted" then
        self.status.Text = T("Connecting · {seconds:int} s", {seconds=seconds})
        self.detail.Text = "Connecting automatically… your role is reserved."
        primaryText, enabled = "Cancel", true
    elseif state == "Ready" then
        self.status.Text = "Ready to fight"
        self.detail.Text = "Your boss role is reserved. Waiting for the encounter."
        primaryText, enabled = "Cancel", true
    elseif state == "Active" then
        self.status.Text = "In combat"
        self.detail.Text = T("You control {boss}.",{boss=T(selected.name)})
        primaryText = "Role assigned"
    else
        self.status.Text = queue.available == true and "Queue available" or "Unavailable"
        self.detail.Text = queue.available == true and "Wait for an invitation before this boss encounter."
            or "The queue is unavailable for your current role."
        primaryText, enabled = "Queue for boss", queue.available == true
    end
    if timed and seconds == 0 then
        self.status.Text, self.detail.Text = "Time expired", "Waiting for server confirmation…"
        enabled = false
    end
    if self.pending then primaryText = "Sending…" end
    enabled = enabled and not self.pending
    self.primary.Text, self.primary.Active, self.primary.Selectable = T(primaryText), enabled, enabled
    self.primary.BackgroundColor3 = enabled and colors.yellow or colors.card
    self.primary.TextColor3 = enabled and colors.ink or colors.muted
    self.secondary.Text = T("Decline")
    self.secondary.Active, self.secondary.Selectable = enabled, enabled
    self.secondary.TextColor3 = enabled and colors.text or colors.muted
end

function BossQueuePanel:step()
    local queue = self.queue
    if not queue then return end
    if self.pending and os.clock() - self.pendingAt &gt; 4 then
        self.pending = nil
        self.sendIntent({kind = "Sync"})
    end
    if queue.state == "Accepted" and not self.pending and queue.offerId and self:_remaining() &gt; 0
        and (self.ackCount or 0) &lt; 3 and (not self.ackAt or os.clock() - self.ackAt &gt;= 2) then
        self.ackCount, self.ackAt = (self.ackCount or 0) + 1, os.clock()
        self.sendIntent({kind = "ConnectBoss", offerId = queue.offerId})
    end
    if (queue.state == "Invited" or queue.state == "Accepted") and self:_remaining() == 0
        and queue.offerId and self.expiredOffer ~= queue.offerId then
        self.expiredOffer = queue.offerId
        self.sendIntent({kind = "Sync"})
    end
    -- Only text and interaction state change each frame; geometry is owned by the main layout.
    if self.card.Visible then self:_draw() end
end

function BossQueuePanel:layout(width, compact, x, y)
    if not self.card.Visible then return 0 end
    self.compact = compact
    self.heading.Visible, self.note.Visible = not compact, not compact
    local height = compact and 140 or (width &lt; 420 and 242 or 218)
    if compact then
        position(self.card, x or 0, y or 0, width, height)
        position(self.portrait, 12, 7, 36, 36)
        position(self.name, 56, 4, width - 68, 44)
        self.name.TextSize = width &lt; 360 and 13 or 15
        position(self.status, 12, 48, width - 24, 18)
        self.status.TextSize = width &lt; 360 and 11 or 12
        position(self.detail, 12, 66, width - 24, 22)
        self.detail.TextSize = width &lt; 360 and 11 or 12
    else
        self.card.Size = UDim2.new(1, 0, 0, height)
        position(self.heading, 14, 10, width - 28, 18)
        position(self.portrait, 14, 31, 44, 44)
        position(self.name, 66, 31, width - 80, 44)
        self.name.TextSize = 19
        position(self.status, 14, 77, width - 28, 20)
        self.status.TextSize = 13
        self.status.TextXAlignment = Enum.TextXAlignment.Left
        position(self.detail, 14, 100, width - 28, width &lt; 420 and 38 or 22)
        self.detail.TextSize = 13
        position(self.note, 14, width &lt; 420 and 140 or 124, width - 28, width &lt; 420 and 44 or 36)
    end
    self.status.TextXAlignment = Enum.TextXAlignment.Left
    local inset, gap, buttonHeight = compact and 12 or 14, 8, 44
    local innerWidth = width - inset * 2
    local half = (innerWidth - gap) / 2
    position(self.primary, inset, height - buttonHeight - 6, self.secondary.Visible and half or innerWidth, buttonHeight)
    position(self.secondary, inset + half + gap, height - buttonHeight - 6, half, buttonHeight)
    self.primary.TextSize, self.secondary.TextSize = compact and 13 or 14, compact and 13 or 14
    return height
end

return BossQueuePanel
</ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="BT72">
          <Properties>
            <string name="Name">BrickToadsClient</string>
            <ProtectedString name="Source">-- Presentation and input only. The server owns the run, actors and combat.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")
local player = Players.LocalPlayer
local sharedText = ReplicatedStorage:WaitForChild("BrickToads")
local ArcadeArt = require(sharedText:WaitForChild("ArcadeArt"))
local localizationService = game:GetService("LocalizationService")
local localization = require(sharedText:WaitForChild("TextLocalization")).new(
    require(sharedText:WaitForChild("TextCatalog")), localizationService, Instance.new)
local function T(source, args) return localization:text(source, args) end
local function teamName(name, id) return localization:groupName(name, id) end
local remotes = ReplicatedStorage:WaitForChild("BrickToadsGame")
local intent = remotes:WaitForChild("Intent")
local stateRemote = remotes:WaitForChild("State")
local SpectatorCamera = require(script.Parent:WaitForChild("SpectatorCamera"))
local BossQueuePanel = require(script.Parent:WaitForChild("BossQueuePanel"))
local CampaignPresentation = require(script.Parent:WaitForChild("CampaignPresentation"))
local GroupPanel = require(script.Parent:WaitForChild("GroupPanel"))
local CombatFeedback = require(script.Parent:WaitForChild("CombatFeedback"))
local GameAudio = require(script.Parent:WaitForChild("GameAudio"))
local CastAssetVisibility = require(script.Parent:WaitForChild("CastAssetVisibility"))
local HeroAssetVisibility = require(script.Parent:WaitForChild("HeroAssetVisibility"))
local MovementInput = require(script.Parent:WaitForChild("MovementInput"))
local RobloxInputBindings = require(script.Parent:WaitForChild("RobloxInputBindings"))
local cameraVisibility = require(script.Parent:WaitForChild("CameraVisibility"))
local spectatorCamera = SpectatorCamera.new()
local combatFeedback = CombatFeedback.new()
local gameAudio = GameAudio.new()
local castAssetVisibility = CastAssetVisibility.new()
local heroAssetVisibility = HeroAssetVisibility.new()
local courseAssetVisibility = CastAssetVisibility.new(nil, 'Course')
local coursePropVisibility = CastAssetVisibility.new(nil, 'Prop')
local soundMuted, musicMuted = false, false
local audioOpen = false
gameAudio:setReducedFlash(true)
script.Destroying:Connect(function() gameAudio:destroy(); castAssetVisibility:destroy(); heroAssetVisibility:destroy(); courseAssetVisibility:destroy(); coursePropVisibility:destroy() end)
local movementInput = MovementInput.new()
local gameplayBindings
local windowFocused = true
local lastReactionEpoch
local lastHeldContext
local vehicleRewindSerial
local sendMovement, syncGameplayContext
local feedbackUntil = 0
local feedbackActionId

local C = {
    ink = Color3.fromRGB(12, 20, 32), panel = Color3.fromRGB(22, 35, 49),
    card = Color3.fromRGB(31, 48, 61), line = Color3.fromRGB(72, 96, 107),
    text = Color3.fromRGB(244, 241, 224), muted = Color3.fromRGB(164, 185, 188),
    lime = Color3.fromRGB(195, 235, 104), red = Color3.fromRGB(250, 115, 107),
    green = Color3.fromRGB(126, 204, 124), yellow = Color3.fromRGB(241, 206, 103),
    brown = Color3.fromRGB(197, 146, 106),
}
local templates = {"Mr. Green", "Mr. Yellow", "Mr. Brown"}
local heroColors = {[templates[1]] = C.green, [templates[2]] = C.yellow, [templates[3]] = C.brown}
local snapshot, mine, controlled, identity = nil, nil, nil, nil
local sequence = 0
local pendingTemplate, pendingAt = nil, 0
local pendingRole, pendingRoleAt = nil, 0
local pendingEnemy, pendingEnemyAt = nil, 0
local choosingEnemy = true
local pendingView, pendingViewAt = nil, 0
local cameraStickInput
local cameraHolds = {}
local actionPending, actionAt = false, 0
local width, height = 900, 650
local render, layout
local mobileExpanded

local function sendIntent(packet)
    local envelope = table.clone(packet)
    if snapshot then
        if type(snapshot.groupId) ~= "string" or snapshot.groupId == "" then return end
        envelope.groupId = snapshot.groupId
    elseif envelope.kind ~= "Sync" then return end
    intent:FireServer(envelope)
end

local function chooseView(view)
    if not snapshot or snapshot.status ~= "Active" or not snapshot.canChooseView or pendingView then return end
    if snapshot.view == view then return end
    pendingView, pendingViewAt = view, os.clock()
    sendIntent({kind = "ChooseView", runId = snapshot.runId, levelEpoch = snapshot.levelEpoch, view = view})
end

local function make(className, name, parent, props)
    local item = Instance.new(className)
    item.Name = name
    for key, value in pairs(props or {}) do item[key] = value end
    item.Parent = parent
    return item
end
local function corner(parent, radius)
    return make("UICorner", "Corner", parent, {CornerRadius = UDim.new(0, radius or 14)})
end
local function stroke(parent, color, thickness)
    return make("UIStroke", "Outline", parent, {
        Color = color or C.line, Thickness = thickness or 1, Transparency = 0.55,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })
end
local function frame(parent, name, color)
    return make("Frame", name, parent, {BackgroundColor3 = color or C.panel, BorderSizePixel = 0})
end
local function label(parent, name, text, size, color, bold)
    return make("TextLabel", name, parent, {
        BackgroundTransparency = 1, BorderSizePixel = 0, Text = text,
        Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham,
        TextSize = size or 16, TextColor3 = color or C.text,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
        TextWrapped = true,
    })
end
local function button(parent, name, text, color, callback)
    local item = make("TextButton", name, parent, {
        BackgroundColor3 = color or C.card, BorderSizePixel = 0,
        Text = text, TextColor3 = C.text, Font = Enum.Font.GothamBold,
        TextSize = 16, TextWrapped = true, AutoButtonColor = false,
    })
    corner(item, 14)
    if callback then item.Activated:Connect(callback) end
    return item
end
local function position(item, x, y, w, h)
    item.Position, item.Size = UDim2.fromOffset(x, y), UDim2.fromOffset(w, h)
end

local gui = make("ScreenGui", "BrickToadsGameUI", player:WaitForChild("PlayerGui"), {
    ResetOnSpawn = false, DisplayOrder = 20, ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
    ClipToDeviceSafeArea = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
})
localization:bind(gui)
localization:bindWorld(workspace)
local safe = make("Frame", "SafeArea", gui, {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1)})
local overlay = frame(safe, "Menu", C.ink)
overlay.Size, overlay.BackgroundTransparency = UDim2.fromScale(1, 1), 0
make("UIGradient", "Atmosphere", overlay, {
    Color = ColorSequence.new(Color3.fromRGB(27, 49, 59), C.ink), Rotation = 110,
})
ArcadeArt.backdrop(make("ImageLabel", "CausewayBackdrop", overlay, {
    Image = ArcadeArt.splash, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
    ImageColor3 = Color3.fromRGB(44, 59, 61), ScaleType = Enum.ScaleType.Crop,
}))
local shell = frame(overlay, "Shell", C.ink)
shell.BackgroundTransparency, shell.AnchorPoint = 1, Vector2.new(0.5, 0.5)
shell.Position = UDim2.fromScale(0.5, 0.5)
local scroll = make("ScrollingFrame", "SelectionContent", shell, {
    BackgroundTransparency = 1, BorderSizePixel = 0, CanvasSize = UDim2.new(),
    AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 4,
    ScrollBarImageColor3 = C.muted, ScrollingDirection = Enum.ScrollingDirection.Y,
})
make("UIPadding", "ScrollPadding", scroll, {
    PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 9),
    PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 14),
})
local menuLayout = make("UIListLayout", "MenuLayout", scroll, {
    FillDirection = Enum.FillDirection.Vertical, SortOrder = Enum.SortOrder.LayoutOrder,
    Padding = UDim.new(0, 14),
})
local header = frame(scroll, "Header")
header.BackgroundColor3, header.LayoutOrder, header.ClipsDescendants = C.ink, 1, true
do
    local shot = make("ImageLabel", "CausewayBanner", header, {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        Image = ArcadeArt.splash, ScaleType = Enum.ScaleType.Crop,
    })
    ArcadeArt.backdrop(shot)
    local scrim = frame(header, "TitleScrim", Color3.fromRGB(7, 17, 24))
    scrim.Size = UDim2.fromScale(1, 1)
    make("UIGradient", "Shade", scrim, {
        Rotation = 90,
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, .58), NumberSequenceKeypoint.new(.5, .32),
            NumberSequenceKeypoint.new(1, .08),
        }),
    })
end
local brand = label(header, "Brand", "BRICK TOADS", 15, C.lime, true)
local title = label(header, "Title", "Flooded Causeway", 35, C.text, true)
local intro = label(header, "Intro", "Guard weapons, grabs and a Guardian. Cross the causeway together.", 16, C.muted)
brand.Font, title.Font = Enum.Font.Arcade, Enum.Font.Arcade
brand.TextColor3 = C.yellow
title.TextStrokeTransparency = .25
require(script.Parent:WaitForChild("CastGallery")).attach(shell, header, ArcadeArt, C, T, button, label, frame)
local resultBanner = frame(scroll, "Result", C.card)
resultBanner.LayoutOrder, resultBanner.Visible = 2, false
corner(resultBanner, 16)
local resultAccent = frame(resultBanner, "Accent", C.lime)
corner(resultAccent, 3)
local resultTitle = label(resultBanner, "ResultTitle", "CAUSEWAY CLEARED", 23, C.lime, true)
local resultDetail = label(resultBanner, "ResultDetail", "", 15, C.text)
local rolePicker = frame(scroll, "RolePreference", C.panel)
rolePicker.LayoutOrder = 3
corner(rolePicker, 16)
local roleTitle = label(rolePicker, "Heading", "YOUR ROLE", 13, C.lime, true)
local roleNote = label(rolePicker, "Help", "", 13, C.muted)
local roleButtons = {}
for i, choice in ipairs({{role = "Hero", text = "Hero"}, {role = "Enemy", text = "Enemy"}, {role = "Spectator", text = "Watch"}}) do
    local role = choice.role
    local item = button(rolePicker, role, choice.text, C.card, function()
        if not snapshot or snapshot.status == "Active" or snapshot.canSelect == false or pendingRole then return end
        if (snapshot.preference or "Hero") == role then return end
        pendingRole, pendingRoleAt = role, os.clock()
        sendIntent({kind = "SelectRole", role = role})
    end)
    roleButtons[i] = {button = item, role = role, text = choice.text, outline = stroke(item, C.line, 1)}
end
local selectionHeading = frame(scroll, "ChooseHero")
selectionHeading.LayoutOrder, selectionHeading.BackgroundTransparency = 4, 1
local chooseTitle = label(selectionHeading, "Heading", "CHOOSE YOUR HERO", 13, C.lime, true)
local chooseNote = label(selectionHeading, "EqualAbilities", "Equal abilities. Teammates may choose the same hero.", 14, C.muted)
local cardsContainer = frame(scroll, "HeroCards")
cardsContainer.LayoutOrder, cardsContainer.BackgroundTransparency = 5, 1
local heroCards = {}

local function toadPortrait(parent, color, template)
    local art = frame(parent, "Portrait", C.ink)
    art.ClipsDescendants = true
    stroke(art, color, 2)
    local portrait = ArcadeArt.portrait(art, template)
    portrait.Name = "ModelPortrait"
    portrait.Size = UDim2.fromScale(1, 1)
    return art
end
for i, template in ipairs(templates) do
    local card = button(cardsContainer, "Hero" .. i, "", C.card, function()
        if not snapshot or not snapshot.canSelect or (snapshot.preference or "Hero") ~= "Hero" or pendingTemplate then return end
        if snapshot.selectedTemplate == template then return end
        pendingTemplate, pendingAt = template, os.clock()
        sendIntent({kind = "SelectHero", template = template})
    end)
    card.ClipsDescendants = true
    heroCards[i] = {
        button = card, outline = stroke(card, C.line, 1),
        accent = frame(card, "Accent", heroColors[template]),
        art = toadPortrait(card, heroColors[template], template), template = template,
        name = label(card, "HeroName", template, 21, C.text, true),
        choice = label(card, "Selection", "SELECT", 12, C.muted, true),
        detail = label(card, "Detail", "Strike · rush · jump", 13, C.muted),
    }
end
local party = frame(scroll, "Party", C.panel)
party.LayoutOrder = 6
corner(party, 16)
local partyTitle = label(party, "PartyTitle", "PLAYERS", 13, C.muted, true)
local partyCount = label(party, "PartyCount", "", 13, C.lime, true)
partyCount.TextXAlignment = Enum.TextXAlignment.Right
local partyRows = {}
local function addPartyRow(i)
    local dot = frame(party, "PlayerColor" .. i, C.line)
    corner(dot, 4)
    local owner = label(party, "Owner" .. i, "", 15, C.text, true)
    owner.AutoLocalize = false
