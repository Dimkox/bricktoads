    {Key="Game paused. Waiting for recovery…",Source="Game paused. Waiting for recovery…",Values={["en-us"]="Game paused. Waiting for recovery…",["ru"]="Игра приостановлена. Ждём восстановления игры…"}},
    {Key="Player ",Source="Player ",Values={["en-us"]="Player ",["ru"]="Игрок "}},
    {Key="host",Source="host",Values={["en-us"]="host",["ru"]="ведущий"}},
    {Key="The team host starts the game.",Source="The team host starts the game.",Values={["en-us"]="The team host starts the game.",["ru"]="Игру начинает ведущий команды."}},
    {Key="Choose one of the three heroes.",Source="Choose one of the three heroes.",Values={["en-us"]="Choose one of the three heroes.",["ru"]="Выберите одного из трёх героев."}},
    {Key="Change your hero before the next game.",Source="Change your hero before the next game.",Values={["en-us"]="Change your hero before the next game.",["ru"]="Смена героя доступна перед следующей игрой."}},
    {Key="The game has already started.",Source="The game has already started.",Values={["en-us"]="The game has already started.",["ru"]="Игра уже началась."}},
    {Key="The team is full. You can watch the game.",Source="The team is full. You can watch the game.",Values={["en-us"]="The team is full. You can watch the game.",["ru"]="Команда собрана. Можно наблюдать за игрой."}},
    {Key="Waiting for teammates.",Source="Waiting for teammates.",Values={["en-us"]="Waiting for teammates.",["ru"]="Ждём участников команды."}},
    {Key="Could not start the game. Try again.",Source="Could not start the game. Try again.",Values={["en-us"]="Could not start the game. Try again.",["ru"]="Не удалось начать игру. Попробуйте ещё раз."}},
    {Key="Choose your role before the game starts.",Source="Choose your role before the game starts.",Values={["en-us"]="Choose your role before the game starts.",["ru"]="Выберите роль перед началом игры."}},
    {Key="You are a hero in this run. Change roles before a new game.",Source="You are a hero in this run. Change roles before a new game.",Values={["en-us"]="You are a hero in this run. Change roles before a new game.",["ru"]="В этой игре вы герой. Сменить роль можно перед новой игрой."}},
    {Key="Your only life is over. Watch until the next game.",Source="Your only life is over. Watch until the next game.",Values={["en-us"]="Your only life is over. Watch until the next game.",["ru"]="Ваша единственная жизнь закончилась. Наблюдайте до следующей игры."}},
    {Key="Enemy selection is closed. Change roles before a new game.",Source="Enemy selection is closed. Change roles before a new game.",Values={["en-us"]="Enemy selection is closed. Change roles before a new game.",["ru"]="Выбор противника закрыт. Роль можно сменить перед новой игрой."}},
    {Key="No guards are available. Guards already in combat cannot be selected.",Source="No guards are available. Guards already in combat cannot be selected.",Values={["en-us"]="No guards are available. Guards already in combat cannot be selected.",["ru"]="Свободных дозорных нет. Вступившего в бой выбрать уже нельзя."}},
    {Key="This guard is already in combat. Choose another from the list.",Source="This guard is already in combat. Choose another from the list.",Values={["en-us"]="This guard is already in combat. Choose another from the list.",["ru"]="Этот дозорный уже вступил в бой. Выберите другого из списка."}},
    {Key="Another player already controls this guard.",Source="Another player already controls this guard.",Values={["en-us"]="Another player already controls this guard.",["ru"]="Этим дозорным уже управляет другой игрок."}},
    {Key="This guard has died. Choose another from the list.",Source="This guard has died. Choose another from the list.",Values={["en-us"]="This guard has died. Choose another from the list.",["ru"]="Этот дозорный погиб. Выберите другого из списка."}},
    {Key="This guard is no longer available. Choose another from the list.",Source="This guard is no longer available. Choose another from the list.",Values={["en-us"]="This guard is no longer available. Choose another from the list.",["ru"]="Этот дозорный больше недоступен. Выберите другого из списка."}},
    {Key="You already chose a guard. It has one life.",Source="You already chose a guard. It has one life.",Values={["en-us"]="You already chose a guard. It has one life.",["ru"]="Вы уже выбрали дозорного. У него одна жизнь."}},
    {Key="The Guardian queue is unavailable for your current role.",Source="The Guardian queue is unavailable for your current role.",Values={["en-us"]="The Guardian queue is unavailable for your current role.",["ru"]="Очередь стража сейчас недоступна для вашей роли."}},
    {Key="You already control a living enemy.",Source="You already control a living enemy.",Values={["en-us"]="You already control a living enemy.",["ru"]="Вы уже управляете живым противником."}},
    {Key="You accepted a Guardian invitation. Cancel it in the queue first.",Source="You accepted a Guardian invitation. Cancel it in the queue first.",Values={["en-us"]="You accepted a Guardian invitation. Cancel it in the queue first.",["ru"]="Приглашение стража уже принято. Сначала отмените его в очереди."}},
    {Key="This invitation is no longer available. Refreshing the queue.",Source="This invitation is no longer available. Refreshing the queue.",Values={["en-us"]="This invitation is no longer available. Refreshing the queue.",["ru"]="Это приглашение больше недоступно. Очередь обновляется."}},
    {Key="A hero is holding you. Control returns after release.",Source="A hero is holding you. Control returns after release.",Values={["en-us"]="A hero is holding you. Control returns after release.",["ru"]="Вас держит герой. Управление вернётся после освобождения."}},
    {Key="You were thrown. Wait until you recover.",Source="You were thrown. Wait until you recover.",Values={["en-us"]="You were thrown. Wait until you recover.",["ru"]="Вас бросили. Дождитесь окончания реакции."}},
    {Key="Your hands are full. Throw what you are holding first.",Source="Your hands are full. Throw what you are holding first.",Values={["en-us"]="Your hands are full. Throw what you are holding first.",["ru"]="Руки заняты. Сначала бросьте то, что держите."}},
    {Key="Double-tap a direction and keep running to use a mega strike.",Source="Double-tap a direction and keep running to use a mega strike.",Values={["en-us"]="Double-tap a direction and keep running to use a mega strike.",["ru"]="Для мегаудара дважды нажмите направление и удерживайте бег."}},
    {Key="Guard",Source="Guard",Values={["en-us"]="Guard",["ru"]="Дозорный"}},
    {Key="Selecting…",Source="Selecting…",Values={["en-us"]="Selecting…",["ru"]="Выбираем…"}},
    {Key="Select",Source="Select",Values={["en-us"]="Select",["ru"]="Выбрать"}},
    {Key="After the start, choose an available guard before its first fight. Three hearts, one life.",Source="After the start, choose an available guard before its first fight. Three hearts, one life.",Values={["en-us"]="After the start, choose an available guard before its first fight. Three hearts, one life.",["ru"]="После старта выберите свободного дозорного до его первого боя. Три сердца, одна жизнь."}},
    {Key="Watch the heroes. You may choose an available guard during the game.",Source="Watch the heroes. You may choose an available guard during the game.",Values={["en-us"]="Watch the heroes. You may choose an available guard during the game.",["ru"]="Наблюдайте за героями. Во время игры можно выбрать свободного дозорного."}},
    {Key="A team has 1–3 heroes. The first hero starts the game.",Source="A team has 1–3 heroes. The first hero starts the game.",Values={["en-us"]="A team has 1–3 heroes. The first hero starts the game.",["ru"]="В команду входят 1–3 героя. Первый герой начинает игру."}},
