      <Item class="ModuleScript" referent="BT62">
        <Properties>
          <string name="Name">AudioCatalog</string>
          <ProtectedString name="Source">-- Original authored pulse/triangle/noise atlases; see assets/audio/README.md.
-- Actual MCP uploads; native availability is recorded separately in roblox-audio.json.
return {
    schema=1,
    assets={sfx='rbxassetid://75042258524153',music='rbxassetid://100771181568063'},
    cues={
        Hit={start=0.180000000000,finish=0.400000000000,volume=0.40},
        Shield={start=0.580000000000,finish=0.755011337868,volume=0.40},
        Miss={start=0.935011337868,finish=1.095011337868,volume=0.32},
        Club={start=1.275011337868,finish=1.575011337868,volume=0.40},
        Throw={start=1.755011337868,finish=2.004988662132,volume=0.40},
        Fly={start=2.184988662132,finish=2.504988662132,volume=0.32},
        Spawn={start=2.684988662132,finish=3.100000000000,volume=0.40},
