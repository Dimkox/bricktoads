        <Item class="ModuleScript" referent="BT10">
          <Properties>
            <string name="Name">BossIntro</string>
            <ProtectedString name="Source">-- Finite first-route Boss Walker INTRO. Source counters/events come from the
-- canonical profile; 60 Hz / 4.25 seconds is a local presentation calibration.
-- Provenance: research/2026-11-09-canonical-character-animation-source.md,
-- "Boss Walker appearance": main 4103-4187 and bank-six arena setup.
-- The source addresses two heroes. Applying fear to the party's three captured
-- identities is an explicit cooperative adaptation, with no gameplay effects.
return function(Animation)
    local Intro={}
    Intro.__index=Intro
    local function finite(n) return type(n)=='number' and n==n and n&gt;-math.huge and n&lt;math.huge end

    function Intro.new(director)
        local s=director.session
        local actors={}
        for _,slot in ipairs(s.order) do
            local h,c=s.state.heroes[slot],s.combat[slot]
            if h and h.status=='Alive' and h.actorId and c and not c.deathAt then actors[slot]=h.actorId end
        end
        local state={id=s.state.runId..':boss-intro:'..s.state.levelEpoch,runId=s.state.runId,
            levelEpoch=s.state.levelEpoch,startedAt=director.now,counter=0,active=true,cameraCut=false,
            phase='BeforeCut',heroActors=actors,bossPosition=table.clone(director.route.boss.position),events={}}
        local self=setmetatable({director=director,session=s,world=director.world,state=state},Intro)
        self:_advance(1)
        return self
    end

    function Intro:_advance(counter)
        local state=self.state
        local row=assert(Animation.bossWalkerIntro(counter))
        state.events=assert(Animation.bossWalkerEventsBetween(state.counter,counter))
        -- E0 and FF skip write_anim_fear, rather than clearing the previous
        -- animation. Recover the preceding write even when a heartbeat skips it.
        local written=row.fearAnimation and row or Animation.bossWalkerIntro(counter-1)
        if written and written.fearAnimation then
            state.fearAnimation=written.fearAnimation;state.fearFrame=written.fearFrame
            state.fearPointerMask=written.fearPointerMask
        end
        state.counter=counter;state.phase=row.phase
        state.footFrame=row.footFrame;state.footMotion=row.footMotion
        for _,event in ipairs(state.events) do if event.kind=='ArenaCut' then state.cameraCut=true end end
        -- Every published context is plain data. Actor replacements can never
        -- inherit this intro's presentation, even within the same party slot.
        local actors={}
        for slot,actorId in pairs(state.heroActors) do
            local h,c=self.session.state.heroes[slot],self.session.combat[slot]
            if h and h.actorId==actorId and h.status=='Alive' and c and not c.deathAt then actors[slot]=actorId end
        end
        state.heroActors=actors
        if self.world.bossIntro then self.world:bossIntro(state) end
        if row.ended then
            state.active=false;self.complete=true
            if self.world.bossIntro then self.world:bossIntro(nil) end
            return 'Complete'
        end
        return 'Active'
    end

    function Intro:step(now)
        if self.cancelled then return 'Cancelled' end
        if self.complete then return 'Complete' end
        local state=self.state
        if self.director.result or self.session.state.status~='Active' then return self:cancel('RunEnded') end
        if self.session.state.runId~=state.runId or self.session.state.levelEpoch~=state.levelEpoch then
            return self:cancel('RunReplaced')
        end
        if not finite(now) or now&lt;state.startedAt then return 'INVALID_TIME' end
        local counter=math.clamp(math.floor((now-state.startedAt)*60+1e-7),1,255)
        if counter&lt;=state.counter then return 'Active' end
        return self:_advance(counter)
    end

    function Intro:cancel(reason)
        if self.cancelled or self.complete then return self.complete and 'Complete' or 'Cancelled' end
        self.cancelled=true;self.state.active=false;self.state.phase='Cancelled';self.state.events={}
        self.state.cancelReason=reason
        if self.world.bossIntro then self.world:bossIntro(nil) end
        return 'Cancelled'
    end

    function Intro:snapshot()
        local s=self.state
        return {id=s.id,runId=s.runId,levelEpoch=s.levelEpoch,counter=s.counter,fearFrame=s.fearFrame,
            phase=s.phase,startedAt=s.startedAt,cameraCut=s.cameraCut,active=s.active}
    end
    return Intro
end
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT11">
          <Properties>
            <string name="Name">BossIntroWorld</string>
            <ProtectedString name="Source">-- Party-owned, cosmetic-only Boss Walker INTRO boundary. No hero assembly,
-- ownership, collision, damage, Lighting or Camera is changed here.
-- Replicated interface: world.folder/BossIntro (Folder) exposes Active(bool),
-- IntroId(string), RunId(string), LevelEpoch(number), Counter(number), Phase(string),
-- CameraCut(bool, latched from E0), FearFrame(number), StartedAt(server seconds),
-- and Focus(Vector3: group-local boss position + group offset + 6 vertical studs).
-- The folder is destroyed on FF/cancellation/clearActors; clients must release
-- their intro view when it disappears. World.bossIntroState contains plain data.
return function(World)
    if World.bossIntro then return World end
    local previousClear=World.clearActors
    local steel=Color3.fromRGB(81,93,101)
    local dark=Color3.fromRGB(33,39,44)
    local copper=Color3.fromRGB(184,119,57)
    local light=Color3.fromRGB(255,194,87)
    local function piece(parent,name,size,offset,color,shape)
        local p=Instance.new('Part');p.Name=name;p.Size=size;p.Color=color
        p.Material=Enum.Material.Metal;p.Anchored=true;p.Massless=true
        p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=true
        p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth
        if shape then p.Shape=shape end
        p.CFrame=offset;p.Parent=parent
        return {part=p,offset=offset}
    end
    local function makeFoot(folder)
        local model=Instance.new('Model');model.Name='IntroFoot12';model.Parent=folder
        model:SetAttribute('SourceFrame',0x12)
        model:SetAttribute('SourceScaleHeroHeights',3.88)
        model:SetAttribute('Adaptation','Authored 3D cosmetic path; no stomp damage')
        local parts={}
        local function add(name,x,y,z,sx,sy,sz,color,shape)
            parts[#parts+1]=piece(model,name,Vector3.new(sx,sy,sz),CFrame.new(x,y,z),color,shape)
        end
        -- A six-stud local hero reference yields a 23.28-stud silhouette.
        -- Original mechanical boot forms retain frame12's exaggerated scale.
        add('Sole',-1,1.05,0,12,2.1,8.8,dark)
        add('ToeArmor',-3.7,3.1,0,7,2.2,9.2,steel)
        add('HeelArmor',3.4,3.5,0,3.8,3.2,8.4,steel)
        add('Instep',0,5.2,0,5.8,3.6,7.8,copper)
        add('AnkleJoint',2,7.5,0,5.2,4.2,6.3,dark,Enum.PartType.Ball)
        add('ShinArmor',2,15.1,0,5.9,13.4,6.7,steel)
        add('ShinInset',-1.04,15.3,0,.32,9.8,3.2,copper)
        add('UpperBand',2,22.24,0,6.5,2.08,7.3,dark)
        for _,side in ipairs({-1,1}) do
            add('Piston'..side,2.1,14.5,side*3.65,1.2,12.5,1.1,copper)
            add('AnkleBolt'..side,2,7.5,side*3.4,2.2,2.2,.55,light,Enum.PartType.Ball)
            add('ToeRidge'..side,-3.7,4.32,side*2.5,6.8,.35,.7,dark)
        end
        return parts
    end
    local function importedLeg(folder)
        if not game then return nil end
        local storage=game:GetService('ServerStorage'):FindFirstChild('BrickToadsBossTemplates')
        local template=storage and storage:FindFirstChild('BossWalkerIntroLeg')
        if not template or not template:IsA('Model') then return nil end
        local ok,parts=pcall(function()
            local profile=template:FindFirstChild('AppearanceProfile')
            local scale=template:FindFirstChild('AppearanceScale')
            assert(profile and profile:IsA('StringValue') and profile.Value=='CanonicalBossWalkerIntroLeg')
            assert(scale and scale:IsA('NumberValue') and scale.Value==1)
            local source,count,seen=nil,0,{}
            for _,child in ipairs(template:GetChildren())do
                assert(not seen[child.Name],'Duplicate intro resource child');seen[child.Name]=true
                if child:IsA('MeshPart') then source=child;count+=1
                else
                    assert(#child:GetChildren()==0,'Nested metadata content')
                    if child.Name=='AppearanceProfile' then
                        assert(child:IsA('StringValue') and child.Value=='CanonicalBossWalkerIntroLeg')
                    elseif child.Name=='AppearanceScale' then assert(child:IsA('NumberValue') and child.Value==1)
                    elseif child.Name=='SourceAssetId' then
                        assert(child:IsA('StringValue') and child.Value:match('^%d+$') and tonumber(child.Value)&gt;0)
                    elseif child.Name=='SourceGlbSha256' or child.Name=='AssetManifestSha256' then
                        assert(child:IsA('StringValue') and #child.Value==64 and child.Value:match('^[0-9a-f]+$'))
                    else error('Unexpected intro metadata') end
                end
            end
            assert(count==1 and source.Name=='IntroLeg12' and source.MeshId:match('^rbxassetid://%d+$')
                and tonumber(source.MeshId:sub(14))&gt;0)
            local function finite(n)return type(n)=='number' and n==n and math.abs(n)&lt;math.huge end
            for _,n in ipairs({source.Size.X,source.Size.Y,source.Size.Z})do assert(finite(n) and n&gt;0)end
            local hasMeshSize,meshSize=pcall(function()return source.MeshSize end)
            if hasMeshSize and meshSize~=nil then
                for _,n in ipairs({meshSize.X,meshSize.Y,meshSize.Z})do assert(finite(n) and n&gt;0)end
            end
            assert(finite(source.Transparency) and source.Transparency&gt;=0 and source.Transparency&lt;1)
            local origin,n,surfaces=nil,0,0
            for _,child in ipairs(source:GetChildren())do
                assert(#child:GetChildren()==0,'Nested intro mesh content')
                if child:IsA('Attachment')then assert(child.Name=='IntroOriginRigAttachment');origin=child;n+=1
                else
                    assert(child:IsA('SurfaceAppearance') and child.Name=='SurfaceAppearance')
                    surfaces+=1;assert(surfaces&lt;=1)
                end
            end
            assert(n==1)
            local identity=source.CFrame*origin.CFrame
            local x,y,z=identity:ToEulerAnglesXYZ()
            for _,v in ipairs({identity.Position.X,identity.Position.Y,identity.Position.Z,x,y,z})do
                assert(finite(v) and math.abs(v)&lt;=1e-4)
            end
            -- Clone only the validated mesh; no behaviour travels with this resource.
            local mesh=source:Clone();mesh.Anchored=true;mesh.Massless=true
            mesh.CanCollide=false;mesh.CanTouch=false;mesh.CanQuery=false
            local model=Instance.new('Model');model.Name='IntroFoot12'
            model:SetAttribute('SourceFrame',0x12);model:SetAttribute('Appearance','CanonicalBossWalkerIntroLeg')
            model:SetAttribute('Adaptation','Source12 silhouette; authored3D depth and path')
            mesh.Parent=model;model.PrimaryPart=mesh;model.Parent=folder
            return {{part=mesh,offset=mesh.CFrame}}
        end)
        return ok and parts or nil
    end
    local function footFrame(state,offset)
        local c=state.counter==0xE0 and 0xDF or state.counter
        local p=state.bossPosition
        local x,y
        if c&lt;0x64 then
            local t=math.clamp((c-0x50)/20,0,1)
            x=p.x-29+13*t;y=22*(1-t)^2
        elseif c&lt;0xE0 then
            local t=(c-0x64)/(0xE0-0x64)
            x=p.x-16+16*t;y=4*math.sin(math.pi*t)
        else
            local t=math.clamp((c-0xE0)/30,0,1)
            x=p.x+10*t;y=17*t
        end
        return CFrame.new(Vector3.new(x,p.y-3+y,p.z)+offset)
    end
    function World:bossIntro(state)
        if not state then
            self.bossIntroState=nil
            if self.bossIntroFolder then self.bossIntroFolder:Destroy() end
            self.bossIntroFolder=nil;self.bossIntroParts=nil;self.bossIntroRipples=nil
            return
        end
        if self.bossIntroFolder and self.bossIntroFolder:GetAttribute('IntroId')~=state.id then self:bossIntro(nil) end
        if not self.bossIntroFolder then
            local folder=Instance.new('Folder');folder.Name='BossIntro';folder.Parent=self.folder
            folder:SetAttribute('IntroId',state.id)
            self.bossIntroFolder=folder;self.bossIntroParts=importedLeg(folder) or makeFoot(folder);self.bossIntroRipples={}
            -- Exactly two reused markers, even across skipped heartbeats.
            for _,counter in ipairs({0x30,0x64}) do
                local ring=piece(folder,'StompRipple'..counter,Vector3.new(.08,1,1),CFrame.new(),light,Enum.PartType.Cylinder).part
                ring.Material=Enum.Material.Neon;ring.CastShadow=false;ring.Transparency=1
                self.bossIntroRipples[counter]=ring
            end
        end
        self.bossIntroState=state
        local folder=self.bossIntroFolder
        folder:SetAttribute('Active',state.active==true)
        folder:SetAttribute('RunId',state.runId);folder:SetAttribute('LevelEpoch',state.levelEpoch)
        folder:SetAttribute('Counter',state.counter);folder:SetAttribute('Phase',state.phase)
        folder:SetAttribute('CameraCut',state.cameraCut==true);folder:SetAttribute('FearFrame',state.fearFrame)
        folder:SetAttribute('StartedAt',state.startedAt)
        local p=state.bossPosition
        folder:SetAttribute('Focus',Vector3.new(p.x,p.y+6,p.z)+self.offset)
        local frame=footFrame(state,self.offset)
        for _,row in ipairs(self.bossIntroParts) do
            row.part.CFrame=frame*row.offset
            row.part.Transparency=state.footFrame==0x12 and 0 or 1
        end
        for counter,ring in pairs(self.bossIntroRipples) do
            local age=state.counter-counter
            local visible=age&gt;=0 and age&lt;24
            ring.Transparency=visible and .2+.8*age/24 or 1
            local diameter=visible and 5+age*1.4 or 1
            ring.Size=Vector3.new(.08,diameter,diameter)
            local x=p.x-(counter==0x30 and 29 or 16)
            ring.CFrame=CFrame.new(Vector3.new(x,p.y-2.9,p.z)+self.offset)*CFrame.Angles(0,0,math.pi/2)
        end
    end
    function World:clearActors()
        self:bossIntro(nil)
        previousClear(self)
    end
    return World
end
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT12">
          <Properties>
            <string name="Name">BossQueue</string>
            <ProtectedString name="Source">-- Server-owned FIFO selection. Slots may compete, but each user has one queue/role state.
-- All methods are synchronous; eligibility is supplied by the authoritative controller.
-- The eligibility callback must not yield, mutate this queue, or reenter its methods.
local BossQueue={}
BossQueue.__index=BossQueue

local function finite(value)
    return type(value)=='number' and value==value and value&gt;-math.huge and value&lt;math.huge
end
local function identifier(value)
    return type(value)=='string' and #value&gt;0 and #value&lt;=160
end
local function validUser(userId)
    -- Studio clients use negative IDs; the server has already authenticated the identity.
    return finite(userId) and userId%1==0 and math.abs(userId)&lt;=9007199254740991
end

function BossQueue.new(options,eligible)
    options=options or {}
    local inviteSeconds=options.inviteSeconds or 10
    local connectSeconds=options.connectSeconds or 15
    assert(finite(inviteSeconds) and inviteSeconds&gt;0,'Invalid invitation duration')
    assert(finite(connectSeconds) and connectSeconds&gt;0,'Invalid connection duration')
    assert(eligible==nil or type(eligible)=='function','Invalid eligibility callback')
    return setmetatable({inviteSeconds=inviteSeconds,connectSeconds=connectSeconds,
        eligible=eligible or function() return true end,entries={},waiting={},slots={},slotOrder={},serial=0,now=0},BossQueue)
end

function BossQueue:_removeWaiting(entry)
    local waiting=self.waiting[entry.bossId]
    if not waiting then return end
    for index,userId in ipairs(waiting) do
        if userId==entry.userId then table.remove(waiting,index); return end
    end
end

function BossQueue:_release(entry)
    local slot=entry.slotId and self.slots[entry.slotId]
    if slot and slot.userId==entry.userId then slot.userId=nil end
    entry.slotId=nil; entry.offerId=nil; entry.deadline=nil
end

function BossQueue:_forget(entry)
    self:_removeWaiting(entry)
    self:_release(entry)
    self.entries[entry.userId]=nil
end

function BossQueue:_rotate(entry)
    self:_removeWaiting(entry)
    self:_release(entry)
    entry.state='Queued'
    local waiting=self.waiting[entry.bossId]
    waiting[#waiting+1]=entry.userId
end

function BossQueue:_fill()
    -- Registration order is stable even when slot identifiers sort differently.
    for _,slot in ipairs(self.slotOrder) do
        if slot.state=='Open' and not slot.userId then
            for _,userId in ipairs(self.waiting[slot.bossId] or {}) do
                local entry=self.entries[userId]
                if entry and entry.state=='Queued' and not slot.tried[userId] and self.eligible(userId,slot.context) then
                    self.serial+=1
                    entry.state='Invited'; entry.slotId=slot.id
                    entry.offerId='boss-offer:'..self.serial; entry.deadline=self.now+self.inviteSeconds
                    slot.userId=userId; slot.tried[userId]=true
                    break
                end
            end
        end
    end
end

function BossQueue:_advance(now)
    if not finite(now) or now&lt;0 then return 'INVALID_TIME' end
    -- A delayed caller cannot roll back deadlines already observed by the server.
    self.now=math.max(self.now,now)
    for _,slot in ipairs(self.slotOrder) do
        if slot.state=='Open' and slot.userId then
            local entry=self.entries[slot.userId]
            if not entry or entry.slotId~=slot.id then
                slot.userId=nil
            elseif (entry.deadline and self.now&gt;=entry.deadline) or not self.eligible(entry.userId,slot.context) then
                if entry.state=='Invited' then self:_rotate(entry)
                else self:_forget(entry) end
            end
        end
    end
    self:_fill()
    return 'OK'
end

function BossQueue:register(slotId,bossId,context,now)
    if not identifier(slotId) then return 'INVALID_SLOT' end
    if not identifier(bossId) then return 'INVALID_BOSS' end
    local result=self:_advance(now); if result~='OK' then return result end
    if self.slots[slotId] then return 'SLOT_EXISTS' end
    local slot={id=slotId,bossId=bossId,context=context,state='Open',tried={}}
    self.slots[slotId]=slot; self.slotOrder[#self.slotOrder+1]=slot
    self:_fill()
    return 'OK'
end

function BossQueue:select(userId,bossId,now)
    if not validUser(userId) then return 'INVALID_USER' end
    if not identifier(bossId) then return 'INVALID_BOSS' end
    local result=self:_advance(now); if result~='OK' then return result end
    local entry=self.entries[userId]
    if entry and entry.bossId==bossId then return 'OK' end
    if entry and (entry.state=='Accepted' or entry.state=='Ready' or entry.state=='Active') then return 'ROLE_RESERVED' end
    if not self.eligible(userId,nil) then return 'INELIGIBLE' end
    if entry then self:_forget(entry) end
    entry={userId=userId,bossId=bossId,state='Queued'}
    self.entries[userId]=entry
    local waiting=self.waiting[bossId]
    if not waiting then waiting={}; self.waiting[bossId]=waiting end
    waiting[#waiting+1]=userId
    self:_fill()
    return 'OK'
end

function BossQueue:cancel(userId,now)
    if not validUser(userId) then return 'INVALID_USER' end
    local result=self:_advance(now); if result~='OK' then return result end
    local entry=self.entries[userId]
    if not entry then return 'OK' end
    if entry.state=='Active' then return 'ROLE_ACTIVE' end
    self:_forget(entry); self:_fill()
    return 'OK'
end

function BossQueue:reply(userId,offerId,accepted,now)
    if not validUser(userId) then return 'INVALID_USER' end
    if not identifier(offerId) then return 'INVALID_OFFER' end
    if type(accepted)~='boolean' then return 'INVALID_REPLY' end
    local result=self:_advance(now); if result~='OK' then return result end
    local entry=self.entries[userId]
    if not entry or entry.offerId~=offerId then return 'STALE_OFFER' end
    if entry.state~='Invited' then
        if accepted and (entry.state=='Accepted' or entry.state=='Ready' or entry.state=='Active') then return 'OK' end
        return 'STALE_OFFER'
    end
    if accepted then
        self:_removeWaiting(entry)
        entry.state='Accepted'; entry.deadline=self.now+self.connectSeconds
    else
        -- tried is retained by the slot, so this entry can only serve a future slot.
        self:_rotate(entry)
    end
    self:_fill()
    return 'OK'
end

function BossQueue:connect(userId,offerId,now)
    if not validUser(userId) then return 'INVALID_USER' end
    if not identifier(offerId) then return 'INVALID_OFFER' end
    local result=self:_advance(now); if result~='OK' then return result end
    local entry=self.entries[userId]
    if not entry or entry.offerId~=offerId then return 'STALE_OFFER' end
    if entry.state=='Ready' or entry.state=='Active' then return 'OK' end
    if entry.state~='Accepted' then return 'STALE_OFFER' end
    entry.state='Ready'; entry.deadline=nil
    return 'OK'
end

function BossQueue:step(now)
    return self:_advance(now)
end

function BossQueue:start(slotId,now)
    local result=self:_advance(now); if result~='OK' then return nil,result end
    local slot=self.slots[slotId]
    if not slot then return nil,'UNKNOWN_SLOT' end
    if slot.state=='Closed' then return nil,'SLOT_CLOSED' end
    if slot.state=='NPC' then return {state='NPC'} end
    if slot.state=='Human' then return {state='Human',userId=slot.userId} end
    local entry=slot.userId and self.entries[slot.userId]
    if entry then
        if entry.state~='Ready' then return {state='Waiting'} end
        entry.state='Active'; slot.state='Human'
        return {state='Human',userId=entry.userId}
    end
    slot.state='NPC'
    return {state='NPC'}
end

function BossQueue:close(slotId,now)
    if not finite(now) or now&lt;0 then return 'INVALID_TIME' end
    local slot=self.slots[slotId]
    if not slot then return 'UNKNOWN_SLOT' end
    -- Close before processing deadlines: expiry must not rotate this owner or
    -- create a replacement offer that closing would immediately discard.
    if slot.userId then
        local entry=self.entries[slot.userId]
        if entry then self:_forget(entry) end
    end
    slot.userId=nil; slot.state='Closed'
    return self:_advance(now)
end

function BossQueue:view(userId,now)
    local result=self:_advance(now); if result~='OK' then return {state='None'},result end
    local entry=self.entries[userId]
    if not entry then return {state='None'} end
    local view={state=entry.state,bossId=entry.bossId,offerId=entry.offerId,
        slotId=entry.slotId,deadline=entry.deadline}
    if entry.state=='Queued' or entry.state=='Invited' then
        for position,id in ipairs(self.waiting[entry.bossId]) do
            if id==userId then view.position=position; break end
        end
    end
    return view
end

return BossQueue
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT13">
          <Properties>
            <string name="Name">CampaignBoss</string>
            <ProtectedString name="Source">-- Original 3D encounters. Source byte arithmetic, C0/80 Life thresholds and
-- 0583 reaction progress are measured; seconds/studs, move bindings and attack
-- vulnerability windows are Roblox tuning (research/2026-11-09-campaign-bosses.md).
-- Session owns hero shields, damage, death and respawn. This object owns no hero resources.
local Boss={}
Boss.__index=Boss
local profiles={
    BigBlag={life=255,first='Hop',second='BellyDrop',name='Big Blag'},
    RoboManus={life=15,progress=true,first='Burst',second='Jump',name='Robo-Manus'},
    GeneralSlaughter={life=255,progress=true,first='Charge',second='Headbutt',name='General Slaughter'},
    Buzzball={life=207,first='Roll',second='Bounce',name='Buzzball'},
    DarkQueen={life=15,progress=true,first='Sweep',second='Spin',name='Dark Queen'},
}
local moves={
    Hop={tell=.55,active=.65,recovery=.8,radius=5,lift=6,damage='PigHeavy'},
    BellyDrop={tell=.8,active=.85,recovery=1.05,radius=7,lift=12,damage='WalkerHeavy'},
    Burst={tell=.45,active=.55,recovery=.8,shots=3,damage='DragonFire'},
    Jump={tell=.65,active=.8,recovery=.9,radius=6,lift=10,damage='WalkerHeavy'},
    Charge={tell=.65,active=.75,recovery=1.0,speed=38,radius=3.2,damage='PigRush'},
    Headbutt={tell=.35,active=.2,recovery=.65,reach=7,width=3.5,height=4,damage='PigHeavy'},
    Roll={tell=.45,active=1.0,recovery=.85,speed=32,radius=3,damage='DragonHeadbutt'},
    Bounce={tell=.55,active=.85,recovery=.8,radius=5.5,lift=9,damage='DragonFire'},
    Sweep={tell=.4,active=.25,recovery=.7,reach=8,width=4,height=4,damage='WalkerHeavy'},
    Spin={tell=.7,active=1.8,recovery=1.1,radius=3.2,orbit=8,damage='PigRush'},
}
local damageByAction={Punch=2,HeroJab=2,HeroKick=8,HeroUppercut=16,HeroPowerPunch=255,HeroBoot=255,HeroElbow=8,
    Club=16,PigJab=2,PigHeavy=16,PigRush=16,WalkerLight=2,WalkerHeavy=16,
    DragonHeadbutt=16,DragonFire=16,EnemyThrow=4,EnemyRunStrike=16}
local responseByAction={Punch=0,HeroJab=0,HeroKick=1,HeroUppercut=2,HeroPowerPunch=3,HeroBoot=6,HeroElbow=10,
    Club=2,PigJab=0,PigHeavy=2,PigRush=4,WalkerLight=0,WalkerHeavy=2,
    DragonHeadbutt=4,DragonFire=4,EnemyRunStrike=4}
local function finite(n) return type(n)=='number' and n==n and n&gt;-math.huge and n&lt;math.huge end
local function point(p) return type(p)=='table' and finite(p.x) and finite(p.y) and finite(p.z) end
local function copy(p) return {x=p.x,y=p.y,z=p.z} end
local function distance(a,b)
    if not point(a) or not point(b) then return math.huge end
    return math.sqrt((a.x-b.x)^2+(a.y-b.y)^2+(a.z-b.z)^2)
end
local function segmentDistance(a,b,p)
    if not point(a) or not point(b) or not point(p) then return math.huge end
    local x,y,z=b.x-a.x,b.y-a.y,b.z-a.z;local length=x*x+y*y+z*z
    local t=length&gt;0 and math.clamp(((p.x-a.x)*x+(p.y-a.y)*y+(p.z-a.z)*z)/length,0,1) or 0
    return distance({x=a.x+t*x,y=a.y+t*y,z=a.z+t*z},p)
end
local function aimVector(aim)
    if type(aim)~='table' or not finite(aim.x) or not finite(aim.z) then return nil end
    local length=math.sqrt(aim.x^2+aim.z^2)
    if not finite(length) or length&lt;.001 then return nil end
    return {x=aim.x/length,z=aim.z/length}
end
local function byteDamage(raw,damage)
    if raw&lt;damage then return 0,true end
    local after=raw-damage
    if math.floor(after/16)~=math.floor(raw/16) then after=math.floor(after/16)*16+15 end
    return after,false
end

function Boss.new(session,world,config,definition)
    local authored=definition.boss or {};local profile=assert(profiles[authored.type],'Unknown campaign boss')
    local now=session.now or 0;local origin=authored.position or {x=0,y=3,z=0}
    assert(point(origin),'Boss position must be finite')
    local gate=definition.bossGate or {};local actorId=session.state.runId..':boss:'..session.state.levelEpoch..':'..authored.type
    local arena=definition.arena
    local platform=authored.platform
    if not arena and type(platform)=='table' and finite(platform.x) and finite(platform.z)
        and finite(platform.w) and finite(platform.d) and platform.w&gt;6 and platform.d&gt;6 then
        arena={minX=platform.x-platform.w/2+3,maxX=platform.x+platform.w/2-3,
            minZ=platform.z-platform.d/2+3,maxZ=platform.z+platform.d/2-3}
    end
    local enemy={boss=true,kind=authored.type,name=profile.name,actorId=actorId,rawLife=profile.life,
        maxRawLife=profile.life,health=profile.life,maxHealth=profile.life,progress=profile.progress and 0 or nil,
        ownerUserId=gate.ownerUserId,connected=gate.connected~=false,connectionEpoch=gate.connectionEpoch or 1,lastSeq=0,dead=false}
    local self=setmetatable({session=session,world=world,config=config,definition=definition,profile=profile,
        kind=authored.type,enemies={[-99]=enemy},projectiles={},byUserId={},now=now,serial=0,attackSerial=0,
        state=authored.type=='Buzzball' and authored.chaseComplete~=true and 'Chase' or 'Ready',readyAt=now+.5,
        origin=copy(origin),arena=arena or {},defeated=false,ownerName=gate.ownerName},Boss)
    if gate.ownerUserId then self.byUserId[gate.ownerUserId]=-99 end
    assert(world:spawnEnemy(-99,authored.type,origin),'Campaign boss spawn failed')
    -- Campaign bosses accept ordinary human movement between attacks. The
    -- stationary first guardian uses a different constructor and keeps its cap.
    if world.campaignWalkSpeed then world:campaignWalkSpeed(-99,config.Enemy.speed) end
    if world.enemyIdentity then world:enemyIdentity(-99,actorId,gate.ownerName) end
    self:_health();self:_log('CampaignBossSpawned',{bossType=self.kind,rawLife=enemy.rawLife,progress=enemy.progress})
    return self
end
function Boss:_log(kind,data)
    if self.session._record then self.session:_record(kind,-99,data,self.now) end
end
function Boss:_active() return not self.closed and not self.defeated and self.session.state.status=='Active' end
function Boss:_health()
    local e=self.enemies[-99];e.health=e.rawLife
    self.world:enemyHealth(-99,e.rawLife,e.maxRawLife)
end
function Boss:_phase()
    local e=self.enemies[-99]
    if self.kind=='BigBlag' then return e.rawLife&gt;=192 and 1 or e.rawLife&gt;=128 and 2 or 3 end
    if self.kind=='Buzzball' then return e.rawLife&gt;=128 and 1 or 2 end
    return (e.progress or 0)&gt;=120 and 2 or 1
end
function Boss:_bound(p)
    local a=self.arena;local o=self.origin
    return {x=math.clamp(p.x,a.minX or o.x-28,a.maxX or o.x+28),y=p.y,
        z=math.clamp(p.z,a.minZ or o.z-22,a.maxZ or o.z+22)}
end
function Boss:_contain()
    -- The source encounter is camera/arena locked. Constrain the boss body in
    -- every combat state, including physical knockback, so a reaction cannot
    -- strand it beneath its finite authored platform. Chase owns another route.
    if self.state=='Chase' then return end
    local p=self.world:position(-99);if not point(p) then return end
    local bounded=self:_bound(p);bounded.y=math.max(p.y,self.origin.y)
    if distance(p,bounded)&gt;.001 then self.world:placeActor(-99,bounded) end
end
function Boss:_targets()
    local ids={}
    for _,id in ipairs(self.session.order) do
        local h=self.session.state.heroes[id];local c=self.session.combat[id]
        if h and h.status=='Alive' and c and not c.deathAt and point(self.world:position(id)) then ids[#ids+1]=id end
    end
    for id,e in pairs(self.externalEnemies or {}) do
        if id~=-99 and not e.dead and point(self.world:position(id)) then ids[#ids+1]=id end
    end
    table.sort(ids);return ids
end
function Boss:_nearest()
    local origin=self.world:position(-99);local selected,best=nil,math.huge
    for _,id in ipairs(self:_targets()) do
        local range=distance(origin,self.world:position(id))
        if range&lt;best then selected,best=id,range end
    end
    return selected,best
end
function Boss:_finishReaction()
    if finite(self.session.now) then self.now=math.max(self.now,self.session.now) end
    if not self:_active() or self.state~='Reaction' or self.now&lt;self.reactionUntil then return false end
    local e=self.enemies[-99];e.rawLife=math.floor(e.rawLife/8)*8+7
    self.state='Ready';self.reactionUntil=nil;self.lightReaction=nil;self.heavyReaction=nil;self.readyAt=self.now+.25
    if self.world.setReaction then self.world:setReaction(-99,false) end;self:_health()
    return true
end
function Boss:canMove(now)
    if now~=nil then
        if not finite(now) or now&lt;self.now then return false end
        self.now=now
    end
    self:_finishReaction()
    return self:_active() and self.state=='Ready'
end
function Boss:_damage(target,action,hitSet,tuning)
    if hitSet[target] then return end
    hitSet[target]=true
    tuning=tuning or self.config.Attacks[action] or self.config.Attacks.Dash
    if self.session.state.heroes[target] then self.session:_hit(-99,target,action,tuning)
    elseif self.enemyHit then self.enemyHit(-99,target,action,tuning) end
end
function Boss:_sweep(before,after,radius,attack)
    for _,id in ipairs(self:_targets()) do
        if segmentDistance(before,after,self.world:position(id))&lt;=radius then self:_damage(id,attack.move.damage,attack.hits) end
    end
end
function Boss:_radial(center,radius,attack)
    for _,id in ipairs(self:_targets()) do
        local p=self.world:position(id)
        if math.abs(p.y-center.y)&lt;=3.5 and (p.x-center.x)^2+(p.z-center.z)^2&lt;=radius^2 then
            self:_damage(id,attack.move.damage,attack.hits)
        end
    end
end
function Boss:_melee(attack)
    local p=self.world:position(-99);local m=attack.move
    for _,id in ipairs(self:_targets()) do
        local q=self.world:position(id);local x,z=q.x-p.x,q.z-p.z
        local forward=x*attack.aim.x+z*attack.aim.z;local side=x*attack.aim.z-z*attack.aim.x
        if forward&gt;=0 and forward&lt;=m.reach and math.abs(side)&lt;=m.width and math.abs(q.y-p.y)&lt;=m.height then
            self:_damage(id,m.damage,attack.hits)
        end
    end
end
function Boss:_removeProjectile(id)
    if not self.projectiles[id] then return end
    self.projectiles[id]=nil;self.world:removeProjectile(id)
end
function Boss:_clearProjectiles()
    local ids={};for id in pairs(self.projectiles) do ids[#ids+1]=id end
    for _,id in ipairs(ids) do self:_removeProjectile(id) end
end
function Boss:_projectile(attack,at,index)
    self.serial+=1;local id=-4001-self.serial*2;local origin=copy(self.world:position(-99))
    local angle=(index-2)*.10;local c,s=math.cos(angle),math.sin(angle)
    local aim={x=attack.aim.x*c-attack.aim.z*s,z=attack.aim.x*s+attack.aim.z*c}
    -- The accepted bolt keeps its own response and spread direction even if
    -- its controller turns, disconnects or starts another attack before impact.
    local tuning=table.clone(self.config.Attacks[attack.move.damage] or self.config.Attacks.Dash)
    tuning.impulseDirection={x=aim.x,z=aim.z}
    local p={position=origin,direction=aim,created=at,lastAt=at,expiresAt=at+2.5,action=attack.move.damage,
        tuning=tuning,hits={},attackSerial=attack.serial}
    self.projectiles[id]=p;self.world:projectile(id,p.position,false,'RoboBolt')
end
function Boss:_projectiles(now)
    local ids={};for id in pairs(self.projectiles) do ids[#ids+1]=id end;table.sort(ids)
    for _,id in ipairs(ids) do
        local p=self.projectiles[id];local duration=math.max(0,math.min(now,p.expiresAt)-p.lastAt)
        local before=p.position
        local after={x=before.x+p.direction.x*42*duration,y=before.y,z=before.z+p.direction.z*42*duration}
        local best,bestDistance=nil,math.huge
        for _,target in ipairs(self:_targets()) do
            local q=self.world:position(target)
            if segmentDistance(before,after,q)&lt;=2.1
                and not (self.world.campaignProjectileBlocked and self.world:campaignProjectileBlocked(before,q)) then
                local d=distance(before,q);if d&lt;bestDistance then best,bestDistance=target,d end
            end
        end
        if best then self:_damage(best,p.action,p.hits,p.tuning);self:_removeProjectile(id)
        elseif now&gt;=p.expiresAt or self.world.campaignProjectileBlocked and self.world:campaignProjectileBlocked(before,after) then self:_removeProjectile(id)
        else p.position=after;p.lastAt=now;self.world:projectile(id,after,false,'RoboBolt') end
    end
end
function Boss:_begin(name,aim,target)
    if not self:_active() then return 'RUN_CLOSED' end
    if self.state~='Ready' then return 'COOLDOWN' end
    local origin=self.world:position(-99);if not point(origin) then return 'NO_TARGET' end
    local direction=aimVector(aim)
    if aim~=nil and not direction then return 'INVALID_AIM' end
    if not direction then
        target=target or self:_nearest();local p=target and self.world:position(target)
        if not point(p) then return 'NO_TARGET' end
        direction=aimVector({x=p.x-origin.x,z=p.z-origin.z}) or {x=1,z=0}
    end
    local m=moves[name];local destination
    if target then destination=copy(self.world:position(target))
    else destination={x=origin.x+direction.x*12,y=origin.y,z=origin.z+direction.z*12} end
    destination.y=origin.y;destination=self:_bound(destination)
    self.attackSerial+=1
    self.attack={name=name,move=m,aim=direction,target=target,origin=copy(origin),destination=destination,
        tellAt=self.now+m.tell,activeUntil=self.now+m.tell+m.active,
        recoveryUntil=self.now+m.tell+m.active+m.recovery,hits={},shots=0,serial=self.attackSerial,lastAt=self.now+m.tell}
    self.state='Tell';self.enemies[-99].engaged=true;self.lastMove=nil
    if self.world.move then self.world:move(-99,0,0) end
    if self.world.aim then self.world:aim(-99,direction.x,direction.z) end
    if target and self.world.face then self.world:face(-99,target) end
    self.world:cue(-99,true)
    if self.world.bossTell then self.world:bossTell(name,destination,m.radius or m.reach or 3,self.attack.tellAt) end
    self:_log('CampaignBossAttack',{bossType=self.kind,attack=name,serial=self.attackSerial,phase=self:_phase(),effectAt=self.attack.tellAt})
    return 'OK'
end
function Boss:command(action,aim,now)
    if now~=nil then
        if not finite(now) or now&lt;0 then return 'INVALID_TIME' end
        if now&lt;self.now then return 'TIME_REVERSED' end
        self.now=now
    elseif finite(self.session.now) then self.now=math.max(self.now,self.session.now) end
    if not self:_active() then return 'RUN_CLOSED' end
    local e=self.enemies[-99]
    if e.ownerUserId and not e.connected then return 'OFFLINE' end
    if action~='Punch' and action~='Dash' then return 'INVALID_ACTION' end
    self:_finishReaction()
    return self:_begin(self:_chooseAttack(action),aim)
end
function Boss:_chooseAttack(action)
    if action=='Dash' then return self.profile.second end
    if self.kind=='BigBlag' and self:_phase()==1 then return 'Hop' end
    return self.attackSerial%2==0 and self.profile.first or self.profile.second
end
function Boss:_motion(attack,at)
    local m=attack.move;local t=math.clamp((at-attack.tellAt)/m.active,0,1);local p
    if m.lift then
        p={x=attack.origin.x+(attack.destination.x-attack.origin.x)*t,
            y=attack.origin.y+math.sin(t*math.pi)*m.lift,z=attack.origin.z+(attack.destination.z-attack.origin.z)*t}
    elseif m.speed then
        local speed=m.speed*(self:_phase()==2 and self.kind=='GeneralSlaughter' and 1.2 or 1)
        p={x=attack.origin.x+attack.aim.x*speed*(at-attack.tellAt),y=attack.origin.y,
            z=attack.origin.z+attack.aim.z*speed*(at-attack.tellAt)}
    elseif m.orbit then
        p={x=attack.origin.x+math.sin(t*math.pi*4)*m.orbit,y=attack.origin.y,
            z=attack.origin.z+(1-math.cos(t*math.pi*4))*m.orbit*.5}
    else return copy(self.world:position(-99)) end
    return self:_bound(p)
end
function Boss:_attackStep(now)
    local a=self.attack;if not a then return end
    if self.state=='Tell' and now&gt;=a.tellAt then self.state='Active';self.world:cue(-99,false) end
    if self.state=='Active' then
        local m=a.move;local untilAt=math.min(now,a.activeUntil)
        if m.shots then
            for index=a.shots+1,m.shots do
                local at=a.tellAt+(index-1)*.18
                if at&gt;untilAt then break end
                self:_projectile(a,at,index);a.shots=index
            end
        elseif m.reach then self:_melee(a)
        elseif m.orbit then
            -- Curved spin is subdivided, so a coarse frame cannot cut through
            -- the orbit and strike a target the actual path never crossed.
            local cursor=a.lastAt
            while cursor&lt;untilAt do
                local nextAt=math.min(untilAt,cursor+.05)
                local before=self:_motion(a,cursor);local after=self:_motion(a,nextAt)
                self:_sweep(before,after,m.radius,a);cursor=nextAt
            end
            self.world:placeActor(-99,self:_motion(a,untilAt))
        elseif m.speed then
            local before=self:_motion(a,a.lastAt);local after=self:_motion(a,untilAt)
            self:_sweep(before,after,m.radius,a);self.world:placeActor(-99,after)
        elseif m.lift then self.world:placeActor(-99,self:_motion(a,untilAt)) end
        a.lastAt=untilAt
        if now&gt;=a.activeUntil then
            if m.lift then self:_radial(a.destination,m.radius,a) end
            self.state='Recovery';self.world:cue(-99,false)
        end
    end
    if self.state=='Recovery' and now&gt;=a.recoveryUntil then
        self.state='Ready';self.attack=nil;self.readyAt=now+.25
    end
end
function Boss:_defeat()
    if self.defeated then return end
    self.defeated=true;self.state='Defeated';self.attack=nil;self.lastMove=nil
    local e=self.enemies[-99];e.dead=true;e.rawLife=0;self:_health();self:_clearProjectiles()
    self.world:cue(-99,false);if self.world.kill then self.world:kill(-99) end
    self:_log('CampaignBossDefeated',{bossType=self.kind,progress=e.progress})
end
function Boss:hit(attacker,target,action,tuning)
    self:_finishReaction()
    if target~=-99 or attacker==-99 or not self:_active()
        or self.state~='Ready' and self.state~='Recovery' and not (self.state=='Reaction' and self.lightReaction) then return false end
    local origin=self.world:position(attacker);local destination=self.world:position(-99)
    local cfg=self.config.Attacks[action];local damage=damageByAction[action]
    if action=='Dash' then damage=self.enemies[-99].rawLife&lt;16 and 255 or 16 end
    if not cfg or not damage or not point(origin) or not point(destination) then return false end
    local geometry=tuning or cfg
    -- Only server projectile collision code supplies this contact point. Public
    -- intents cannot carry tuning, target IDs or collision coordinates.
    local impact=tuning and tuning.impactPosition
    local reach=finite(geometry.reach) and geometry.reach or cfg.reach or 6
    local height=finite(geometry.height) and geometry.height or cfg.height or 4
    if impact~=nil then
        if not point(impact) or distance(impact,destination)&gt;2.5 then return false end
    elseif distance(origin,destination)&gt;reach+1 or math.abs(origin.y-destination.y)&gt;height then return false end
    if impact==nil and self.world.targets then
        local visible=false
        for _,id in ipairs(self.world:targets(attacker,geometry)) do if id==-99 then visible=true;break end end
        if not visible then return false end
    end
    local hero=self.session.state.heroes[attacker];local enemy=self.externalEnemies and self.externalEnemies[attacker]
    if hero then
        local c=self.session.combat[attacker]
        if hero.status~='Alive' or not c or c.deathAt then return false end
    elseif not enemy or enemy.dead and impact==nil then return false end
    local e=self.enemies[-99];local before=e.rawLife;local after,underflow=byteDamage(before,damage)
    e.rawLife=after
    self:_log('CampaignBossHit',{attacker=attacker,action=action,before=before,after=after,underflow=underflow,progress=e.progress})
    if underflow and (not self.profile.progress or e.progress&gt;=240) then self:_defeat();return true end
    if underflow then e.progress+=12 end
    self.attack=nil;self.state='Reaction';self.lightReaction=damage==2;self.heavyReaction=damage~=2
    self.reactionUntil=self.now+(self.lightReaction and 1.05 or .4)
    self.world:cue(-99,false);if self.world.setReaction then self.world:setReaction(-99,true) end
    local response=responseByAction[action] or (action=='Dash' and (damage==255 and 3 or 4))
    local impulse=response and self.config.Impulses[response]
    if impulse and self.world.impulse then self.world:impulse(-99,attacker,impulse,response) end
    self:_health();return true
end
function Boss:selectAction(input)
    self:_finishReaction()
    local raw=self.enemies[-99].rawLife
    local heavy=self.state=='Reaction' and self.heavyReaction==true
    if input=='Dash' then return heavy and 'HeroBoot' or 'Dash' end
    if heavy then return raw&lt;8 and 'HeroBoot' or 'HeroKick' end
    if raw&lt;4 then return 'HeroPowerPunch' end
    if raw%16&lt;4 then return 'HeroUppercut' end
    return 'HeroJab'
end
function Boss:finishChase()
    if not self:_active() then return 'RUN_CLOSED' end
    if self.state~='Chase' then return 'NO_CHANGE' end
    self.state='Ready';self.readyAt=self.now+.5
    self:_log('BuzzballBattleStarted',{actorId=self.enemies[-99].actorId,rawLife=self.enemies[-99].rawLife})
    return 'OK'
end
function Boss:step(now,dt)
    if not finite(now) or now&lt;0 or dt~=nil and (not finite(dt) or dt&lt;0) then return 'INVALID_TIME' end
    if now&lt;self.now then return 'TIME_REVERSED' end
    self.now=now
    if not self:_active() then self:_clearProjectiles();return 'OK' end
    self:_contain()
    self:_finishReaction()
    if self.lastMove and now-self.lastMove&gt;=(self.config.MoveTimeout or .35) then
        self.lastMove=nil
        if self.world.move then self.world:move(-99,0,0,false) end
    end
    self:_attackStep(now);self:_projectiles(now)
    local e=self.enemies[-99]
    if self.state=='Ready' and not e.ownerUserId and now&gt;=self.readyAt then
        local target,range=self:_nearest()
        if target and range&lt;=80 then
            local name=self:_chooseAttack('Punch')
            self:_begin(name,nil,target)
        end
    end
    return 'OK'
end
function Boss:available() return {} end
function Boss:claim() return 'UNKNOWN_ENEMY' end
function Boss:connection(userId,connected)
    local e=self.enemies[-99]
    if userId~=e.ownerUserId then return 'UNKNOWN_ENEMY' end
    if type(connected)~='boolean' then return 'INVALID_CONNECTION' end
    if e.connected==connected then return 'NO_CHANGE' end
    e.connected=connected;e.connectionEpoch+=1;e.lastSeq=0;self.lastMove=nil
    if self.world.move then self.world:move(-99,0,0) end
    return 'OK'
end
function Boss:controlled(userId)
    local e=self.enemies[-99];if e.ownerUserId~=userId then return nil end
    return {enemyId=-99,actorId=e.actorId,attempt=1,connectionEpoch=e.connectionEpoch,connected=e.connected,
        status=e.dead and 'Dead' or 'Alive',template='Boss',name=self.ownerName or e.name,
        hearts=e.rawLife,maxHearts=e.maxRawLife,rawLife=e.rawLife,progress=e.progress,maxProgress=self.profile.progress and 240 or nil,
        bossType=self.kind,bossState=self.state,bossPhase=self:_phase()}
end
function Boss:snapshot()
    local e=self.enemies[-99]
    return {bossType=self.kind,bossName=e.name,bossRawLife=e.rawLife,bossMaxRawLife=e.maxRawLife,
        rawLife=e.rawLife,maxRawLife=e.maxRawLife,progress=e.progress,maxProgress=self.profile.progress and 240 or nil,
        bossProgress=e.progress,bossMaxProgress=self.profile.progress and 240 or nil,bossPhase=self:_phase(),
        bossState=self.state,bossAttack=self.attack and self.attack.name,bossDefeated=self.defeated,
        bossVulnerable=self:_active() and (self.state=='Ready' or self.state=='Recovery' or self.state=='Reaction' and self.lightReaction),projectiles=(function()
            local n=0;for _ in pairs(self.projectiles) do n+=1 end;return n end)()}
end
function Boss:close(reason)
    if self.closed then return end
    self.closed=reason or 'Closed';self.state='Closed';self.attack=nil;self.lastMove=nil;self:_clearProjectiles()
    self.world:cue(-99,false);if self.world.move then self.world:move(-99,0,0) end
    if self.world.setReaction then self.world:setReaction(-99,false) end
end
return Boss
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT14">
          <Properties>
            <string name="Name">CampaignDefinition</string>
            <ProtectedString name="Source">-- Original BrickToads courses. Mode/family inventory follows FULL_GAME_SCOPE;
-- every distance, speed, geometry, population and timer here is Roblox tuning.
-- No ROM track data, music, art or unknown source object identities are copied.
local Definition={count=13,bossTypes={'CausewayGuardian','BigBlag','RoboManus','GeneralSlaughter','Buzzball','DarkQueen'}}
local MOD=2147483647
local function copy(v) if type(v)~='table' then return v end;local r={};for k,a in pairs(v) do r[k]=copy(a) end;return r end
local function floor(x,top,z,w,d) return {x=x,y=top-1,z=z,w=w,h=2,d=d} end
local function point(x,y,z) return {x=x,y=y,z=z or 0} end
local function volume(x,y,z,w,h,d) return {minX=x-w/2,maxX=x+w/2,minY=y-h/2,maxY=y+h/2,minZ=z-d/2,maxZ=z+d/2} end
local function hazard(id,kind,x,y,z,w,h,d,motion)
    return {id=id,kind=kind,x=x,y=y,z=z,w=w,h=h,d=d,motion=motion}
end
local names={"Flooded Causeway","Echo Shaft","Copper Rush","Frostworks","Tidal Foundry","Four Coil Vaults",
    "Ember Airway","Machine Ascent","Pressure Pipes","Fuse Pursuit","Magnetic Circuit","Turning Spire","Last Eclipse"}
local modes={'Causeway','Rope','Speeder','Ice','Surf','Serpents','Jet','Ascent','Tubes','Race','Clinger','Tower','Finale'}
local bossByLevel={[5]='BigBlag',[8]='RoboManus',[10]='GeneralSlaughter',[11]='Buzzball',[13]='DarkQueen'}
local objectives={Rope='Descend on the rope; swing clear of the shaft traps',Speeder='Board the speeder; steer and jump through the course',
    Ice='Control your slide across the frozen platforms',Surf='Board the surfboard and reach the shoreline',Serpents='Ride moving serpents through all four vaults',
    Jet='Board the jet and steer through the aerial gates',Ascent='Climb the lifts, springs and fan shafts',Tubes='Cross dry pipes and swim the flooded chambers',
    Race='Beat the rat to every bomb and defuse it',Clinger='Hold each route direction and stay ahead of the orb',Tower='Climb around the rotating spire and resist the wind',
    Finale='Enter the eclipse arena and defeat the final guardian'}
local function sourceModule(name)
    if script then return require(script.Parent[name]) end
    return require('./'..name)
end
-- All heights use the same piecewise-linear profile as the physical road panels.
function Definition.roadHeight(course,x)
    local profile=course.roadProfile
    if not profile then return 0 end
    local u=math.clamp((x-profile.startX)/profile.spacing,0,#profile.heights-1)
    local i=math.min(math.floor(u)+1,#profile.heights-1)
    return profile.heights[i]+(profile.heights[i+1]-profile.heights[i])*(u-i+1)
end
function Definition.build(index,seed)
    assert(type(index)=='number' and index%1==0 and index&gt;=1 and index&lt;=13,'Invalid campaign index')
    assert(type(seed)=='number' and seed==seed and seed%1==0 and seed&gt;=1 and seed&lt;MOD,'Invalid campaign seed')
    if index==1 then
        local d=sourceModule('LevelVariation').build(sourceModule('LevelDefinition'),seed)
        d.campaignIndex=1;d.mode='Causeway';d.spawn=point(-65,3,0);d.boss.kind='CausewayGuardian';return d
    end
    local rng=(seed+index*7919)%(MOD-1)+1
    local choices={}
    local function choose() rng=rng*48271%MOD;local n=rng%3+1;choices[#choices+1]=n;return n end
    local c={hazards={},checkpoints={},supports={},media={},platforms={},tuning='ROBLOX_ORIGINAL_COURSE',speed=28}
    local d={id='campaign-'..index,name=names[index],campaignIndex=index,mode=modes[index],course=c,
        requiresClearAtExit=false,
        spawn=point(0,3,0),bounds={minX=-32,maxX=500,minY=-60,maxY=280,minZ=-56,maxZ=56},
        variation={version=1,seed=seed,sectionChoices=choices},calibration='ORIGINAL_ROBLOX_MODE_TUNING'}
    local platforms,enemies={},{}
    local function addFloor(x,y,z,w,depth) local p=floor(x,y,z,w,depth);platforms[#platforms+1]=p;return p end
    local function cp(x,y,z,progress) c.checkpoints[#c.checkpoints+1]={position=point(x,y,z),progress=progress} end
    local function foe(kind,x,y,z) enemies[#enemies+1]={id=-#enemies-1,kind=kind,x=x,y=y,z=z,rawLife=31} end
    local finish=point(180,3,0)
    if index==2 then
        c.anchor=point(0,258,0);c.ropeLength=15;c.descentSpeed=10;c.swingLimit=16;c.swingAcceleration=32;c.swingDamping=1.1;c.emitters={}
        d.spawn=point(0,240,0);addFloor(0,237,0,18,20);addFloor(0,0,0,46,32);cp(0,240,0,0)
        for n=1,9 do local v=choose();local y=220-n*20
            c.hazards[#c.hazards+1]=hazard('shaft-'..n,({'Raven','ElectricTrap','Toadtrap'})[(n-1)%3+1],(v-2)*10,y,0,9,5,18,
                n%3==0 and {axis='x',amplitude=5,period=3.5,phase=n} or nil)
            if n%3==0 then cp(0,y+12,0,240-y-12) end
        end
        for n=1,3 do c.emitters[n]={id='shaft-blaster-'..n,kind='RetroBlaster',position=point(n%2==0 and -22 or 22,225-n*55,0),interval=2.3,speed=15,life=3} end
        finish=point(0,3,0);c.axis='descent';d.bounds.maxX=38;d.bounds.maxY=270;d.bounds.minY=-25
    elseif index==3 or index==5 or index==7 then
        local surf=index==5;local jet=index==7
        c.speed=jet and 35 or (surf and 29 or 32);c.acceleration=jet and .45 or .35;c.maxSpeed=jet and 52 or 48
        c.mount=point(24,3,0);c.mountRange=7;c.finishDistance=420;c.laneLimit=18;c.steerSpeed=22;c.jumpSpeed=42
        -- Only the entry foot patrol blocks boarding. Rocket rats are actual
        -- later scripted encounters, never an enemy that must die before riding.
        addFloor(5,0,0,58,46);foe('Invader',28,3,-10)
        c.restart={stopSeconds=.35,rewindSeconds=.55,acceleration=110,tuning='ROBLOX_ORIGINAL_RESTART_TIMING'}
        c.encounters={}
        if index==3 or index==7 then c.encounters[1]={id='rocket-rat-pass-1',kind='RocketRat',progress=90,
            position=point(138,jet and 27 or 14,12),allowedDrop=true,
            trajectory={from=point(138,jet and 27 or 14,12),to=point(274,jet and 27 or 14,-12),duration=4,dropAt=1.5,dropGroundY=3}}
        end
        if surf then c.media[1]={kind='Water',minX=32,maxX=450,minY=-12,maxY=1,minZ=-25,maxZ=25} end
        if jet then c.altitudeMin=5;c.altitudeMax=31;c.mount.y=8 end
        c.ramps={};c.emitters={}
        cp(24,c.mount.y,0,0)
        local sectors=index==3 and 4 or 1
        local extension=(sectors-1)*410
        finish=point(434+extension,3,0)
        if index==3 then
            c.finishDistance=finish.x-c.mount.x
            local heights={0}
            local shape={0,3,8,11,8,3,-2,-6,-7,-4,0,4,6,4,0,-3,-6,-4,-1,0,0}
            for sector=1,sectors do
                for sample=2,#shape do
                    local h=sector%2==1 and shape[sample] or -shape[#shape-sample+1]
                    table.insert(heights,h*(1+(sector-1)*.08))
                end
            end
            local startX=34
            local spacing=(finish.x-26-startX)/(#heights-1)
            c.roadProfile={startX=startX,spacing=spacing,heights=heights}
            for i=1,#heights-1 do
                local h1,h2=heights[i],heights[i+1]
                local slab=addFloor(startX+(i-.5)*spacing,(h1+h2)/2,0,spacing,46)
                slab.roadRise=h2-h1
            end
            local t=c.encounters[1].trajectory
            t.dropGroundY=3+Definition.roadHeight(c,t.from.x+(t.to.x-t.from.x)*t.dropAt/t.duration)
        end
        local sectionX=54
        for n=1,12*sectors do
            local section=(n-1)%12+1
            if section==1 then sectionX=54+410*math.floor((n-1)/12) end
            local v=choose();sectionX+=25+v;local x=sectionX
            local kind=jet and ({'AirMine','ElectricGate','Rocket'})[(n-1)%3+1] or
                (surf and ({'Mine','Log','Whirlpool'})[(n-1)%3+1] or ({'Wall','LowBarrier','Overhead'})[(n-1)%3+1])
            local y=jet and (8+(v-1)*9) or (kind=='Overhead' and 10 or 3)
            local h=jet and 9 or (kind=='Overhead' and 5 or (kind=='Wall' and 18 or 3))
            local z=jet and 0 or (v-2)*12;local depth=(jet or kind=='LowBarrier' or kind=='Log') and 44 or 12
            c.hazards[#c.hazards+1]=hazard('ride-'..n,kind,x,y+Definition.roadHeight(c,x),z,3,h,depth,
                kind=='Rocket' and {axis='z',amplitude=8,period=2.4,phase=n} or nil)
            if section==4 or section==8 or (section==12 and n&lt;12*sectors) then cp(x+12,c.mount.y+Definition.roadHeight(c,x+12),0,x+12-c.mount.x) end
            if index==3 and (section==2 or section==8) then c.ramps[#c.ramps+1]={id='ramp-'..n,x=x-10,y=1,z=0,w=10,h=2,d=12,launchSpeed=50} end
        end
        if surf or jet then for n=1,3 do c.emitters[n]={id='ride-launcher-'..n,kind='RocketLauncher',position=point(100+n*85,jet and 20 or 4,23),interval=3,speed=18,life=2} end end
        addFloor(439+extension,0,0,62,48);d.bounds.maxX=495+extension;c.axis='x'
    elseif index==4 then
        c.acceleration=19;c.friction=2.4;c.maxSpeed=25;c.gravity=150;c.jumpSpeed=51
        local cursor=-12
        for n=1,9 do local v=choose();local width=25+v*4;local z=(v-2)*3
            addFloor(cursor+width/2,(n%3==0 and 2 or 0),z,width,30);cursor+=width
            if n&lt;9 then cursor+=4 end
            if n%2==0 then c.hazards[#c.hazards+1]=hazard('ice-'..n,n%4==0 and 'Icicle' or 'Snowball',cursor-8,5,(v-2)*9,4,6,7,
                {axis=n%4==0 and 'y' or 'z',amplitude=n%4==0 and 4 or 10,period=3,phase=n}) end
            if n==3 or n==6 then cp(cursor-8,5,z,cursor-8) end
        end
        c.blocks={}
        for _,n in ipairs({2,6}) do local p=platforms[n]
            c.blocks[#c.blocks+1]={id='ice-block-'..n,kind='IceBlock',position=point(p.x,p.y+p.h/2+2,p.z+8),w=6,h=4,d=6,
                minX=p.x-p.w/2+4,maxX=p.x+p.w/2-4}
        end
        c.walls={}
        for _,n in ipairs({3,7}) do local p=platforms[n]
            c.walls[#c.walls+1]={id='ice-wall-'..n,kind='MovingWall',x=p.x,y=p.y+7,z=p.z+10,w=4,h=14,d=5,
                motion={axis='z',amplitude=3,period=4.5,phase=n}}
        end
        local p=platforms[4];local edge=p.x+p.w/2+2
        c.supports[1]={id='ice-shuttle',kind='MovingIcePlatform',w=7,h=1,d=12,speed=3,
            path={point(edge,p.y+1,-5),point(edge,p.y+1,5)}}
        for _,n in ipairs({3,7}) do local p=platforms[n]
            c.hazards[#c.hazards+1]=hazard('ice-spike-'..n,'Spike',p.x+4,p.y+3.5,9,5,5,5,
                {axis='y',amplitude=1.5,period=4,phase=n})
        end
        table.sort(c.hazards,function(a,b) return a.x&lt;b.x end)
        cp(0,3,0,0);finish=point(cursor-6,3,0);foe('Snowman',56,3,6);foe('Snowman',154,3,-7);d.bounds.maxX=cursor+52
    elseif index==6 then
        c.gravity=150;c.jumpSpeed=51;c.maxSpeed=16;c.rooms={}
        for room=1,4 do local v=choose();local base=(room-1)*80;local y=(room-1)*6
            addFloor(base,y,0,20,22);addFloor(base+72,y+6,0,20,24)
            local ex=volume(base+72,y+9,0,12,8,18)
            c.rooms[room]={id=room,exit=ex,start=point(base,y+3,0)}
            c.supports[room]={id='serpent-'..room,kind='Serpent',room=room,speed=10+v,w=15,h=1,d=14,segments=4,segmentSpacing=6,
                path={point(base+19,y+1,0),point(base+36,y+3,(v-2)*4),point(base+55,y+5,0),point(base+36,y+3,-(v-2)*4)}}
            c.hazards[#c.hazards+1]=hazard('coil-spike-'..room,'Spike',base+38,y+5,(v-2)*6,4,4,5)
            cp(base,y+3,0,room-1)
        end
        finish=point(312,27,0);d.bounds.maxX=350;c.axis='rooms'
    elseif index==8 then
        c.gravity=150;c.jumpSpeed=52;c.maxSpeed=16;c.fans={};c.springs={};c.lifts={};c.axis='ascent'
        addFloor(0,0,0,36,30);cp(0,3,0,0)
        for n=1,16 do local v=choose();local x=n%2==0 and -8 or 8;local y=n*6
            addFloor(x,y,(v-2)*2,25,24)
            if n==4 or n==12 then c.fans[#c.fans+1]={id='fan-'..n,x=x,y=y+7,z=0,w=12,h=14,d=14,force=170} end
            if n==6 then c.springs[1]={x=x,y=y+3,z=0,w=8,h=4,d=8,power=68} end
            if n==8 then cp(x,y+3,0,y) end
            if n%4==2 then c.hazards[#c.hazards+1]=hazard('ascent-'..n,'Gas',x+(v-2)*8,y+4,9,6,6,6,
                {axis='z',amplitude=5,period=4,phase=n}) end
            if n==5 or n==13 then c.hazards[#c.hazards+1]=hazard('ascent-electric-'..n,'ElectricTrap',x+7,y+5,8,6,8,7,
                {phase=n}) end
            if n==9 then c.hazards[#c.hazards+1]=hazard('ascent-piston','MechanicalCrusher',x+8,y+7,9,6,10,6,
                {axis='y',amplitude=5,period=3.5,phase=n}) end
        end
        c.lifts[1]={id='lift-a',kind='Lift',w=14,h=1,d=15,path={point(-24,16,0),point(-24,34,0)},speed=5}
        foe('SentryDrone',8,15,0);foe('Slug',-8,39,0);foe('GasTurret',8,63,8)
        finish=point(-8,99,0);d.bounds.maxX=65;d.bounds.maxY=150;d.bounds.minX=-65
    elseif index==9 then
        c.gravity=150;c.jumpSpeed=51;c.maxSpeed=16;c.swimSpeed=15;c.swimAcceleration=28;c.oxygenSeconds=18
        addFloor(12,0,0,50,30);addFloor(91,-18,0,112,34);addFloor(172,0,0,52,30)
        addFloor(246,-25,0,96,34);addFloor(321,0,0,58,36);cp(0,3,0,0);cp(174,3,0,174)
        c.media={{kind='Water',minX=35,maxX=148,minY=-17,maxY=5,minZ=-18,maxZ=18,current={x=-5,y=0,z=0}},
            {kind='Water',minX=196,maxX=295,minY=-24,maxY=5,minZ=-18,maxZ=18,current={x=4,y=-1.5,z=0}}}
        for n=1,6 do local v=choose();local x=46+n*37
            c.hazards[#c.hazards+1]=hazard('pipe-'..n,n%2==0 and 'Gear' or 'PipeCrusher',x,-5,(v-2)*9,5,10,8,
                {axis='y',amplitude=6,period=3.5,phase=n})
        end
        foe('Robot',20,3,6);foe('Electrofish',78,-6,-8);foe('Hammerfish',117,-8,7);foe('Shark',230,-9,-6);foe('Duck',276,-5,8)
        finish=point(337,3,0);d.bounds.maxX=390
    elseif index==10 then
        c.gravity=150;c.jumpSpeed=52;c.maxSpeed=19;c.axis='race';c.bombs={};c.ratSpeed=9
        addFloor(0,90,0,30,28);d.spawn=point(0,93,0);cp(0,93,0,0)
        for race=1,3 do local v=choose();local y=90-race*30;local x=(race%2==0 and -1 or 1)*(8+v*2)
            for stair=1,5 do addFloor(x*(stair%2==0 and -.3 or 1),90-(race-1)*30-stair*6,0,28,28) end
            c.bombs[race]={id='bomb-'..race,position=point(x,y+3,0),radius=7,
                checkpoint=point(x,y+3,0),ratStart=point(-x,y+28,0)}
            if race&lt;3 then cp(x,y+3,0,race) end
            c.hazards[#c.hazards+1]=hazard('race-gas-'..race,'Gas',-x,y+17,9,6,6,6)
        end
        foe('SentryDrone',0,75,7);foe('GasTurret',0,45,8);finish=point(c.bombs[3].position.x,3,0)
        d.bounds.minX=-60;d.bounds.maxX=60;d.bounds.maxY=140
    elseif index==11 then
        c.speed=24;c.chaseSpeed=22;c.chaseGap=32;c.chaseLife=207;c.path={};c.axis='path'
        local x,y,z=0,3,0;local directions={{x=1,z=0},{x=0,z=1},{x=-1,z=0},{x=0,z=-1}}
        for n=1,12 do local v=choose();local direction=directions[(n-1)%4+1];local length=32+v*6
            c.path[n]={from=point(x,y,z),direction=copy(direction),length=length}
            local nx,nz=x+direction.x*length,z+direction.z*length
            addFloor((x+nx)/2,0,(z+nz)/2,direction.x~=0 and length+8 or 9,direction.z~=0 and length+8 or 9)
            x,z=nx,nz
        end
        finish=point(x,y,z);d.bounds={minX=-70,maxX=120,minY=-30,maxY=65,minZ=-70,maxZ=120}
    elseif index==12 then
        c.gravity=150;c.jumpSpeed=52;c.maxSpeed=16;c.radius=23;c.rotationSpeed=.16;c.windForce=6;c.towerPlatforms={};c.springs={};c.axis='tower';c.renderDynamicPlatforms=true
        local v=choose();c.windPhase=v
        d.spawn=point(23,3,0);cp(23,3,0,0)
        for n=0,18 do local choice=choose();local angle=n*.48;local y=n*5.5;local radius=23+(choice-2)
            local x,z=math.cos(angle)*radius,math.sin(angle)*radius
            addFloor(x,y,z,18,18);c.towerPlatforms[#c.towerPlatforms+1]={angle=angle,radius=radius,y=y,w=18,d=18}
            if n==9 then cp(x,y+3,z,y) end
            if n==7 or n==14 then c.springs[#c.springs+1]={x=x,y=y+3,z=z,w=8,h=3,d=8,power=65,towerPlatform=#c.towerPlatforms} end
            if n&gt;0 and n%5==0 then c.hazards[#c.hazards+1]=hazard('spire-spike-'..n,'RotatingSpike',x,y+3,z,4,5,4,
                {axis='orbit',radius=radius,period=6,phase=angle}) end
        end
        foe('Hordhead',23,25,0);foe('Swellcheeks',-20,58,4);foe('FlyingHead',-4,86,-20)
        local final=c.towerPlatforms[#c.towerPlatforms];finish=point(math.cos(final.angle)*final.radius,final.y+3,math.sin(final.angle)*final.radius)
        d.bounds={minX=-64,maxX=64,minY=-30,maxY=160,minZ=-64,maxZ=64}
    elseif index==13 then
        local v=choose();addFloor(0,0,0,70+v*4,68+v*4);addFloor(43,0,0,22,24)
        finish=point(38,3,0);cp(0,3,0,0);c.axis='arena';d.bounds={minX=-60,maxX=110,minY=-30,maxY=90,minZ=-60,maxZ=60}
    end
    if #c.checkpoints==0 then cp(d.spawn.x,d.spawn.y,d.spawn.z,0) end
    table.sort(c.checkpoints,function(a,b) return a.progress&lt;b.progress end)
    if index==2 or index==5 or index==7 then
        for n,p in ipairs(c.checkpoints) do if n&gt;1 then addFloor(p.position.x,p.position.y-3,p.position.z,16,20) end end
    end
    c.finishPoint=finish;c.finish=volume(finish.x,finish.y,finish.z,12,10,18);c.platforms=copy(platforms)
    local arenaX,arenaY,arenaZ=finish.x+34,finish.y-3,finish.z
    if index==2 or index==8 or index==10 or index==12 then arenaX=finish.x;arenaZ=finish.z+28 end
    local arena=floor(arenaX,arenaY,arenaZ,72,64)
    d.boss={kind=bossByLevel[index],position=point(arenaX+12,arenaY+3,arenaZ),platform=arena,gateX=arenaX+31,
        exit=volume(arenaX+28,arenaY+3,arenaZ,12,10,20),pad={x=arenaX+28,y=arenaY+.09,z=arenaZ,w=12,d=20}}
    d.zones={{id=d.mode..'Course',name=d.name,objective=objectives[d.mode],gateX=finish.x,exit=copy(c.finish),platforms=platforms,enemies=enemies}}
    d.bounds.maxX=math.max(d.bounds.maxX,arena.x+arena.w/2+8);d.bounds.minX=math.min(d.bounds.minX,arena.x-arena.w/2-8)
    d.bounds.maxZ=math.max(d.bounds.maxZ,arena.z+arena.d/2+8);d.bounds.minZ=math.min(d.bounds.minZ,arena.z-arena.d/2-8)
    sourceModule('CampaignRoster').apply(d,index)
    return d
end
return Definition
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT15">
          <Properties>
            <string name="Name">CampaignDirector</string>
            <ProtectedString name="Source">-- A campaign stage has independent traversal, ordinary-combat and boss gates.
-- The ordinary first-route director supplies family combat, never its exit FSM.
local CampaignDirector={}
CampaignDirector.__index=CampaignDirector
local function finite(value)
    return type(value)=='number' and value==value and value&gt;-math.huge and value&lt;math.huge
end

function CampaignDirector.new(session,world,Combat,config,deps)
    local self=setmetatable({session=session,world=world,config=config,deps=deps,
        definition=config.Level,now=session.now,stage=config.Level.mode or 'Course',bossSequences={},encounterSerial=0},CampaignDirector)
    self.modes=deps.CampaignModes.new(session,world,self.definition)
    world.campaignModes=self.modes
    self.ordinary=deps.Director.new(session,world,Combat,config,deps.GuardianPattern,deps.HealingFlies,
        deps.EnemyCarry,deps.WalkerClubs,deps.DragonFlight,deps.BossIntro)
    -- Authored campaign courses own topology and completion. Family AI still
    -- resolves its attacks, reactions, claims and same-body ownership normally.
    self.ordinary._zoneReached=function() return false end
    self.ordinary._boss=function() end
    self.enemies=table.clone(self.ordinary.enemies)
    self.ownerNames=self.ordinary.ownerNames
    self.ownerConnections=self.ordinary.ownerConnections or {}
    self.ordinary.ownerConnections=self.ownerConnections
    self.carry=self.ordinary.carry;self.clubs=self.ordinary.clubs;self.dragons=self.ordinary.dragons
    self.modes.canBoard=function() return self:_boardingCleared() end
    self.modes.spawnEncounter=function(event) return self:_spawnEncounter(event) end
    self.modes.resetEncounters=function(event) return self:_resetEncounters(event) end
    self.modes.ropeKick=function(slot,now) return self:_ropeKick(slot,now) end
    if deps.CampaignEnemies then
        self.campaignEnemies=deps.CampaignEnemies.new(self.ordinary)
        self.ordinary.campaignEnemies=self.campaignEnemies
        self.campaignEnemies.externalEnemies=self.enemies
        self.campaignEnemies.enemyHit=function(attacker,target,action,tuning) return self:hit(attacker,target,action,tuning) end
        self.campaignEnemies.vehicleObstacleHit=function(slot,owner,actorId) return self.modes:vehicleObstacleHit(slot) end
    end
    if self.modes.race then
        self.enemies[self.modes.race.enemyId]=self.modes.race.enemy
        self.modes.race.ownerNames=self.ownerNames
    end
    return self
end

function CampaignDirector:_boardingCleared()
    for id,enemy in pairs(self.ordinary.enemies) do
        if id~=-99 and not enemy.dead and not enemy.encounter
            and not (self.dragons and self.dragons:isMounted(id)) then return false end
    end
    return true
end
function CampaignDirector:_spawnEncounter(event)
    if self.closed or self.result then return false end
    self.encounterSerial+=1
    local row=table.clone(event)
    -- A course rewind is a new scripted appearance, never reuse an old identity.
    row.id=-200-self.encounterSerial
    assert(row.id&gt;-1000,'Too many scripted encounter appearances')
    local p=event.position
    row.x,row.y,row.z=p.x,p.y,p.z;row.spawnSerial=self.encounterSerial
    self.ordinary.now=self.session.now
    self.ordinary:_wave('Route',{row})
    local enemy=self.ordinary.enemies[row.id]
    enemy.encounter=true;enemy.encounterKey=event.id
    self.enemies[row.id]=enemy
    return row.id
end
function CampaignDirector:_resetEncounters(event)
    for id,enemy in pairs(self.ordinary.enemies) do
        -- Cleanup is unconditional; Modes separately decides which triggers
        -- lie beyond the checkpoint and may create a new scripted appearance.
        if enemy.encounter then
            if not enemy.dead then self.ordinary:_kill(id,'CourseRewind') end
            if self.campaignEnemies and self.campaignEnemies.expireEncounter then self.campaignEnemies:expireEncounter(id) end
        end
    end
end
function CampaignDirector:_ropeKick(slot,now)
    local hero=self.session.state.heroes[slot]
    local combat=self.session.combat[slot]
    if not hero or hero.status~='Alive' or not hero.connected or not combat or combat.deathAt then return 'NOT_ALIVE' end
    self.now=now;self.ordinary.now=now
    local code=self.session:_event('BeginAttack',slot,{connectionEpoch=hero.connectionEpoch})
    if code~='OK' then return code end
    self.world:hold(slot,false)
    local armed=self.campaignEnemies and self.campaignEnemies:hasRavenClaw(slot)
    local targets=self.world:targets(slot,self.config.Attacks[armed and 'RopeClaw' or 'RopeStrike'])
    self:closeTargetForAttack(targets)
    local action=armed and 'RopeClaw' or 'RopeStrike'
    for _,target in ipairs(targets) do
        local enemy=self.ordinary.enemies[target]
        if enemy and not enemy.dead then
            action=(enemy.kind~='LargeRaven' and enemy.rawLife and (enemy.rawLife&lt;16 or enemy.kind=='RetroBlaster' and enemy.rawLife&lt;32)) and 'RopeBoot'
                or (armed and 'RopeClaw' or 'RopeStrike')
            if self.ordinary:hit(slot,target,action,self.config.Attacks[action]) then break end
        elseif self.session.state.heroes[target] and self.session:_hit(slot,target,action,self.config.Attacks[action]) then break end
    end
    combat.lastStrikeAction='HeroKick';combat.strikeRecoveryUntil=now+.25
    self.session:_record('AttackAccepted',slot,{action=action,context='Rope',sourceAnimation='46/48/4E/50/52'})
    return 'OK'
end

function CampaignDirector:_hasSurvivor()
    for _,id in ipairs(self.session.order) do
        local hero,combat=self.session.state.heroes[id],self.session.combat[id]
        if hero and hero.status=='Alive' and combat and not combat.deathAt then return true end
    end
    return false
end

function CampaignDirector:_ordinaryCleared()
    for id,enemy in pairs(self.ordinary.enemies) do
        if id~=-99 and not enemy.dead and not (self.dragons and self.dragons:isMounted(id)) then return false end
    end
    return true
end

function CampaignDirector:_startBoss(now,chase)
    local assigned=self.bossGate and self.bossGate(now) or {state='NPC'}
    if not assigned or assigned.state=='Waiting' then self.stage='BossReady';return false end
    local definition=table.clone(self.definition)
    definition.boss=table.clone(self.definition.boss)
    definition.boss.type=definition.boss.type or definition.boss.kind
    definition.boss.chaseComplete=chase~=true
    definition.bossGate={ownerUserId=assigned.state=='Human' and assigned.userId or nil,
        connected=assigned.state~='Human' or self.ownerConnections[assigned.userId]~=false,
        connectionEpoch=1,ownerName=assigned.userId and self.ownerNames[assigned.userId]}
    self.boss=self.deps.CampaignBoss.new(self.session,self.world,self.config,definition)
    self.boss.externalEnemies=self.enemies
    self.boss.enemyHit=function(attacker,target,action,tuning) return self:hit(attacker,target,action,tuning) end
    self.enemies[-99]=self.boss.enemies[-99]
    if chase then
        self.stage='Chase'
        self.modes.chaseActor=function(point)
            if self.boss.state=='Chase' then self.world:placeActor(-99,point) end
        end
        self.modes.chaseLife=self.boss.enemies[-99].rawLife
        if definition.bossGate.ownerUserId and self.modes.setChaseController then
            self.modes:setChaseController(definition.bossGate.ownerUserId,definition.bossGate.connected)
        end
    else self.stage='Boss' end
    self.world:stage(self.stage)
    return true
end

function CampaignDirector:step(now,dt)
    if self.closed or self.result then return end
    self.now=now;self.ordinary.now=now
    if self.session.state.status=='Lost' then
        self.result='Lost';self.stage='Lost';self.world:stage('Lost');self:close('Lost');return
    end
    if self.definition.mode=='Clinger' and not self.boss and not self:_startBoss(now,true) then return end
    self.modes:step(now,dt)
    self.ordinary:step(now,dt)
    if self.campaignEnemies then self.campaignEnemies:step(now,dt) end
    if self.boss then
        if self.boss.state=='Chase' and self.modes.complete then
            self.modes.chaseFinished=true
            self.world:placeActor(-99,self.definition.boss.position)
            self.boss:finishChase();self.stage='Boss';self.world:stage('Boss')
        end
        self.boss:step(now,dt)
        -- Session may still owe the last hero's accepted death and paid retry.
        -- Keep this stage stepping until the same eligibility as advanceLevel
        -- holds; never replace its geometry or cancel that lethal deadline.
        if self.boss.defeated and self.modes.complete and self:_hasSurvivor() then self.result='Won';self.stage='Won';self.world:stage('Won') end
    elseif self.modes.complete and (self.definition.requiresClearAtExit==false or self:_ordinaryCleared()) then
        local boss=self.definition.boss
        if boss and (boss.kind or boss.type) then self:_startBoss(now)
        elseif self:_hasSurvivor() then self.result='Won';self.stage='Won';self.world:stage('Won') end
    end
end

function CampaignDirector:hit(attacker,target,action,tuning)
    if self.closed or self.result then return false end
    if self.modes.race and self.modes.race:isTarget(target) then
        self.modes.race.now=math.max(self.now,self.session.now or 0)
        return self.modes.race:hit(attacker,target,action,tuning)
    end
    if target==-99 then
        if not self.boss then return false end
        self.boss.now=self.now
        return self.boss:hit(attacker,target,action,tuning)
    end
    self.ordinary.now=self.now
    return self.ordinary:hit(attacker,target,action,tuning)
end
function CampaignDirector:selectBossAction(target,input)
    if target==-99 and self.boss and self.boss.selectAction then return self.boss:selectAction(input) end
end
function CampaignDirector:_finishReaction(id,enemy) return self.ordinary:_finishReaction(id,enemy) end
function CampaignDirector:closeTargetForAttack(targets)
    if self.modes.race then self.modes.race:closeTargetForAttack(targets) end
    return self.ordinary:closeTargetForAttack(targets)
end
function CampaignDirector:controlled(userId)
    local boss=self.boss and self.boss:controlled(userId)
    local racer=self.modes.race and self.modes.race:controlled(userId)
    return boss or racer or self.ordinary:controlled(userId)
end
function CampaignDirector:available(userId)
    if self.closed or self.result or (self.boss and self.boss:controlled(userId)) then return {} end
    local race=self.modes.race
    if race and race:controlled(userId) then return {} end
    local offers=self.ordinary:available(userId)
    if race and not self.ordinary:controlled(userId) then
        for _,offer in ipairs(race:available(userId)) do offers[#offers+1]=offer end
    end
    return offers
end
function CampaignDirector:claim(userId,id)
    if self.closed or self.result then return 'RUN_CLOSED' end
    if id==-99 then return 'UNKNOWN_ENEMY' end
    if self.boss and self.boss:controlled(userId) then return 'ENEMY_ALREADY_OWNED' end
    if self.modes.race then
        if self.modes.race:controlled(userId) or self.ordinary:controlled(userId) and id==self.modes.race.enemyId then return 'ENEMY_ALREADY_OWNED' end
        if id==self.modes.race.enemyId then return self.modes.race:claim(userId,id) end
    end
    return self.ordinary:claim(userId,id)
end
function CampaignDirector:connection(userId,connected)
    if self.modes.race and self.modes.race:controlled(userId) then return self.modes.race:connection(userId,connected) end
    if self.boss and self.boss:controlled(userId) then
        if self.boss.state=='Chase' and self.modes.chaseConnection then self.modes:chaseConnection(connected) end
        return self.boss:connection(userId,connected)
    end
    return self.ordinary:connection(userId,connected)
end
function CampaignDirector:command(userId,payload,now,validator)
    if self.modes.race and self.modes.race:controlled(userId) then return self.modes.race:command(userId,payload,now,validator) end
    local role=self.boss and self.boss:controlled(userId)
    if not role then return self.ordinary:command(userId,payload,now,validator) end
    if type(validator)~='function' or not validator(payload) then return 'INVALID_INTENT' end
    if payload.runId~=self.session.state.runId then return 'WRONG_RUN' end
    if self.closed or self.result or self.session.state.status~='Active' then return 'RUN_CLOSED' end
    if not role.connected then return 'OFFLINE' end
    if role.status~='Alive' then return 'NOT_ALIVE' end
    if payload.actorId~=role.actorId or payload.attempt~=role.attempt
        or payload.levelEpoch~=self.session.state.levelEpoch then return 'STALE_ACTOR' end
    if payload.connectionEpoch~=role.connectionEpoch then return 'STALE_CONNECTION' end
    local sequence=self.bossSequences[userId]
    if sequence and sequence.connectionEpoch==role.connectionEpoch and payload.seq&lt;=sequence.seq then return 'STALE_SEQUENCE' end
    if not finite(now) or now&lt;0 then return 'INVALID_TIME' end
    if now&lt;self.now then return 'TIME_REVERSED' end
    self.now=now;self.bossSequences[userId]={connectionEpoch=role.connectionEpoch,seq=payload.seq}
    if self.boss.state=='Chase' then
        if payload.kind~='Move' then return 'CHASE_ONLY' end
        if self.modes.chaseCommand then return self.modes:chaseCommand(payload.x,payload.z,now) end
        return 'CHASE_ONLY'
    end
    if payload.kind=='Attack' then return self.boss:command(payload.attack,self.bossAim,now) end
    if not self.boss:canMove(now) then return 'REACTION' end
    if payload.kind=='Jump' then self.world:jump(-99)
    else
        local length=math.sqrt(payload.x^2+payload.z^2)
        if length&gt;0 then self.bossAim={x=payload.x/length,z=payload.z/length} end
        self.boss.lastMove=length&gt;0 and now or nil
        self.world:move(-99,payload.x,payload.z,false)
    end
    return 'OK'
end
function CampaignDirector:interaction(slot)
    local mode=self.modes:interaction(slot)
    if mode and (mode.available or mode.carrying) then
        mode.label=mode.label or mode.action
        if mode.kind=='CampaignKick' and self.campaignEnemies and self.campaignEnemies:hasRavenClaw(slot) then mode.label='Raven claw strike' end
        return mode
    end
    return self.ordinary:interaction(slot)
end
function CampaignDirector:interact(slot,now,action)
    local result=self.modes:interact(slot,now,action)
    if result~='NO_INTERACTION' then return result end
    return self.ordinary:interact(slot,now,action)
end
function CampaignDirector:cancelBossIntro(reason) return self.ordinary:cancelBossIntro(reason) end
function CampaignDirector:close(reason)
    if self.closed then return end
    self.closed=true
    self.modes:close(reason)
    if self.world.campaignModes==self.modes then self.world.campaignModes=nil end
    if self.boss then self.boss:close(reason) end
    if self.campaignEnemies then self.campaignEnemies:close(reason) end
    self.ordinary:cancelBossIntro(reason)
    for _,name in ipairs({'flies','carry','clubs','dragons'}) do
        local component=self.ordinary[name]
        if component and component.close then component:close(reason) end
    end
end
function CampaignDirector:snapshot()
    local data=self.ordinary:snapshot()
    local mode=self.modes:snapshot()
    data.stage=self.stage;data.mode=self.definition.mode;data.modeState=mode
    data.bossMechanic=self.boss and 'Campaign' or nil;data.bossHits=nil;data.bossMax=nil;data.bossIntro=nil
    data.objective=mode.objective or self.definition.objective or self.definition.name
    if self.definition.course and self.definition.course.mount and not self:_boardingCleared() then
        data.objective='Defeat the patrol before boarding'
    end
    data.campaignIndex=self.definition.campaignIndex;data.campaignCount=self.deps.CampaignDefinition and self.deps.CampaignDefinition.count or 13
    data.levelName=self.definition.name;data.result=self.result
    if self.modes.race then
        local rival=self.modes.race:snapshot()
        data.enemies[#data.enemies+1]={id=rival.enemyId,actorId=rival.actorId,kind='RacingRat',resourceKind='CourseRival',
            dead=rival.dead,courseRival=true,reactionEpoch=self.modes.race.enemy.reactionEpoch}
    end
    if self.stage=='BossReady' then data.objective='Assigning boss: waiting for the invited player' end
    if self.boss then
        data.boss=self.boss:snapshot();data.bossType=self.definition.boss.kind or self.definition.boss.type
        data.bossRawLife=data.boss.rawLife;data.bossProgress=data.boss.progress
        for key,value in pairs(data.boss) do if string.sub(key,1,4)=='boss' then data[key]=value end end
        data.objective=data.boss.objective or 'Defeat '..data.bossType
    end
    if self.result=='Won' then data.objective='Course cleared' elseif self.result=='Lost' then data.objective='Team eliminated' end
    return data
end
return CampaignDirector
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT16">
          <Properties>
            <string name="Name">CampaignEnemies</string>
            <ProtectedString name="Source">-- Original 3D family controllers. Source handler identities/attack families are
-- recorded in research/2026-11-09-campaign-enemies.md; all physical budgets,
-- attack bindings, populations and named-action mappings below are Roblox tuning.
-- Existing Director owns spawn, engagement, one-life claims, raw Life and damage.
local Enemies={}
Enemies.__index=Enemies
local families={
    Raven={mode='Fly',attack='Swoop',range=28,speed=10},LargeRaven={mode='Fly',attack='Swoop',range=30,speed=8},
    Invader={mode='Ground',attack='StealLife',range=16,speed=9},
    RocketRat={mode='Ride',attack='DropObstacle',range=35,speed=14},
    Snowman={mode='Ground',attack='Snowball',range=38,speed=4},
    SentryDrone={mode='Ground',attack='TwinBolt',range=40,speed=0},
    GasTurret={mode='Ground',attack='Gas',range=30,speed=0},
    RetroBlaster={mode='Wall',attack='Bolt',range=42,speed=0},
    SaturnToadtrap={mode='Wall',attack='Snap',range=9,speed=0},
    Robot={mode='Ground',attack='Bolt',range=36,speed=6},
    Slug={mode='Ground',attack='Latch',range=10,speed=5},
    Electrofish={mode='Swim',attack='Shock',range=8,speed=9},
    Hammerfish={mode='Swim',attack='Lunge',range=15,speed=10},
    Shark={mode='Swim',attack='Bite',range=18,speed=13},
    Duck={mode='Swim',attack='Bite',range=12,speed=7},
    Hordhead={mode='Ground',attack='Roll',range=15,speed=8},
    Swellcheeks={mode='Fly',attack='Gas',range=30,speed=8},
    FlyingHead={mode='Fly',attack='Swoop',range=25,speed=11},
}
local actions={
    Swoop={tell=.4,active=.75,recovery=.6,lift=-3,radius=2.6,damage='DragonHeadbutt'},
    Leap={tell=.35,active=.7,recovery=.6,lift=5,radius=2.8,damage='PigRush'},
    StealLife={tell=.35,active=.7,recovery=.6,lift=5,radius=2.8},
    DropObstacle={tell=.45,active=.1,recovery=.8,projectile='Obstacle',damage='WalkerHeavy'},
    Snowball={tell=.5,active=.15,recovery=.75,projectile='Snowball',speed=28,damage='DragonFire'},
    Bolt={tell=.45,active=.12,recovery=.65,projectile='Bolt',speed=34,damage='DragonFire'},
    TwinBolt={tell=.4,active=.15,recovery=.8,projectile='Bolt',speed=34,twin=true,damage='DragonFire'},
    Gas={tell=.5,active=.2,recovery=.9,projectile='GasCloud',speed=12,damage='PigJab'},
    Shock={tell=.4,active=.2,recovery=.8,radial=6,damage='DragonFire'},
    Lunge={tell=.4,active=.65,recovery=.6,lift=0,radius=2.8,damage='WalkerHeavy'},
    Bite={tell=.3,active=.6,recovery=.6,lift=0,radius=2.7,damage='PigHeavy'},
    Roll={tell=.4,active=.7,recovery=.8,lift=1.5,radius=3,damage='PigRush'},
    Snap={tell=.45,active=.25,recovery=.9,reach=9,width=3,height=4,damage='WalkerHeavy'},
    Latch={tell=.3,active=.6,recovery=.7,lift=3,radius=2.6,damage='PigJab'},
    Explode={tell=.8,active=.1,recovery=0,radial=7,damage='HeroBoot',selfDestruct=true},
}
local function finite(n) return type(n)=='number' and n==n and n&gt;-math.huge and n&lt;math.huge end
local function point(p) return type(p)=='table' and finite(p.x) and finite(p.y) and finite(p.z) end
local function copy(p) return {x=p.x,y=p.y,z=p.z} end
local function distance(a,b)
    if not point(a) or not point(b) then return math.huge end
    return math.sqrt((a.x-b.x)^2+(a.y-b.y)^2+(a.z-b.z)^2)
end
local function aim(x,z)
    if not finite(x) or not finite(z) then return nil end
    local length=math.sqrt(x*x+z*z)
    if not finite(length) or length&lt;.001 then return nil end
    return {x=x/length,z=z/length}
end
local function sweep(a,b,p)
    if not point(a) or not point(b) or not point(p) then return math.huge end
    local x,y,z=b.x-a.x,b.y-a.y,b.z-a.z;local length=x*x+y*y+z*z
    local t=length&gt;0 and math.clamp(((p.x-a.x)*x+(p.y-a.y)*y+(p.z-a.z)*z)/length,0,1) or 0
    return distance({x=a.x+x*t,y=a.y+y*t,z=a.z+z*t},p)
end
function Enemies.new(director)
    return setmetatable({director=director,session=director.session,world=director.world,config=director.config,
        runId=director.session.state.runId,levelEpoch=director.session.state.levelEpoch,
        now=director.now or 0,states={},projectiles={},lifeTokens={},debris={},ravenClaws={},serial=0},Enemies)
end
function Enemies:owns(_,e) return e~=nil and not e.boss and families[e.kind]~=nil end
function Enemies:movementKind(_,e) return e and families[e.kind] and families[e.kind].mode or nil end
function Enemies:_state(id,e)
    local state=self.states[id]
    if not state or state.actorId~=e.actorId then
        state={actorId=e.actorId,mode='Ready',nextAttack=e.nextAttack or self.now,origin=copy(self.world:position(id)),aim={x=1,z=0},startAt=self.now}
        self.states[id]=state
        local family=families[e.kind]
        if family.mode=='Ground' and self.world.campaignWalkSpeed then self.world:campaignWalkSpeed(id,family.speed) end
    end
    return state
end
function Enemies:stateFor(id) return self.states[id] and self.states[id].mode or 'Ready' end
function Enemies:_targets(id)
    local result,seen={},{}
    for _,target in ipairs(self.session.order) do
        local h,c=self.session.state.heroes[target],self.session.combat[target]
        if h.status=='Alive' and c and not c.deathAt and point(self.world:position(target)) then result[#result+1]=target;seen[target]=true end
    end
    for target,e in pairs(self.director.enemies) do
        if target~=id and not e.dead and point(self.world:position(target)) then result[#result+1]=target;seen[target]=true end
    end
    for target,e in pairs(self.externalEnemies or {}) do
        if target~=id and not seen[target] and not e.dead and point(self.world:position(target)) then result[#result+1]=target end
    end
    table.sort(result);return result
end
function Enemies:_nearest(id,direction)
    local p=self.world:position(id);local selected,best=nil,math.huge
    for _,target in ipairs(self.session.order) do
        local h,c=self.session.state.heroes[target],self.session.combat[target];local q=self.world:position(target)
        if h.status=='Alive' and c and not c.deathAt and point(q) then
            local d=distance(p,q);local front=not direction or (q.x-p.x)*direction.x+(q.z-p.z)*direction.z&gt;=0
            if front and d&lt;best then selected,best=target,d end
        end
    end
    return selected,best
end
function Enemies:_hit(id,target,action,hits,impactPosition)
    if hits[target] then return end;hits[target]=true
    local tuning=self.config.Attacks[action]
    if impactPosition then
        tuning=table.clone(tuning);tuning.impactPosition=copy(impactPosition)
    end
    if self.session.state.heroes[target] then return self.session:_hit(id,target,action,tuning) end
    if self.enemyHit then return self.enemyHit(id,target,action,tuning) end
    return self.director:hit(id,target,action,tuning)
end
function Enemies:_bounded(p,id)
    local b=self.config.Level and self.config.Level.bounds or {}
    local result={x=math.clamp(p.x,b.minX or -10000,b.maxX or 10000),
        y=math.clamp(p.y,b.minY or -10000,b.maxY or 10000),z=math.clamp(p.z,b.minZ or -10000,b.maxZ or 10000)}
    local e=id and self.director.enemies[id];local state=id and self.states[id]
    if e and families[e.kind].mode=='Swim' and state then
        local media=self.config.Level and self.config.Level.course and self.config.Level.course.media or {}
        for _,water in ipairs(media) do
            local o=state.origin
            if water.kind=='Water' and o.x&gt;=water.minX and o.x&lt;=water.maxX and o.y&gt;=water.minY
                and o.y&lt;=water.maxY and o.z&gt;=water.minZ and o.z&lt;=water.maxZ then
                result.x=math.clamp(result.x,water.minX+2,water.maxX-2)
                result.y=math.clamp(result.y,water.minY+2,water.maxY-2)
                result.z=math.clamp(result.z,water.minZ+2,water.maxZ-2);break
            end
        end
    end
