                local front=x*a.aim.x+z*a.aim.z;local side=x*a.aim.z-z*a.aim.x
                if front&gt;=0 and front&lt;=m.reach and math.abs(side)&lt;=m.width and math.abs(q.y-a.origin.y)&lt;=m.height then
