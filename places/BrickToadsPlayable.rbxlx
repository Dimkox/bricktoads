    objectiveLabel.Position, objectiveLabel.Size = UDim2.fromOffset(13, 29), UDim2.new(1, -26, 0, short and 33 or 40)
    objectiveLabel.TextSize = short and 14 or 16
    bossLabel.Position, bossLabel.Size = UDim2.new(0, 13, 1, -49), UDim2.new(1, -26, 0, 24)
    bossLabel.TextSize = short and 11 or 12
    feedbackLabel.Position, feedbackLabel.Size = UDim2.new(0, 13, 1, -26), UDim2.new(1, -26, 0, 20)
    feedbackLabel.TextSize = short and 11 or 12
    local bottom, controlWidth = short and 12 or 20, width &lt; 360 and 146 or 162
    local actionHeight, topHeight = short and (isTouch and 108 or 105) or 128, short and 56 or 70
    actions.Position, actions.Size = UDim2.new(1, -inset, 1, -bottom), UDim2.fromOffset(controlWidth, controlledBoss and topHeight or actionHeight)
    local half = (controlWidth - 8) / 2
    position(punch, 0, 0, (isTouch or enemy or carrying) and controlWidth or half, topHeight)
    position(dash, half + 8, 0, half, topHeight)
    position(jump, 0, topHeight + 8, controlWidth, short and (isTouch and 44 or 41) or 50)
    punch.TextSize, dash.TextSize, jump.TextSize = short and 13 or 15, short and 13 or 15, short and 12 or 14
    local primaryLabel = controlledBoss and not enemy.bossType and "FIRE" or "ATTACK"
    if enemy and enemy.movementKind=='Ride' then primaryLabel='DROP OBSTACLE' end
    if not carrying and not controlledBoss and controlled and controlled.movementMode == "Run" then
        primaryLabel = "MEGA STRIKE"
    elseif not enemy and interaction and interaction.available == true and type(interaction.label) == "string" then
        primaryLabel = interaction.label
    end
    punch.Text = isTouch and T(primaryLabel) or (T(primaryLabel) .. "\nF")
    dash.Text = "MEGA\nR · WHILE RUNNING"
    local flyer=snapshot and snapshot.enemyRole and snapshot.enemyRole.movementKind=='Fly'
    jump.Text = flyer and (isTouch and T('FLAP') or T('FLAP · SPACE')) or (isTouch and "JUMP" or "JUMP · SPACE")
    local padSize = short and 144 or (width &lt; 360 and 146 or 164)
    pad.Position, pad.Size = UDim2.new(0, inset + 2, 1, -bottom), UDim2.fromOffset(padSize, padSize)
    pad.Visible, keyboardHint.Visible = isTouch, not isTouch
    local cell = (padSize - 8) / 3
    position(directionButtons.Forward, cell + 4, 0, cell, cell)
    position(directionButtons.Left, 0, cell + 4, cell, cell)
    position(directionButtons.Right, (cell + 4) * 2, cell + 4, cell, cell)
    position(directionButtons.Backward, cell + 4, (cell + 4) * 2, cell, cell)
    position(runHint, cell + 4, cell + 4, cell, cell)
    keyboardHint.Position, keyboardHint.Size = UDim2.new(0, inset, 1, -bottom), UDim2.fromOffset(260, 42)
    if isTouch then
        local mobileInset, cardGap = width &lt; 500 and 8 or 12, 8
        local statusWidth, goalWidth = math.min(172, width - mobileInset * 2), math.min(260, width - mobileInset * 2)
        local twoRows = statusWidth + goalWidth + cardGap + 52 &gt; width - mobileInset * 2
        local goalY = mobileInset + (twoRows and 52 or 0)
        position(mobileStatus, mobileInset, mobileInset, statusWidth, 44)
        position(mobileGoal, width - mobileInset - goalWidth - (twoRows and 0 or 52), goalY, goalWidth, 44)
        mobileHudBottom = goalY + 44
        position(mobileStatusTitle, 8, 1, statusWidth - 32, 21)
        position(mobileStatusDetail, 8, 23, statusWidth - 32, 17)
        position(mobileReturns, statusWidth - 78, 2, 54, 20)
        position(mobileStatusArrow, statusWidth - 22, 23, 15, 17)
        for n, heart in ipairs(mobileHearts) do position(heart.heart, 8 + (n - 1) * 18, 0, 18, 22) end
        position(mobileGoalTitle, 10, 2, goalWidth - 34, 18)
        position(mobileGoalDetail, 10, 22, goalWidth - 34, 18)
        position(mobileGoalArrow, goalWidth - 23, 12, 15, 20)
        local detailsWidth = math.min(344, width - mobileInset * 2)
        local detailsY = mobileHudBottom + 8
        local controlsTop = height - bottom - math.max(padSize, controlledBoss and topHeight or actionHeight)
        local desiredHeight = mobileExpanded == "Goal" and 252 or (60 + count * 64 + (enemy and (hasBossProgress and 96 or 72) or 0))
        local availableHeight = controlsTop - detailsY - 8
        local detailsHeight = math.max(52, math.min(desiredHeight, availableHeight))
        local detailsX = mobileExpanded == "Goal" and (width - mobileInset - detailsWidth) or mobileInset
        if availableHeight &lt; 112 then
            -- An explicitly opened panel may use the centre, leaving both control corners free.
            local middleLeft = inset + 2 + padSize + 8
            local middleRight = width - inset - controlWidth - 8
            local middleWidth = middleRight - middleLeft
            if middleWidth &gt;= 144 then
                detailsWidth = math.min(344, middleWidth)
                detailsX = middleLeft + (middleWidth - detailsWidth) / 2
                detailsHeight = math.min(desiredHeight, height - bottom - detailsY)
            end
        end
        position(mobileDetails, detailsX, detailsY, detailsWidth, detailsHeight)
        position(mobileDetailsTitle, 12, 0, detailsWidth - 144, 44)
        position(mobileCollapse, detailsWidth - 130, 0, 122, 44)
        position(mobileDetailsScroll, 8, 44, detailsWidth - 16, detailsHeight - 52)
        local innerWidth, teamTop = detailsWidth - 16, enemy and (hasBossProgress and 96 or 72) or 0
        roster.Visible, enemyStatus.Visible, objective.Visible = mobileExpanded == "Team",
            mobileExpanded == "Team" and enemy ~= nil, mobileExpanded == "Goal"
        position(enemyStatus, 0, 0, innerWidth, hasBossProgress and 88 or 64)
        position(enemyStripe, 0, 9, 3, 46)
        position(enemyStatus.CharacterPortrait, 7, 2, 24, 24)
        position(enemyOwner, 37, 3, innerWidth - 48, 20)
        enemyOwner.TextSize, enemyLife.TextSize = 14, 12
        position(enemyLife, 94, 30, innerWidth - 106, 24)
        position(enemyProgress, 11, 62, innerWidth-22, 22)
        for n, heart in ipairs(enemyHearts) do position(heart.heart, 10 + (n - 1) * 25, 29, 24, 27) end
        position(roster, 0, teamTop, innerWidth, count * 64)
        for i, row in ipairs(heroRows) do
            position(row.row, 0, (i - 1) * 64, innerWidth, 58)
            position(row.stripe, 0, 9, 3, 40)
            position(row.portrait, 7, 2, 24, 24)
            position(row.owner, 37, 3, innerWidth - 89, 20)
            row.owner.TextSize = 14
            position(row.status, 126, 32, innerWidth - 137, 18)
            position(row.returns, innerWidth - 45, 4, 34, 18)
            for n, heart in ipairs(row.fills) do position(heart.heart, 10 + (n - 1) * 22, 28, 22, 25) end
        end
        position(objective, 0, 0, innerWidth, 168)
        position(stageLabel, 12, 8, innerWidth - 24, 18)
        position(objectiveLabel, 12, 0, innerWidth - 24, 72)
        objectiveLabel.TextSize = 16
        position(bossLabel, 12, 80, innerWidth - 24, 24)
        bossLabel.TextSize = 13
        position(feedbackLabel, 12, 108, innerWidth - 24, 50)
        feedbackLabel.TextSize = 13
        mobileDetailsScroll.CanvasSize = UDim2.fromOffset(0, mobileExpanded == "Goal" and 168 or (teamTop + count * 64))
    end
    local expanded = enemyChoiceAllowed() and choosingEnemy and snapshot.view ~= "Choice"
    local spectatorWidth = math.min(500, width - inset * 2)
    local hasCameraButtons = nextHeroButton.Visible
    local hasViewButtons = watchButton.Visible or personalMenuButton.Visible or chooseEnemyButton.Visible
    local spectatorHeight = expanded and (short and 224 or 274) or (hasCameraButtons and 158 or (hasViewButtons and 116 or 74))
    local cameraPadSize = short and 104 or (width &lt; 360 and 106 or 116)
    local compactCameraPanel = not portrait and short and isTouch and cameraControls.Visible and hasCameraButtons and not expanded
    if compactCameraPanel then
        spectatorWidth = math.min(spectatorWidth, width - 2 * (inset + cameraPadSize + 12))
        spectatorHeight = groupPanel.hudButton.Visible and 158 or 132
    end
    local cameraBottom = isTouch and cameraControls.Visible and not compactCameraPanel and (cameraPadSize + 12) or 0
    local queueSideBySide = queuePriority and not portrait and short
    local queueScrollStack = false
    local queueHeight, queueY
    queueHudScroll.Visible=false
    spectator.Parent,spectator.AnchorPoint=hud,Vector2.new(0.5,1)
    if bossQueue.card.Visible then
        if bossQueue.compact then
            bossQueue.card.Parent=hud
            local queueX = isTouch and mobileGoal.Position.X.Offset or objective.Position.X.Offset
            local queueWidth = isTouch and mobileGoal.Size.X.Offset or math.max(180,objective.Size.X.Offset-52)
            queueY = isTouch and (mobileHudBottom + 8) or (objective.Position.Y.Offset + objective.Size.Y.Offset + 8)
            if queueSideBySide then
                queueWidth=math.min(260,(width-inset*3)/2)
                queueX,queueY=inset,mobileHudBottom+4
                spectatorWidth=width-queueWidth-inset*3
                if hasCameraButtons and not expanded then spectatorHeight=140 end
            end
            queueHeight=bossQueue:layout(queueWidth,true,queueX,queueY)
            local spectatorTop=height-bottom-cameraBottom-spectatorHeight
            if isTouch and not queueSideBySide and queueY+queueHeight+8&gt;spectatorTop then
                -- Both complete cards remain reachable in a clipped scroll viewport,
                -- above the native camera controls on a shallow portrait display.
                queueScrollStack=true
                local viewportWidth=width-inset*2
                local cameraReserve=cameraControls.Visible and math.max(cameraPadSize,108)+8 or 0
                local viewportHeight=math.max(44,height-bottom-cameraReserve-queueY)
                position(queueHudScroll,inset,queueY,viewportWidth,viewportHeight)
                queueHudScroll.Visible=true
                bossQueue.card.Parent=queueHudScroll
                queueHeight=bossQueue:layout(viewportWidth,true,0,0)
                spectatorWidth=viewportWidth
                spectator.Parent,spectator.AnchorPoint=queueHudScroll,Vector2.new(0,0)
                position(spectator,0,queueHeight+8,spectatorWidth,spectatorHeight)
                queueHudScroll.CanvasSize=UDim2.fromOffset(0,queueHeight+8+spectatorHeight)
            elseif not isTouch and queueY+queueHeight+8&gt;spectatorTop then
                roster.Visible,objective.Visible=false,false
                queueY=inset
                bossQueue:layout(queueWidth,true,queueX,queueY)
            end
        else bossQueue:layout(contentWidth,false) end
    end
    if not queueScrollStack then
        local observerX=queueSideBySide and (width-inset-spectatorWidth/2) or width/2
        local observerBottom=height-bottom-cameraBottom
        if queueSideBySide and hasCameraButtons and not expanded then observerBottom=queueY+queueHeight end
        spectator.Position=UDim2.fromOffset(observerX,observerBottom)
        spectator.Size=UDim2.fromOffset(spectatorWidth,spectatorHeight)
    end
    cameraPad.Position, cameraPad.Size = UDim2.new(0, inset, 1, -bottom), UDim2.fromOffset(cameraPadSize, cameraPadSize)
    cameraPad.Visible, cameraAxes.Visible, cameraHint.Visible = isTouch, isTouch, not isTouch
    cameraAxes.Position, cameraAxes.Size = UDim2.new(1, -inset, 1, -bottom), UDim2.fromOffset(108, 50)
    position(cameraButtons.Up, 0, 0, 50, 50)
    position(cameraButtons.Down, 58, 0, 50, 50)
    cameraButtons.Up.TextSize, cameraButtons.Down.TextSize = 11, 11
    cameraHint.Position = UDim2.new(0.5, 0, 1, -bottom - spectatorHeight - 10)
    cameraHint.Size = UDim2.fromOffset(math.min(620, width - inset * 2), 40)
    local innerWidth, gapButtons = spectatorWidth - 28, 8
    local halfButton = (innerWidth - gapButtons) / 2
    local bottomRow = spectatorHeight - 54
    spectatorText.Visible = true
    if expanded then
        position(enemyChoiceTitle, 14, 9, spectatorWidth - 28, 19)
        position(spectatorText, 14, 31, spectatorWidth - 28, 19)
        position(enemyChoiceNote, 14, 52, spectatorWidth - 28, short and 32 or 38)
        position(enemyOffers, 14, short and 88 or 95, spectatorWidth - 28, spectatorHeight - (short and 150 or 157))
        position(watchButton, 14, bottomRow, personalMenuButton.Visible and halfButton or innerWidth, 44)
        position(personalMenuButton, 14 + halfButton + gapButtons, bottomRow, halfButton, 44)
        spectatorText.TextSize = short and 12 or 13
        if spectatorHeight &lt; 200 then
            spectatorText.Visible = false
            position(enemyChoiceNote, 14, 30, spectatorWidth - 28, 25)
            position(enemyOffers, 14, 59, spectatorWidth - 28, spectatorHeight - 121)
        end
    else
        position(spectatorText, 14, 7, spectatorWidth - 28, hasViewButtons and 44 or 60)
        position(nextHeroButton, 14, 55, halfButton, 44)
        position(freeCameraButton, 14 + halfButton + gapButtons, 55, halfButton, 44)
        local paired = personalMenuButton.Visible and (watchButton.Visible or chooseEnemyButton.Visible)
        local viewButtonHeight = 44
        if queueSideBySide and hasCameraButtons then
            spectatorText.Visible=false
            position(nextHeroButton,14,48,halfButton,44)
            position(freeCameraButton,14+halfButton+gapButtons,48,halfButton,44)
            bottomRow,viewButtonHeight=96,44
        elseif compactCameraPanel then
            position(spectatorText, 14, 7, spectatorWidth - 28, 18)
            local cameraRowY = groupPanel.hudButton.Visible and 51 or 29
            position(nextHeroButton, 14, cameraRowY, halfButton, 44)
            position(freeCameraButton, 14 + halfButton + gapButtons, cameraRowY, halfButton, 44)
            bottomRow, viewButtonHeight = cameraRowY + 52, 44
        end
        position(watchButton, 14, bottomRow, paired and halfButton or innerWidth, viewButtonHeight)
        position(chooseEnemyButton, 14, bottomRow, paired and halfButton or innerWidth, viewButtonHeight)
        position(personalMenuButton, paired and (14 + halfButton + gapButtons) or 14,
            bottomRow, paired and halfButton or innerWidth, viewButtonHeight)
        spectatorText.TextSize = short and 12 or 14
    end
    spectatorText.TextWrapped = not compactCameraPanel
    spectatorText.TextTruncate = compactCameraPanel and Enum.TextTruncate.AtEnd or Enum.TextTruncate.None
    nextHeroButton.TextSize, freeCameraButton.TextSize = compact and 13 or 15, compact and 13 or 15
    if groupPanel.hudButton.Visible then
        -- Share the spectator heading row without obscuring ordinary offers or camera buttons.
        spectatorText.Size = UDim2.fromOffset(spectatorWidth - 140, spectatorText.Size.Y.Offset)
        if expanded then
            enemyChoiceTitle.Size = UDim2.fromOffset(spectatorWidth - 140, 19)
            if spectatorHeight &lt; 200 then enemyChoiceNote.Size = UDim2.fromOffset(spectatorWidth - 140, 25) end
        end
    end
    layoutAudioSettings(width,height,isTouch,mobileHudBottom,inset,short and 112 or 126,contentWidth)
    groupPanel:layout(contentWidth, width, height, spectatorWidth)
    if queueSideBySide and hasCameraButtons and not expanded then
        position(groupPanel.hudButton,spectatorWidth-114,0,100,44)
    end
end

local function dragCameraTo(input)
    if not spectatorCamera.enabled or not spectatorCamera:isFree() then return end
    local center = cameraPad.AbsolutePosition + cameraPad.AbsoluteSize / 2
    local radius = math.max(1, cameraPad.AbsoluteSize.X * 0.34)
    local delta = (Vector2.new(input.Position.X, input.Position.Y) - center) / radius
    if delta.Magnitude &gt; 1 then delta = delta.Unit end
    if delta.Magnitude &lt; 0.12 then delta = Vector2.zero end
    spectatorCamera:setTouch(delta.X, delta.Y)
    cameraKnob.Position = UDim2.new(0.5, delta.X * radius, 0.5, delta.Y * radius)
end
cameraPad.InputBegan:Connect(function(input)
    if cameraStickInput or not spectatorCamera.enabled or not spectatorCamera:isFree() then return end
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        cameraStickInput = input
        dragCameraTo(input)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if cameraStickInput and (input == cameraStickInput or (cameraStickInput.UserInputType == Enum.UserInputType.MouseButton1
        and input.UserInputType == Enum.UserInputType.MouseMovement)) then dragCameraTo(input) end
end)
UserInputService.InputBegan:Connect(function(input, processed)
    if processed or UserInputService:GetFocusedTextBox() then return end
    local key = input.KeyCode
    if spectatorCamera.enabled and spectatorCamera:isFree() then
        if key == Enum.KeyCode.W or key == Enum.KeyCode.A or key == Enum.KeyCode.S or key == Enum.KeyCode.D
            or key == Enum.KeyCode.Q or key == Enum.KeyCode.E then spectatorCamera:setKey(key.Name, true) end
        return
    end
end)
UserInputService.InputEnded:Connect(function(input)
    spectatorCamera:setKey(input.KeyCode.Name, false)
    for held, key in pairs(cameraHolds) do
        if held == input or (held.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseButton1) then
            spectatorCamera:setKey(key, false)
            cameraHolds[held] = nil
        end
    end
    if cameraStickInput and (input == cameraStickInput or (cameraStickInput.UserInputType == Enum.UserInputType.MouseButton1
        and input.UserInputType == Enum.UserInputType.MouseButton1)) then
        cameraStickInput = nil
        spectatorCamera:setTouch(0, 0)
        cameraKnob.Position = UDim2.fromScale(0.5, 0.5)
    end
end)
UserInputService.WindowFocusReleased:Connect(function()
    windowFocused = false
    resetInput()
    sendMovement()
end)
UserInputService.WindowFocused:Connect(function() windowFocused = true; syncGameplayContext() end)
UserInputService.TextBoxFocused:Connect(function() syncGameplayContext() end)
UserInputService.TextBoxFocusReleased:Connect(function() syncGameplayContext() end)

stateRemote.OnClientEvent:Connect(function(data)
    if type(data) ~= "table" then return end
    local confirmed, accepted = combatFeedback:sync(data, workspace:GetServerTimeNow())
    if accepted == false then return end
    gameAudio:sync(data)
    local wasPlayable = playable()
    local previousStatus = snapshot and snapshot.status
    local previousGroupId = snapshot and snapshot.groupId
    local previousRunId = snapshot and snapshot.runId
    local previousLevelEpoch = snapshot and snapshot.levelEpoch
    local previousView = snapshot and snapshot.view
    snapshot, mine = data, nil
    for _, hero in ipairs(data.heroes or {}) do if hero.slot == data.mine then mine = hero; break end end
    controlled = mine or data.enemyRole
    spectatorCamera:sync(data, controlled)
    local rewind=data.level and data.level.modeState and data.level.modeState.camera
    local serial=rewind and rewind.rewindSerial
    if previousGroupId~=data.groupId or previousRunId~=data.runId or previousLevelEpoch~=data.levelEpoch then vehicleRewindSerial=nil end
    if serial~=nil and vehicleRewindSerial~=nil and serial~=vehicleRewindSerial and controlled then
        movementInput:reset(gameplayBindings and gameplayBindings:heldDirections() or {},true)
        sendMovement()
    end
    vehicleRewindSerial=serial
    local nextIdentity = controlled and table.concat({tostring(data.groupId), tostring(data.runId), tostring(data.levelEpoch),
        tostring(controlled.actorId), tostring(controlled.attempt), tostring(controlled.connectionEpoch)}, ":") or nil
    local nextHeldContext = tostring(data.interaction ~= nil and data.interaction.carrying == true) .. ":" .. tostring(controlled and controlled.carryState)
    if nextIdentity ~= identity or previousStatus ~= data.status or previousView ~= data.view
        or previousGroupId ~= data.groupId or previousRunId ~= data.runId or previousLevelEpoch ~= data.levelEpoch then
        mobileExpanded = nil
    end
    if nextIdentity ~= identity then identity, sequence = nextIdentity, 0; feedbackUntil = 0; feedbackActionId = nil; resetInput()
    elseif wasPlayable and not playable() then resetInput()
    elseif controlled and ((lastReactionEpoch ~= nil and controlled.reactionEpoch ~= lastReactionEpoch)
        or (lastHeldContext ~= nil and nextHeldContext ~= lastHeldContext)) then
        movementInput:reset(gameplayBindings:heldDirections(),true)
        sendMovement()
    end
    lastReactionEpoch = controlled and controlled.reactionEpoch
    lastHeldContext = nextHeldContext
    if previousGroupId ~= data.groupId or previousRunId ~= data.runId or previousLevelEpoch ~= data.levelEpoch then
        choosingEnemy = data.preference ~= "Spectator"
        pendingTemplate, pendingRole = nil, nil
        pendingEnemy = nil
        pendingView = nil
        resetInput()
    end
    if pendingTemplate and (data.selectedTemplate == pendingTemplate or data.notice) then pendingTemplate = nil end
    if pendingRole and (data.preference == pendingRole or data.notice) then pendingRole = nil end
    if pendingEnemy and (data.enemyRole or data.notice) then pendingEnemy = nil end
    if pendingView and (data.view == pendingView or data.notice or data.status ~= "Active") then pendingView = nil end
    if previousGroupId ~= data.groupId or previousStatus ~= data.status then scroll.CanvasPosition = Vector2.zero end
    actionPending = false
    if feedbackActionId and (type(data.actionFeedback) ~= "table" or data.actionFeedback.id ~= feedbackActionId) then
        feedbackUntil, feedbackActionId = 0, nil
    end
    if os.clock() &gt;= feedbackUntil then
        feedbackLabel.Text, feedbackLabel.TextColor3 = T(CombatFeedback.hint(data,T)), C.muted
    end
    if #confirmed &gt; 0 then
        local latest = confirmed[#confirmed]
        feedbackLabel.Text = T(latest.text)
        feedbackLabel.TextColor3 = ({damage=C.red,shield=C.yellow,success=C.lime})[latest.style] or C.text
        feedbackActionId = latest.kind == "ActionResult" and latest.actionId or nil
        feedbackUntil = os.clock() + math.min(1.4, latest.duration or 1.4)
    end
    render()
    layout()
    syncGameplayContext()
end)
safe:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)
localizationService:GetPropertyChangedSignal("RobloxLocaleId"):Connect(function()
    feedbackUntil,feedbackActionId=0,nil
    feedbackLabel.Text=T(CombatFeedback.hint(snapshot,T))
    render();layout()
end)
UserInputService:GetPropertyChangedSignal("TouchEnabled"):Connect(function() mobileExpanded = nil; layout() end)
-- Gameplay drives server-owned bodies instead of a default Roblox character.
task.spawn(function()
    local scripts = player:WaitForChild("PlayerScripts")
    local playerModule = scripts:WaitForChild("PlayerModule", 8)
    if playerModule then
        local ok, module = pcall(require, playerModule)
        if ok and module.GetControls then module:GetControls():Disable() end
    end
    pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false) end)
end)
local moveElapsed, syncElapsed = 0, 0
local lastEntryReady = -math.huge
local lastRideReady = -math.huge
local function speederInView(camera)
    if not camera or not playable() or not mine then return false end
    local mode = snapshot.level and snapshot.level.modeState
    if not mode or not mode.vehicleGroup or mode.vehicleGroup.phase ~= "AwaitingEntryView" then return false end
    local model = spectatorCamera.models and spectatorCamera.models[mine.actorId]
    local root = model and model:FindFirstChild("HumanoidRootPart")
    if not root or model:GetAttribute("CampaignMode") ~= "Speeder" then return false end
    local world = workspace:FindFirstChild(snapshot.worldName)
    local actors = world and world:FindFirstChild("Actors")
    if not actors or model.Parent ~= actors then return false end
    -- The rider's body may be outside the viewport in first person.
    local subject = camera.CameraSubject
    if not subject or (subject ~= root and subject ~= model:FindFirstChild("Head")) then return false end
    local geometry = world:FindFirstChild("Geometry")
    if not geometry or not geometry:FindFirstChild("CourseSupport_Arrival") then return false end
    local id = "vehicle-" .. snapshot.mine
    local plate = geometry:FindFirstChild("Campaign_Speeder_" .. id)
    if not plate or (plate.Position - root.Position).Magnitude &gt; 12 then return false end
    if plate.Transparency &lt; 1 and plate.LocalTransparencyModifier &lt; 1 then return true end
    local skin = geometry:FindFirstChild("CourseVehicle_" .. id)
    local deck = skin and skin:FindFirstChild("RiderDeck", true)
    return deck and deck:IsA("BasePart") and deck.Transparency &lt; 1 and deck.LocalTransparencyModifier &lt; 1
end
RunService:BindToRenderStep("BrickToadsCameraSubject", Enum.RenderPriority.Camera.Value - 1, function(dt)
    spectatorCamera:step(dt, workspace.CurrentCamera)
end)
RunService.RenderStepped:Connect(function(dt)
    syncGameplayContext()
    -- Wait for both an authoritative entry route and an unobscured, bound HUD.
    if snapshot and snapshot.entryPending and os.clock() - lastEntryReady &gt;= 2
        and not gui.Parent:FindFirstChild("BrickToadsSplash") then
        lastEntryReady = os.clock()
        intent:FireServer({kind="EntryReady"})
    end
    if feedbackUntil &gt; 0 and os.clock() &gt;= feedbackUntil then
        feedbackUntil = 0
        feedbackLabel.Text, feedbackLabel.TextColor3 = T(CombatFeedback.hint(snapshot,T)), C.muted
    end
    bossQueue:step()
    groupPanel:step()
    moveElapsed, syncElapsed = moveElapsed + dt, syncElapsed + dt
    if syncElapsed &gt;= 2 then
        syncElapsed = 0
        if not snapshot then sendIntent({kind = "Sync"}) end
        if pendingTemplate and os.clock() - pendingAt &gt; 4 then
            pendingTemplate = nil
            sendIntent({kind = "Sync"})
            renderSelection()
        end
        if pendingRole and os.clock() - pendingRoleAt &gt; 4 then
            pendingRole = nil
            sendIntent({kind = "Sync"})
            renderSelection()
        end
        if pendingEnemy and os.clock() - pendingEnemyAt &gt; 4 then
            pendingEnemy = nil
            sendIntent({kind = "Sync"})
            render()
        end
        if pendingView and os.clock() - pendingViewAt &gt; 4 then
            pendingView = nil
            sendIntent({kind = "Sync"})
            render()
        end
        if actionPending and os.clock() - actionAt &gt; 4 then actionPending = false; render() end
    end
    local camera = workspace.CurrentCamera
    local closeUp = camera and (camera.CFrame.Position - camera.Focus.Position).Magnitude &lt; 1.25
    cameraVisibility.setHiddenActor(closeUp and spectatorCamera.followedModel or nil)
    if snapshot and os.clock() - lastRideReady &gt;= 2 and speederInView(camera) then
        lastRideReady = os.clock()
        sendIntent({kind="RideReady", runId=snapshot.runId})
    end
    if moveElapsed &gt;= 0.1 then
        moveElapsed = 0
        if playable() then
            sendMovement()
        end
    end
end)
render()
layout()
gui:SetAttribute("MenuReady", true)
sendIntent({kind = "Sync"})
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT73">
          <Properties>
            <string name="Name">CameraVisibility</string>
            <ProtectedString name="Source">-- Compose the first-person mask with the game's streamed skins and attack morphs.
local CameraVisibility = {}
local hiddenActor, added, removing
local saved = {}

function CameraVisibility.get(part)
    local value = saved[part] or part.LocalTransparencyModifier
    return type(value) == "number" and value &gt;= 0 and value &lt;= 1 and value or 0
end

function CameraVisibility.set(part, value)
    if saved[part] ~= nil then
        saved[part] = value
    else
        part.LocalTransparencyModifier = value
    end
end

local function hide(part)
    if saved[part] == nil and (part:IsA("BasePart") or part:IsA("Decal")) then
        saved[part] = part.LocalTransparencyModifier
        part.LocalTransparencyModifier = 1
    end
end

local function restore(part)
    local value = saved[part]
    if value ~= nil then
        saved[part] = nil
        part.LocalTransparencyModifier = value
    end
end

function CameraVisibility.setHiddenActor(actor)
    if actor == hiddenActor then return end
    if hiddenActor then
        added:Disconnect()
        removing:Disconnect()
        added, removing = nil, nil
        for part in pairs(saved) do restore(part) end
    end
    hiddenActor = actor
    if actor then
        added = actor.DescendantAdded:Connect(hide)
        removing = actor.DescendantRemoving:Connect(restore)
        for _, part in ipairs(actor:GetDescendants()) do hide(part) end
    end
end

return CameraVisibility
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT74">
          <Properties>
            <string name="Name">CampaignPresentation</string>
            <ProtectedString name="Source">-- Pure snapshot presentation. Role authority and starting a new game stay on the server.
local Presentation={}
local bossNames={CausewayGuardian='Causeway Guardian',BigBlag='Big Blag',RoboManus='Robo-Manus',
    GeneralSlaughter='General Slaughter',Buzzball='Buzzball',DarkQueen='Dark Queen'}

function Presentation.bossName(enemy)
    -- Controlled snapshot.name may be the human owner's display name.
    return enemy and (bossNames[enemy.bossType] or
        (enemy.template=='Boss' and not enemy.bossType and 'Causeway Guardian') or enemy.name) or 'Boss'
end

function Presentation.menu(snapshot)
    snapshot=snapshot or {}
    local level=snapshot.level or {}
    local campaign=snapshot.campaign or {}
    local index=tonumber(campaign.index or level.campaignIndex)
    local count=tonumber(campaign.count or level.campaignCount)
    local stage=level.levelName or 'Flooded Causeway'
    local won=snapshot.status=='Won'
    local enemy=snapshot.enemyRole
    local result={title=stage,intro='Guard weapons, grabs and a Guardian. Cross the causeway together.',
        chooseTitle='CHOOSE YOUR HERO'}
    if snapshot.status=='Faulted' then
        result.title='Party stopped';result.resultTitle='PARTY STOPPED'
        result.resultDetail='An error stopped this party. The host can start a new game manually.'
        result.intro='A new party starts only when you press “Start again”.';result.chooseTitle='NEW PARTY'
        result.stopped=true
    elseif won or snapshot.status=='Lost' then
        local complete=won and (campaign.complete==true or (index~=nil and count~=nil and index&gt;=count))
        result.success=(enemy~=nil and not won) or (enemy==nil and won)
        result.intro='Press “New game” to start the next attempt.';result.chooseTitle='HERO FOR THE NEXT GAME'
        if complete then
            result.title='Campaign complete'
            result.resultTitle=enemy and 'HEROES COMPLETED THE CAMPAIGN' or 'CAMPAIGN COMPLETE!'
            result.resultDetail='All {count:int} stages cleared. The Dark Queen is defeated. Choose roles for a new game.'
            result.resultArgs={count=count or index or 13}
        elseif index then
            result.resultTitle=enemy and (won and 'HEROES CLEARED THE STAGE' or 'HEROES STOPPED')
                or (won and 'STAGE CLEARED!' or 'TEAM ELIMINATED')
            result.resultDetail=won and '{stage} cleared. Choose roles for the next game.'
                or 'The heroes were stopped at {stage}. A new game starts from the first stage.'
            result.resultArgs={stage=stage}
        else
            -- Older standalone Causeway snapshots have no campaign metadata.
            result.resultTitle=enemy and (won and 'HEROES CLEARED THE CAUSEWAY' or 'HEROES STOPPED')
                or (won and 'CAUSEWAY CLEARED!' or 'TEAM ELIMINATED')
            result.resultDetail=won and 'The Guardian is defeated. The gate is open — the team reached the exit.'
                or 'The heroes have no respawns left. Choose roles and try the causeway again.'
        end
    elseif snapshot.status=='Active' and snapshot.view=='Menu' then
        result.title='The team is still playing'
        if enemy and enemy.status=='Dead' then
            if enemy.template=='Boss' then
                result.intro='{boss} is defeated. You can keep watching this game.'
                result.introArgs={boss=Presentation.bossName(enemy)}
            else result.intro='Your only life is over. You can keep watching this game.' end
        else result.intro='You can return to watching this same game.' end
    elseif index and index&gt;1 then
        result.intro='Choose a role for this campaign.'
    end
    return result
end

function Presentation.reactionProgress(enemy)
    local maximum=enemy and tonumber(enemy.maxProgress)
    if not enemy or not enemy.bossType or not maximum or maximum&lt;=0 then return nil end
    return 'Reaction progress: {count:int}/{maximum:int}',{
        count=math.clamp(tonumber(enemy.progress) or 0,0,maximum),maximum=maximum}
end

return Presentation
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT75">
          <Properties>
            <string name="Name">CastAssetVisibility</string>
            <ProtectedString name="Source">-- Client content availability changes only local visibility, never server bodies.
local Gate={}
Gate.__index=Gate
local CONTRACTS={
    Cast={tag='BrickToadsCastSkin',skin='CanonicalCastSkin',id='CastSkinId',
        owner='CastAppearance',profile='CanonicalNESCast',alpha='CastVisibleTransparency',
        reference='CastFallbackTarget',backlink='CastFallbackOwner',fallbackAlpha='CastFallbackTransparency'},
    Course={tag='BrickToadsCourseSkin',skin='CanonicalCourseSkin',id='CourseSkinId',
        owner='CourseAppearance',profile='CanonicalCourseVehicle',alpha='CourseVisibleTransparency',
        reference='CourseFallbackTarget',backlink='CourseFallbackOwner',fallbackAlpha='CourseFallbackTransparency'},
    Prop={tag='BrickToadsCoursePropSkin',skin='CanonicalCoursePropSkin',id='CoursePropSkinId',
        owner='CoursePropAppearance',profile='CanonicalCourseProp',alpha='CoursePropVisibleTransparency',
        reference='CoursePropFallbackTarget',backlink='CoursePropFallbackOwner',fallbackAlpha='CoursePropFallbackTransparency'},
}
local RETRY_DELAYS={1,3,10}
local function finite(v)return type(v)=='number' and v==v and v&gt;=0 and v&lt;=1 end
local function identity(v)return type(v)=='string' and #v&gt;0 and #v&lt;=512 end
local function key(id)
    if type(id)~='string' or id=='' then return nil end
    return id:match('^rbxassetid://(%d+)') or id:match('[?&amp;]id=(%d+)') or id
end
local function disconnect(list)
    for _,connection in ipairs(list)do pcall(function()connection:Disconnect()end)end
    table.clear(list)
end
local function connect(list,event,fn)
    if event then list[#list+1]=event:Connect(fn)end
end
local visibility = if script then require(script.Parent:WaitForChild("CameraVisibility")) else require("./CameraVisibility")
local function localAlpha(part,value)
    pcall(visibility.set,part,value)
end
function Gate:_valid(row)
    return not self.destroyed and self.rows[row.skin]==row and row.skin.Parent==row.owner
        and row.skin:IsDescendantOf(self.workspace) and row.skin:GetAttribute(self.contract.skin)==true
        and row.skin:GetAttribute(self.contract.id)==row.id and row.owner:GetAttribute(self.contract.owner)==self.contract.profile
end
function Gate:_restoreFallback(row,part,value)
    local backlink=part:GetAttribute(self.contract.backlink)
    if part.Parent and (backlink==nil or backlink==row.id)then localAlpha(part,value)end
end
function Gate:_rememberFallback(row,part)
    local baseline=self.baselines[part]
    if not baseline then
        baseline={value=visibility.get(part),owners={}}
        self.baselines[part]=baseline
    end
    baseline.owners[row]=true
    return baseline.value
end
function Gate:_releaseFallback(row,part)
    local baseline=self.baselines[part];if not baseline then return end
    baseline.owners[row]=nil
    local backlink=part:GetAttribute(self.contract.backlink)
    -- During handoff the server may replace the backlink before publishing the
    -- new skin's reference. Retain the pre-gate value for that incoming owner.
    if next(baseline.owners)==nil and (backlink==nil or backlink==row.id)then self.baselines[part]=nil end
end
function Gate:_unsubscribe(row)
    local entry=row.entry;row.entry=nil
    if not entry then return end
    entry.waiters[row]=nil
    if entry.state~='Ready' and next(entry.waiters)==nil then
        entry.cancelled=true
        if self.cache[entry.signature]==entry then self.cache[entry.signature]=nil end
    end
end
function Gate:_retry(entry)
    local seconds=RETRY_DELAYS[entry.attempts or 0]
    if not seconds or not self.delay or entry.retryScheduled or entry.cancelled or self.destroyed then return end
    entry.retryScheduled=true
    self.delay(seconds,function()
        entry.retryScheduled=false
        if not entry.cancelled and not self.destroyed and self.cache[entry.signature]==entry then self:_request(entry)end
    end)
end
function Gate:_request(entry)
    self.spawn(function()
        if entry.cancelled or self.destroyed or self.cache[entry.signature]~=entry then return end
        -- Reconcile live subscribers before selecting typed instances. The
        -- original request's skin may have been destroyed during the delay.
        local waiters={};for row in pairs(entry.waiters)do waiters[#waiters+1]=row end
        local selected
        for _,row in ipairs(waiters)do
            if self.rows[row.skin]==row then self:_refresh(row)end
            if row.entry==entry and self:_valid(row)and row.signature==entry.signature and row.parts and #row.parts&gt;0 then selected=row end
        end
        if not selected or entry.cancelled or self.destroyed then return end
        local parts,ids=selected.parts,selected.resourceIds
        entry.state='Pending';entry.attempts=(entry.attempts or 0)+1
        for row in pairs(entry.waiters)do if row.entry==entry and self:_valid(row)then self:_apply(row,'Pending')end end
        local observed,failed={},false
        local ok=pcall(function()
            self.provider:PreloadAsync(parts,function(id,status)
                local resource=key(id)
                if resource and ids[resource]then observed[resource]=true end
                if status~=self.success then failed=true end
            end)
        end)
        for resource in pairs(ids)do if not observed[resource]then failed=true end end
        if entry.cancelled or self.destroyed or self.cache[entry.signature]~=entry then return end
        entry.state=ok and not failed and 'Ready'or'Failed'
        for row in pairs(entry.waiters)do if row.entry==entry and self:_valid(row)then self:_apply(row,entry.state)end end
        if entry.state=='Failed'then self:_retry(entry)end
    end)
end
function Gate:_remove(skin)
    local row=self.rows[skin];if not row then return end
    self.rows[skin]=nil;self:_unsubscribe(row)
    disconnect(row.connections);disconnect(row.assetConnections)
    for part,value in pairs(row.skinSaved)do
        if part.Parent and part:IsDescendantOf(skin)then localAlpha(part,value)end
    end
    for part,value in pairs(row.fallbackSaved)do self:_restoreFallback(row,part,value);self:_releaseFallback(row,part)end
end
function Gate:_apply(row,state)
    if not self:_valid(row)then return end
    row.state=state
    for part,value in pairs(row.skinSaved)do
        if part.Parent and part:IsDescendantOf(row.skin)then localAlpha(part,state=='Ready' and value or 1)end
    end
    for part,value in pairs(row.fallbackSaved)do
        if part.Parent and part:GetAttribute(self.contract.backlink)==row.id then localAlpha(part,state=='Ready' and 1 or value)end
    end
end
function Gate:_refresh(row)
    if not self:_valid(row)then self:_remove(row.skin);return end
    disconnect(row.assetConnections)
    local parts,ids,signature,targets={},{},{},{}
    local complete=true
    local function refresh()if self.rows[row.skin]==row then self:_refresh(row)end end
    local function include(prefix,id,required)
        if required and not key(id)then complete=false end
        if type(id)=='string' and id~=''then
            signature[#signature+1]=prefix..tostring(#id)..':'..id
            ids[key(id)]=true
        end
    end
    for _,part in ipairs(row.skin:GetDescendants())do
        if part:IsA('MeshPart')then
            parts[#parts+1]=part
            if row.skinSaved[part]==nil then row.skinSaved[part]=visibility.get(part) end
            if not finite(part:GetAttribute(self.contract.alpha))then complete=false end
            include('M',part.MeshId,true);include('T',part.TextureID,false)
            connect(row.assetConnections,part:GetPropertyChangedSignal('MeshId'),refresh)
            connect(row.assetConnections,part:GetPropertyChangedSignal('TextureID'),refresh)
            connect(row.assetConnections,part:GetAttributeChangedSignal(self.contract.alpha),refresh)
            for _,surface in ipairs(part:GetChildren())do if surface:IsA('SurfaceAppearance')then
                include('C',surface.ColorMap,false)
                connect(row.assetConnections,surface:GetPropertyChangedSignal('ColorMap'),refresh)
            end end
        end
    end
    -- Explicit references support the serpent's external support collider. A
    -- unique backlink prevents an old skin from controlling a replacement.
    for _,ref in ipairs(row.skin:GetChildren())do
        if ref:IsA('ObjectValue')and ref.Name==self.contract.reference then
            connect(row.assetConnections,ref:GetPropertyChangedSignal('Value'),refresh)
            local part=ref.Value
            if part and part:IsA('BasePart')then
                connect(row.assetConnections,part:GetAttributeChangedSignal(self.contract.backlink),refresh)
                connect(row.assetConnections,part:GetAttributeChangedSignal(self.contract.fallbackAlpha),refresh)
                if part.Parent and part:GetAttribute(self.contract.backlink)==row.id
                    and finite(part:GetAttribute(self.contract.fallbackAlpha))then
                    targets[part]=true
                    if row.fallbackSaved[part]==nil then row.fallbackSaved[part]=self:_rememberFallback(row,part)end
                end
            end
        end
    end
    for part,value in pairs(row.fallbackSaved)do
        if not targets[part]then self:_restoreFallback(row,part,value);self:_releaseFallback(row,part);row.fallbackSaved[part]=nil end
    end
    table.sort(signature)
    local signatureKey=table.concat(signature,'|')
    row.signature,row.parts,row.resourceIds=signatureKey,parts,ids
    if #parts==0 or not complete then
        self:_unsubscribe(row);self:_apply(row,'Pending');return
    end
    local entry=self.cache[signatureKey]
    if row.entry~=entry then self:_unsubscribe(row)end
    if not entry then
        entry={state='Pending',signature=signatureKey,waiters={},attempts=0}
        self.cache[signatureKey]=entry
        row.entry=entry;entry.waiters[row]=true
        self:_apply(row,'Pending')
        self:_request(entry)
    else
        row.entry=entry;entry.waiters[row]=true;self:_apply(row,entry.state)
    end
end
function Gate:_add(skin)
    if self.destroyed or self.rows[skin]or not skin:IsA('Model')or skin:GetAttribute(self.contract.skin)~=true then return end
    local owner=skin.Parent;local id=skin:GetAttribute(self.contract.id)
    if not owner or not owner:IsA('Model')or not identity(id)or not skin:IsDescendantOf(self.workspace)
        or owner:GetAttribute(self.contract.owner)~=self.contract.profile then return end
    local row={skin=skin,owner=owner,id=id,connections={},assetConnections={},skinSaved={},fallbackSaved={}}
    self.rows[skin]=row
    local function refresh()if self.rows[skin]==row then self:_refresh(row)end end
    connect(row.connections,skin.AncestryChanged,refresh)
    connect(row.connections,skin:GetAttributeChangedSignal(self.contract.skin),refresh)
    connect(row.connections,skin:GetAttributeChangedSignal(self.contract.id),refresh)
    connect(row.connections,owner:GetAttributeChangedSignal(self.contract.owner),refresh)
    connect(row.connections,skin.DescendantAdded,refresh)
    -- DescendantRemoving fires before the child leaves. Defer reconciliation so
    -- it cannot keep a removed fallback reference or obsolete asset signature.
    connect(row.connections,skin.DescendantRemoving,function()self.defer(refresh)end)
    self:_refresh(row)
end
function Gate.new(deps,contractName)
    deps=deps or {}
    local contract=assert(CONTRACTS[contractName or 'Cast'],'Unsupported appearance contract')
    local self=setmetatable({workspace=deps.workspace or game:GetService('Workspace'),
        collection=deps.collectionService or game:GetService('CollectionService'),
        provider=deps.contentProvider or game:GetService('ContentProvider'),
        spawn=deps.spawn or task.spawn,defer=deps.defer or deps.spawn or task.defer,delay=deps.delay or (task and task.delay),
        success=deps.successStatus or Enum.AssetFetchStatus.Success,contract=contract,rows={},cache={},connections={},
        baselines=setmetatable({},{__mode='k'})},Gate)
    connect(self.connections,self.collection:GetInstanceAddedSignal(contract.tag),function(skin)self:_add(skin)end)
    connect(self.connections,self.collection:GetInstanceRemovedSignal(contract.tag),function(skin)self:_remove(skin)end)
    for _,skin in ipairs(self.collection:GetTagged(contract.tag))do self:_add(skin)end
    return self
end
function Gate:diagnostics()
    local out={tracked=0,pending=0,ready=0,failed=0,destroyed=self.destroyed==true}
    for _,row in pairs(self.rows)do out.tracked+=1;local state=string.lower(row.state or'Pending');out[state]+=1 end
    return out
end
function Gate:destroy()
    if self.destroyed then return end
    self.destroyed=true;disconnect(self.connections)
    local skins={};for skin in pairs(self.rows)do skins[#skins+1]=skin end
    for _,skin in ipairs(skins)do self:_remove(skin)end
    self.cache={};self.baselines={}
end
return Gate
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT76">
          <Properties>
            <string name="Name">CastGallery</string>
            <ProtectedString name="Source">-- Paginate the two illustrated cast sheets so touch devices only render eight cards at once.
local Gallery = {}

function Gallery.attach(shell, header, art, colors, translate, button, label, frame)
    local page = 1
    local panel = frame(shell, "CastGallery", colors.ink)
    panel.Size = UDim2.fromScale(1,1)
    panel.ZIndex = 6
    panel.Visible = false
    panel.Active = true
    local heading = label(panel, "Heading", translate("Character gallery"), 19, colors.yellow, true)
    heading.Position, heading.Size = UDim2.fromOffset(12,0), UDim2.new(1,-110,0,44)
    heading.Font = Enum.Font.Arcade
    local close = button(panel, "CloseGallery", translate("Close"), colors.card, function() panel.Visible = false end)
    close.Position, close.Size = UDim2.new(1,-84,0,0), UDim2.fromOffset(80,44)
    local grid = frame(panel, "PortraitGrid")
    grid.BackgroundTransparency = 1
    grid.Position, grid.Size = UDim2.fromOffset(4,48), UDim2.new(1,-8,1,-98)
    local cards = {}
    local count = math.ceil(#art.cast / 8)
    local counter = label(panel, "Page", "", 16, colors.text, true)
    counter.Position, counter.Size = UDim2.new(.25,0,1,-46), UDim2.new(.5,0,0,44)
    counter.TextXAlignment = Enum.TextXAlignment.Center
    local function draw()
        local columns = if grid.AbsoluteSize.X &gt;= grid.AbsoluteSize.Y then 4 else 2
        local rows = 8 / columns
        for i = 1, 8 do
            local key = art.cast[(page-1)*8+i]
            local card = cards[i]
            if not card then
                local tile = frame(grid, "CastCard"..i, colors.panel)
                local face = art.portrait(tile, key)
                face.Position, face.Size = UDim2.fromOffset(1,1), UDim2.new(1,-2,1,-29)
                local name = label(tile, "CharacterName", "", 14, colors.text, true)
                name.Position, name.Size = UDim2.new(0,2,1,-27), UDim2.new(1,-4,0,26)
                name.TextXAlignment = Enum.TextXAlignment.Center
                card = {tile=tile, face=face, name=name}
                cards[i] = card
            end
            card.tile.Position = UDim2.fromScale((i-1)%columns/columns, math.floor((i-1)/columns)/rows)
            card.tile.Size = UDim2.new(1/columns,-3,1/rows,-3)
            card.tile.Visible = key ~= nil
            if key then
                art.setPortrait(card.face, key)
                local display = key:gsub("(%l)(%u)", "%1 %2")
                card.name.Text = translate(if key == "RoboManus" then "Robo-Manus" else display)
            end
        end
        counter.Text = string.format("%d / %d", page, count)
    end
    for _, step in ipairs({-1,1}) do
        local direction = button(panel, if step &lt; 0 then "PreviousPage" else "NextPage",
            if step &lt; 0 then "◀" else "▶", colors.card, function()
                page = (page-1+step)%count+1
                draw()
            end)
        direction.Position = UDim2.new(if step &lt; 0 then 0 else .75,2,1,-46)
        direction.Size = UDim2.new(.25,-4,0,44)
    end
    grid:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() if panel.Visible then draw() end end)
    local open = button(header, "OpenCastGallery", translate("Cast"), colors.card, function()
        page = 1
        panel.Visible = true
        draw()
    end)
    open.Size, open.Position = UDim2.fromOffset(100,44), UDim2.new(1,-106,0,3)
    open.Font, open.TextColor3 = Enum.Font.Arcade, colors.yellow
end

return Gallery
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT77">
          <Properties>
            <string name="Name">CombatEffects</string>
            <ProtectedString name="Source">-- Local, bounded cosmetic geometry. This module never writes to gameplay actors.
local Effects={}
Effects.__index=Effects
local MAX_PARTICLES=24
local styles={
    hit={count=4,life=.22,radius=1.15,color={255,206,106}},
    shield={count=8,life=.32,radius=1.8,color={133,202,225}},
    heal={count=5,life=.48,radius=1.1,color={157,223,135}},
    spawn={count=6,life=.52,radius=1.6,color={178,220,154}},
    warning={count=6,life=.42,radius=2,color={232,177,104}},
    crash={count=5,life=.34,radius=1.8,color={224,155,116}},
    result={count=8,life=.62,radius=2.4,color={219,213,135}},
    death={count=4,life=.35,radius=1.2,color={177,168,162}},
}
local function finite(x) return type(x)=='number' and x==x and x&gt;-math.huge and x&lt;math.huge end
local function observedNow(data)
    if finite(data.now) and finite(data.serverNow) then return math.max(data.now,data.serverNow) end
    return finite(data.serverNow) and data.serverNow or data.now
end
local function dispose(handle) if handle and handle.destroy then pcall(function() handle:destroy() end) end end

local function native(deps)
    local workspace=deps.workspace or game:GetService('Workspace')
    local tweenService=deps.tweenService or game:GetService('TweenService')
    local debris=deps.debris or game:GetService('Debris')
    local folder
    local function container(group)
        if not folder or not folder.Parent then
            folder=Instance.new('Folder');folder.Name='BrickToadsLocalEffects';folder.Parent=deps.effectsParent or workspace
        end
        folder:SetAttribute('GroupId',group)
        return folder
    end
    local function position(event,data)
        if type(data.groupId)~='string' or data.groupId=='' then return nil end
        local world
        for _,child in ipairs(workspace:GetChildren()) do
            if child:GetAttribute('GroupId')==data.groupId and child:FindFirstChild('Actors') then world=child;break end
        end
        if not world then return nil end
        local actorId=event.actorId
        local slot=event.slot or data.mine or -99
        if not actorId then
            for _,hero in ipairs(data.heroes or {}) do if hero.slot==slot then actorId=hero.actorId;break end end
        end
        for _,model in ipairs(world.Actors:GetChildren()) do
            local matches=actorId and model:GetAttribute('ActorId')==actorId
                or not actorId and (model:GetAttribute('Slot')==slot or model.Name=='Actor_'..tostring(slot))
            if matches then
                local root=model:FindFirstChild('HumanoidRootPart') or model.PrimaryPart
                if root and root:IsA('BasePart') then local p=root.Position;return {x=p.X,y=p.Y,z=p.Z} end
            end
        end
        return nil
    end
    local function particle(spec)
        local p=Instance.new('Part');p.Name='Cosmetic_'..spec.kind;p.Anchored=true
        p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false;p.Massless=true
        p.Material=Enum.Material.SmoothPlastic;p.Color=Color3.fromRGB(unpack(spec.color))
        p.Size=Vector3.new(spec.size,spec.size,spec.size);p.Transparency=spec.transparency
        p.CFrame=CFrame.new(spec.x,spec.y,spec.z)*CFrame.Angles(0,0,spec.angle)
        p.Parent=container(spec.groupId)
        local tween=tweenService:Create(p,TweenInfo.new(spec.life,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),
            {Transparency=1,Position=Vector3.new(spec.toX,spec.toY,spec.toZ),Size=p.Size*.35})
        tween:Play();debris:AddItem(p,spec.life+.08)
        return {destroy=function() tween:Cancel();p:Destroy() end}
    end
    return position,particle,function() if folder then folder:Destroy();folder=nil end end
end

function Effects.new(deps)
    deps=deps or {}
    local resolve,create,cleanup=deps.resolvePosition,deps.createParticle,nil
    if not resolve or not create then local r,c,d=native(deps);resolve=resolve or r;create=create or c;cleanup=d end
    return setmetatable({resolve=resolve,create=create,cleanup=cleanup,particles={},enabled=true,reduced=true},Effects)
end
function Effects:reset()
    for _,row in ipairs(self.particles) do dispose(row.handle) end
    self.particles={}
    if self.cleanup then self.cleanup() end
end
function Effects:sync(data)
    if self.destroyed then return end
    local now=type(data)=='table' and observedNow(data)
    if not finite(now) then return end
    for i=#self.particles,1,-1 do
        if self.particles[i].expires&lt;=now then dispose(self.particles[i].handle);table.remove(self.particles,i) end
    end
end
function Effects:emit(kind,event,data)
    if self.destroyed or not self.enabled or type(data)~='table' or type(data.groupId)~='string' or data.groupId=='' then return false end
    local style=styles[kind];if not style then return false end
    local now=observedNow(data);if not finite(now) then return false end
    self:sync(data)
    local ok,p=pcall(self.resolve,event,data)
    if not ok or type(p)~='table' or not finite(p.x) or not finite(p.y) or not finite(p.z) then return false end
    for i=1,style.count do
        while #self.particles&gt;=MAX_PARTICLES do dispose(table.remove(self.particles,1).handle) end
        local angle=(i-1)*math.pi*2/style.count
        local dx,dz=math.cos(angle),math.sin(angle)
        local ring=kind=='shield' or kind=='warning' or kind=='spawn'
        local start=ring and style.radius*.65 or .2
        local spec={kind=kind,groupId=data.groupId,life=style.life,color=style.color,
            size=ring and .18 or .24,transparency=self.reduced and .32 or .14,angle=angle,
            anchored=true,canCollide=false,canQuery=false,canTouch=false,
            x=p.x+dx*start,y=p.y+(kind=='result' and 1.8 or .25),z=p.z+dz*start,
            toX=p.x+dx*style.radius,toY=p.y+(kind=='heal' and 2.2 or kind=='result' and 3.2 or .5),toZ=p.z+dz*style.radius}
        local made,handle=pcall(self.create,spec)
        if made and handle then self.particles[#self.particles+1]={handle=handle,expires=now+style.life} end
    end
    return true
end
function Effects:setEnabled(value) self.enabled=value==true;if not self.enabled then self:reset() end end
function Effects:setReducedFlash(value) self.reduced=value~=false end
function Effects:diagnostics() return {live=#self.particles,limit=MAX_PARTICLES,enabled=self.enabled,destroyed=self.destroyed==true} end
function Effects:destroy() if self.destroyed then return end;self:reset();self.destroyed=true end
return Effects
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT78">
          <Properties>
            <string name="Name">CombatFeedback</string>
            <ProtectedString name="Source">-- Confirmed presentation only. This module never sends input or changes actors.
local Feedback={}
Feedback.__index=Feedback
local messages={DragonMounted="DRAGON MOUNTED",DragonCaptured="YOU WERE CAPTURED",
    DragonReleased="BACK ON FOOT",DragonFireHit="FIRE HIT",AttackMiss="MISS",EnemyAttackMiss="MISS",EnemyDeath="ENEMY DEFEATED",
    EnemyClaimed="ROLE CLAIMED",FlyCaught="HEALTH RESTORED",ClubEquipped="CLUB EQUIPPED",
    ClubDropped="CLUB DROPPED",ClubSwingHit="CLUB HIT",EnemyGrabbed="ENEMY GRABBED",
    EnemyThrown="ENEMY THROWN",EnemyDropped="ENEMY RELEASED",RelocateToSafety="SAFE SUPPORT",
    GuardianBallPickedUp="BALL PICKED UP",GuardianBallThrown="BALL THROWN",BossHit="GUARDIAN HIT",
    BossShielded="GUARDIAN PROTECTED",BossWarning="HEAVY BALL — DODGE"}
messages.LifeStolen='LIFE STOLEN';messages.StolenLifeRecovered='LIFE RECOVERED';messages.RavenClawPickedUp='RAVEN CLAW EQUIPPED'
messages.CampaignGroupStopped='CRASH · GROUP STOPPED';messages.CampaignGroupRewound='CHECKPOINT · READY'
messages.CampaignBombDefused='BOMB DEFUSED'
local global={RunResult=true,EnemyDeath=true,BossHit=true,BossShielded=true,BossWarning=true,
    CampaignGroupStopped=true,CampaignGroupRewound=true,CampaignBombDefused=true}
local actionMessages={NOT_RUNNING="Run first: double-tap a direction",REACTION="Wait until you recover",
    COOLDOWN="Wait before your next action",HELD="You are held · wait for release",
    THROWN="You are thrown · wait until landing"}
local function finite(v) return type(v)=='number' and v==v and v&gt;-math.huge and v&lt;math.huge end
local function integer(v) return finite(v) and v&gt;=0 and v&lt;=1e12 and v%1==0 end
local function identity(v) return type(v)=='string' and #v&gt;0 and #v&lt;=160 end
local function owner(data)
    if finite(data.mine) and type(data.heroes)=='table' then
        for i=1,math.min(#data.heroes,3) do
            local hero=data.heroes[i]
            if type(hero)=='table' and hero.slot==data.mine then return hero.slot,hero.actorId end
        end
    end
    local enemy=data.enemyRole
    if type(enemy)=='table' and finite(enemy.enemyId) then return enemy.enemyId,enemy.actorId end
end

function Feedback.new() return setmetatable({cursor=0},Feedback) end

function Feedback:_actionFeedback(data,group,observedServerNow)
    local _,actor=owner(data)
    if not identity(actor) or (data.view~=nil and data.view~='Playing')
        or (data.status~=nil and data.status~='Active') then
        self.actionScope,self.actionCursor=nil,0;return nil
    end
    local scope=tostring(#group)..':'..group..':'..data.runId..':'..tostring(data.levelEpoch)..':'..actor
    local baseline=self.actionScope~=scope
    if baseline then self.actionScope,self.actionCursor=scope,0 end
    local row=data.actionFeedback
    local envelopeNow=finite(data.serverNow) and data.serverNow or data.now
    if type(row)~='table' or not integer(row.id) or row.id&lt;1 or not actionMessages[row.code]
        or (row.kind~='Attack' and row.kind~='Jump') or row.groupId~=group or row.runId~=data.runId
        or row.actorId~=actor or not finite(row.expiresAt) or not finite(envelopeNow) then return nil end
    local now=finite(observedServerNow) and math.max(observedServerNow,envelopeNow) or envelopeNow
    local remaining=row.expiresAt-now
    if remaining&lt;=0 or row.expiresAt-envelopeNow&gt;1.400001 or row.id&lt;=(self.actionCursor or 0) then return nil end
    self.actionCursor=row.id
    if baseline then return nil end
    return {kind='ActionResult',actionId=row.id,text=actionMessages[row.code],style='shield',
        duration=math.min(1.4,remaining),expiresAt=row.expiresAt}
end

function Feedback:sync(data,observedServerNow)
    if type(data)~='table' or not integer(data.snapshotSeq) or data.snapshotSeq&lt;1
        or (self.snapshotSeq and data.snapshotSeq&lt;=self.snapshotSeq) then return {},false end
    self.snapshotSeq=data.snapshotSeq
    if not identity(data.runId) then self.scope=nil;self.cursor=0;self.actionScope=nil;self.actionCursor=0;return {},true end
    local group=data.groupId or 'combat-stand'
    if not identity(group) then return {},false end
    local action=self:_actionFeedback(data,group,observedServerNow)
    local actionRows=action and {action} or {}
    local feed=data.feedback
    if type(feed)~='table' or not integer(feed.latestSeq) or type(feed.events)~='table'
        or #feed.events&gt;12 or not finite(data.now) then return actionRows,true end
    local scope=tostring(#group)..':'..group..':'..data.runId
    if self.scope~=scope then self.scope=scope;self.cursor=feed.latestSeq;return actionRows,true end
    if feed.latestSeq&lt;=self.cursor then return actionRows,true end
    local serverNow=finite(data.serverNow) and data.serverNow or data.now
    local ownSlot,ownActor=owner(data)
    local pending={}
    for _,event in ipairs(feed.events) do
        if type(event)=='table' and integer(event.seq) and event.seq&gt;self.cursor and event.seq&lt;=feed.latestSeq
            and finite(event.now) and event.now&lt;=serverNow+.5 and serverNow-event.now&lt;=3
            and event.levelEpoch==data.levelEpoch then pending[#pending+1]=event end
    end
    table.sort(pending,function(a,b) return a.seq&lt;b.seq end)
    local result,seen={},{}
    for _,event in ipairs(pending) do
        local relevant=ownSlot==nil or global[event.kind] or event.slot==ownSlot or event.attacker==ownSlot
        if event.slot==ownSlot and event.actorId and ownActor and event.actorId~=ownActor then relevant=false end
        if not seen[event.seq] and relevant then
            seen[event.seq]=true
            local message,style=messages[event.kind],'neutral'
            if event.kind=='Hit' or event.kind=='EnemyHit' then
                if event.blocked then message,style="PROTECTED",'shield'
                elseif event.slot==ownSlot then message,style="DAMAGE TAKEN",'damage'
                else message,style="HIT",'success' end
            elseif event.kind=='CommitSpawn' and finite(event.attempt) and event.attempt&gt;1 then
                message,style="RETURNED",'success'
            elseif event.kind=='RunResult' then
                if event.result=='Won' then message,style="VICTORY",'success'
                elseif event.result=='Lost' then message,style="DEFEAT",'damage' end
            elseif event.kind=='BossWarning' then style='shield' end
            if message then result[#result+1]={seq=event.seq,kind=event.kind,text=message,style=style} end
        end
    end
    self.cursor=feed.latestSeq
    if action then result[#result+1]=action end
    return result,true
end

function Feedback.hint(data,translate)
    local T=translate or function(source) return source end
    data=type(data)=='table' and data or {}
    if data.status=='Faulted' then return "Party stopped · start again" end
    if type(data.enemyRole)=='table' and data.enemyRole.template=='Boss' then
        return data.enemyRole.bossType and 'ATTACK: use your boss moves' or "FIRE: shoot at the heroes"
    end
    if data.enemyRole and data.enemyRole.resourceKind=='CourseRival' then return 'RACE: move and jump · punches can stun you' end
    local interaction=type(data.interaction)=='table' and data.interaction or {}
    if interaction.carrying and type(interaction.label)=='string' then
        return T(interaction.label)..(interaction.available and T(" — action button") or '')
    end
    local controlled=type(data.enemyRole)=='table' and data.enemyRole or nil
    if data.mine and type(data.heroes)=='table' then
        for i=1,math.min(#data.heroes,3) do
            local h=data.heroes[i]
            if type(h)=='table' and h.slot==data.mine then controlled=h;break end
        end
    end
    if controlled and controlled.status=='Alive' and controlled.connected~=false
        and controlled.movementMode=='Run' and (data.view==nil or data.view=='Playing') then
        return "MEGA: running strike"
    end
    if type(data.interaction)=='table' and data.interaction.available and type(data.interaction.label)=='string' then
        return T(data.interaction.label)..T(" — action button")
    end
    if data.mine and data.level and data.level.modeState then
        local hints={Rope='SWING · JUMP: push off · ATTACK: kick',Speeder='STEER · JUMP: clear barriers',
            Surf='STEER · JUMP: clear the water hazards',Jet='UP/DOWN: altitude · LEFT/RIGHT: speed',
            Ice='BRAKE EARLY · run and jump',Serpents='JUMP: ride the moving serpent',
            Ascent='JUMP: use lifts, fans and springs',Tubes='UP/DOWN: swim · JUMP: kick upward',
            Race='REACH THE BOMB · ATTACK: defuse',Clinger='HOLD THE ROUTE DIRECTION',Tower='LEFT/RIGHT: circle · JUMP: climb'}
        local unfinished=true
        for _,actor in ipairs(data.level.modeState.actors or {}) do
            if actor.slot==data.mine then unfinished=not actor.finished;break end
        end
        if unfinished and hints[data.level.mode] then return hints[data.level.mode] end
    end
    if data.mine then return "ATTACK: strike or interact nearby" end
    if data.enemyRole and data.enemyRole.movementKind=='Swim' then return 'LEFT/RIGHT: swim · UP/DOWN: dive or rise' end
    if data.enemyRole and data.enemyRole.movementKind=='Fly' then return 'MOVE: steer · JUMP: flap upward' end
    if data.enemyRole and data.enemyRole.movementKind=='Ride' then return 'SCRIPTED FLIGHT · ATTACK: drop one obstacle' end
    if data.enemyRole then return "ATTACK: stop the heroes" end
    return "Choose a role or watch"
end

function Feedback.aliveHeroes(heroes)
    local count=0
    for _,hero in ipairs(heroes or {}) do
        if hero.status=='Alive' and not hero.dying then count+=1 end
    end
    return count
end

function Feedback.remainingEnemies(level)
    local count=0
    for _,actor in ipairs(level.enemies or {}) do
        local current=actor.zoneIndex==nil or level.zoneIndex==nil or actor.zoneIndex==level.zoneIndex
        local ordinary=actor.boss~=true and actor.template~='Boss' and actor.id~=-99 and actor.enemyId~=-99
            and actor.courseRival~=true and actor.resourceKind~='CourseRival'
        if current and ordinary and actor.dragonMode~='Mounted' and actor.dead~=true and actor.alive~=false
            and actor.status~='Dead' and actor.status~='Eliminated' then count+=1 end
    end
    return count
end

return Feedback
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT79">
          <Properties>
            <string name="Name">GameAudio</string>
            <ProtectedString name="Source">-- Confirmed client presentation only. No remotes, gameplay writes or world physics.
local Audio={}
Audio.__index=Audio
local function finite(v) return type(v)=='number' and v==v and v&gt;-math.huge and v&lt;math.huge end
local function integer(v) return finite(v) and v&gt;=0 and v&lt;=1e12 and v%1==0 end
local function identity(v) return type(v)=='string' and #v&gt;0 and #v&lt;=160 end
local function asset(v) return type(v)=='string' and v:match('^rbxassetid://[1-9]%d*$')~=nil end
local function call(v,method,...) if v and type(v[method])=='function' then return pcall(v[method],v,...) end;return false end
local function region(row) return type(row)=='table' and finite(row.start) and finite(row.finish) and row.start&gt;=0 and row.finish&gt;row.start and row.finish&lt;420 end
local function owner(data)
    if finite(data.mine) and type(data.heroes)=='table' then
        for i=1,math.min(#data.heroes,3) do local h=data.heroes[i];if type(h)=='table' and h.slot==data.mine then return h.slot,h.actorId,h.attempt end end
    end
    local e=data.enemyRole;if type(e)=='table' and finite(e.enemyId) then return e.enemyId,e.actorId,e.attempt end
end
local function defaultCatalog()
    if script then return require(game:GetService('ReplicatedStorage'):WaitForChild('BrickToads'):WaitForChild('AudioCatalog')) end
    return require('../shared/AudioCatalog')
end
local function defaultEffects(deps)
    local Effects=if script then require(script.Parent:WaitForChild('CombatEffects')) else require('./CombatEffects')
    return Effects.new(deps)
end
local function nativeFactory(deps)
    local soundService=deps.soundService or game:GetService('SoundService')
    local folder=Instance.new('Folder');folder.Name='BrickToadsLocalAudio';folder.Parent=soundService
    local function create(kind,index,assetId)
        local sound=Instance.new('Sound');sound.Name=kind=='music' and 'Music' or 'SFX_'..index
        sound.SoundId=assetId;sound.Volume=0;sound.PlaybackRegionsEnabled=true;sound.Parent=folder
        return {sound=sound,
            isLoaded=function() return sound.IsLoaded and sound.TimeLength&gt;0 end,
            play=function(_,row,looped,volume)
                if not sound.IsLoaded or sound.TimeLength&lt;row.finish-.02 then return false end
                sound:Stop();sound.PlaybackRegion=NumberRange.new(row.start,row.finish)
                sound.LoopRegion=NumberRange.new(row.start,row.finish);sound.Looped=looped
                sound.Volume=volume;sound.TimePosition=row.start;sound:Play();return true
            end,
            stop=function() sound:Stop() end,
            destroy=function() sound:Destroy() end}
    end
    return create,function() folder:Destroy() end
end
-- ClubSwingHit and DragonFireHit are journal supplements to an existing Hit /
-- EnemyHit; the base impact carries action/target and owns its one audiovisual cue.
local cues={Hit='Hit',EnemyHit='Hit',AttackMiss='Miss',EnemyAttackMiss='Miss',
    EnemyThrown='Throw',GuardianBallThrown='Throw',FlyCaught='Fly',StolenLifeRecovered='Fly',CommitSpawn='Spawn',
    CampaignGroupRewound='Spawn',BossWarning='BossWarning',BossHit='BossHit',BossShielded='Shield',
    CampaignGroupStopped='Crash',CampaignBombDefused='Bomb',EnemyDeath='EnemyDeath',
    ClubEquipped='Equip',RavenClawPickedUp='Equip',GuardianBallPickedUp='Equip',DragonMounted='Equip',
    LifeStolen='Death'}
local fx={Hit='hit',Shield='shield',Club='hit',Fly='heal',Spawn='spawn',BossWarning='warning',BossHit='hit',
    Crash='crash',Bomb='result',Victory='result',Defeat='death',Death='death',EnemyDeath='death'}

function Audio.new(deps,catalog)
    deps=deps or {};catalog=catalog or defaultCatalog()
    local self=setmetatable({catalog=catalog,voices={},nextVoice=1,cursor=nil,heroStates={},muted=false,musicMuted=false,
        effects=deps.effects or defaultEffects(deps),createVoice=deps.createVoice},Audio)
    if not self.createVoice and (asset((catalog.assets or {}).sfx) or asset((catalog.assets or {}).music)) then
        self.createVoice,self.cleanup=nativeFactory(deps)
    end
    if self.createVoice then
        local ids=catalog.assets or {}
        if asset(ids.sfx) then for i=1,8 do local ok,v=pcall(self.createVoice,'sfx',i,ids.sfx);if ok and v then self.voices[#self.voices+1]=v end end end
        if asset(ids.music) then local ok,v=pcall(self.createVoice,'music',1,ids.music);if ok then self.music=v end end
    end
    -- Preloading never schedules playback: an impact missed while loading stays missed.
    if not deps.createVoice and (#self.voices&gt;0 or self.music) then
        local preload={}
        if self.voices[1] and self.voices[1].sound then preload[#preload+1]=self.voices[1].sound end
        if self.music and self.music.sound then preload[#preload+1]=self.music.sound end
        local provider=deps.contentProvider or game:GetService('ContentProvider')
        task.spawn(function() pcall(function() provider:PreloadAsync(preload) end) end)
    end
    return self
end
function Audio:_stop()
    for _,v in ipairs(self.voices) do call(v,'stop') end;call(self.music,'stop');self.musicKey=nil
end
function Audio:_reset(scope)
    self:_stop();call(self.effects,'reset');self.scope=scope;self.cursor=nil;self.heroStates={};self.bossState=nil;self.nextVoice=1
    if scope==nil then self.contextScope=nil;self.ownerSlot=nil;self.ownerActor=nil end
end
function Audio:_cue(key,event,data)
    if self.destroyed then return end
    local row=(self.catalog.cues or {})[key]
    if not self.muted and region(row) and #self.voices&gt;0 then
        local voice=self.voices[self.nextVoice];self.nextVoice=self.nextVoice%#self.voices+1
        call(voice,'play',row,false,math.clamp(row.volume or .36,0,.7),key)
    end
    if fx[key] then call(self.effects,'emit',fx[key],event or {},data) end
end
function Audio:_music(data)
    local key
    local level=type(data.level)=='table' and data.level or {}
    local boss=type(level.boss)=='table' and level.boss or {}
    if data.status=='Won' or data.status=='Lost' then key='Result'
    elseif data.status=='Lobby' then key='Lobby'
    elseif data.status=='Active' and data.view~='Menu' then
        key=(level.stage=='Boss' or level.stage=='Chase' or level.stage=='BossReady'
            or level.bossType and boss.bossDefeated~=true) and 'Boss' or 'Level'
        local index=level.campaignIndex
        if integer(index) and index&gt;=1 and index&lt;=13 then
            -- Magnetic Circuit's chase is its course. The Buzzball duel follows it.
            local battle=level.stage=='Boss' or level.stage=='BossIntro'
                or level.stage=='BossReady' and level.mode~='Clinger'
            local cue=(battle and 'Boss' or 'Level')..tostring(index)
            if self.catalog.music and self.catalog.music[cue] then key=cue end
        end
    end
    if self.muted or self.musicMuted then key=nil end
    if key~=self.musicKey then
        call(self.music,'stop');self.musicKey=nil
        local row=key and (self.catalog.music or {})[key]
        if region(row) then local ok,played=call(self.music,'play',row,true,math.clamp(row.volume or .22,0,.5),key);if ok and played then self.musicKey=key end end
    end
end
function Audio:_transitions(data,baseline,played)
    local nextHeroes={}
    for i=1,math.min(type(data.heroes)=='table' and #data.heroes or 0,3) do
        local hero=data.heroes[i]
        if type(hero)=='table' and finite(hero.slot) then
            local prev=self.heroStates[hero.slot]
            local dead=hero.dying==true or hero.status=='AwaitingRespawn' or hero.status=='Eliminated'
            local same=prev and (hero.actorId==nil or hero.actorId==prev.actorId) and hero.attempt==prev.attempt
            if not baseline and same and dead and not prev.dead then
                self:_cue('Death',{slot=hero.slot,actorId=hero.actorId or prev.actorId},data)
            end
            nextHeroes[hero.slot]={actorId=hero.actorId or prev and prev.actorId,attempt=hero.attempt,dead=dead}
        end
    end
    self.heroStates=nextHeroes
    local boss=type(data.level)=='table' and type(data.level.boss)=='table' and data.level.boss or nil
    if boss then
        local prev=self.bossState
        if not baseline and prev then
            if boss.bossState=='Tell' and (prev.state~='Tell' or prev.attack~=boss.bossAttack) and not played.BossWarning then
                self:_cue('BossWarning',{slot=-99},data)
            end
            if (finite(boss.rawLife) and finite(prev.life) and boss.rawLife&lt;prev.life
                or finite(boss.progress) and finite(prev.progress) and boss.progress&gt;prev.progress) and not played.BossHit then
                self:_cue('BossHit',{slot=-99},data)
            end
        end
        self.bossState={state=boss.bossState,attack=boss.bossAttack,life=boss.rawLife,progress=boss.progress}
    else self.bossState=nil end
end
function Audio:sync(data,_confirmed)
    if self.destroyed or type(data)~='table' or not integer(data.snapshotSeq) or data.snapshotSeq&lt;1
        or self.snapshotSeq and data.snapshotSeq&lt;=self.snapshotSeq then return false end
    self.snapshotSeq=data.snapshotSeq
    if not identity(data.groupId) or not finite(data.now) or data.status=='Faulted' then self:_reset(nil);return false end
    local slot,actor,attempt=owner(data)
    local run=identity(data.runId) and data.runId or data.status=='Lobby' and 'lobby' or nil
    if not run or run~='lobby' and not integer(data.levelEpoch) then self:_reset(nil);return false end
    local context=tostring(#data.groupId)..':'..data.groupId..':'..run..':'..tostring(data.levelEpoch)
    local replacedOwner=self.contextScope==context and self.ownerSlot==slot and identity(actor)
        and identity(self.ownerActor) and actor~=self.ownerActor
    local previousCursor=self.cursor
    local ownerKey=slot and tostring(slot)..':'..(identity(actor) and actor or self.ownerSlot==slot and self.ownerActor or 'pending') or 'spectator'
    self.ownerSlot,self.ownerActor=slot,identity(actor) and actor or self.ownerSlot==slot and self.ownerActor or nil
    local scope=context..':'..ownerKey
    local baseline=self.scope~=scope
    if baseline then self:_reset(scope) end
    self.contextScope=context
    call(self.effects,'sync',data)
    self:_music(data)
    local feed=data.feedback
    local validFeed=type(feed)=='table' and integer(feed.latestSeq) and type(feed.events)=='table' and #feed.events&lt;=12
    baseline=baseline or self.cursor==nil
    local played={}
    local active=(data.status=='Active' and data.view~='Menu') or data.status=='Won' or data.status=='Lost'
    if validFeed then
        local minimum=if baseline then (replacedOwner and previousCursor or nil) else self.cursor
        if minimum and active and feed.latestSeq&gt;minimum then
            local now=finite(data.serverNow) and math.max(data.now,data.serverNow) or data.now
            local pending,seen={},{}
            for _,e in ipairs(feed.events) do
                if type(e)=='table' and integer(e.seq) and e.seq&gt;minimum and e.seq&lt;=feed.latestSeq
                    and finite(e.now) and e.now&lt;=now+.5 and now-e.now&lt;=3 and e.levelEpoch==data.levelEpoch then pending[#pending+1]=e end
            end
            table.sort(pending,function(a,b) return a.seq&lt;b.seq end)
            for _,e in ipairs(pending) do
                local relevant=true
                -- A new owner body still discards history. Only its new confirmed
                -- respawn, beyond the old cursor in this same context, may cross.
                if baseline then
                    relevant=e.kind=='CommitSpawn' and e.slot==slot and e.actorId==actor
                        and integer(e.attempt) and e.attempt&gt;1 and e.attempt==attempt
                end
                if e.actorId then
                    for i=1,math.min(type(data.heroes)=='table' and #data.heroes or 0,3) do local h=data.heroes[i]
                        if h.slot==e.slot and identity(h.actorId) and h.actorId~=e.actorId then relevant=false end
                    end
                end
                if relevant and not seen[e.seq] then
                    seen[e.seq]=true
                    local key=cues[e.kind]
                    if e.kind=='Hit' or e.kind=='EnemyHit' then
                        key=e.blocked and 'Shield' or e.action=='Club' and 'Club' or 'Hit'
                    elseif e.kind=='RunResult' then key=e.result=='Won' and 'Victory' or e.result=='Lost' and 'Defeat' or nil end
                    if key then self:_cue(key,e,data);played[key]=true end
                end
            end
        end
        self.cursor=math.max(self.cursor or 0,feed.latestSeq)
    end
    self:_transitions(data,baseline or not active,played)
    return true
end
function Audio:setMuted(value) self.muted=value==true;if self.muted then self:_stop() end end
function Audio:setMusicMuted(value) self.musicMuted=value==true;if self.musicMuted then call(self.music,'stop');self.musicKey=nil end end
function Audio:setEffectsEnabled(value) call(self.effects,'setEnabled',value) end
function Audio:setReducedFlash(value) call(self.effects,'setReducedFlash',value) end
function Audio:diagnostics()
    local loaded=#self.voices==8 and self.music~=nil
    for _,v in ipairs(self.voices) do local ok,ready=call(v,'isLoaded');loaded=loaded and ok and ready==true end
    local ok,ready=call(self.music,'isLoaded');loaded=loaded and ok and ready==true
    return {ready=loaded and not self.destroyed,configured=asset((self.catalog.assets or {}).sfx) and asset((self.catalog.assets or {}).music),
        sfxVoices=#self.voices,sfxLimit=8,music=self.musicKey,scope=self.scope,cursor=self.cursor,destroyed=self.destroyed==true}
end
function Audio:destroy()
    if self.destroyed then return end
    self:_stop();for _,v in ipairs(self.voices) do call(v,'destroy') end;call(self.music,'destroy');call(self.effects,'destroy')
    if self.cleanup then pcall(self.cleanup) end;self.destroyed=true
end
return Audio
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT80">
          <Properties>
            <string name="Name">GroupPanel</string>
            <ProtectedString name="Source">-- Group selection changes the observed world; membership and role eligibility stay server-owned.
local GroupPanel = {}
GroupPanel.__index = GroupPanel
local function sourceText(source,args)
    return (source:gsub('{([%w_]+):?[%w_]*}',function(key) return tostring(args and args[key] or '') end))
end

local statusNames = {Lobby = "Forming team", Active = "Playing", Won = "Victory", Lost = "Game over", Faulted = "Party stopped"}
local reasons = {
    ROLE_ACTIVE = "Finish playing your living character first.",
    ACTIVE_ROLE = "Finish playing your living character first.",
    ROLE_RESERVED = "Cancel your accepted boss invitation first.",
    GROUP_FULL = "This team has no free places.",
    GROUP_LIMIT = "The team limit has been reached.",
    UNKNOWN_GROUP = "This team is no longer available.",
    STALE_GROUP = "The selected team changed. Refreshing the list.",
    WRONG_GROUP = "The selected team changed. Refreshing the list.",
    HERO_LOCKED = "You cannot select another enemy role in this team.",
}

local function make(className, name, parent, properties)
    local item = Instance.new(className)
    item.Name = name
    for key, value in pairs(properties or {}) do item[key] = value end
    item.Parent = parent
    return item
end

local function position(item, x, y, width, height)
    item.Position, item.Size = UDim2.fromOffset(x, y), UDim2.fromOffset(width, height)
end

function GroupPanel.new(menuParent, spectatorParent, safeParent, sendIntent, colors, onToggle, translate, groupName)
    local self = setmetatable({sendIntent = sendIntent, colors = colors, onToggle = onToggle, rows = {},
        translate=translate,groupName=groupName}, GroupPanel)
    local function round(item, radius)
        make("UICorner", "Corner", item, {CornerRadius = UDim.new(0, radius or 12)})
        return item
    end
    local function text(parent, name, size, color, bold)
        return make("TextLabel", name, parent, {
            BackgroundTransparency = 1, Text = "", TextColor3 = color, TextSize = size,
            Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
            TextWrapped = true, ZIndex = 73,
        })
    end
    local function button(parent, name, title, callback, zIndex)
        local item = round(make("TextButton", name, parent, {
            BackgroundColor3 = colors.card, BorderSizePixel = 0, Text = title,
            TextColor3 = colors.text, Font = Enum.Font.GothamBold, TextSize = 14,
            TextWrapped = true, AutoButtonColor = false, ZIndex = zIndex or 73,
        }))
        item.Activated:Connect(callback)
        return item
    end
    self.menuCard = round(make("Frame", "Groups", menuParent, {
        BackgroundColor3 = colors.panel, BorderSizePixel = 0, LayoutOrder = 8, Visible = false,
    }))
    self.menuHeading = text(self.menuCard, "GroupHeading", 12, colors.lime, true)
    self.menuHeading.Text = "YOUR TEAM"
    self.menuCurrent = text(self.menuCard, "CurrentGroup", 18, colors.text, true)
    self.menuHelp = text(self.menuCard, "GroupHelp", 13, colors.muted, false)
    self.menuHelp.Text = "Other teams keep playing their games. You enter an active game as a spectator."
    self.menuButton = button(self.menuCard, "ChooseGroup", "Choose team", function() self:_setOpen(true) end, 1)
    self.hudButton = button(spectatorParent, "GroupsButton", "Groups", function() self:_setOpen(true) end, 2)
    self.hudButton.Visible = false

    self.overlay = make("Frame", "GroupSelector", safeParent, {
        BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Active = true, ZIndex = 70,
    })
    self.backdrop = button(self.overlay, "GroupBackdrop", "", function() self:_setOpen(false) end, 70)
    self.backdrop.Size = UDim2.fromScale(1, 1)
    self.backdrop.BackgroundColor3, self.backdrop.BackgroundTransparency = colors.ink, 0.08
    self.backdrop.Modal = true
    self.shell = round(make("Frame", "GroupSelectorCard", self.overlay, {
        BackgroundColor3 = colors.panel, BorderSizePixel = 0, Active = true, ZIndex = 71,
    }), 16)
    self.title = text(self.shell, "GroupSelectorTitle", 21, colors.text, true)
    self.title.Text = "GROUPS"
    self.current = text(self.shell, "GroupSelectorCurrent", 14, colors.lime, true)
    self.close = button(self.shell, "CloseGroups", "Close", function() self:_setOpen(false) end)
    self.help = text(self.shell, "GroupSelectorHelp", 13, colors.muted, false)
    self.help.Text = "Join an active game as a spectator. Its heroes are already locked in."
    self.list = make("ScrollingFrame", "GroupList", self.shell, {
        BackgroundTransparency = 1, BorderSizePixel = 0, CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 4,
        ScrollBarImageColor3 = colors.muted, ScrollingDirection = Enum.ScrollingDirection.Y, ZIndex = 72,
    })
    make("UIListLayout", "GroupListLayout", self.list, {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8)})
    make("UIPadding", "GroupListPadding", self.list, {PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 4)})
    self.empty = text(self.list, "NoOtherGroups", 14, colors.muted, false)
    self.empty.Text, self.empty.Size = "No other teams yet. Create your own.", UDim2.new(1, 0, 0, 64)
    self.create = button(self.shell, "CreateGroup", "Create team", function() self:_create() end)
    self.notice = text(self.shell, "GroupSelectorNotice", 12, colors.yellow, false)
    return self
end

function GroupPanel:isOpen()
    return self.overlay.Visible
end

function GroupPanel:_setOpen(open)
    if open and (not self.data or (not self.menuCard.Visible and not self.hudButton.Visible)) then return end
    self.overlay.Visible = open
    if self.onToggle then self.onToggle() end
end

function GroupPanel:_join(targetId)
    if not self.overlay.Visible or self.pending or not self.data then return end
    for _, group in ipairs(self.data.groups or {}) do
        if group.id == targetId and group.id ~= self.data.groupId and group.canJoin == true then
            self.pending, self.pendingAt = targetId, os.clock()
            self.sendIntent({kind = "JoinGroup", targetGroupId = targetId})
            self:_draw()
            return
        end
    end
end

function GroupPanel:_create()
    if not self.overlay.Visible or self.pending or not self.data or self.data.canCreateGroup ~= true then return end
    self.createRequestId = self.createRequestId or game:GetService("HttpService"):GenerateGUID(false)
    self.pending, self.pendingAt = "Create", os.clock()
    self.sendIntent({kind = "CreateGroup", requestId = self.createRequestId})
    self:_draw()
end

function GroupPanel:_draw()
    local data, seen, count = self.data, {}, 0
    if not data then return end
    local T=self.translate or sourceText
    local groupName=self.groupName or function(name) return T(name or 'Team') end
    local transfer = type(data.serverTransfer) == "table" and data.serverTransfer.state
    local serverPending, transferFailed = transfer == "Pending", transfer == "Failed"
    local currentName = groupName(data.groupName or "Current team",data.groupId)
    self.menuCurrent.Text, self.current.Text = currentName, T("Current: {team}", {team=currentName})
    self.menuButton.Text = self.pending and "Joining…" or "Choose team"
    for _, group in ipairs(data.groups or {}) do
        if group.id ~= data.groupId then
            count += 1
            seen[group.id] = true
            local row = self.rows[group.id]
            if not row then
                local targetId = group.id
                row = make("TextButton", "JoinGroup_" .. targetId, self.list, {
                    BackgroundColor3 = self.colors.card, BorderSizePixel = 0,
                    Text = "", TextColor3 = self.colors.text, Font = Enum.Font.Gotham,
                    TextSize = 14, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
                    AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 82), ZIndex = 73,
                })
                make("UICorner", "Corner", row, {CornerRadius = UDim.new(0, 10)})
                make("UIPadding", "TextPadding", row, {PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12)})
                row.Activated:Connect(function() self:_join(targetId) end)
                self.rows[targetId] = row
            end
            local enabled = group.canJoin == true and not self.pending
            local action = group.status == "Active" and "Watch" or "Join team"
            if group.canJoin ~= true then action = reasons[group.reason] or "You cannot switch right now." end
            if self.pending == group.id then action = "Joining…" end
            row.Text = T("{team} · {status}\nHeroes: {heroes:int} · players: {players:int}\n{action}", {
                team=groupName(group.name or "Team",group.id),status=T(statusNames[group.status] or "Waiting"),
                heroes=group.heroes or 0,players=group.players or 0,action=T(action)})
            row.LayoutOrder, row.Active, row.Selectable = count, enabled, enabled
            row.TextColor3 = group.canJoin == true and self.colors.text or self.colors.muted
        end
    end
    for id, row in pairs(self.rows) do if not seen[id] then row:Destroy(); self.rows[id] = nil end end
    self.empty.Visible = count == 0
    self.create.Active = data.canCreateGroup == true and not self.pending
    self.create.Selectable = self.create.Active
    self.create.BackgroundColor3 = self.create.Active and self.colors.lime or self.colors.card
    self.create.TextColor3 = self.create.Active and self.colors.ink or self.colors.muted
    self.create.Text = serverPending and "Joining…" or (self.pending == "Create" and "Creating…"
        or (transferFailed and "Try again" or "Create team"))
    self.notice.Text = serverPending and "Moving to a new server…"
        or (self.pending and "Waiting for transfer confirmation…")
        or (transferFailed and "Could not move. Try again.")
        or (reasons[data.notice] or (data.canCreateGroup == false and "Team creation is currently unavailable." or ""))
end

function GroupPanel:update(data, hero)
    local changed = self.data and data and self.data.groupId ~= data.groupId
    local transfer = data and type(data.serverTransfer) == "table" and data.serverTransfer.state
    if changed then
        self.pending, self.createRequestId = nil, nil
        self.overlay.Visible = false
        self.list.CanvasPosition = Vector2.zero
    elseif transfer == "Pending" then
        self.pending = "Server"
    elseif transfer == "Failed" then
        self.pending, self.createRequestId = nil, nil
    elseif self.pending == "Server" then
        self.pending = nil
    elseif self.pending and data and data.notice then
        self.pending = nil
    end
    self.data = data
    local available = data ~= nil and type(data.groups) == "table"
    local active = data and data.status == "Active"
    local personalMenu = active and data.view == "Menu"
    local livingHero = hero and hero.status ~= "Eliminated"
    local livingEnemy = data and data.enemyRole and data.enemyRole.status ~= "Dead"
    self.menuCard.Visible = available and (not active or personalMenu == true)
    self.hudButton.Visible = available and active == true and not personalMenu and not livingHero and not livingEnemy
    if not self.menuCard.Visible and not self.hudButton.Visible then self.overlay.Visible = false end
    self:_draw()
end

function GroupPanel:step()
    if self.pending and self.pending ~= "Server" and os.clock() - self.pendingAt &gt; 4 then
        self.pending = nil
        self.sendIntent({kind = "Sync"})
        self:_draw()
    end
end

function GroupPanel:layout(menuWidth, width, height, spectatorWidth)
    self.menuCard.Size = UDim2.new(1, 0, 0, menuWidth &lt; 420 and 170 or 152)
    position(self.menuHeading, 14, 10, menuWidth - 28, 18)
    position(self.menuCurrent, 14, 32, menuWidth - 28, 24)
    position(self.menuHelp, 14, 60, menuWidth - 28, menuWidth &lt; 420 and 49 or 31)
    position(self.menuButton, 14, menuWidth &lt; 420 and 116 or 98, menuWidth - 28, 44)
    position(self.hudButton, spectatorWidth - 114, 5, 100, 44)
    local margin = width &lt; 500 and 12 or 18
    local shellWidth, shellHeight = math.min(640, width - margin * 2), math.min(590, height - margin * 2)
    position(self.shell, (width - shellWidth) / 2, (height - shellHeight) / 2, shellWidth, shellHeight)
    local shallow = shellHeight &lt; 380
    position(self.title, 14, 10, shellWidth - 126, 28)
    position(self.close, shellWidth - 104, 10, 90, 44)
    position(self.current, 14, 42, shellWidth - 126, shallow and 23 or 27)
    position(self.help, 14, shallow and 68 or 77, shellWidth - 28, shallow and 30 or 42)
    local listY = shallow and 104 or 128
    position(self.list, 14, listY, shellWidth - 28, math.max(42, shellHeight - listY - 83))
    position(self.create, 14, shellHeight - 76, shellWidth - 28, 44)
    position(self.notice, 14, shellHeight - 29, shellWidth - 28, 23)
end

return GroupPanel
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT81">
          <Properties>
            <string name="Name">HeroAssetVisibility</string>
            <ProtectedString name="Source">-- One coordinator composes physical fallback, canonical base and active morph.
-- Only local modifiers change here. Assemblies/poses remain server-owned.
local Gate={}
Gate.__index=Gate
local TAG='BrickToadsHeroSkin'
local MAPS={'ColorMap','NormalMap','RoughnessMap','MetalnessMap','EmissiveMask'}
local RETRY_DELAYS={1,3,10}
local function alpha(v)return type(v)=='number'and v==v and v&gt;=0 and v&lt;=1 end
local function identity(v)return type(v)=='string'and #v&gt;0 and #v&lt;=512 end
local function rawId(value)return type(value)=='string'and value or''end
local function mapUri(surface,property)
    -- *Content getters are script-readable; legacy map strings and their
    -- signals require PluginSecurity. Only published URI or None is valid.
    local ok,id=pcall(function()
        local content=surface[property..'Content'];local source=content.SourceType.Name
        if source=='None'then return '' end
        if source=='Uri'then
            local uri=content.Uri;if type(uri)=='string'and uri~=''then return uri end
        end
    end)
    return ok and id or nil
end
local function key(id)
    if type(id)~='string'or id==''then return nil end
    return id:match('^rbxassetid://(%d+)')or id:match('[?&amp;]id=(%d+)')or id
end
local function disconnect(list)
    for _,c in ipairs(list)do c:Disconnect()end;table.clear(list)
end
local function connect(list,event,fn)if event then list[#list+1]=event:Connect(fn)end end
local function watchProperty(list,instance,property,refresh)
    return pcall(function()connect(list,assert(instance:GetPropertyChangedSignal(property)),refresh)end)
end
local visibility = if script then require(script.Parent:WaitForChild("CameraVisibility")) else require("./CameraVisibility")
local function localAlpha(part,value)
    pcall(visibility.set,part,value)
end
function Gate:_valid(row)
    return not self.destroyed and self.rows[row.skin]==row and row.skin.Parent==row.owner
