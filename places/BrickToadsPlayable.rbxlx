      <Item class="Script" referent="BT7">
        <Properties>
          <string name="Name">BrickToadsServer</string>
          <ProtectedString name="Source">-- Main playable BrickToads runtime. The client supplies intent, never hit results.
local Players=game:GetService('Players')
local ReplicatedStorage=game:GetService('ReplicatedStorage')
local RunService=game:GetService('RunService')
local HttpService=game:GetService('HttpService')
Players.CharacterAutoLoads=false
local runtime=script.Parent:WaitForChild('CombatRuntime')
local gameplay=script.Parent:WaitForChild('gameplay')
local config=require(gameplay.GameConfig)(require(runtime.Config))
local world=require(gameplay.GameWorld).new(require(runtime.RobloxWorld),config)
local controller=require(gameplay.GameController).new({Core=require(script.Parent.RunLifecycle),
    Combat=require(runtime.Combat),Session=require(runtime.Session),Registry=require(runtime.ConnectionRegistry),
    Config=config,Director=require(gameplay.LevelDirector),clock=function() return workspace:GetServerTimeNow() end,
    guid=function() return HttpService:GenerateGUID(false) end},world)
local remotes=Instance.new('Folder'); remotes.Name='BrickToadsGame'; remotes.Parent=ReplicatedStorage
local intent=Instance.new('RemoteEvent'); intent.Name='Intent'; intent.Parent=remotes
local state=Instance.new('RemoteEvent'); state.Name='State'; state.Parent=remotes
local fault,lastBroadcast=nil,0
local function replicationFocus(player)
    local slot=controller:controlledSlot(player.UserId)
    local actor=slot and world.actors[slot]
    if not actor or not actor.root.Parent then
        actor=nil
        for id,candidate in pairs(world.actors) do
            if id&gt;0 and candidate.root.Parent and candidate.humanoid.Health&gt;0 then actor=candidate; break end
        end
    end
    local focus=actor and actor.root or world.floors[1]
    if player.ReplicationFocus~=focus then player.ReplicationFocus=focus end
end
local function broadcast(requester)
    local players=Players:GetPlayers()
    for _,player in ipairs(requester and {requester} or players) do
        if player.Parent==Players then
            local snapshot=controller:snapshot(player,players)
            if snapshot then snapshot.fault=fault; state:FireClient(player,snapshot) end
        end
    end
end
local function joined(player)
    if player.Parent~=Players then return end
    if player.Character then player.Character:Destroy(); player.Character=nil end
    controller:join(player); replicationFocus(player); broadcast(player)
end
Players.PlayerAdded:Connect(joined)
Players.PlayerRemoving:Connect(function(player) controller:leave(player) end)
for _,player in ipairs(Players:GetPlayers()) do joined(player) end
intent.OnServerEvent:Connect(function(player,payload)
    if player.Parent~=Players or fault then return end
    local ok,code=xpcall(function() return controller:handle(player,payload,Players:GetPlayers()) end,debug.traceback)
    if not ok then fault=tostring(code); warn('[BrickToads] '..fault); return end
    if type(payload)=='table' and (payload.kind=='Sync' or payload.kind=='Start' or payload.kind=='SelectHero'
        or payload.kind=='SelectRole' or payload.kind=='ClaimEnemy' or payload.kind=='ChooseView') then
        if code~='RATE_LIMIT' and code~='STALE_CONNECTION' then broadcast(player) end
    end
end)
RunService.Heartbeat:Connect(function(dt)
    local at=workspace:GetServerTimeNow()
    if not fault then
        local ok,err=xpcall(function()
            controller:step(at,dt)
            if controller.current then world:updatePresentation(controller.current,dt,controller.director.enemies) end
        end,debug.traceback)
        if not ok then fault=tostring(err); warn('[BrickToads] '..fault) end
    end
    for _,player in ipairs(Players:GetPlayers()) do replicationFocus(player) end
    if at-lastBroadcast&gt;=config.SnapshotInterval then lastBroadcast=at; broadcast() end
end)
print('[BrickToads] playable causeway ready')
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="BT8">
        <Properties>
          <string name="Name">RunLifecycle</string>
          <ProtectedString name="Source">-- Server-only lifecycle core. No Roblox instances, remotes, physics or damage coefficients.
-- Events represent decisions already authenticated by the server adapter.
local Core = {}
local MAX_HEALTH = 5
local INITIAL_RESPAWNS = 3
local NORMAL_SHIELD_SECONDS = 2
local EMERGENCY_SHIELD_SECONDS = 10
local TEMPLATES = { ["Mr. Green"] = true, ["Mr. Yellow"] = true, ["Mr. Brown"] = true }
local BASE_FIELDS = { id=true, runId=true, expectedRevision=true, kind=true, now=true }
local FIELDS = {
    ReserveSpawn = {userId=true,connectionEpoch=true},
    CommitSpawn = {userId=true,token=true,actorId=true,safe=true},
    AbortSpawn = {userId=true,token=true},
    Death = {userId=true,actorId=true,attempt=true,levelEpoch=true},
    SetHealth = {userId=true,actorId=true,attempt=true,levelEpoch=true,health=true},
    BeginAttack = {userId=true,actorId=true,attempt=true,levelEpoch=true,connectionEpoch=true},
    Connection = {userId=true,connectionEpoch=true,connected=true},
    ExpireShield = {userId=true,actorId=true,attempt=true,levelEpoch=true},
    RelocateToSafety = {userId=true,actorId=true,attempt=true,levelEpoch=true,safe=true},
    AdvanceLevel = {userId=true,actorId=true,attempt=true,levelEpoch=true,levelId=true,destinationSafe=true,prerequisitesMet=true},
    ChooseView = {userId=true,view=true,connectionEpoch=true},
}

local function finite(value)
    return type(value) == "number" and value == value and value &gt; -math.huge and value &lt; math.huge
end
local function integer(value, minimum)
    return finite(value) and value &gt;= minimum and value &lt;= 9007199254740991 and value % 1 == 0
end
local function identifier(value)
    return type(value) == "string" and #value &gt; 0 and #value &lt;= 160
end
local function copy(value)
    if type(value) ~= "table" then return value end
    local result = {}
    for key, item in pairs(value) do result[key] = copy(item) end
    return result
end

-- Length prefixes make strings containing separators unambiguous in replay fingerprints.
local function fingerprint(event)
    local keys = {}
    for key in pairs(event) do keys[#keys+1] = key end
    table.sort(keys)
    local pieces = {}
    for _, key in ipairs(keys) do
        local value = event[key]
        local encoded
        if type(value) == "string" then encoded = "s" .. #value .. ":" .. value
        elseif type(value) == "number" then encoded = "n" .. string.format("%.17g", value) .. ";"
        else encoded = value and "b1" or "b0" end
        pieces[#pieces+1] = #key .. ":" .. key .. encoded
    end
    return table.concat(pieces)
end

function Core.new(runId, groupId, roster, levelId)
    assert(identifier(runId) and identifier(groupId) and identifier(levelId), "Invalid run/group/level identifier")
    assert(type(roster) == "table" and #roster &gt;= 1 and #roster &lt;= 3, "Roster must contain 1–3 heroes")
    local count = 0
    for key in pairs(roster) do
        assert(integer(key, 1) and key &lt;= #roster, "Roster must be a contiguous array")
        count = count + 1
    end
    assert(count == #roster, "Roster must be a contiguous array")
    local state = {
        runId=runId, groupId=groupId, levelId=levelId, levelEpoch=1,
        revision=0, time=0, status="Active", partyDissolved=false,
        heroes={}, receipts={}, seenActors={},
    }
    for _, member in ipairs(roster) do
        assert(type(member) == "table" and integer(member.userId, 1), "Invalid hero userId")
        assert(TEMPLATES[member.template] == true, "Unknown hero template")
        assert(state.heroes[member.userId] == nil, "Duplicate hero owner")
        state.heroes[member.userId] = {
            userId=member.userId, template=member.template, connected=true, connectionEpoch=1,
            status="AwaitingInitial", health=MAX_HEALTH, respawns=INITIAL_RESPAWNS,
            attempt=0, retryReady=false, view="Playing",
        }
    end
    return state
end

local function validateEvent(event)
    if type(event) ~= "table" or not identifier(event.id) or not identifier(event.runId)
        or not identifier(event.kind) or not integer(event.expectedRevision, 0)
        or not finite(event.now) or event.now &lt; 0 then return "INVALID_EVENT" end
    local allowed = FIELDS[event.kind]
    if not allowed then return "UNKNOWN_EVENT" end
    for key, value in pairs(event) do
        if type(key) ~= "string" or (not BASE_FIELDS[key] and not allowed[key]) then return "UNKNOWN_FIELD" end
        local kind = type(value)
        if kind ~= "string" and kind ~= "number" and kind ~= "boolean" then return "INVALID_EVENT" end
        if kind == "number" and not finite(value) then return "INVALID_EVENT" end
    end
    if not integer(event.userId, 1) then return "INVALID_EVENT" end
    if allowed.connectionEpoch and not integer(event.connectionEpoch, 1) then return "INVALID_EVENT" end
    if allowed.attempt and (not integer(event.attempt, 1) or not integer(event.levelEpoch, 1)
        or not identifier(event.actorId)) then return "INVALID_EVENT" end
    if allowed.token and not identifier(event.token) then return "INVALID_EVENT" end
    if allowed.safe and type(event.safe) ~= "boolean" then return "INVALID_EVENT" end
    if event.kind == "CommitSpawn" and not identifier(event.actorId) then return "INVALID_EVENT" end
    if event.kind == "Connection" and type(event.connected) ~= "boolean" then return "INVALID_EVENT" end
    if event.kind == "AdvanceLevel" and (not identifier(event.levelId)
        or type(event.destinationSafe) ~= "boolean" or type(event.prerequisitesMet) ~= "boolean") then return "INVALID_EVENT" end
    return nil
end

local function checkConnection(hero, event, requireOnline)
    if event.connectionEpoch ~= hero.connectionEpoch then return "STALE_CONNECTION" end
    if requireOnline and not hero.connected then return "OFFLINE" end
    return nil
end
local function checkActor(state, hero, event)
    if event.levelEpoch ~= state.levelEpoch then return "STALE_LEVEL" end
    if hero.status ~= "Alive" then return "NOT_ALIVE" end
    if event.actorId ~= hero.actorId or event.attempt ~= hero.attempt then return "STALE_ACTOR" end
    return nil
end
local function checkReservation(state, hero, event)
    local pending = hero.pending
    if not pending or pending.token ~= event.token or pending.levelEpoch ~= state.levelEpoch
        or pending.connectionEpoch ~= hero.connectionEpoch or pending.sourceAttempt ~= hero.attempt then
        return "STALE_RESERVATION"
    end
    if not hero.connected then return "OFFLINE" end
    return nil
end
local function clearEmergency(hero)
    hero.shield = nil
    hero.retryReady = false
    if hero.pending and hero.pending.kind == "Emergency" then hero.pending = nil end
end
local function closeIfDefeated(state)
    for _, hero in pairs(state.heroes) do
        if hero.status ~= "Eliminated" then return end
    end
    state.status = "Lost"
    state.partyDissolved = true
    for _, hero in pairs(state.heroes) do hero.view = "Menu" end
end

-- Mutations are applied only to a private candidate snapshot and discarded on rejection.
local function execute(state, event)
    local hero = state.heroes[event.userId]
    if not hero then return "UNKNOWN_HERO" end
    local kind = event.kind
    if kind == "ReserveSpawn" then
        local problem = checkConnection(hero, event, true)
        if problem then return problem end
        if hero.pending then return "SPAWN_PENDING" end
        local spawnKind
        if hero.status == "AwaitingInitial" then spawnKind = "Initial"
        elseif hero.status == "AwaitingRespawn" and hero.respawns &gt; 0 then spawnKind = "Respawn"
        elseif hero.status == "Alive" and hero.retryReady and hero.respawns &gt; 0 then spawnKind = "Emergency"
        else return "SPAWN_NOT_ALLOWED" end
        hero.pending = {
            token = tostring(state.revision+1) .. ":" .. tostring(event.userId),
            kind=spawnKind, levelEpoch=state.levelEpoch,
            connectionEpoch=hero.connectionEpoch, sourceAttempt=hero.attempt,
        }
    elseif kind == "CommitSpawn" then
        local problem = checkReservation(state, hero, event)
        if problem then return problem end
        if state.seenActors[event.actorId] then return "ACTOR_ID_REUSED" end
        local spawnKind = hero.pending.kind
        if spawnKind == "Initial" and not event.safe then return "UNSAFE_INITIAL_SPAWN" end
        if spawnKind ~= "Initial" then
            if hero.respawns &lt;= 0 then return "NO_RESPAWNS" end
            hero.respawns = hero.respawns - 1
        end
        hero.health = MAX_HEALTH
        hero.attempt = hero.attempt + 1
        hero.actorId = event.actorId
        hero.status = "Alive"
        hero.view = "Playing"
        hero.pending = nil
        hero.retryReady = false
        hero.shield = nil
        if spawnKind ~= "Initial" then
            hero.shield = {
                kind = event.safe and "Normal" or "Emergency",
                deadline = event.now + (event.safe and NORMAL_SHIELD_SECONDS or EMERGENCY_SHIELD_SECONDS),
            }
        end
        state.seenActors[event.actorId] = true
    elseif kind == "AbortSpawn" then
        local problem = checkReservation(state, hero, event)
        if problem then return problem end
        hero.pending = nil
    elseif kind == "Connection" then
        local problem = checkConnection(hero, event, false)
        if problem then return problem end
        if hero.connected == event.connected then return "NO_CHANGE" end
        hero.connected = event.connected
        hero.connectionEpoch = hero.connectionEpoch + 1
        hero.pending = nil
        hero.retryReady = false
    elseif kind == "ChooseView" then
        local problem = checkConnection(hero, event, true)
        if problem then return problem end
        if hero.status ~= "Eliminated" then return "NOT_ELIMINATED" end
        if event.view ~= "Menu" and event.view ~= "Spectating" then return "INVALID_VIEW" end
        hero.view = event.view
    else
        local problem = checkActor(state, hero, event)
        if problem then return problem end
        if kind == "Death" then
            hero.health = 0
            hero.actorId = nil
            hero.pending = nil
            hero.shield = nil
            hero.retryReady = false
            hero.status = hero.respawns &gt; 0 and "AwaitingRespawn" or "Eliminated"
            if hero.status == "Eliminated" then hero.view = "Choice" end
            closeIfDefeated(state)
        elseif kind == "SetHealth" then
            if not finite(event.health) or event.health &lt; 0 or event.health &gt; MAX_HEALTH then return "INVALID_HEALTH" end
            if event.health &lt; hero.health and hero.shield and event.now &lt; hero.shield.deadline then return "PROTECTED" end
            hero.health = event.health
        elseif kind == "BeginAttack" then
            problem = checkConnection(hero, event, true)
            if problem then return problem end
            clearEmergency(hero)
        elseif kind == "ExpireShield" then
            if not hero.shield then return "NO_SHIELD" end
            if event.now &lt; hero.shield.deadline then return "NOT_DUE" end
            hero.retryReady = hero.shield.kind == "Emergency" and hero.connected and hero.respawns &gt; 0
            hero.shield = nil
        elseif kind == "RelocateToSafety" then
            local emergency = (hero.shield and hero.shield.kind == "Emergency") or hero.retryReady
                or (hero.pending and hero.pending.kind == "Emergency")
            if not emergency then return "NOT_EMERGENCY" end
            if not event.safe then return "UNSAFE_DESTINATION" end
            clearEmergency(hero)
        elseif kind == "AdvanceLevel" then
            if not event.prerequisitesMet then return "EXIT_NOT_READY" end
            if not event.destinationSafe then return "UNSAFE_DESTINATION" end
            if event.levelId == state.levelId then return "SAME_LEVEL" end
            state.levelId = event.levelId
            state.levelEpoch = state.levelEpoch + 1
            for _, member in pairs(state.heroes) do
                member.pending = nil
                member.retryReady = false
                if member.status == "Alive" then
                    member.health = MAX_HEALTH
                    if member.shield and member.shield.kind == "Emergency" then member.shield = nil end
                end
            end
        end
    end
    return nil
end

function Core.apply(state, event)
    local problem = validateEvent(event)
    if problem then return state, problem, nil end
    if event.runId ~= state.runId then return state, "WRONG_RUN", nil end
    local signature = fingerprint(event)
    local previous = state.receipts[event.id]
    if previous then
        if previous.fingerprint ~= signature then return state, "EVENT_ID_REUSED", nil end
        return state, "REPLAY", copy(previous.ack)
    end
    if event.expectedRevision ~= state.revision then return state, "STALE_REVISION", nil end
    if state.status ~= "Active" then return state, "RUN_CLOSED", nil end
    if event.now &lt; state.time then return state, "TIME_REVERSED", nil end
    local nextState = copy(state)
    problem = execute(nextState, event)
    if problem then return state, problem, nil end
    nextState.revision = state.revision + 1
    nextState.time = event.now
    local hero = nextState.heroes[event.userId]
    local ack = {
        eventId=event.id, kind=event.kind, revision=nextState.revision,
        runId=nextState.runId, levelEpoch=nextState.levelEpoch,
        actorId=hero.actorId, attempt=hero.attempt, respawns=hero.respawns,
        token=hero.pending and hero.pending.token or nil,
    }
    nextState.receipts[event.id] = {fingerprint=signature, ack=copy(ack)}
    return nextState, "OK", ack
end

return Core
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Folder" referent="BT9">
        <Properties>
          <string name="Name">gameplay</string>
        </Properties>
        <Item class="ModuleScript" referent="BT10">
          <Properties>
            <string name="Name">GameConfig</string>
            <ProtectedString name="Source">-- Original playable prototype calibration. Resource limits are canonical.
-- Enemy damage and spatial/timing values still need the full source transfer.
return function(base)
    local config=table.clone(base)
    config.Calibration='PLAYABLE_PROTOTYPE'
    config.Enemy={hearts=3,punchDamage=1,dashDamage=2,speed=9,range=5,windup=.65,cooldown=1.6,reaction=.35,attack='Dash'}
    config.Boss={hits=3,interval=2.4,projectileSpeed=12,returnSpeed=26,projectileLife=12,aggroRange=45}
    return config
end
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT11">
          <Properties>
            <string name="Name">GameController</string>
            <ProtectedString name="Source">-- One playable group. Player identity comes from the server, never from payload fields.
local Controller={}
Controller.__index=Controller
local templates={['Mr. Green']=true,['Mr. Yellow']=true,['Mr. Brown']=true}
local roles={Hero=true,Enemy=true,Spectator=true}
local function exact(payload,allowed)
    if type(payload)~='table' then return false end
    local count=0
    for key in pairs(payload) do count+=1; if count&gt;4 or not allowed[key] then return false end end
    return true
end
function Controller.new(deps,world)
    return setmetatable({deps=deps,world=world,connections=deps.Registry.new(),choices={},preferences={},viewChoices={},owners={},ownerSlots={},buckets={},notices={}},Controller)
end
function Controller:_heroes(players)
    local heroes={}
    for _,p in ipairs(self.connections:online(players)) do
        if (self.preferences[p.UserId] or 'Hero')=='Hero' then heroes[#heroes+1]=p end
    end
    return heroes
end
function Controller:_enemyName(player)
    self.director.ownerNames=self.director.ownerNames or {}
    self.director.ownerNames[player.UserId]=player.DisplayName..' @'..player.Name
    local role=self.director:controlled(player.UserId)
    if role and role.status=='Alive' and self.world.enemyIdentity then
        self.world:enemyIdentity(role.enemyId,role.actorId,self.director.ownerNames[player.UserId])
    end
end
function Controller:join(player)
    if not self.connections:join(player) then return end
    local slot=self.ownerSlots[player.UserId]
    if self.current and slot and self.current.state.status=='Active' and not self.director.result then
        if self.current.state.heroes[slot].connected then self.current:connection(slot,false,self.deps.clock()) end
        self.current:connection(slot,true,self.deps.clock())
    end
    if self.director and not self:_open() then
        local role=self.director:controlled(player.UserId)
        if role then
            if role.connected then self.director:connection(player.UserId,false) end
            self.director:connection(player.UserId,true)
            self:_enemyName(player)
        end
    end
end
function Controller:leave(player)
    local changed=self.connections:remove(player)
    local slot=self.ownerSlots[player.UserId]
    if changed and self.current and slot and self.current.state.status=='Active' and not self.director.result then
        self.current:connection(slot,false,self.deps.clock())
    end
    if changed and self.director and not self:_open() then self.director:connection(player.UserId,false) end
    self.buckets[player]=nil; self.notices[player]=nil
end
function Controller:_open()
    return not self.current or self.current.state.status=='Lost' or self.director.result~=nil
end
function Controller:_begin(player,players)
    local online=self:_heroes(players)
    if #online==0 then return 'NO_HERO' end
    if online[1]~=player then return 'HOST_ONLY' end
    if not self:_open() then return 'RUN_ACTIVE' end
    self.world:clearActors(); self.ownerSlots={}; self.owners={}; self.viewChoices={}
    local roster={}
    for index=1,math.min(3,#online) do
        local owner=online[index]
        local template=self.choices[owner.UserId] or 'Mr. Green'
        self.ownerSlots[owner.UserId]=index
        self.owners[index]={userId=owner.UserId,displayName=owner.DisplayName,username=owner.Name,template=template}
        self.world.names[index]=owner.DisplayName..' @'..owner.Name
        roster[index]={userId=index,template=template}
    end
    self.current=self.deps.Session.new(self.deps.Core,self.deps.Combat,self.deps.Config,roster,self.deps.guid(),self.world,function(row)
        if row.kind=='Hit' then self.world:cue(row.userId,row.data.blocked) end
    end)
    self.current:step(self.deps.clock())
    self.director=self.deps.Director.new(self.current,self.world,self.deps.Combat,self.deps.Config)
    local originalHit=self.current._hit
    local director=self.director
    self.current._hit=function(session,attacker,target,action)
        if type(target)=='number' and target&lt;0 then return director:hit(attacker,target,action) end
        return originalHit(session,attacker,target,action)
    end
    self.finished=false
    return 'OK'
end
function Controller:controlledSlot(userId)
    local hero=self.ownerSlots[userId]
    if hero then return hero end
    local role=self.director and self.director:controlled(userId)
    if role and role.status=='Alive' then return role.enemyId end
end
function Controller:handle(player,payload,players)
    if not player.Parent or not self.connections:isCurrent(player) then return 'STALE_CONNECTION' end
    local at=self.deps.clock()
    local rate=self.deps.Config.MaxIntentRate
    local bucket=self.buckets[player] or {tokens=rate,last=at}
    bucket.tokens=math.min(rate,bucket.tokens+math.max(0,at-bucket.last)*rate); bucket.last=at; self.buckets[player]=bucket
    if bucket.tokens&lt;1 then return 'RATE_LIMIT' end
    bucket.tokens-=1
    if type(payload)~='table' or type(payload.kind)~='string' then return 'INVALID_INTENT' end
    local code
    if payload.kind=='Sync' or payload.kind=='Start' then
        if not exact(payload,{kind=true}) then return 'INVALID_INTENT' end
        code=payload.kind=='Start' and self:_begin(player,players) or 'OK'
    elseif payload.kind=='SelectHero' then
        if not exact(payload,{kind=true,template=true}) or not templates[payload.template] then return 'INVALID_INTENT' end
        if not self:_open() then code='RUN_ACTIVE'
        else self.choices[player.UserId]=payload.template; code='OK' end
    elseif payload.kind=='SelectRole' then
        if not exact(payload,{kind=true,role=true}) or not roles[payload.role] then return 'INVALID_INTENT' end
        if not self:_open() then code='RUN_ACTIVE'
        else self.preferences[player.UserId]=payload.role; code='OK' end
    elseif payload.kind=='ChooseView' then
        if not exact(payload,{kind=true,runId=true,levelEpoch=true,view=true})
            or type(payload.runId)~='string' or #payload.runId==0 or #payload.runId&gt;160
            or type(payload.levelEpoch)~='number' or payload.levelEpoch&lt;1 or payload.levelEpoch&gt;1000000000 or payload.levelEpoch%1~=0
            or (payload.view~='Menu' and payload.view~='Spectating') then return 'INVALID_INTENT' end
        if self:_open() then code='RUN_CLOSED'
        elseif payload.runId~=self.current.state.runId then code='WRONG_RUN'
        elseif payload.levelEpoch~=self.current.state.levelEpoch then code='STALE_LEVEL'
        else
            local slot=self.ownerSlots[player.UserId]
            local hero=slot and self.current.state.heroes[slot]
            local enemy=self.director:controlled(player.UserId)
            if hero and hero.status~='Eliminated' then code='NOT_ELIMINATED'
            elseif hero then
                code=self.current:_clock(at)
                if code=='OK' and hero.view~=payload.view then
                    code=self.current:_event('ChooseView',slot,{view=payload.view,connectionEpoch=hero.connectionEpoch})
                end
            elseif enemy and enemy.status=='Alive' then code='ROLE_ACTIVE'
            else self.viewChoices[player.UserId]=payload.view; code='OK' end
        end
    elseif payload.kind=='ClaimEnemy' then
        if not exact(payload,{kind=true,runId=true,levelEpoch=true,enemyId=true})
            or type(payload.enemyId)~='number' or payload.enemyId%1~=0 or payload.enemyId&gt;=0 or payload.enemyId&lt;=-1000 then return 'INVALID_INTENT' end
        if self:_open() then code='RUN_CLOSED'
        elseif payload.runId~=self.current.state.runId then code='WRONG_RUN'
        elseif payload.levelEpoch~=self.current.state.levelEpoch then code='STALE_LEVEL'
        elseif self.ownerSlots[player.UserId] then code='HERO_LOCKED'
        else
            self:_enemyName(player)
            self.director.now=at
            code=self.director:claim(player.UserId,payload.enemyId)
            if code=='OK' then self.viewChoices[player.UserId]=nil end
        end
    elseif self.current then
        local slot=self.ownerSlots[player.UserId]
        if self:_open() then code='RUN_CLOSED'
        elseif slot then
            code=self.current:intent(slot,payload,at)
            if code=='OK' and payload.kind=='Attack' then
                self.director.now=at
                self.director:closeTargetForAttack(self.world:targets(slot,self.deps.Config.Attacks[payload.attack]))
            end
        elseif self.director:controlled(player.UserId) then
            code=self.director:command(player.UserId,payload,at,self.deps.Session.validIntent)
        else code='SPECTATOR' end
    else code='NO_RUN' end
    if code=='OK' then self.notices[player]=nil else self.notices[player]=code end
    return code
end
function Controller:step(now,dt)
    if not self.current or self.finished then return end
    self.director.now=now
    self.current:step(now); self.director:step(now,dt)
    if self.director.result then
        self.finished=true
        for _,id in ipairs(self.current.order) do
            self.world:move(id,0,0)
            if self.world.hold then self.world:hold(id,true) end
        end
        for id in pairs(self.director.enemies or {}) do self.world:move(id,0,0) end
    end
end
function Controller:snapshot(player,players)
    if not self.connections:isCurrent(player) then return nil end
    local online=self.connections:online(players)
    local data=self.current and self.current:snapshot() or {status='Lobby',heroes={},now=self.deps.clock()}
    data.status=self.director and self.director.result or data.status
    data.level=self.director and self.director:snapshot() or {stage='Lobby',objective='Выберите героя и отправляйтесь в путь'}
    for _,hero in ipairs(data.heroes) do
        local owner=self.owners[hero.slot]
        for key,value in pairs(owner) do hero[key]=value end
    end
    data.lobby={}
    for _,owner in ipairs(online) do
        data.lobby[#data.lobby+1]={userId=owner.UserId,displayName=owner.DisplayName,username=owner.Name,
            template=self.choices[owner.UserId] or 'Mr. Green',preference=self.preferences[owner.UserId] or 'Hero'}
    end
    data.mine=self.ownerSlots[player.UserId]
    local heroes=self:_heroes(players)
    data.online=#online; data.heroOnline=#heroes; data.host=heroes[1] and heroes[1].UserId
    data.canStart=heroes[1]==player and self:_open()
    data.canSelect=self:_open()
    data.selectedTemplate=self.choices[player.UserId] or 'Mr. Green'
    data.preference=self.preferences[player.UserId] or 'Hero'
    data.enemyRole=self.director and self.director:controlled(player.UserId)
    data.cameraBounds=self.world.cameraBounds and self.world:cameraBounds() or nil
    if self:_open() then data.view='Menu'; data.canChooseView=false
    elseif data.mine then
        local hero=self.current.state.heroes[data.mine]
        data.view=hero.status=='Eliminated' and hero.view or 'Playing'
        data.canChooseView=hero.status=='Eliminated'
    elseif data.enemyRole and data.enemyRole.status=='Alive' then data.view='Playing'; data.canChooseView=false
    else
        data.view=self.viewChoices[player.UserId] or (data.enemyRole and 'Choice' or 'Spectating')
        data.canChooseView=true
    end
    data.enemyOffers={}
    if not self.current or self:_open() then data.enemyUnavailableReason='RUN_CLOSED'
    elseif data.mine then data.enemyUnavailableReason='HERO_LOCKED'
    elseif data.enemyRole then
        data.enemyUnavailableReason=data.enemyRole.status=='Alive' and 'ENEMY_ALREADY_OWNED' or 'ENEMY_LIFE_SPENT'
    else
        data.enemyOffers=self.director:available(player.UserId)
        if #data.enemyOffers==0 then data.enemyUnavailableReason='NO_ENEMY_AVAILABLE' end
    end
    data.notice=self.notices[player]
    return data
end
return Controller
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT12">
          <Properties>
            <string name="Name">GameWorld</string>
            <ProtectedString name="Source">-- Original first-level presentation. Combat and hero physics stay in BaseWorld.
local World = {}

local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local COLORS = {
    stone = Color3.fromRGB(71, 92, 89),
    dark = Color3.fromRGB(35, 54, 57),
    pale = Color3.fromRGB(159, 179, 151),
    moss = Color3.fromRGB(72, 115, 77),
    mint = Color3.fromRGB(134, 255, 194),
    amber = Color3.fromRGB(255, 184, 72),
    rust = Color3.fromRGB(178, 82, 47),
}

local function part(parent, name, size, frame, color, material, collidable)
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.CFrame = frame
    p.Color = color
    p.Material = material or Enum.Material.SmoothPlastic
    p.Anchored = true
    p.CanCollide = collidable == true
    p.CanTouch = false
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.Parent = parent
    return p
end

local function ball(parent, name, size, frame, color, material)
    local p = part(parent, name, size, frame, color, material, false)
    p.Shape = Enum.PartType.Ball
    return p
end

local function cosmetic(model, limb, name, size, offset, color, shape, material)
    local p = part(model, name, size, limb.CFrame * offset, color, material, false)
    if shape then p.Shape = shape end
    p.Anchored = false
    p.Massless = true
    p.CanQuery = false
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = limb
    weld.Part1 = p
    weld.Parent = p
    return p
end

local function label(parent, text, size, offset)
    local board = Instance.new("BillboardGui")
    board.Name = "WorldLabel"
    board.Size = UDim2.fromOffset(size or 240, 44)
    board.StudsOffset = offset or Vector3.new(0, 3, 0)
    board.AlwaysOnTop = false
    board.MaxDistance = 120
    board.Parent = parent
    local textLabel = Instance.new("TextLabel")
    textLabel.Name = "Text"
    textLabel.Size = UDim2.fromScale(1, 1)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = text
    textLabel.TextColor3 = Color3.fromRGB(226, 244, 211)
    textLabel.TextStrokeColor3 = Color3.fromRGB(20, 39, 37)
    textLabel.TextStrokeTransparency = 0.15
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextSize = 17
    textLabel.TextWrapped = true
    textLabel.Parent = board
    return textLabel
end

local function pointLight(parent, color, range, brightness)
    local light = Instance.new("PointLight")
    light.Color = color
    light.Range = range
    light.Brightness = brightness
    light.Shadows = false
    light.Parent = parent
    return light
end

local function hideRig(actor)
    for _,p in ipairs(actor.model:GetChildren()) do
        if p:IsA("BasePart") then p.Transparency = 1 end
    end
    -- The stand's small eye parts are also cosmetic and can be replaced safely.
    for _,p in ipairs(actor.model:GetChildren()) do
        if p.Name == "Eye" then p:Destroy() end
    end
end

local function toad(actor, template)
    hideRig(actor)
    local palettes = {
        ["Mr. Green"] = {Color3.fromRGB(94, 159, 102), Color3.fromRGB(188, 209, 122), Color3.fromRGB(41, 85, 65)},
        ["Mr. Yellow"] = {Color3.fromRGB(210, 169, 61), Color3.fromRGB(246, 224, 143), Color3.fromRGB(118, 83, 41)},
        ["Mr. Brown"] = {Color3.fromRGB(160, 112, 86), Color3.fromRGB(224, 186, 129), Color3.fromRGB(86, 61, 61)},
    }
    local palette = palettes[template] or palettes["Mr. Green"]
    local skin, belly, accent = palette[1], palette[2], palette[3]
    local model = actor.model
    local torso, head = model.Torso, model.Head
    cosmetic(model, torso, "ToadBody", Vector3.new(2.3, 2.05, 1.55), CFrame.new(), skin, Enum.PartType.Ball)
    cosmetic(model, torso, "Belly", Vector3.new(1.65, 1.65, 0.32), CFrame.new(0, -0.08, -0.7), belly, Enum.PartType.Ball)
    cosmetic(model, head, "ToadHead", Vector3.new(2.5, 1.55, 1.55), CFrame.new(0, 0.08, -0.05), skin, Enum.PartType.Ball)
    cosmetic(model, head, "LowerMuzzle", Vector3.new(2.12, 0.5, 1.1), CFrame.new(0, -0.35, -0.36), belly, Enum.PartType.Ball)
    cosmetic(model, head, "Mouth", Vector3.new(1.3, 0.055, 0.045), CFrame.new(0, -0.28, -0.91), accent)
    for _,side in ipairs({-1, 1}) do
        local x = side * 0.75
        cosmetic(model, head, "EyeRidge", Vector3.new(0.98, 0.98, 0.9), CFrame.new(x, 0.6, -0.27), skin, Enum.PartType.Ball)
        cosmetic(model, head, "EyeWhite", Vector3.new(0.71, 0.75, 0.39), CFrame.new(x, 0.63, -0.67), Color3.fromRGB(251, 245, 203), Enum.PartType.Ball)
        cosmetic(model, head, "Iris", Vector3.new(0.3, 0.43, 0.15), CFrame.new(x, 0.64, -0.88), accent, Enum.PartType.Ball)
        cosmetic(model, head, "EyeShine", Vector3.new(0.09, 0.12, 0.05), CFrame.new(x - 0.06, 0.74, -0.96), Color3.new(1, 1, 1), Enum.PartType.Ball)
        cosmetic(model, head, "Brow", Vector3.new(0.82, 0.16, 0.37), CFrame.new(x, 1, -0.6) * CFrame.Angles(0, 0, side * 0.12), accent, Enum.PartType.Ball)
        cosmetic(model, head, "Nostril", Vector3.new(0.12, 0.1, 0.06), CFrame.new(side * 0.27, -0.02, -0.81), accent, Enum.PartType.Ball)
        local arm = model[side == -1 and "Left Arm" or "Right Arm"]
        local leg = model[side == -1 and "Left Leg" or "Right Leg"]
        cosmetic(model, arm, "UpperArm", Vector3.new(0.9, 1.7, 0.95), CFrame.new(0, 0.1, 0), skin, Enum.PartType.Ball)
        cosmetic(model, arm, "Palm", Vector3.new(0.94, 0.65, 0.85), CFrame.new(0, -0.8, -0.08), skin, Enum.PartType.Ball)
        cosmetic(model, leg, "Haunch", Vector3.new(1.15, 1.4, 1.2), CFrame.new(0, 0.3, 0.12), skin, Enum.PartType.Ball)
        cosmetic(model, leg, "Foot", Vector3.new(1.1, 0.44, 1.5), CFrame.new(0, -0.8, -0.36), skin, Enum.PartType.Ball)
        for finger = -1, 1 do
            cosmetic(model, arm, "Finger", Vector3.new(0.22, 0.55, 0.25), CFrame.new(finger * 0.29, -1.1, -0.18), belly, Enum.PartType.Ball)
            cosmetic(model, leg, "Toe", Vector3.new(0.26, 0.3, 0.67), CFrame.new(finger * 0.3, -0.82, -1.02), belly, Enum.PartType.Ball)
        end
        for spot = 1, 2 do
            cosmetic(model, torso, "ToadSpot", Vector3.new(0.28, 0.35, 0.12), CFrame.new(side * 0.93, 0.3 - spot * 0.43, -0.42), accent, Enum.PartType.Ball)
        end
    end
    model:SetAttribute("Template", template or "Mr. Green")
    model:SetAttribute("Appearance", "OriginalToad")
end

local function drone(actor)
    hideRig(actor)
    local m = actor.model
    cosmetic(m, m.Torso, "RustHull", Vector3.new(2.35, 1.85, 1.55), CFrame.new(), COLORS.rust)
    cosmetic(m, m.Torso, "ChestGrille", Vector3.new(1.4, 0.95, 0.15), CFrame.new(0, -0.15, -0.84), COLORS.dark)
    for n = -1, 1 do
        cosmetic(m, m.Torso, "Vent", Vector3.new(1.1, 0.08, 0.07), CFrame.new(0, n * 0.25 - 0.1, -0.95), COLORS.pale)
        local arm = m[n == -1 and "Left Arm" or "Right Arm"]
        local leg = m[n == -1 and "Left Leg" or "Right Leg"]
        cosmetic(m, arm, "ToolArm", Vector3.new(0.72, 1.8, 0.72), CFrame.new(), COLORS.dark)
        cosmetic(m, arm, "Clamp", Vector3.new(1.05, 0.52, 1.08), CFrame.new(0, -0.8, -0.18), COLORS.rust)
        cosmetic(m, leg, "Strut", Vector3.new(0.56, 1.7, 0.62), CFrame.new(), COLORS.pale)
        cosmetic(m, leg, "TrackFoot", Vector3.new(0.9, 0.45, 1.5), CFrame.new(0, -0.8, -0.15), COLORS.dark)
    end
    cosmetic(m, m.Head, "SensorHousing", Vector3.new(1.5, 0.86, 1.4), CFrame.new(), COLORS.dark)
    cosmetic(m, m.Head, "SingleOptic", Vector3.new(0.68, 0.5, 0.25), CFrame.new(0, 0.02, -0.77), COLORS.amber, Enum.PartType.Ball, Enum.Material.Neon)
    cosmetic(m, m.Head, "Antenna", Vector3.new(0.12, 0.95, 0.12), CFrame.new(0.6, 0.7, 0.22) * CFrame.Angles(0, 0, -0.25), COLORS.pale)
    cosmetic(m, m.Head, "AntennaTip", Vector3.new(0.23, 0.23, 0.23), CFrame.new(0.72, 1.13, 0.22), COLORS.amber, Enum.PartType.Ball, Enum.Material.Neon)
end

local function boss(actor)
    hideRig(actor)
    local m, root = actor.model, actor.root
    local function c(name, size, offset, color, shape, material)
        return cosmetic(m, root, name, size, offset, color, shape, material)
    end
    c("GuardianBase", Vector3.new(7.6, 1.5, 6.3), CFrame.new(0, -2.1, 0), COLORS.dark)
    c("GuardianDrum", Vector3.new(5.6, 4.8, 4.8), CFrame.new(0, -0.1, 0), COLORS.rust, Enum.PartType.Ball)
    c("GuardianCrown", Vector3.new(6.4, 1.15, 4.8), CFrame.new(0, 2.5, 0.2), COLORS.dark)
    c("FacePlate", Vector3.new(3.8, 2.7, 0.7), CFrame.new(0, 0.9, -2.1), COLORS.pale)
    c("ReactorEye", Vector3.new(1.45, 1.45, 0.5), CFrame.new(0, 1.12, -2.56), COLORS.amber, Enum.PartType.Ball, Enum.Material.Neon)
    c("CannonHousing", Vector3.new(2.3, 1.7, 2.5), CFrame.new(0, -0.85, -2.05), COLORS.dark)
    c("CannonMouth", Vector3.new(1.6, 1.15, 0.25), CFrame.new(0, -0.85, -3.4), COLORS.amber, Enum.PartType.Ball, Enum.Material.Neon)
    for _,side in ipairs({-1, 1}) do
        c("AnchorPylon", Vector3.new(1.25, 4.6, 1.7), CFrame.new(side * 3, -0.55, 0.4) * CFrame.Angles(0, 0, side * 0.15), COLORS.dark)
        c("ShieldCoil", Vector3.new(1.1, 2.4, 1.1), CFrame.new(side * 3.6, 1.1, 0), COLORS.mint, Enum.PartType.Cylinder, Enum.Material.Neon)
        c("CrownFin", Vector3.new(0.7, 2, 1.8), CFrame.new(side * 2.1, 3.65, 0.6) * CFrame.Angles(0, 0, -side * 0.2), COLORS.rust)
    end
    pointLight(root, COLORS.amber, 16, 1.5)
end

local function buildGeometry(self)
    self.geometry:ClearAllChildren()
    self.floors = {}
    local g = self.geometry
    local floor = part(g, "FloodedCauseway", Vector3.new(206, 3.4, 42), CFrame.new(21, -1.7, 0), COLORS.stone, Enum.Material.Slate, true)
    floor:SetAttribute("SurfaceId", "Causeway")
    self.floors[1] = floor
    -- Large stone surfaces support respawn checks; shallow insets are visual only.
    for x = -76, 120, 7 do
        for z = -14, 14, 7 do
            local shade = ((math.floor(x / 7) + math.floor(z / 7)) % 3) * 6
            part(g, "PavingStone", Vector3.new(6.7, 0.1, 6.7), CFrame.new(x, 0.025, z), Color3.fromRGB(81 + shade, 105 + shade, 98 + shade), Enum.Material.Slate)
        end
    end
    part(g, "SubmergedFoundation", Vector3.new(208, 7, 44), CFrame.new(21, -5.1, 0), COLORS.dark, Enum.Material.Rock)
    local marsh = part(g, "MarshWater", Vector3.new(440, 0.4, 230), CFrame.new(20, -7.8, 0), Color3.fromRGB(34, 101, 96), Enum.Material.Glass)
    marsh.Transparency = 0.3
    marsh.Reflectance = 0.25
    local mist = part(g, "WaterDepth", Vector3.new(440, 12, 230), CFrame.new(20, -14, 0), Color3.fromRGB(22, 54, 61), Enum.Material.SmoothPlastic)
    mist.Transparency = 0.15
    -- The optional side pool is visibly separated from the wide, safe central path.
    self.danger = part(g, "BitterBogPool", Vector3.new(15, 0.24, 6), CFrame.new(10, 0.14, 15.5), Color3.fromRGB(195, 113, 44), Enum.Material.Neon, true)
    self.danger.Transparency = 0.2
    self.danger:SetAttribute("Hazard", true)
    self.danger:SetAttribute("SurfaceId", "Causeway")
    for _,z in ipairs({11.9, 19.1}) do
        part(g, "PoolRim", Vector3.new(16, 0.5, 0.45), CFrame.new(10, 0.25, z), COLORS.dark, Enum.Material.Rock)
    end
    for _,x in ipairs({2, 18}) do
        part(g, "PoolRim", Vector3.new(0.5, 0.5, 7.6), CFrame.new(x, 0.25, 15.5), COLORS.dark, Enum.Material.Rock)
    end
    local warning = part(g, "BogWarning", Vector3.new(0.4, 2.6, 0.4), CFrame.new(-1, 1.3, 12.5), COLORS.pale, Enum.Material.Wood)
    label(warning, "ОПАСНАЯ ТОПЬ", 160, Vector3.new(0, 2, 0)).TextColor3 = COLORS.amber

    -- Broken parapets leave readable edges while keeping the route open.
    for x = -76, 118, 12 do
        for _,side in ipairs({-1, 1}) do
            local z = side * 20
            part(g, "ParapetFoot", Vector3.new(2.2, 1.7, 2), CFrame.new(x, 0.85, z), COLORS.stone, Enum.Material.Rock, true)
            if (math.floor(x / 12) + side) % 3 ~= 0 then
                part(g, "BrokenParapet", Vector3.new(7.6, 1.35, 1.1), CFrame.new(x + 4.4, 0.68, z), COLORS.dark, Enum.Material.Rock, true)
            end
            local lamp = ball(g, "WayLight", Vector3.new(0.55, 0.55, 0.55), CFrame.new(x, 1.95, z), COLORS.mint, Enum.Material.Neon)
            pointLight(lamp, COLORS.mint, 9, 0.55)
        end
    end

    -- A ruined aqueduct silhouette, using only native primitives.
    local function arch(x, name, intact)
        local model = Instance.new("Model")
        model.Name = name
        model.Parent = g
        for _,side in ipairs({-1, 1}) do
            part(model, "PillarFoot", Vector3.new(5, 1.4, 5), CFrame.new(x, 0.7, side * 17), COLORS.dark, Enum.Material.Rock)
            part(model, "MossPillar", Vector3.new(2.7, 10.5, 3.2), CFrame.new(x, 6.6, side * 17), COLORS.stone, Enum.Material.Rock)
            part(model, "Capital", Vector3.new(3.9, 1.1, 4), CFrame.new(x, 12, side * 17), COLORS.pale, Enum.Material.Rock)
            for n = 1, 3 do
                local z = side * (17 - n * 2.5)
                part(model, "ArchVoussoir", Vector3.new(2.8, 2.3, 3.1), CFrame.new(x, 12.1 + n * 1.4, z) * CFrame.Angles(side * 0.12, 0, 0), COLORS.stone, Enum.Material.Rock)
            end
        end
        if intact then
            part(model, "Keystone", Vector3.new(3.1, 2.8, 15), CFrame.new(x, 17.3, 0), COLORS.dark, Enum.Material.Rock)
            local seal = ball(model, "AncientSeal", Vector3.new(0.5, 2.4, 2.4), CFrame.new(x - 1.8, 17.3, 0), COLORS.mint, Enum.Material.Neon)
            pointLight(seal, COLORS.mint, 18, 1)
        end
    end
    arch(-75, "WelcomeRuin", true)
    arch(42, "BrokenAqueduct", false)
    arch(107, "ExitArch", true)

    -- Reeds, lily pads, fallen masonry and distant trunks frame the linear level.
    for n = 1, 48 do
        local x = -95 + (n * 37 % 239)
        local side = n % 2 == 0 and 1 or -1
        local z = side * (27 + (n * 11 % 35))
        local y = -6.8
        ball(g, "MarshIsland", Vector3.new(9 + n % 5, 1.1, 7), CFrame.new(x, y - 0.1, z), COLORS.moss, Enum.Material.Grass)
        for reed = 1, 3 do
            local height = 2.4 + (n + reed) % 4
            part(g, "Reed", Vector3.new(0.19, height, 0.24), CFrame.new(x + reed * 0.6 - 1.2, y + height / 2, z) * CFrame.Angles(0.08, 0, (reed - 2) * 0.13), Color3.fromRGB(102, 141, 79), Enum.Material.Grass)
            ball(g, "SeedHead", Vector3.new(0.4, 1.05, 0.4), CFrame.new(x + reed * 0.6 - 1.2, y + height, z), Color3.fromRGB(109, 84, 64))
        end
        if n % 4 == 0 then
            part(g, "FallenMasonry", Vector3.new(6, 3, 4), CFrame.new(x, -5.8, z + side * 3) * CFrame.Angles(0.2, n, 0.35), COLORS.dark, Enum.Material.Rock)
        end
    end
    for n = 1, 16 do
        local side = n % 2 == 0 and 1 or -1
        local x, z = -98 + n * 16, side * (62 + n % 3 * 8)
        local height = 13 + n % 5 * 3
        part(g, "DrownedTrunk", Vector3.new(2.6, height, 2.7), CFrame.new(x, height / 2 - 8, z) * CFrame.Angles(0, 0, side * 0.1), Color3.fromRGB(42, 66, 62), Enum.Material.Wood)
        ball(g, "Canopy", Vector3.new(21, 9, 17), CFrame.new(x, height - 7, z), Color3.fromRGB(41, 82, 70), Enum.Material.Grass)
    end

    local start = part(g, "StartSign", Vector3.new(1, 0.5, 1), CFrame.new(-63, 4.6, -15), COLORS.dark)
    start.Transparency = 1
    label(start, "ЗАТОПЛЕННЫЙ ТРАКТ", 310, Vector3.new(0, 2.8, 0)).TextSize = 23
    label(start, "ВПЕРЁД  →", 200, Vector3.new(0, 0.8, 0)).TextColor3 = COLORS.mint

    self.gates = {}
    local function gate(x, title)
        local beam = part(g, "EncounterGate", Vector3.new(0.6, 7.5, 44), CFrame.new(x, 3.75, 0), COLORS.amber, Enum.Material.ForceField, true)
        beam.Transparency = 0.63
        local text = label(beam, title, 290, Vector3.new(0, 6, 0))
        local marker = ball(g, "ObjectiveBeacon", Vector3.new(1.8, 1.8, 1.8), CFrame.new(x, 11.4, 0), COLORS.amber, Enum.Material.Neon)
        local light = pointLight(marker, COLORS.amber, 17, 1.6)
        local record = {beam = beam, label = text, marker = marker, light = light}
        self.gates[#self.gates + 1] = record
        return record
    end
    gate(2, "I  ·  РАСЧИСТИТЕ ТРАКТ")
    gate(52, "II  ·  ЗАТОПЛЕННЫЙ ДВОР")
    self.exitGate = gate(108, "III  ·  СТРАЖ ПЕРЕПРАВЫ")
    local exitPad = part(g, "ExitPad", Vector3.new(12, 0.13, 20), CFrame.new(115, 0.09, 0), COLORS.mint, Enum.Material.Neon)
    exitPad.Transparency = 0.6
    self.exitPad = exitPad
    for x = -57, 101, 18 do
        local arrow = part(g, "RouteArrow", Vector3.new(2, 0.08, 0.45), CFrame.new(x, 0.12, 0), COLORS.pale, Enum.Material.Neon)
        arrow.Transparency = 0.45
        for _,side in ipairs({-1, 1}) do
            local wing = part(g, "RouteArrowWing", Vector3.new(1.15, 0.08, 0.3), CFrame.new(x + 0.45, 0.12, side * 0.35) * CFrame.Angles(0, side * 0.65, 0), COLORS.pale, Enum.Material.Neon)
            wing.Transparency = 0.45
        end
    end
end

function World.new(BaseWorld, config)
    -- Remove only the untouched blank-place defaults in this playable runtime.
    for _,object in ipairs(Workspace:GetChildren()) do
        if (object.Name == "Baseplate" and object:IsA("BasePart"))
            or (object.Name == "SpawnLocation" and object:IsA("SpawnLocation")) then
            object:Destroy()
        end
    end
    local previous = Workspace:FindFirstChild("BrickToadsWorld")
    if previous then previous:Destroy() end
    local self = BaseWorld.new(config)
    self._base = BaseWorld
    setmetatable(self, {__index = function(_, key) return World[key] or BaseWorld[key] end})
    self.folder.Name = "BrickToadsWorld"
    self.folder:SetAttribute("LevelName", "Затопленный тракт")
    self.folder:SetAttribute("OriginalArt", true)
    self.enemyKinds = {}
    self.origins = {
        [1] = Vector3.new(-65, 3, -7),
        [2] = Vector3.new(-65, 3, 0),
        [3] = Vector3.new(-65, 3, 7),
    }
    buildGeometry(self)
    Lighting.ClockTime = 16.5
    Lighting.Brightness = 2.2
    Lighting.Ambient = Color3.fromRGB(80, 109, 111)
    Lighting.OutdoorAmbient = Color3.fromRGB(119, 142, 132)
    Lighting.ColorShift_Top = Color3.fromRGB(255, 220, 170)
    Lighting.GlobalShadows = true
    Lighting.FogColor = Color3.fromRGB(112, 155, 151)
    Lighting.FogStart = 150
    Lighting.FogEnd = 380
    local atmosphere = Lighting:FindFirstChild("CausewayAtmosphere") or Instance.new("Atmosphere")
    atmosphere.Name = "CausewayAtmosphere"
    atmosphere.Density = 0.24
    atmosphere.Offset = 0.12
    atmosphere.Color = Color3.fromRGB(178, 207, 186)
    atmosphere.Decay = Color3.fromRGB(84, 123, 126)
    atmosphere.Glare = 0.12
    atmosphere.Haze = 1.5
    atmosphere.Parent = Lighting
    self:stage("Approach")
    return self
end

function World:spawn(uid, actorId, point, held, template)
    if not self.origins[uid] and uid &gt; 0 then self.origins[uid] = Vector3.new(-65, 3, (uid - 2) * 7) end
    local ok = self._base.spawn(self, uid, actorId, point, held, template or "Mr. Green")
    if ok then
        self.actors[uid].model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
        toad(self.actors[uid], template or "Mr. Green")
        local actor=self.actors[uid]
        actor.humanoid.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
        local ownerName=label(actor.root,actor.humanoid.DisplayName,220,Vector3.new(0,4.2,0))
        ownerName.TextSize=14
        ownerName.Parent.Name='OwnerNameplate'
    end
    return ok
end

function World:spawnEnemy(id, kind, positionTable)
    if type(id) ~= "number" or id &gt;= 0 or id &lt;= -1000 or not positionTable then return false end
    local x, y, z = positionTable.x, positionTable.y, positionTable.z
    if type(x) ~= "number" or type(y) ~= "number" or type(z) ~= "number" then return false end
    local isBoss = string.lower(tostring(kind)) == "boss"
    self.origins[id] = Vector3.new(x, y, z)
    self.names[id] = isBoss and "Страж переправы" or "Ржавый дозорный"
    if not self._base.spawn(self, id, id, nil, isBoss, "Mr. Brown") then return false end
    local actor = self.actors[id]
    actor.model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
    -- BaseWorld's ordinary spawn is deliberately y=3, so preserve the supplied
    -- world position explicitly for project/director callers.
    actor.model:PivotTo(CFrame.lookAt(Vector3.new(x, y, z), Vector3.new(x - 1, y, z)))
    actor.model:SetAttribute("EnemyKind", kind)
    actor.model:SetAttribute("Template", nil)
    actor.model:SetAttribute("Slot", nil)
    actor.humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    actor.humanoid.WalkSpeed = isBoss and 0 or 8
    self.enemyKinds[id] = isBoss and "Boss" or "Drone"
    if isBoss then boss(actor) else drone(actor) end
    actor.healthLabel = label(actor.root, "♥ ♥ ♥", isBoss and 270 or 160, Vector3.new(0, isBoss and 7.6 or 4.5, 0))
    actor.healthLabel.TextColor3 = isBoss and COLORS.amber or Color3.fromRGB(255, 164, 139)
    self:enemyHealth(id, 3, 3)
    return true
end

function World:position(id)
    local a = self.actors[id]
    if not a or not a.root.Parent then return nil end
    local p = a.root.Position
    return {x = p.X, y = p.Y, z = p.Z}
end

function World:cameraBounds()
    local minX,maxX,minZ,maxZ,top=math.huge,-math.huge,math.huge,-math.huge,-math.huge
    for _,floor in ipairs(self.floors) do
        minX=math.min(minX,floor.Position.X-floor.Size.X/2)
        maxX=math.max(maxX,floor.Position.X+floor.Size.X/2)
        minZ=math.min(minZ,floor.Position.Z-floor.Size.Z/2)
        maxZ=math.max(maxZ,floor.Position.Z+floor.Size.Z/2)
        top=math.max(top,floor.Position.Y+floor.Size.Y/2)
    end
    assert(minX&lt;maxX and minZ&lt;maxZ,'The current level has no camera bounds')
    return {minX=minX-12,maxX=maxX+12,minY=top+7,maxY=top+52,minZ=minZ-28,maxZ=maxZ+28}
end

function World:enemyIdentity(id,actorId,ownerName)
    local actor=self.actors[id]
    if not actor or self.enemyKinds[id]~='Drone' then return end
    actor.model:SetAttribute('ActorId',actorId)
    actor.model:SetAttribute('ControlledByPlayer',ownerName~=nil)
    if ownerName then
        local board=actor.root:FindFirstChild('OwnerNameplate')
        if board then board.Text.Text=ownerName
        else
            local text=label(actor.root,ownerName,220,Vector3.new(0,5.7,0))
            text.TextSize=14; text.TextColor3=COLORS.amber; text.Parent.Name='OwnerNameplate'
        end
    end
end

function World:move(id,x,z)
    local actor=self.actors[id]
    if actor and self.enemyKinds[id]=='Drone' and not actor.humanoid.PlatformStand then
        actor.humanoid.WalkSpeed=self.config.Enemy.speed
    end
    self._base.move(self,id,x,z)
end

function World:setReaction(id,active)
    self._base.setReaction(self,id,active)
    local actor=self.actors[id]
    if actor and self.enemyKinds[id]=='Drone' then actor.humanoid.WalkSpeed=active and 0 or self.config.Enemy.speed end
end

function World:face(id, targetId)
    local a, b = self.actors[id], self.actors[targetId]
    if not a or not b or not a.root.Parent or not b.root.Parent then return end
    local p, q = a.root.Position, b.root.Position
    local flat = Vector3.new(q.X - p.X, 0, q.Z - p.Z)
    if flat.Magnitude &gt; 0.05 then a.root.CFrame = CFrame.lookAt(p, p + flat) end
end

function World:enemyMove(id, targetId, speed)
    local a, b = self.actors[id], self.actors[targetId]
    if not a or not b or not a.root.Parent or not b.root.Parent or a.root.Anchored or a.humanoid.Health &lt;= 0 then return end
    local delta = b.root.Position - a.root.Position
    local flat = Vector3.new(delta.X, 0, delta.Z)
    a.humanoid.WalkSpeed = speed or 8
    local direction = flat.Magnitude &gt; 0.2 and flat.Unit or Vector3.new()
    if direction.Magnitude &gt; 0 then
        local ahead = a.root.Position + direction * 3
        local side = Vector3.new(-direction.Z, 0, direction.X) * 0.85
        for _,offset in ipairs({Vector3.new(), side, -side}) do
            local support = Workspace:Raycast(ahead + offset + Vector3.new(0, 1, 0), Vector3.new(0, -6, 0), self.ray)
            if not support or support.Normal.Y &lt; 0.95 or support.Instance:GetAttribute("Hazard")
                or not support.Instance:GetAttribute("SurfaceId") then
                direction = Vector3.new()
                break
            end
        end
    end
    -- Stop voluntary pursuit at an unsafe edge. External impulses and gravity
    -- remain untouched, so combat can still knock a mechanical enemy off.
    a.humanoid:Move(direction, false)
end

function World:enemyHealth(id, raw, maximum)
    local a = self.actors[id]
    if not a then return end
    maximum = math.max(1, tonumber(maximum) or 3)
    local hearts = math.clamp(math.ceil(math.max(0, tonumber(raw) or 0) / maximum * 3), 0, 3)
    a.model:SetAttribute("Hearts", hearts)
    a.model:SetAttribute("HealthRaw", raw)
    a.model:SetAttribute("HealthMax", maximum)
    if a.healthLabel then
        local symbols = {}
        for n = 1, 3 do symbols[n] = n &lt;= hearts and "♥" or "♡" end
        a.healthLabel.Text = (self.enemyKinds[id] == "Boss" and "СТРАЖ  ·  " or "") .. table.concat(symbols, " ")
    end
end

function World:stage(name)
    self.stageName = name
    self.folder:SetAttribute("Stage", name)
    local progress = ({Approach = 0, Courtyard = 1, Boss = 2, Exit = 3, Won = 3, Lost = -1})[name] or 0
    for index, gate in ipairs(self.gates) do
        local open = progress &gt;= index
        gate.beam.CanCollide = not open
        gate.beam.Transparency = open and 1 or 0.63
        gate.marker.Color = open and COLORS.mint or COLORS.amber
        gate.marker.Transparency = open and 0.75 or 0
        gate.light.Color = gate.marker.Color
        gate.light.Brightness = open and 0.4 or 1.6
        gate.label.TextTransparency = open and 0.65 or 0
    end
    if name == "Exit" or name == "Won" then
        self.exitGate.label.Text = name == "Won" and "ТРАКТ ПРОЙДЕН!" or "ВЫХОД  →  ВСТАНЬТЕ НА ПЕЧАТЬ"
        self.exitGate.label.TextColor3 = COLORS.mint
        self.exitGate.label.TextTransparency = 0
    else
        self.exitGate.label.Text = "III  ·  СТРАЖ ПЕРЕПРАВЫ"
        self.exitGate.label.TextColor3 = Color3.fromRGB(226, 244, 211)
    end
    self.exitPad.Transparency = progress &gt;= 3 and 0.12 or 0.78
end

function World:atExit(heroId)
    local a = self.actors[heroId]
    return a ~= nil and a.root.Parent ~= nil and a.humanoid.Health &gt; 0
        and a.root.Position.X &gt;= 108 and math.abs(a.root.Position.Z) &lt;= 10
end

function World:projectile(id, positionTable, reflected)
    if type(id) ~= "number" or id &gt; -1000 or not positionTable then return false end
    local p = Vector3.new(positionTable.x, positionTable.y, positionTable.z)
    local a = self.actors[id]
    if not a then
        local model = Instance.new("Model")
        model.Name = "BogBolt_" .. tostring(-id)
        local root = ball(model, "HumanoidRootPart", Vector3.new(1.55, 1.55, 1.55), CFrame.new(p), COLORS.amber, Enum.Material.Neon)
        root.CanQuery = false
        local halo = ball(model, "BoltAura", Vector3.new(2.1, 2.1, 2.1), CFrame.new(p), COLORS.amber, Enum.Material.ForceField)
        halo.Transparency = 0.55
        local humanoid = Instance.new("Humanoid")
        humanoid.Name = "Humanoid"
        humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
        humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        humanoid.BreakJointsOnDeath = false
        humanoid.RequiresNeck = false
        humanoid.Parent = model
        model.PrimaryPart = root
        model:SetAttribute("ActorId", id)
        model:SetAttribute("Projectile", true)
        model.Parent = self.actorFolder
        a = {model = model, root = root, humanoid = humanoid, halo = halo, cue = 0}
        a.light = pointLight(root, COLORS.amber, 10, 1.2)
        self.actors[id] = a
    end
    local color = reflected and COLORS.mint or COLORS.amber
    a.root.CFrame = CFrame.new(p)
    a.halo.CFrame = CFrame.new(p)
    a.root.Color = color
    a.halo.Color = color
    a.light.Color = color
    a.model:SetAttribute("Reflected", reflected == true)
    return true
end

function World:removeProjectile(id)
    local a = self.actors[id]
    if a and id &lt;= -1000 then
        a.model:Destroy()
        self.actors[id] = nil
    end
end

function World:updatePresentation(session, dt, enemies)
    dt = math.clamp(tonumber(dt) or 0, 0, 0.1)
    self.presentationTime = (self.presentationTime or 0) + dt
    local blend = 1 - math.exp(-dt * 18)
    for id, actor in pairs(self.actors) do
        if id &gt; -1000 and actor.root.Parent and self.enemyKinds[id] ~= "Boss" then
            if not actor.poseMotors then
                actor.poseMotors = {}
                for _,joint in ipairs(actor.model:GetDescendants()) do
                    if joint:IsA("Motor6D") and (joint.Name == "Left Shoulder" or joint.Name == "Right Shoulder"
                        or joint.Name == "Left Hip" or joint.Name == "Right Hip") then
                        actor.poseMotors[joint.Name] = {joint = joint, base = joint.C0}
                    end
                end
            end
            local velocity = actor.root.AssemblyLinearVelocity
            local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
            local walking = not actor.root.Anchored and actor.humanoid.Health &gt; 0
                and actor.humanoid.FloorMaterial ~= Enum.Material.Air
            actor.walkPhase = (actor.walkPhase or 0) + dt * math.min(speed, 20) * 0.8
            local stride = walking and math.sin(actor.walkPhase) * math.clamp(speed / 12, 0, 1) * 0.5 or 0
            local combat = session and session.combat and session.combat[id]
            local enemy = enemies and enemies[id]
            local attack = (combat and combat.attack) or (enemy and enemy.windup)
            if attack then
                actor.attackPoseUntil = self.presentationTime + 0.17
                actor.attackPoseAction = attack.action or 'Punch'
            end
            local attacking = actor.attackPoseUntil and self.presentationTime &lt; actor.attackPoseUntil
            local reacting = (combat and combat.reactionEnd ~= nil) or (enemy and enemy.reactionUntil ~= nil)
            for name, motor in pairs(actor.poseMotors) do
                local shoulder = string.find(name, "Shoulder", 1, true) ~= nil
                local left = string.find(name, "Left", 1, true) ~= nil
                local angle = stride * (left and 1 or -1) * (shoulder and -1 or 1)
                local roll = 0
                if shoulder and reacting then
                    angle, roll = 0.65, left and -0.25 or 0.25
                elseif shoulder and attacking then
                    angle = actor.attackPoseAction == "Dash" and 1.5 or (left and 0.45 or 1.95)
                end
                motor.joint.C0 = motor.joint.C0:Lerp(motor.base * CFrame.Angles(angle, 0, roll), blend)
            end
        end
    end
end

function World:clearActors()
    self._base.clearActors(self)
    self.enemyKinds = {}
    self.origins = {
        [1] = Vector3.new(-65, 3, -7),
        [2] = Vector3.new(-65, 3, 0),
        [3] = Vector3.new(-65, 3, 7),
    }
    self:stage("Approach")
end

return World
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT13">
          <Properties>
            <string name="Name">LevelDirector</string>
            <ProtectedString name="Source">-- Original prototype encounters. All decisions run on the server.
-- Enemy arithmetic/timing are provisional; hero damage/shields use the tested Session.
local Director={}
Director.__index=Director
local function finite(n) return type(n)=='number' and n==n and n&gt;-math.huge and n&lt;math.huge end
local function distance(a,b)
    if not a or not b then return math.huge end
    return math.sqrt((a.x-b.x)^2+(a.y-b.y)^2+(a.z-b.z)^2)
end
local function towards(a,b,amount)
    local d=distance(a,b)
    if d==0 then return table.clone(a) end
    local t=math.min(1,amount/d)
    return {x=a.x+(b.x-a.x)*t,y=a.y+(b.y-a.y)*t,z=a.z+(b.z-a.z)*t}
end
local objectives={Approach='Разбейте дозор у старых ворот',Courtyard='Освободите внутренний двор',
    Boss='Отбейте ударом три снаряда обратно в стража',Exit='Путь открыт — доберитесь до светящихся ворот',
    Won='Тракт пройден',Lost='Команда выбыла'}

function Director.new(session,world,Combat,config)
    local profile=config.Attacks[config.Enemy.attack]
    local self=setmetatable({session=session,world=world,config=config,enemies={},projectiles={},byUserId={},ownerNames={},
        stage='Approach',now=session.now or 0,bossHits=0,serial=0,
        strikeProfile={reach=config.Enemy.range+1,width=profile.width,height=profile.height}},Director)
    self:_wave('Approach',{{id=-1,x=-24,z=-6},{id=-2,x=-18,z=7}})
    return self
end
function Director:_wave(stage,roster)
    self.stage=stage; self.world:stage(stage)
    for _,r in ipairs(roster) do
        assert(self.world:spawnEnemy(r.id,'Drone',{x=r.x,y=3,z=r.z}),'Enemy spawn failed')
        local actorId=self.session.state.runId..':enemy:'..self.session.state.levelEpoch..':'..r.id
        self.enemies[r.id]={health=self.config.Enemy.hearts,nextAttack=self.now,engaged=false,
            actorId=actorId,name='Ржавый дозорный'}
        self.world:enemyIdentity(r.id,actorId)
        self.world:enemyHealth(r.id,self.config.Enemy.hearts,self.config.Enemy.hearts)
    end
end
function Director:claim(userId,enemyId)
    local owned=self.byUserId[userId]
    if owned then
        if self.enemies[owned].dead then return 'ENEMY_LIFE_SPENT' end
        if owned==enemyId then return 'OK' end
        return 'ENEMY_ALREADY_OWNED'
    end
    if self.result or self.session.state.status~='Active' then return 'RUN_CLOSED' end
    local e=self.enemies[enemyId]
    if not e then return 'UNKNOWN_ENEMY' end
    if not e.dead and self.world:hazard(enemyId) then self:_kill(enemyId) end
    if e.dead then return 'ENEMY_DEAD' end
    if e.ownerUserId then return 'ENEMY_OCCUPIED' end
    if e.engaged then return 'ENEMY_ENGAGED' end
    e.ownerUserId=userId; e.connected=true; e.connectionEpoch=1; e.lastSeq=0
    self.byUserId[userId]=enemyId
    self.world:move(enemyId,0,0)
    self.world:enemyIdentity(enemyId,e.actorId,self.ownerNames[userId])
    return 'OK'
end
function Director:connection(userId,connected)
    local id=self.byUserId[userId]; local e=id and self.enemies[id]
    if not e then return 'UNKNOWN_ENEMY' end
    if type(connected)~='boolean' then return 'INVALID_CONNECTION' end
    if e.connected==connected then return 'NO_CHANGE' end
    e.connected=connected; e.connectionEpoch+=1; e.lastSeq=0; e.lastMove=nil
    self.world:move(id,0,0)
    return 'OK'
end
function Director:controlled(userId)
    local id=self.byUserId[userId]; local e=id and self.enemies[id]
    if not e then return nil end
    return {enemyId=id,actorId=e.actorId,attempt=1,connectionEpoch=e.connectionEpoch,
        connected=e.connected,status=e.dead and 'Dead' or 'Alive',hearts=e.health,
        maxHearts=self.config.Enemy.hearts,template='Sentry',name=e.name}
end
function Director:available(userId)
    local offers={}
    if self.byUserId[userId] or self.result or self.session.state.status~='Active' then return offers end
    for id,e in pairs(self.enemies) do
        if not e.dead and not e.engaged and not e.ownerUserId and not self.world:hazard(id) then
            offers[#offers+1]={enemyId=id,actorId=e.actorId,name=e.name,hearts=e.health,maxHearts=self.config.Enemy.hearts}
        end
    end
    table.sort(offers,function(a,b) return a.enemyId&gt;b.enemyId end)
    return offers
end
function Director:closeTargetForAttack(targetIds)
    for _,id in ipairs(targetIds) do
        local e=self.enemies[id]
        if e and not e.dead and not (e.reactionUntil and self.now&lt;e.reactionUntil) then e.engaged=true; return end
        local h=self.session.state.heroes[id]
        local c=self.session.combat[id]
        if h and h.status=='Alive' and not c.deathAt and not c.reactionEnd then return end
        local ball=self.projectiles[id]
        if (ball and not ball.reflected) or (id==-99 and self.stage=='Boss') then return end
    end
end
function Director:command(userId,payload,now,validator)
    local id=self.byUserId[userId]; local e=id and self.enemies[id]
    if not e then return 'UNKNOWN_ENEMY' end
    if type(validator)~='function' or not validator(payload) then return 'INVALID_INTENT' end
    if payload.kind~='Move' and payload.kind~='Jump' and payload.kind~='Attack' then return 'INVALID_INTENT' end
    if payload.kind=='Attack' and payload.attack~='Punch' then return 'INVALID_INTENT' end
    if payload.runId~=self.session.state.runId then return 'WRONG_RUN' end
    if self.result or self.session.state.status~='Active' then return 'RUN_CLOSED' end
    if not e.connected then return 'OFFLINE' end
    if e.dead then return 'NOT_ALIVE' end
    if payload.actorId~=e.actorId or payload.attempt~=1 or payload.levelEpoch~=self.session.state.levelEpoch then return 'STALE_ACTOR' end
    if payload.connectionEpoch~=e.connectionEpoch then return 'STALE_CONNECTION' end
    if payload.seq&lt;=e.lastSeq then return 'STALE_SEQUENCE' end
    if not finite(now) or now&lt;0 then return 'INVALID_TIME' end
    if now&lt;self.now then return 'TIME_REVERSED' end
    self.now=now; e.lastSeq=payload.seq
    if e.reactionUntil then return 'REACTION' end
    if payload.kind=='Move' then
        e.lastMove=now; self.world:move(id,payload.x,payload.z)
    elseif payload.kind=='Jump' then self.world:jump(id)
    else
        if e.windup or now&lt;e.nextAttack then return 'COOLDOWN' end
        self:_beginStrike(id,e)
    end
    return 'OK'
end
function Director:_beginStrike(id,e)
    e.engaged=true; e.windup={at=self.now+self.config.Enemy.windup}
    self.world:move(id,0,0); self.world:cue(id,true)
end
function Director:_resolveStrike(id,e)
    e.windup=nil; e.nextAttack=self.now+self.config.Enemy.cooldown
    for _,target in ipairs(self.world:targets(id,self.strikeProfile)) do
        local hit=false
        if self.enemies[target] then hit=self:hit(id,target,self.config.Enemy.attack)
        elseif self.session.state.heroes[target] then hit=self.session:_hit(id,target,self.config.Enemy.attack) end
        if hit then break end
    end
end
function Director:_boss()
    self.stage='Boss'; self.world:stage('Boss')
    assert(self.world:spawnEnemy(-99,'Boss',{x=82,y=3,z=0}),'Boss spawn failed')
    self.world:enemyHealth(-99,self.config.Boss.hits,self.config.Boss.hits)
    self.nextShot=self.now+1.8
end
function Director:isTarget(id)
    return self.enemies[id]~=nil or self.projectiles[id]~=nil or id==-99
end
function Director:_kill(id)
    local e=self.enemies[id]
    if not e or e.dead then return end
    e.dead=true; e.windup=nil; e.health=0
    self.world:enemyHealth(id,0,self.config.Enemy.hearts)
    self.world:kill(id)
end
function Director:hit(attacker,target,action)
    if self.result then return false end
    local ball=self.projectiles[target]
    if ball then
        if ball.reflected then return false end
        ball.reflected=true
        ball.reflectedAt=self.now
        self.world:projectile(target,ball.position,true)
        self.world:cue(attacker,false)
        return true
    end
    if target==-99 and self.stage=='Boss' then self.world:cue(-99,true); return true end
    local e=self.enemies[target]
    if not e or e.dead or (e.reactionUntil and self.now&lt;e.reactionUntil) then return false end
    e.engaged=true; e.windup=nil
    e.health=math.max(0,e.health-(action=='Dash' and self.config.Enemy.dashDamage or self.config.Enemy.punchDamage))
    self.world:enemyHealth(target,e.health,self.config.Enemy.hearts)
    self.world:cue(target,false)
    if e.health==0 then self:_kill(target)
    else
        e.reactionUntil=self.now+self.config.Enemy.reaction
        self.world:move(target,0,0); self.world:setReaction(target,true)
        local profile=action=='Dash' and 22 or 18
        if self.config.Impulses then self.world:impulse(target,attacker,self.config.Impulses[profile],profile) end
    end
    return true
end
function Director:_nearest(position)
    local selected,best=nil,math.huge
    for _,id in ipairs(self.session.order) do
        local h=self.session.state.heroes[id]
        if h.status=='Alive' and not self.session.combat[id].deathAt then
            local d=distance(position,self.world:position(id))
            if d&lt;best then selected,best=id,d end
        end
    end
    return selected,best
end
function Director:_enemies()
    local living=0
    for id,e in pairs(self.enemies) do
        if not e.dead then
            if self.world:hazard(id) then self:_kill(id)
            else
                living+=1
                if e.reactionUntil and self.now&gt;=e.reactionUntil then
                    e.reactionUntil=nil; self.world:setReaction(id,false)
                end
                if not e.reactionUntil then
                    if e.windup then
                        self.world:move(id,0,0)
                        if self.now&gt;=e.windup.at then self:_resolveStrike(id,e) end
                    elseif e.ownerUserId then
                        if e.lastMove and self.now-e.lastMove&gt;=(self.config.MoveTimeout or .35) then
                            e.lastMove=nil; self.world:move(id,0,0)
                        end
                    else
                        local target,range=self:_nearest(self.world:position(id))
                        if target and range&lt;=self.config.Enemy.range and self.now&gt;=e.nextAttack then
                            self.world:face(id,target); self:_beginStrike(id,e)
                        elseif target and range&gt;self.config.Enemy.range*.8 then
                            self.world:enemyMove(id,target,self.config.Enemy.speed)
                        else self.world:move(id,0,0) end
                    end
                end
            end
        end
    end
    if living==0 then
        if self.stage=='Approach' then self:_wave('Courtyard',{{id=-3,x=22,z=-7},{id=-4,x=30,z=6}})
        elseif self.stage=='Courtyard' then self:_boss() end
    end
end
function Director:_projectiles(dt)
    if self.stage=='Boss' and self.now&gt;=self.nextShot then
        local target,range=self:_nearest(self.world:position(-99))
        if target and range&lt;=self.config.Boss.aggroRange then
            self.world:face(-99,target); self.world:cue(-99,true)
            local origin=self.world:position(-99)
            local destination=self.world:position(target)
            self.serial+=1
            local id=-1000-self.serial
            local start=towards(origin,destination,5)
            self.projectiles[id]={position=start,direction=destination,created=self.now,target=target,reflected=false}
            self.world:projectile(id,start,false)
        end
        self.nextShot=self.now+self.config.Boss.interval
    end
    local remove={}
    for id,p in pairs(self.projectiles) do
        local destination=p.reflected and self.world:position(-99) or p.direction
        if not destination or self.now-(p.reflectedAt or p.created)&gt;self.config.Boss.projectileLife then remove[#remove+1]=id
        else
            local speed=p.reflected and self.config.Boss.returnSpeed or self.config.Boss.projectileSpeed
            p.position=towards(p.position,destination,speed*dt)
            self.world:projectile(id,p.position,p.reflected)
            if p.reflected and self.stage=='Boss' and distance(p.position,destination)&lt;2.5 then
                self.bossHits+=1; self.world:cue(-99,false)
                self.world:enemyHealth(-99,self.config.Boss.hits-self.bossHits,self.config.Boss.hits)
                remove[#remove+1]=id
                if self.bossHits&gt;=self.config.Boss.hits then
                    self.world:kill(-99); self.stage='Exit'; self.world:stage('Exit')
                end
            elseif not p.reflected then
                local hit=false
                for _,hero in ipairs(self.session.order) do
                    if self.session.state.heroes[hero].status=='Alive' and distance(p.position,self.world:position(hero))&lt;2.3 then
                        self.session:_hit(-99,hero,'Dash'); hit=true; break
                    end
                end
                if hit or distance(p.position,destination)&lt;.1 then remove[#remove+1]=id end
            end
        end
    end
    for _,id in ipairs(remove) do self.projectiles[id]=nil; self.world:removeProjectile(id) end
    if self.stage=='Exit' then
        for id in pairs(self.projectiles) do self.world:removeProjectile(id) end
        self.projectiles={}
    end
end
function Director:step(now,dt)
    if self.result then return end
    self.now=now
    if self.session.state.status=='Lost' then
        self.result='Lost'; self.stage='Lost'; self.world:stage('Lost'); return
    end
    if self.stage=='Approach' or self.stage=='Courtyard' then self:_enemies() end
    if self.stage=='Boss' or next(self.projectiles) then self:_projectiles(math.min(math.max(dt or 0,0),.1)) end
    if self.stage=='Exit' then
        for _,id in ipairs(self.session.order) do
            if self.session.state.heroes[id].status=='Alive' and not self.session.combat[id].deathAt and self.world:atExit(id) then
                self.result='Won'; self.stage='Won'; self.world:stage('Won'); break
            end
        end
    end
end
function Director:snapshot()
    local enemies={}
    for id,e in pairs(self.enemies) do
        enemies[#enemies+1]={id=id,hearts=e.health,maxHearts=self.config.Enemy.hearts,dead=e.dead==true,attacking=e.windup~=nil}
    end
    table.sort(enemies,function(a,b) return a.id&gt;b.id end)
    return {stage=self.stage,objective=objectives[self.stage],enemies=enemies,bossHits=self.bossHits,
        bossMax=self.config.Boss.hits,result=self.result}
end
return Director
</ProtectedString>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="BT14">
        <Properties>
          <string name="Name">CombatRuntime</string>
        </Properties>
        <Item class="ModuleScript" referent="BT15">
          <Properties>
            <string name="Name">Combat</string>
            <ProtectedString name="Source">-- Source arithmetic is independent from the stand's physical and UI calibration.
local Combat = {}
local function life(value)
    assert(type(value) == "number" and value == value and value &gt;= 0
        and value &lt;= 47 and value % 1 == 0, "raw Life must be an integer in 0..47")
end

function Combat.damage(old, damage)
    life(old)
    assert(damage == 4 or damage == 16 or damage == 255, "unsupported hero damage profile")
    if old &lt; damage then return 0, true end
    local result = old - damage
    if math.floor(result / 16) ~= math.floor(old / 16) then
        result = math.floor(result / 16) * 16 + 15
    end
    return result, false
end

function Combat.hit(old, action, shield)
    life(old)
    assert(action == "Punch" or action == "Dash", "unsupported action")
    assert(shield == nil or shield == "Normal" or shield == "Emergency", "unsupported shield")
    local profile = action == "Punch" and 18 or (old &lt; 16 and 21 or 22)
    local damage = profile == 18 and 4 or (profile == 21 and 255 or 16)
    local raw, dying = Combat.damage(old, damage)
    if shield then raw, dying = old, false end
    return {
        rawLife=raw, dying=dying, profile=profile, rawDamage=damage,
        impulse=shield ~= "Emergency", blocked=shield ~= nil,
        recover=action == "Punch" and not dying and shield == nil,
    }
end

function Combat.recover(raw)
    life(raw)
    return math.floor(raw / 8) * 8 + 7
end

function Combat.hearts(raw)
    life(raw)
    return 5 * raw / 47
end

return Combat
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT16">
          <Properties>
            <string name="Name">Session</string>
            <ProtectedString name="Source">-- Synchronous coordinator: World methods must not yield or partially commit a failed spawn.
local Session = {}
Session.__index = Session
local common = {kind=true,runId=true,actorId=true,attempt=true,levelEpoch=true,connectionEpoch=true,seq=true}
local extras = {Attack={attack=true},Move={x=true,z=true},Jump={}}
local function finite(n) return type(n)=="number" and n==n and n&gt;-math.huge and n&lt;math.huge end
local function integer(n) return finite(n) and n&gt;=1 and n&lt;=1000000000 and n%1==0 end
local function valid(p)
    if type(p)~="table" or not extras[p.kind] then return false end
    local count=0
    for k,v in pairs(p) do
        count=count+1
        if count&gt;9 or not (common[k] or extras[p.kind][k]) or type(v)=="table" then return false end
    end
    if type(p.runId)~="string" or #p.runId&gt;160 or type(p.actorId)~="string" or #p.actorId&gt;160
        or not integer(p.attempt) or not integer(p.levelEpoch) or not integer(p.connectionEpoch)
        or not integer(p.seq) then return false end
    if p.kind=="Attack" then return p.attack=="Punch" or p.attack=="Dash" end
    if p.kind=="Move" then return finite(p.x) and finite(p.z) and p.x*p.x+p.z*p.z&lt;=1.01 end
    return true
end

-- The ordinary-enemy controller uses the same untrusted intent schema.
Session.validIntent=valid

function Session.new(Core, Combat, Config, roster, runId, world, logger)
    local self=setmetatable({Core=Core,Combat=Combat,config=Config,world=world,logger=logger,
        state=Core.new(runId,"combat-stand",roster,"stand-1"),now=0,serial=0,
        order={},combat={},lastSeq={},nextSpawn={},lastMove={},buckets={},logs={}},Session)
    for _,member in ipairs(roster) do
        local uid=member.userId
        self.order[#self.order+1]=uid
        self.combat[uid]={rawLife=47,nextAttack=0}
    end
    return self
end

function Session:_clock(now)
    if not finite(now) or now&lt;0 then return "INVALID_TIME" end
    if now&lt;self.now then return "TIME_REVERSED" end
    self.now=now
    return "OK"
end

function Session:_record(kind, uid, data)
    local h=self.state.heroes[uid]
    local row={kind=kind,userId=uid,now=self.now,runId=self.state.runId,revision=self.state.revision,
        actorId=h and h.actorId,attempt=h and h.attempt,respawns=h and h.respawns,
        rawLife=self.combat[uid] and self.combat[uid].rawLife,data=data}
    self.logs[#self.logs+1]=row
    if #self.logs&gt;self.config.MaxLogEntries then table.remove(self.logs,1) end
    if self.logger then self.logger(row) end
end

function Session:_event(kind, uid, fields)
    self.serial=self.serial+1
    local h=self.state.heroes[uid]
    local e={id="s-"..self.serial,runId=self.state.runId,expectedRevision=self.state.revision,
        now=self.now,kind=kind,userId=uid}
    if kind=="Death" or kind=="SetHealth" or kind=="BeginAttack" or kind=="ExpireShield"
        or kind=="RelocateToSafety" then
        e.actorId=h.actorId; e.attempt=h.attempt; e.levelEpoch=self.state.levelEpoch
    end
    for k,v in pairs(fields or {}) do e[k]=v end
    local state,code,ack=self.Core.apply(self.state,e)
    self.state=state
    self:_record(kind,uid,{code=code,eventId=e.id})
    return code,ack
end

function Session:_spawn(uid)
    local h=self.state.heroes[uid]
    if not h.connected or self.now&lt;(self.nextSpawn[uid] or 0) then return end
    local point=self.world:findSafe(uid)
    if not point and h.status=="AwaitingInitial" then
        self.nextSpawn[uid]=self.now+self.config.SpawnRetry
        return
    end
    local code=self:_event("ReserveSpawn",uid,{connectionEpoch=h.connectionEpoch})
    if code~="OK" then return end
    local token=self.state.heroes[uid].pending.token
    self.serial=self.serial+1
    local actorId=self.state.runId..":actor:"..self.serial
    local safe=point~=nil
    local ok,spawned=pcall(function()
        if safe and not self.world:isSafe(point,uid) then return false end
        return self.world:spawn(uid,actorId,point,not safe,h.template)
    end)
    if not ok or not spawned then
        self:_event("AbortSpawn",uid,{token=token})
        self.nextSpawn[uid]=self.now+self.config.SpawnRetry
        self:_record("SpawnFailed",uid,{error=ok and "rejected" or tostring(spawned)})
        return
    end
    code=self:_event("CommitSpawn",uid,{token=token,actorId=actorId,safe=safe})
    assert(code=="OK","Synchronous spawn commit violated its reservation: "..code)
    self.combat[uid]={rawLife=47,nextAttack=self.now}
    self.lastSeq[uid]=0; self.lastMove[uid]=nil; self.nextSpawn[uid]=nil
    self.world:hold(uid,not safe)
end

function Session:_die(uid, reason)
    local h=self.state.heroes[uid]
    if h.status~="Alive" then return end
    if self:_event("Death",uid)~="OK" then return end
    self.combat[uid]={rawLife=0,nextAttack=self.now}
    self.lastMove[uid]=nil
    self.world:kill(uid)
    self:_record("ConfirmedDeath",uid,{reason=reason})
end

function Session:connection(uid, connected, now)
    if not self.state.heroes[uid] then return "UNKNOWN_HERO" end
    local code=self:_clock(now); if code~="OK" then return code end
    if type(connected)~="boolean" then return "INVALID_CONNECTION" end
    local h=self.state.heroes[uid]
    code=self:_event("Connection",uid,{connectionEpoch=h.connectionEpoch,connected=connected})
    if code=="OK" then
        self.lastSeq[uid]=0; self.buckets[uid]=nil; self.lastMove[uid]=nil
        self.world:move(uid,0,0)
    end
    return code
end

function Session:intent(uid, p, now)
    local h=self.state.heroes[uid]
    if not h then return "UNKNOWN_HERO" end
    if not valid(p) then return "INVALID_INTENT" end
    if p.runId~=self.state.runId then return "WRONG_RUN" end
    if self.state.status~="Active" then return "RUN_CLOSED" end
    if not h.connected then return "OFFLINE" end
    if h.status~="Alive" then return "NOT_ALIVE" end
    if p.actorId~=h.actorId or p.attempt~=h.attempt or p.levelEpoch~=self.state.levelEpoch then return "STALE_ACTOR" end
    if p.connectionEpoch~=h.connectionEpoch then return "STALE_CONNECTION" end
    if p.seq&lt;=(self.lastSeq[uid] or 0) then return "STALE_SEQUENCE" end
    local code=self:_clock(now); if code~="OK" then return code end
    local b=self.buckets[uid] or {tokens=self.config.MaxIntentRate,last=now}
    b.tokens=math.min(self.config.MaxIntentRate,b.tokens+(now-b.last)*self.config.MaxIntentRate)
    b.last=now; self.buckets[uid]=b
    self.lastSeq[uid]=p.seq
    if b.tokens&lt;1 then return "RATE_LIMIT" end
    b.tokens=b.tokens-1
    local c=self.combat[uid]
    if c.reactionEnd or c.deathAt then return "REACTION" end
    if p.kind=="Move" then
        self.lastMove[uid]=now
        self.world:move(uid,p.x,p.z)
    elseif p.kind=="Jump" then
        self.world:jump(uid)
    else
        if now&lt;c.nextAttack or c.attack then return "COOLDOWN" end
        code=self:_event("BeginAttack",uid,{connectionEpoch=h.connectionEpoch})
        if code~="OK" then return code end
        self.world:hold(uid,false)
        local cfg=self.config.Attacks[p.attack]
        c.nextAttack=now+cfg.cooldown
        c.attack={action=p.attack,actorId=h.actorId,at=now+cfg.windup,
            untilTime=now+cfg.windup+cfg.window,order=self.serial}
        self:_record("AttackAccepted",uid,{action=p.attack,seq=p.seq})
    end
    return "OK"
end

function Session:_hit(attacker, target, action)
    local h=self.state.heroes[target]
    local c=self.combat[target]
    if not h or target==attacker or h.status~="Alive" or c.reactionEnd or c.deathAt then return false end
    local shield=h.shield and self.now&lt;h.shield.deadline and h.shield.kind or nil
    local before=c.rawLife
    local result=self.Combat.hit(before,action,shield)
    local cfg=self.config.Attacks[action]
    if not result.blocked then
        local code=self:_event("SetHealth",target,{health=self.Combat.hearts(result.rawLife)})
        if code~="OK" then return false end
        c.rawLife=result.rawLife
    end
    if result.impulse then
        c.attack=nil
        c.recover=result.recover
        c.reactionEnd=self.now+cfg.reaction
        c.deathAt=result.dying and self.now+self.config.DeathDelay or nil
        self.world:move(target,0,0)
        self.world:setReaction(target,true)
        self.world:impulse(target,attacker,self.config.Impulses[result.profile],result.profile)
    end
    self:_record("Hit",target,{attacker=attacker,action=action,profile=result.profile,
        before=before,after=c.rawLife,blocked=result.blocked,impulse=result.impulse,
        dying=result.dying,observed=self.world:observe(target)})
    return true
end

function Session:step(now)
    local code=self:_clock(now); if code~="OK" then return code end
    if self.state.status~="Active" then return "RUN_CLOSED" end
    -- Previous-frame deaths spawn here; a new death cannot respawn twice in this step.
    for _,uid in ipairs(self.order) do
        local h=self.state.heroes[uid]
        if h.status=="AwaitingInitial" or h.status=="AwaitingRespawn" then self:_spawn(uid) end
    end
    for _,uid in ipairs(self.order) do
        local h=self.state.heroes[uid]
        if h.status=="Alive" and h.shield then
            if h.shield.kind=="Emergency" then
                local point=self.world:findSafe(uid)
                if point and self.world:isSafe(point,uid) and self.world:relocate(uid,point) then
                    assert(self:_event("RelocateToSafety",uid,{safe=true})=="OK")
                    self.world:hold(uid,false)
                end
            end
            h=self.state.heroes[uid]
            if h.shield and now&gt;=h.shield.deadline then
                assert(self:_event("ExpireShield",uid)=="OK")
                self.world:hold(uid,false)
                if self.state.heroes[uid].retryReady then self:_spawn(uid) end
            end
        elseif h.status=="Alive" and h.retryReady then
            self:_spawn(uid)
        end
        local c=self.combat[uid]
        if self.state.heroes[uid].status=="Alive" then
            if c.deathAt and now&gt;=c.deathAt then
                self:_die(uid,"CombatUnderflow")
            elseif c.reactionEnd and not c.deathAt and now&gt;=c.reactionEnd then
                if c.recover then
                    c.rawLife=self.Combat.recover(c.rawLife)
                    assert(self:_event("SetHealth",uid,{health=self.Combat.hearts(c.rawLife)})=="OK")
                end
                c.reactionEnd=nil; c.recover=nil
                self.world:setReaction(uid,false)
            end
        end
    end
    local due={}
    for _,uid in ipairs(self.order) do
        local a=self.combat[uid].attack
        if a and now&gt;=a.at then due[#due+1]={uid=uid,attack=a} end
    end
    table.sort(due,function(a,b)
        if a.attack.at~=b.attack.at then return a.attack.at&lt;b.attack.at end
        return a.attack.order&lt;b.attack.order
    end)
    for _,entry in ipairs(due) do
        local uid,a=entry.uid,entry.attack
        local h=self.state.heroes[uid]
        if self.combat[uid].attack==a then
            self.combat[uid].attack=nil
            if h.status=="Alive" and h.actorId==a.actorId and now&lt;=a.untilTime then
                for _,target in ipairs(self.world:targets(uid,self.config.Attacks[a.action])) do
                    if self:_hit(uid,target,a.action) then break end
                end
            else self:_record("AttackExpired",uid,{action=a.action}) end
        end
    end
    for _,uid in ipairs(self.order) do
        local h=self.state.heroes[uid]
        if h.status=="Alive" then
            if self.lastMove[uid] and now-self.lastMove[uid]&gt;=self.config.MoveTimeout then
                self.world:move(uid,0,0); self.lastMove[uid]=nil
            end
            local reason=self.world:hazard(uid)
            local held=h.shield and h.shield.kind=="Emergency" and now&lt;h.shield.deadline
            if reason and (not held or reason=="ActorMissing") then self:_die(uid,reason) end
        end
    end
    return "OK"
end

function Session:snapshot()
    local heroes={}
    for _,uid in ipairs(self.order) do
        local h=self.state.heroes[uid]
        local c=self.combat[uid]
        heroes[#heroes+1]={slot=uid,actorId=h.actorId,attempt=h.attempt,
            connectionEpoch=h.connectionEpoch,connected=h.connected,status=h.status,view=h.view,
            hearts=self.Combat.hearts(c.rawLife),rawLife=c.rawLife,respawns=h.respawns,
            shield=h.shield and h.shield.kind,shieldUntil=h.shield and h.shield.deadline,
            dying=c.deathAt~=nil}
    end
    return {runId=self.state.runId,levelEpoch=self.state.levelEpoch,status=self.state.status,
        now=self.now,heroes=heroes,calibration=self.config.Calibration}
end

return Session
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT17">
          <Properties>
            <string name="Name">Config</string>
            <ProtectedString name="Source">-- All spatial/timing values below are stand calibration, not measured NES units.
return {
    Calibration = "EXPERIMENTAL_STAND_ONLY",
    WalkSpeed = 16,
    JumpPower = 42,
    MoveTimeout = 0.35,
    SpawnRetry = 0.5,
    DeathDelay = 0.8,
    FallY = -35,
    MaxIntentRate = 40,
    SnapshotInterval = 0.1,
    MaxLogEntries = 256,
    Impulses = {
        [18] = {horizontal=9, vertical=0},
        [21] = {horizontal=34, vertical=27},
        [22] = {horizontal=32, vertical=18},
    },
    Attacks = {
        Punch = {windup=0.10, window=0.12, cooldown=0.55, reaction=28/60,
            reach=6, width=3, height=4},
        Dash = {windup=0.18, window=0.14, cooldown=1.0, reaction=0.75,
            reach=8, width=3, height=4},
    },
}
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT18">
          <Properties>
            <string name="Name">ConnectionRegistry</string>
            <ProtectedString name="Source">-- Authority belongs to the current Player object, not merely its UserId.
local Registry = {}
Registry.__index = Registry

function Registry.new()
    return setmetatable({
        -- Tombstones prevent repeated add/remove events reviving an old object.
        -- Values contain no Player reference; departed objects can be collected.
        _seen = setmetatable({}, {__mode = "k"}),
        _current = {},
        _serial = 0,
    }, Registry)
end

function Registry:join(player)
    if self._seen[player] then return false, nil end
    local userId = player.UserId
    assert(userId ~= nil, "Connection requires Player.UserId")
    local previous = self._current[userId]
    if previous then self._seen[previous].active = false end
    self._serial = self._serial + 1
    self._seen[player] = {userId = userId, arrival = self._serial, active = true}
    self._current[userId] = player
    return true, previous
end

function Registry:isCurrent(player)
    local entry = self._seen[player]
    return entry ~= nil and entry.active and rawequal(self._current[entry.userId], player)
end

function Registry:remove(player)
    if not self:isCurrent(player) then return false end
    local entry = self._seen[player]
    entry.active = false
    self._current[entry.userId] = nil
    return true
end

function Registry:online(players)
    local result, included = {}, {}
    for _, player in ipairs(players) do
        if self:isCurrent(player) and not included[player] then
            included[player] = true
            result[#result + 1] = player
        end
    end
    table.sort(result, function(a, b)
        return self._seen[a].arrival &lt; self._seen[b].arrival
    end)
    return result
end

return Registry
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT19">
          <Properties>
            <string name="Name">RobloxWorld</string>
            <ProtectedString name="Source">-- Original stand geometry and server-owned physical bodies. No ROM assets or client positions.
local World = {}
World.__index = World
local Workspace = game:GetService("Workspace")
local function part(parent, name, size, frame, color, anchored)
    local p=Instance.new("Part")
    p.Name=name; p.Size=size; p.CFrame=frame; p.Anchored=anchored
    p.Color=color; p.Material=Enum.Material.SmoothPlastic
    p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
    p.Parent=parent
    return p
end
local function joint(parent, name, a, b, c0, c1)
    local m=Instance.new("Motor6D")
    m.Name=name; m.Part0=a; m.Part1=b; m.C0=c0; m.C1=c1; m.Parent=parent
end
local function own(root)
    if not root.Anchored then
        local allowed,reason=root:CanSetNetworkOwnership()
        assert(allowed,reason or "Cannot assign server ownership")
        root:SetNetworkOwner(nil)
    end
end
local function body(actorId, position, color, displayName)
    local model=Instance.new("Model"); model.Name="Actor_"..actorId
    local root=part(model,"HumanoidRootPart",Vector3.new(2,2,1),CFrame.new(),color,true)
    root.Transparency=1; root.CanCollide=false; root.RootPriority=127
    local torso=part(model,"Torso",Vector3.new(2,2,1),CFrame.new(),color,false)
    local head=part(model,"Head",Vector3.new(2,1,1),CFrame.new(0,1.5,0),color,false)
    local la=part(model,"Left Arm",Vector3.new(1,2,1),CFrame.new(-1.5,0,0),color,false)
    local ra=part(model,"Right Arm",Vector3.new(1,2,1),CFrame.new(1.5,0,0),color,false)
    local ll=part(model,"Left Leg",Vector3.new(1,2,1),CFrame.new(-0.5,-2,0),color,false)
    local rl=part(model,"Right Leg",Vector3.new(1,2,1),CFrame.new(0.5,-2,0),color,false)
    for _,limb in ipairs({la,ra,ll,rl}) do limb.CanCollide=false end
    joint(root,"RootJoint",root,torso,CFrame.new(),CFrame.new())
    joint(torso,"Neck",torso,head,CFrame.new(0,1,0),CFrame.new(0,-0.5,0))
    joint(torso,"Left Shoulder",torso,la,CFrame.new(-1,0.5,0),CFrame.new(0.5,0.5,0))
    joint(torso,"Right Shoulder",torso,ra,CFrame.new(1,0.5,0),CFrame.new(-0.5,0.5,0))
    joint(torso,"Left Hip",torso,ll,CFrame.new(-0.5,-1,0),CFrame.new(0,1,0))
    joint(torso,"Right Hip",torso,rl,CFrame.new(0.5,-1,0),CFrame.new(0,1,0))
    for _,x in ipairs({-0.55,0.55}) do
        local eye=part(model,"Eye",Vector3.new(0.35,0.35,0.25),CFrame.new(x,1.75,-0.58),Color3.new(1,1,0.8),false)
        eye.CanCollide=false; eye.Massless=true
        local weld=Instance.new("WeldConstraint"); weld.Part0=head; weld.Part1=eye; weld.Parent=eye
    end
    local humanoid=Instance.new("Humanoid")
    humanoid.Name="Humanoid"; humanoid.DisplayName=displayName
    humanoid.BreakJointsOnDeath=false; humanoid.MaxHealth=100; humanoid.Health=100
    humanoid.HealthDisplayType=Enum.HumanoidHealthDisplayType.AlwaysOff
    humanoid.HipHeight=0; humanoid.UseJumpPower=true; humanoid.Parent=model
    model.PrimaryPart=root
    model:PivotTo(CFrame.lookAt(position,position+Vector3.new(1,0,0)))
    model:SetAttribute("ActorId",actorId)
    return {model=model,root=root,humanoid=humanoid,cue=0}
end

function World.new(config)
    local folder=Instance.new("Folder"); folder.Name="CombatStandWorld"; folder.Parent=Workspace
    local geometry=Instance.new("Folder"); geometry.Name="Geometry"; geometry.Parent=folder
    local actors=Instance.new("Folder"); actors.Name="Actors"; actors.Parent=folder
    local self=setmetatable({config=config,folder=folder,geometry=geometry,actorFolder=actors,
        actors={},origins={},lastSupport={},deathReason={},names={},floors={},blocked=false},World)
    local floor=part(geometry,"MainPlatform",Vector3.new(72,2,36),CFrame.new(0,-1,0),Color3.fromRGB(64,83,99),true)
    floor:SetAttribute("SurfaceId","Main"); self.floors[#self.floors+1]=floor
    local island=part(geometry,"Island",Vector3.new(16,2,16),CFrame.new(56,-1,0),Color3.fromRGB(73,98,112),true)
    island:SetAttribute("SurfaceId","Island"); self.floors[#self.floors+1]=island
    part(geometry,"PhysicalWall",Vector3.new(2,7,36),CFrame.new(-35,3.5,0),Color3.fromRGB(114,128,140),true)
    self.danger=part(geometry,"DangerSurface",Vector3.new(10,0.2,6),CFrame.new(-8,0.1,12),Color3.fromRGB(220,85,70),true)
    self.danger:SetAttribute("Hazard",true); self.danger:SetAttribute("SurfaceId","Main")
    local ray=RaycastParams.new(); ray.FilterType=Enum.RaycastFilterType.Include
    ray.FilterDescendantsInstances={geometry}; ray.RespectCanCollide=true; self.ray=ray
    local overlap=OverlapParams.new(); overlap.FilterType=Enum.RaycastFilterType.Include
    overlap.FilterDescendantsInstances={geometry,actors}; overlap.RespectCanCollide=true; self.overlap=overlap
    return self
end

function World:isSafe(point, uid)
    if self.blocked or not point or not point.surface or not point.surface.Parent or not point.surface.CanCollide then return false end
    local p=point.position
    for _,offset in ipairs({Vector3.new(),Vector3.new(-1.9,0,-0.9),Vector3.new(-1.9,0,0.9),
        Vector3.new(1.9,0,-0.9),Vector3.new(1.9,0,0.9)}) do
        local hit=Workspace:Raycast(p+offset+Vector3.new(0,1,0),Vector3.new(0,-6,0),self.ray)
        if not hit or hit.Instance~=point.surface or hit.Normal.Y&lt;0.95 or hit.Instance:GetAttribute("Hazard") then return false end
    end
    local actor=self.actors[uid]
    for _,p2 in ipairs(Workspace:GetPartBoundsInBox(CFrame.new(p),Vector3.new(4.1,5.8,2.1),self.overlap)) do
        if p2.CanCollide and not (actor and p2:IsDescendantOf(actor.model)) then return false end
    end
    return true
end

function World:findSafe(uid)
    if self.blocked then return nil end
    local actor=self.actors[uid]
    local origin=actor and actor.root.Parent and actor.root.Position or self.origins[uid] or Vector3.new(-18+uid*6,3,0)
    local points={}
    for _,floor in ipairs(self.floors) do
        local same=self.deathReason[uid]=="Fall" or not self.lastSupport[uid]
            or floor:GetAttribute("SurfaceId")==self.lastSupport[uid]
        if floor.CanCollide and same then
            local minX,maxX=floor.Position.X-floor.Size.X/2+2.2,floor.Position.X+floor.Size.X/2-2.2
            local minZ,maxZ=floor.Position.Z-floor.Size.Z/2+1.2,floor.Position.Z+floor.Size.Z/2-1.2
            local y=floor.Position.Y+floor.Size.Y/2+3
            local function add(x,z) points[#points+1]={position=Vector3.new(x,y,z),surface=floor} end
            add(math.clamp(origin.X,minX,maxX),math.clamp(origin.Z,minZ,maxZ))
            for x=minX,maxX,4.5 do for z=minZ,maxZ,3 do add(x,z) end end
        end
    end
    table.sort(points,function(a,b)
        local da=(a.position-origin).Magnitude; local db=(b.position-origin).Magnitude
        if da~=db then return da&lt;db end
        if a.position.X~=b.position.X then return a.position.X&lt;b.position.X end
        return a.position.Z&lt;b.position.Z
    end)
    for _,point in ipairs(points) do if self:isSafe(point,uid) then return point end end
    return nil
end

function World:spawn(uid, actorId, point, held, template)
    if point and not self:isSafe(point,uid) then return false end
    local origin=self.origins[uid] or Vector3.new(-18+uid*6,3,0)
    local position=point and point.position or Vector3.new(origin.X,3,origin.Z)
    local colors={["Mr. Green"]=Color3.fromRGB(81,160,88),["Mr. Yellow"]=Color3.fromRGB(201,179,64),["Mr. Brown"]=Color3.fromRGB(144,108,76)}
    local prepared
    local ok,err=pcall(function()
        prepared=body(actorId,position,colors[template],self.names[uid] or ("P"..uid))
        prepared.model:SetAttribute("Slot",uid)
        prepared.humanoid.WalkSpeed=self.config.WalkSpeed; prepared.humanoid.JumpPower=self.config.JumpPower
        prepared.model.Parent=self.actorFolder
        prepared.root.Anchored=held
        own(prepared.root)
    end)
    if not ok then
        if prepared then prepared.model:Destroy() end
        warn("[BT-STAND] physical spawn failed: "..tostring(err))
        return false
    end
    local old=self.actors[uid]
    self.actors[uid]=prepared; self.origins[uid]=position
    if not held then self.deathReason[uid]=nil end
    if old then old.model:Destroy() end
    return true
end

function World:hold(uid, held)
    local a=self.actors[uid]; if not a or not a.root.Parent then return end
    a.root.Anchored=held
    if held then
        a.root.AssemblyLinearVelocity=Vector3.new(); a.root.AssemblyAngularVelocity=Vector3.new()
        a.humanoid:Move(Vector3.new(),false)
    else own(a.root) end
end
function World:move(uid, x, z)
    local a=self.actors[uid]
    if a and a.humanoid.Health&gt;0 and not a.root.Anchored and not a.humanoid.PlatformStand then
        a.humanoid:Move(Vector3.new(x,0,z),false)
    end
end
function World:jump(uid)
    local a=self.actors[uid]
    if a and a.humanoid.Health&gt;0 and not a.root.Anchored and not a.humanoid.PlatformStand
        and a.humanoid.FloorMaterial~=Enum.Material.Air then a.humanoid.Jump=true end
end
function World:setReaction(uid, active)
    local a=self.actors[uid]; if not a then return end
    a.humanoid.PlatformStand=active
    a.humanoid.AutoRotate=not active
    a.humanoid.WalkSpeed=active and 0 or self.config.WalkSpeed
end
function World:targets(uid, cfg)
    local a=self.actors[uid]; if not a then return {} end
    local candidates={}
    for id,b in pairs(self.actors) do
        if id~=uid and b.root.Parent and b.humanoid.Health&gt;0 then
            local localP=a.root.CFrame:PointToObjectSpace(b.root.Position)
            local delta=b.root.Position-a.root.Position
            if -localP.Z&gt;=0 and -localP.Z&lt;=cfg.reach and math.abs(localP.X)&lt;=cfg.width and math.abs(localP.Y)&lt;=cfg.height then
                local blocker=Workspace:Raycast(a.root.Position,delta,self.ray)
                if not blocker then candidates[#candidates+1]={id=id,distance=delta.Magnitude} end
            end
        end
    end
    table.sort(candidates,function(a2,b2)
        if a2.distance~=b2.distance then return a2.distance&lt;b2.distance end
        return a2.id&lt;b2.id
    end)
    local result={}; for _,candidate in ipairs(candidates) do result[#result+1]=candidate.id end
    return result
end
function World:impulse(uid, attacker, cfg, profile)
    assert(self.config.Impulses[profile]==cfg,"Unbound response profile")
    local a,b=self.actors[uid],self.actors[attacker]
    if not a or not b or a.root.Anchored then return end
    local facing=b.root.CFrame.LookVector
    local horizontal=Vector3.new(facing.X,0,facing.Z)
    if horizontal.Magnitude&lt;0.001 then horizontal=Vector3.new(1,0,0) else horizontal=horizontal.Unit end
    a.root:ApplyImpulse((horizontal*cfg.horizontal+Vector3.new(0,cfg.vertical,0))*a.root.AssemblyMass)
end
function World:hazard(uid)
    local a=self.actors[uid]
    if not a or not a.root.Parent then return "ActorMissing" end
    if a.humanoid.Health&lt;=0 then return "EngineDeath" end
    local p=a.root.Position
    if p.Y&lt;self.config.FallY then self.deathReason[uid]="Fall"; return "Fall" end
    for _,offset in ipairs({Vector3.new(),Vector3.new(-0.7,0,-0.35),Vector3.new(0.7,0,0.35)}) do
        local hit=Workspace:Raycast(p+offset,Vector3.new(0,-3.4,0),self.ray)
        if hit then
            self.lastSupport[uid]=hit.Instance:GetAttribute("SurfaceId") or self.lastSupport[uid]
            if hit.Instance:GetAttribute("Hazard") then self.deathReason[uid]="Surface"; return "Surface" end
        end
    end
    return nil
end
function World:kill(uid)
    local a=self.actors[uid]; if not a then return end
    self.origins[uid]=a.root.Position
    a.root.Anchored=false; a.humanoid.Health=0
    for _,p in ipairs(a.model:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide=false end end
end
function World:relocate(uid, point)
    if not self:isSafe(point,uid) then return false end
    local a=self.actors[uid]
    a.model:PivotTo(CFrame.lookAt(point.position,point.position+Vector3.new(1,0,0)))
    a.root.AssemblyLinearVelocity=Vector3.new(); a.root.AssemblyAngularVelocity=Vector3.new()
    self.origins[uid]=point.position; self.deathReason[uid]=nil
    return true
end
function World:observe(uid)
    local a=self.actors[uid]; if not a or not a.root.Parent then return {} end
    local p,v=a.root.Position,a.root.AssemblyLinearVelocity
    return {position={p.X,p.Y,p.Z},velocity={v.X,v.Y,v.Z},held=a.root.Anchored}
end
function World:cue(uid, blocked)
    local a=self.actors[uid]; if not a then return end
    a.cue=a.cue+1; local token=a.cue
    local h=a.model:FindFirstChild("Feedback") or Instance.new("Highlight")
    h.Name="Feedback"; h.FillTransparency=0.35; h.OutlineTransparency=0
    h.FillColor=blocked and Color3.fromRGB(90,175,255) or Color3.fromRGB(255,170,70)
    h.Parent=a.model
    task.delay(0.18,function() if self.actors[uid]==a and a.cue==token then h:Destroy() end end)
end
function World:noSafe(enabled)
    self.blocked=enabled
    for _,floor in ipairs(self.floors) do floor.CanCollide=not enabled end
    self.danger.CanCollide=not enabled
end
function World:pose(uid, x, y, z, yaw)
    local a=assert(self.actors[uid],"No actor")
    a.model:PivotTo(CFrame.new(x,y,z)*CFrame.Angles(0,math.rad(yaw),0))
    a.root.AssemblyLinearVelocity=Vector3.new(); a.root.AssemblyAngularVelocity=Vector3.new()
end
function World:clearActors()
    for _,a in pairs(self.actors) do a.model:Destroy() end
    self.actors={}; self.origins={}; self.lastSupport={}; self.deathReason={}
    self:noSafe(false)
end
return World
</ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ReplicatedStorage" referent="BT20">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="BT21">
      <Properties>
        <string name="Name">BrickToads</string>
      </Properties>
      <Item class="ModuleScript" referent="BT22">
        <Properties>
          <string name="Name">BrickToadsConfig</string>
          <ProtectedString name="Source">-- BrickToads metadata shared by the server and client entry points.
return table.freeze({
    Name = "BrickToads",
})
</ProtectedString>
