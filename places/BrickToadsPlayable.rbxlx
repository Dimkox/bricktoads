      <string name="Name">StarterGui</string>
      <token name="ScreenOrientation">4</token>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="BT54">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="BT55">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="BT56">
