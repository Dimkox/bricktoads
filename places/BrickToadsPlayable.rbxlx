local function freeze(value)
    if type(value)=='table' and not table.isfrozen(value) then
        for _,item in pairs(value) do freeze(item) end
        table.freeze(value)
    end
    return value
end
local function integer(v) return type(v)=='number' and v==v and v&gt;-math.huge and v&lt;math.huge and v%1==0 end

