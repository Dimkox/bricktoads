}
local ALIASES={["Mr. Green"]="Hero",["Mr. Yellow"]="Hero",["Mr. Brown"]="Hero"}
local function freeze(value,seen)
    if type(value)~='table' then return value end
    seen=seen or {};if seen[value] then return value end;seen[value]=true
    for _,child in pairs(value) do freeze(child,seen) end
    return table.freeze(value)
end
freeze(DATA);freeze(ALIASES)
local function integer(value) return type(value)=='number' and value==value and value&gt;=0 and value&lt;math.huge and value%1==0 end
local function byte(value) return integer(value) and value&lt;=255 end
local function finite(value) return type(value)=='number' and value==value and value&gt;-math.huge and value&lt;math.huge end
local function result(p,frame,basis,source)
    return table.freeze({frameId=frame,namespace=p.namespace,spriteNamespace=p.spriteNamespace,
        bankRecipe=p.bankRecipe,frameBasis=basis,source=source,appliesDamage=false})
end
function Profiles.get(kind)
    return DATA[ALIASES[kind] or kind]
end
local NORMAL={Normal=true,Walk=true,Run=true,Fly=true,Swim=true,Ride=true,Wall=true,Moving=true}
local function cycle(p,frames,context,source,basis)
    if not integer(context.phase) then return nil,'UNKNOWN_STATE' end
    return result(p,frames[context.phase%#frames+1],basis or 'ExplicitSourceCycleIndex',source)
end
function Profiles.sample(kind,context)
    local p=Profiles.get(kind)
    if not p then return nil,'UNKNOWN_KIND' end
    if type(context)~='table' then return nil,'UNKNOWN_STATE' end
    local state=context.state or context.mode or 'Neutral'
    if state=='Neutral' or state=='Idle' or state=='Ready' then
        return result(p,p.neutralFrame,'VerifiedRepresentativeFrame',p.sourceFrameSelectors[1] and p.sourceFrameSelectors[1].source or p.locomotion and p.locomotion.source)
    end
    if p.kind=='Hero' then
        local frames=state=='Walk' and p.locomotion.walkFrames or state=='Run' and p.locomotion.runFrames
            or state=='CarryWalk' and p.locomotion.carryWalkFrames or state=='Depth' and p.locomotion.depthFrames
        if frames then return cycle(p,frames,context,p.locomotion.source) end
        if state=='HoldingStill' then return result(p,0x11,'SourceState','main.asm:8362-8365') end
        if state=='HeldAirborne' then return result(p,0x2E,'SourceState','main.asm:8190-8204') end
        if state=='Airborne' and finite(context.verticalSpeed) and context.verticalSpeed&gt;=-128 and context.verticalSpeed&lt;=255 and context.verticalSpeed%1==0 then
            local z=(context.verticalSpeed+2)%256
            return result(p,z&lt;5 and 0x2D or 0x05,'SourceUnsignedZSpeed','main.asm:8190-8204')
        end
    elseif p.kind=='Pig' then
        if state=='LightReaction' and byte(context.timerRaw) then return result(p,context.timerRaw&lt;0x3B and 4 or 7,'SourceReactionTimer','main.asm:16703-16713') end
        if state=='HeavyReaction' and byte(context.timerRaw) then return result(p,context.timerRaw&gt;=0x60 and 5 or 8,'SourceReactionTimer','main.asm:16695-16720') end
        if state=='CarriedOrDisabled' or state=='Dead' then return result(p,8,'SourceState','main.asm:16638-16663') end
    elseif p.kind=='Dragon' then
        if state=='Approach' then return result(p,9,'SourceState','main.asm:3034-3039') end
        if state=='HeavyDisabled' or state=='HeavyReaction' then return result(p,10,'SourceState','main.asm:3004-3022') end
        if state=='LightReaction' and byte(context.timerRaw) and context.timerRaw&gt;=0x26 then return result(p,12,'SourceReactionTimer','main.asm:2974-3001') end
    elseif p.kind=='Raven' then
        if state=='Dead' or state=='CarriedCorpse' then return result(p,state=='Dead' and 0x22 or 0x23,'SourceState','main.asm:4869-4894') end
    elseif p.kind=='Invader' then
        if state=='ReturningWithLife' then return cycle(p,{0x39,0x39,0x3A,0x3A},context,'main.asm:5682-5690') end
        if state=='LifeToken' then return result(p,0x3D,'LinkedTokenState','main.asm:5512-5522') end
    elseif p.kind=='RetroBlaster' then
        if state=='Reaction' and finite(context.speed) then return result(p,context.speed==0 and 0x61 or 0x60,'SourceSpeedBranch','main.asm:10792-10801') end
    elseif p.kind=='Snowman' and state=='Reaction' then return result(p,0x6B,'SourceState','main.asm:20185-20208')
    elseif p.kind=='Slug' then
        local frames={Linked=0xA1,WallTransition=0xA2,Transition=0x9F,Moving=0xA0,Airborne=0xA0}
        if frames[state] then return result(p,frames[state],'SourceState','main.asm:19050-19140') end
    elseif p.kind=='FlyingHead' then
        if state=='LinkedFlight' then return cycle(p,{0xBC,0xBD},context,'main.asm:13843-13854') end
        if state=='SpecialRoute' and byte(context.frameCounter) then
            return result(p,math.floor(((context.frameCounter+9)%32)/16)+0xBC,'SourceCounterBits','main.asm:13869-13881')
        end
        if state=='HeadEmitter' then return result(p,0xC4,'SourceState','main.asm:13985-14014') end
    elseif p.kind=='Swellcheeks' and state=='HeavyReaction' then return result(p,0xBD,'SourceState','main.asm:14032-14052')
    elseif p.kind=='Duck' and state=='Reaction' then return result(p,0xE9,'SourceState','main.asm:12030-12055')
    elseif p.kind=='BigBlag' then
        if state=='Grounded' or state=='Airborne' then return result(p,state=='Grounded' and 0xEF or 0xF1,'SourceFloorBranch','main.asm:13187-13199') end
    elseif p.kind=='RoboManus' then
        if state=='Grounded' or state=='Airborne' then return result(p,state=='Grounded' and 0xF8 or 0xF7,'SourceFloorBranch','main.asm:13533-13572') end
    elseif p.kind=='DarkQueen' then
        if state=='Grounded' or state=='Airborne' then return result(p,state=='Grounded' and 0x81 or 0x82,'SourceFloorBranch','main.asm:14340-14345') end
    end
    if NORMAL[state] and p.locomotion and p.locomotion.frames then
        local frames=p.locomotion.frames
        if #frames==1 then return result(p,frames[1],'StaticSourceBody',p.locomotion.source) end
        return cycle(p,frames,context,p.locomotion.source)
    end
    return nil,'UNKNOWN_STATE'
end
Profiles.provenance=table.freeze({commit='f1a43b69577246850d136473700a333b3cdfe93f',
    reference='research/canonical-visuals/cast-animation-profiles.json',
    timing='Explicit phase only; caller calibration is an adaptation',appliesDamage=false})
return table.freeze(Profiles)
</ProtectedString>
