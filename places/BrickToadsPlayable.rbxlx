      <Item class="Script" referent="BT7">
        <Properties>
          <string name="Name">BrickToadsServer</string>
          <ProtectedString name="Source">-- Main playable BrickToads runtime. The client supplies intent, never hit results.
local Players=game:GetService('Players')
local ReplicatedStorage=game:GetService('ReplicatedStorage')
local RunService=game:GetService('RunService')
local HttpService=game:GetService('HttpService')
Players.CharacterAutoLoads=false
local runtime=script.Parent:WaitForChild('CombatRuntime')
local gameplay=script.Parent:WaitForChild('gameplay')
local worldType=require(gameplay.GameWorld)
require(gameplay.DragonWorld)(worldType)
require(gameplay.BossIntroWorld)(worldType)
local config=require(gameplay.GameConfig)(require(runtime.Config),require(gameplay.LevelDefinition))
local buildInfo=script.Parent:FindFirstChild('BuildInfo')
local buildId=buildInfo and require(buildInfo).sourceSha256 or 'unpackaged-source'
local controller=require(gameplay.MatchHub).new({Core=require(script.Parent.RunLifecycle),
    Combat=require(runtime.Combat),Session=require(runtime.Session),Registry=require(runtime.ConnectionRegistry),
    Config=config,Controller=require(gameplay.GameController),Director=require(gameplay.LevelDirector),BossQueue=require(gameplay.BossQueue),
    GuardianPattern=require(gameplay.GuardianPattern),HealingFlies=require(gameplay.HealingFlies),
    BossIntro=require(gameplay.BossIntro)(require(gameplay.CanonicalAnimation)),
    EnemyCarry=require(gameplay.EnemyCarry),
    WalkerClubs=require(gameplay.WalkerClubs),
    SourceCombat=require(gameplay.SourceCombat),DragonFlight=require(gameplay.DragonFlight),
    LevelVariation=require(gameplay.LevelVariation),
    CampaignDefinition=require(gameplay.CampaignDefinition),CampaignDirector=require(gameplay.CampaignDirector),
    CampaignModes=require(gameplay.CampaignModes),CampaignBoss=require(gameplay.CampaignBoss),
    CampaignEnemies=require(gameplay.CampaignEnemies),
    RunJournal=require(gameplay.RunJournal),BuildId=buildId,
    clock=function() return workspace:GetServerTimeNow() end,guid=function() return HttpService:GenerateGUID(false) end},
    function(index,groupId)
        -- Migrate this runtime's older saved preview once; its unscoped floor
        -- would otherwise overlap the first group's independently owned arena.
        if index==1 then
            local legacy=workspace:FindFirstChild('BrickToadsWorld')
            if legacy and legacy:GetAttribute('OriginalArt')==true
                and legacy:GetAttribute('LevelName')=='Затопленный тракт' and legacy:GetAttribute('GroupId')==nil then
                legacy:Destroy()
            end
        end
        local world=worldType.new(require(runtime.RobloxWorld),config,{
            name='BrickToadsWorld_'..groupId,offset={x=0,y=0,z=(index-1)*config.Groups.spacing},
            characterAppearance=require(gameplay.CharacterAppearance),guardianAppearance=require(gameplay.GuardianAppearance),
            campaignWorld=require(gameplay.CampaignWorld)})
        world.folder:SetAttribute('GroupId',groupId)
        return world
    end)
if RunService:IsStudio() then
    -- Read-only server-side export. No remote, gameplay mutation or test control.
    local diagnostics=Instance.new('BindableFunction')
    diagnostics.Name='BrickToadsDiagnostics';diagnostics.Parent=game:GetService('ServerStorage')
    diagnostics.OnInvoke=function(groupId)
        if type(groupId)~='string' then return nil end
        local group=controller.groups[groupId]
        if not group then return nil end
        local run=group.controller
        return {sourceSha256=buildId,placeId=game.PlaceId,placeVersion=game.PlaceVersion,
            loggerFailures=run.current and (run.current.loggerFailures or 0) or 0,
            current=run.journal and run.journal:snapshot(),previous=run.previousJournal and run.previousJournal:snapshot()}
    end
end
local remotes=Instance.new('Folder'); remotes.Name='BrickToadsGame'; remotes.Parent=ReplicatedStorage
local intent=Instance.new('RemoteEvent'); intent.Name='Intent'; intent.Parent=remotes
local state=Instance.new('RemoteEvent'); state.Name='State'; state.Parent=remotes
local fault,lastBroadcast=nil,0
local function replicationFocus(player)
    local group=controller:selected(player)
    if not group then return end
    local world=group.world
    local slot=controller:controlledSlot(player.UserId)
    local actor=slot and world.actors[slot]
    if not actor or not actor.root.Parent then
        actor=nil
        for id,candidate in pairs(world.actors) do
            if id&gt;0 and candidate.root.Parent and candidate.humanoid.Health&gt;0 then actor=candidate; break end
        end
    end
    local focus=actor and actor.root or world.floors[1]
    if player.ReplicationFocus~=focus then player.ReplicationFocus=focus end
end
local function broadcast(requester)
    local players=Players:GetPlayers()
    for _,player in ipairs(requester and {requester} or players) do
        if player.Parent==Players then
            local snapshot=controller:snapshot(player,players)
            if snapshot then snapshot.fault=snapshot.fault==true or fault~=nil; state:FireClient(player,snapshot) end
        end
    end
end
local function joined(player)
    if player.Parent~=Players then return end
    if player.Character then player.Character:Destroy(); player.Character=nil end
    controller:join(player); replicationFocus(player); broadcast(player)
end
Players.PlayerAdded:Connect(joined)
Players.PlayerRemoving:Connect(function(player) controller:leave(player) end)
for _,player in ipairs(Players:GetPlayers()) do joined(player) end
intent.OnServerEvent:Connect(function(player,payload)
    if player.Parent~=Players or fault then return end
    local ok,code=xpcall(function() return controller:handle(player,payload,Players:GetPlayers()) end,debug.traceback)
    if not ok then fault=tostring(code); warn('[BrickToads] '..fault); return end
    if type(payload)=='table' and (payload.kind=='Sync' or payload.kind=='Start' or payload.kind=='SelectHero'
        or payload.kind=='SelectRole' or payload.kind=='ClaimEnemy' or payload.kind=='ChooseView'
        or payload.kind=='QueueBoss' or payload.kind=='CancelBossQueue' or payload.kind=='ReplyBoss' or payload.kind=='ConnectBoss'
        or payload.kind=='CreateGroup' or payload.kind=='JoinGroup'
        or ((payload.kind=='Attack' or payload.kind=='Jump') and (code=='OK' or code=='NOT_RUNNING'
            or code=='REACTION' or code=='COOLDOWN' or code=='HELD' or code=='THROWN'))) then
        if code~='RATE_LIMIT' and code~='STALE_CONNECTION' then broadcast(player) end
    end
end)
RunService.Heartbeat:Connect(function(dt)
    local at=workspace:GetServerTimeNow()
    if not fault then
        local ok,err=xpcall(function()
            controller:step(at,dt)
        end,debug.traceback)
        if not ok then fault=tostring(err); warn('[BrickToads] '..fault) end
    end
    for _,player in ipairs(Players:GetPlayers()) do replicationFocus(player) end
    if at-lastBroadcast&gt;=config.SnapshotInterval then lastBroadcast=at; broadcast() end
end)
print('[BrickToads] campaign runtime ready')
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="BT8">
        <Properties>
          <string name="Name">RunLifecycle</string>
          <ProtectedString name="Source">-- Server-only lifecycle core. No Roblox instances, remotes, physics or damage coefficients.
-- Events represent decisions already authenticated by the server adapter.
local Core = {}
local MAX_HEALTH = 5
local INITIAL_RESPAWNS = 3
local NORMAL_SHIELD_SECONDS = 2
local EMERGENCY_SHIELD_SECONDS = 10
local TEMPLATES = { ["Mr. Green"] = true, ["Mr. Yellow"] = true, ["Mr. Brown"] = true }
local BASE_FIELDS = { id=true, runId=true, expectedRevision=true, kind=true, now=true }
local FIELDS = {
    ReserveSpawn = {userId=true,connectionEpoch=true},
    CommitSpawn = {userId=true,token=true,actorId=true,safe=true},
    AbortSpawn = {userId=true,token=true},
    Death = {userId=true,actorId=true,attempt=true,levelEpoch=true},
    SetHealth = {userId=true,actorId=true,attempt=true,levelEpoch=true,health=true},
    BeginAttack = {userId=true,actorId=true,attempt=true,levelEpoch=true,connectionEpoch=true},
    Connection = {userId=true,connectionEpoch=true,connected=true},
    ExpireShield = {userId=true,actorId=true,attempt=true,levelEpoch=true},
    RelocateToSafety = {userId=true,actorId=true,attempt=true,levelEpoch=true,safe=true},
    AdvanceLevel = {userId=true,actorId=true,attempt=true,levelEpoch=true,levelId=true,destinationSafe=true,prerequisitesMet=true},
    ChooseView = {userId=true,view=true,connectionEpoch=true},
}

local function finite(value)
    return type(value) == "number" and value == value and value &gt; -math.huge and value &lt; math.huge
end
local function integer(value, minimum)
    return finite(value) and value &gt;= minimum and value &lt;= 9007199254740991 and value % 1 == 0
end
local function identifier(value)
    return type(value) == "string" and #value &gt; 0 and #value &lt;= 160
end
local function copy(value)
    if type(value) ~= "table" then return value end
    local result = {}
    for key, item in pairs(value) do result[key] = copy(item) end
    return result
end

-- Length prefixes make strings containing separators unambiguous in replay fingerprints.
local function fingerprint(event)
    local keys = {}
    for key in pairs(event) do keys[#keys+1] = key end
    table.sort(keys)
    local pieces = {}
    for _, key in ipairs(keys) do
        local value = event[key]
        local encoded
        if type(value) == "string" then encoded = "s" .. #value .. ":" .. value
        elseif type(value) == "number" then encoded = "n" .. string.format("%.17g", value) .. ";"
        else encoded = value and "b1" or "b0" end
        pieces[#pieces+1] = #key .. ":" .. key .. encoded
    end
    return table.concat(pieces)
end

function Core.new(runId, groupId, roster, levelId)
    assert(identifier(runId) and identifier(groupId) and identifier(levelId), "Invalid run/group/level identifier")
    assert(type(roster) == "table" and #roster &gt;= 1 and #roster &lt;= 3, "Roster must contain 1–3 heroes")
    local count = 0
    for key in pairs(roster) do
        assert(integer(key, 1) and key &lt;= #roster, "Roster must be a contiguous array")
        count = count + 1
    end
    assert(count == #roster, "Roster must be a contiguous array")
    local state = {
        runId=runId, groupId=groupId, levelId=levelId, levelEpoch=1,
        revision=0, time=0, status="Active", partyDissolved=false,
        heroes={}, receipts={}, seenActors={},
    }
    for _, member in ipairs(roster) do
        assert(type(member) == "table" and integer(member.userId, 1), "Invalid hero userId")
        assert(TEMPLATES[member.template] == true, "Unknown hero template")
        assert(state.heroes[member.userId] == nil, "Duplicate hero owner")
        state.heroes[member.userId] = {
            userId=member.userId, template=member.template, connected=true, connectionEpoch=1,
            status="AwaitingInitial", health=MAX_HEALTH, respawns=INITIAL_RESPAWNS,
            attempt=0, retryReady=false, view="Playing",
        }
    end
    return state
end

local function validateEvent(event)
    if type(event) ~= "table" or not identifier(event.id) or not identifier(event.runId)
        or not identifier(event.kind) or not integer(event.expectedRevision, 0)
        or not finite(event.now) or event.now &lt; 0 then return "INVALID_EVENT" end
    local allowed = FIELDS[event.kind]
    if not allowed then return "UNKNOWN_EVENT" end
    for key, value in pairs(event) do
        if type(key) ~= "string" or (not BASE_FIELDS[key] and not allowed[key]) then return "UNKNOWN_FIELD" end
        local kind = type(value)
        if kind ~= "string" and kind ~= "number" and kind ~= "boolean" then return "INVALID_EVENT" end
        if kind == "number" and not finite(value) then return "INVALID_EVENT" end
    end
    if not integer(event.userId, 1) then return "INVALID_EVENT" end
    if allowed.connectionEpoch and not integer(event.connectionEpoch, 1) then return "INVALID_EVENT" end
    if allowed.attempt and (not integer(event.attempt, 1) or not integer(event.levelEpoch, 1)
        or not identifier(event.actorId)) then return "INVALID_EVENT" end
    if allowed.token and not identifier(event.token) then return "INVALID_EVENT" end
    if allowed.safe and type(event.safe) ~= "boolean" then return "INVALID_EVENT" end
    if event.kind == "CommitSpawn" and not identifier(event.actorId) then return "INVALID_EVENT" end
    if event.kind == "Connection" and type(event.connected) ~= "boolean" then return "INVALID_EVENT" end
    if event.kind == "AdvanceLevel" and (not identifier(event.levelId)
        or type(event.destinationSafe) ~= "boolean" or type(event.prerequisitesMet) ~= "boolean") then return "INVALID_EVENT" end
    return nil
end

local function checkConnection(hero, event, requireOnline)
    if event.connectionEpoch ~= hero.connectionEpoch then return "STALE_CONNECTION" end
    if requireOnline and not hero.connected then return "OFFLINE" end
    return nil
end
local function checkActor(state, hero, event)
    if event.levelEpoch ~= state.levelEpoch then return "STALE_LEVEL" end
    if hero.status ~= "Alive" then return "NOT_ALIVE" end
    if event.actorId ~= hero.actorId or event.attempt ~= hero.attempt then return "STALE_ACTOR" end
    return nil
end
local function checkReservation(state, hero, event)
    local pending = hero.pending
    if not pending or pending.token ~= event.token or pending.levelEpoch ~= state.levelEpoch
        or pending.connectionEpoch ~= hero.connectionEpoch or pending.sourceAttempt ~= hero.attempt then
        return "STALE_RESERVATION"
    end
    if not hero.connected then return "OFFLINE" end
    return nil
end
local function clearEmergency(hero)
    hero.shield = nil
    hero.retryReady = false
    if hero.pending and hero.pending.kind == "Emergency" then hero.pending = nil end
end
local function closeIfDefeated(state)
    for _, hero in pairs(state.heroes) do
        if hero.status ~= "Eliminated" then return end
    end
    state.status = "Lost"
    state.partyDissolved = true
    for _, hero in pairs(state.heroes) do hero.view = "Menu" end
end

-- Mutations are applied only to a private candidate snapshot and discarded on rejection.
local function execute(state, event)
    local hero = state.heroes[event.userId]
    if not hero then return "UNKNOWN_HERO" end
    local kind = event.kind
    if kind == "ReserveSpawn" then
        local problem = checkConnection(hero, event, true)
        if problem then return problem end
        if hero.pending then return "SPAWN_PENDING" end
        local spawnKind
        if hero.status == "AwaitingInitial" then spawnKind = "Initial"
        elseif hero.status == "AwaitingRespawn" and hero.respawns &gt; 0 then spawnKind = "Respawn"
        elseif hero.status == "Alive" and hero.retryReady and hero.respawns &gt; 0 then spawnKind = "Emergency"
        else return "SPAWN_NOT_ALLOWED" end
        hero.pending = {
            token = tostring(state.revision+1) .. ":" .. tostring(event.userId),
            kind=spawnKind, levelEpoch=state.levelEpoch,
            connectionEpoch=hero.connectionEpoch, sourceAttempt=hero.attempt,
        }
    elseif kind == "CommitSpawn" then
        local problem = checkReservation(state, hero, event)
        if problem then return problem end
        if state.seenActors[event.actorId] then return "ACTOR_ID_REUSED" end
        local spawnKind = hero.pending.kind
        if spawnKind == "Initial" and not event.safe then return "UNSAFE_INITIAL_SPAWN" end
        if spawnKind ~= "Initial" then
            if hero.respawns &lt;= 0 then return "NO_RESPAWNS" end
            hero.respawns = hero.respawns - 1
        end
        hero.health = MAX_HEALTH
        hero.attempt = hero.attempt + 1
        hero.actorId = event.actorId
        hero.status = "Alive"
        hero.view = "Playing"
        hero.pending = nil
        hero.retryReady = false
        hero.shield = nil
        if spawnKind ~= "Initial" then
            hero.shield = {
                kind = event.safe and "Normal" or "Emergency",
                deadline = event.now + (event.safe and NORMAL_SHIELD_SECONDS or EMERGENCY_SHIELD_SECONDS),
            }
        end
        state.seenActors[event.actorId] = true
    elseif kind == "AbortSpawn" then
        local problem = checkReservation(state, hero, event)
        if problem then return problem end
        hero.pending = nil
    elseif kind == "Connection" then
        local problem = checkConnection(hero, event, false)
        if problem then return problem end
        if hero.connected == event.connected then return "NO_CHANGE" end
        hero.connected = event.connected
        hero.connectionEpoch = hero.connectionEpoch + 1
        hero.pending = nil
        hero.retryReady = false
    elseif kind == "ChooseView" then
        local problem = checkConnection(hero, event, true)
        if problem then return problem end
        if hero.status ~= "Eliminated" then return "NOT_ELIMINATED" end
        if event.view ~= "Menu" and event.view ~= "Spectating" then return "INVALID_VIEW" end
        hero.view = event.view
    else
        local problem = checkActor(state, hero, event)
        if problem then return problem end
        if kind == "Death" then
            hero.health = 0
            hero.actorId = nil
            hero.pending = nil
            hero.shield = nil
            hero.retryReady = false
            hero.status = hero.respawns &gt; 0 and "AwaitingRespawn" or "Eliminated"
            if hero.status == "Eliminated" then hero.view = "Choice" end
            closeIfDefeated(state)
        elseif kind == "SetHealth" then
            if not finite(event.health) or event.health &lt; 0 or event.health &gt; MAX_HEALTH then return "INVALID_HEALTH" end
            if event.health &lt; hero.health and hero.shield and event.now &lt; hero.shield.deadline then return "PROTECTED" end
            hero.health = event.health
        elseif kind == "BeginAttack" then
            problem = checkConnection(hero, event, true)
            if problem then return problem end
            clearEmergency(hero)
        elseif kind == "ExpireShield" then
            if not hero.shield then return "NO_SHIELD" end
            if event.now &lt; hero.shield.deadline then return "NOT_DUE" end
            hero.retryReady = hero.shield.kind == "Emergency" and hero.connected and hero.respawns &gt; 0
            hero.shield = nil
        elseif kind == "RelocateToSafety" then
            local emergency = (hero.shield and hero.shield.kind == "Emergency") or hero.retryReady
                or (hero.pending and hero.pending.kind == "Emergency")
            if not emergency then return "NOT_EMERGENCY" end
            if not event.safe then return "UNSAFE_DESTINATION" end
            clearEmergency(hero)
        elseif kind == "AdvanceLevel" then
            if not event.prerequisitesMet then return "EXIT_NOT_READY" end
            if not event.destinationSafe then return "UNSAFE_DESTINATION" end
            if event.levelId == state.levelId then return "SAME_LEVEL" end
            state.levelId = event.levelId
            state.levelEpoch = state.levelEpoch + 1
            for _, member in pairs(state.heroes) do
                member.pending = nil
                member.retryReady = false
                if member.status == "Alive" then
                    member.health = MAX_HEALTH
                    if member.shield and member.shield.kind == "Emergency" then member.shield = nil end
                end
            end
        end
    end
    return nil
end

function Core.apply(state, event)
    local problem = validateEvent(event)
    if problem then return state, problem, nil end
    if event.runId ~= state.runId then return state, "WRONG_RUN", nil end
    local signature = fingerprint(event)
    local previous = state.receipts[event.id]
    if previous then
        if previous.fingerprint ~= signature then return state, "EVENT_ID_REUSED", nil end
        return state, "REPLAY", copy(previous.ack)
    end
    if event.expectedRevision ~= state.revision then return state, "STALE_REVISION", nil end
    if state.status ~= "Active" then return state, "RUN_CLOSED", nil end
    if event.now &lt; state.time then return state, "TIME_REVERSED", nil end
    local nextState = copy(state)
    problem = execute(nextState, event)
    if problem then return state, problem, nil end
    nextState.revision = state.revision + 1
    nextState.time = event.now
    local hero = nextState.heroes[event.userId]
    local ack = {
        eventId=event.id, kind=event.kind, revision=nextState.revision,
        runId=nextState.runId, levelEpoch=nextState.levelEpoch,
        actorId=hero.actorId, attempt=hero.attempt, respawns=hero.respawns,
        token=hero.pending and hero.pending.token or nil,
    }
    nextState.receipts[event.id] = {fingerprint=signature, ack=copy(ack)}
    return nextState, "OK", ack
end

return Core
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Folder" referent="BT9">
        <Properties>
          <string name="Name">gameplay</string>
        </Properties>
        <Item class="ModuleScript" referent="BT10">
          <Properties>
            <string name="Name">BossIntro</string>
            <ProtectedString name="Source">-- Finite first-route Boss Walker INTRO. Source counters/events come from the
-- canonical profile; 60 Hz / 4.25 seconds is a local presentation calibration.
-- Provenance: research/2026-11-09-canonical-character-animation-source.md,
-- "Boss Walker appearance": main 4103-4187 and bank-six arena setup.
-- The source addresses two heroes. Applying fear to the party's three captured
-- identities is an explicit cooperative adaptation, with no gameplay effects.
return function(Animation)
    local Intro={}
    Intro.__index=Intro
    local function finite(n) return type(n)=='number' and n==n and n&gt;-math.huge and n&lt;math.huge end

    function Intro.new(director)
        local s=director.session
        local actors={}
        for _,slot in ipairs(s.order) do
            local h,c=s.state.heroes[slot],s.combat[slot]
            if h and h.status=='Alive' and h.actorId and c and not c.deathAt then actors[slot]=h.actorId end
        end
        local state={id=s.state.runId..':boss-intro:'..s.state.levelEpoch,runId=s.state.runId,
            levelEpoch=s.state.levelEpoch,startedAt=director.now,counter=0,active=true,cameraCut=false,
            phase='BeforeCut',heroActors=actors,bossPosition=table.clone(director.route.boss.position),events={}}
        local self=setmetatable({director=director,session=s,world=director.world,state=state},Intro)
        self:_advance(1)
        return self
    end

    function Intro:_advance(counter)
        local state=self.state
        local row=assert(Animation.bossWalkerIntro(counter))
        state.events=assert(Animation.bossWalkerEventsBetween(state.counter,counter))
        -- E0 and FF skip write_anim_fear, rather than clearing the previous
        -- animation. Recover the preceding write even when a heartbeat skips it.
        local written=row.fearAnimation and row or Animation.bossWalkerIntro(counter-1)
        if written and written.fearAnimation then
            state.fearAnimation=written.fearAnimation;state.fearFrame=written.fearFrame
            state.fearPointerMask=written.fearPointerMask
        end
        state.counter=counter;state.phase=row.phase
        state.footFrame=row.footFrame;state.footMotion=row.footMotion
        for _,event in ipairs(state.events) do if event.kind=='ArenaCut' then state.cameraCut=true end end
        -- Every published context is plain data. Actor replacements can never
        -- inherit this intro's presentation, even within the same party slot.
        local actors={}
        for slot,actorId in pairs(state.heroActors) do
            local h,c=self.session.state.heroes[slot],self.session.combat[slot]
            if h and h.actorId==actorId and h.status=='Alive' and c and not c.deathAt then actors[slot]=actorId end
        end
        state.heroActors=actors
        if self.world.bossIntro then self.world:bossIntro(state) end
        if row.ended then
            state.active=false;self.complete=true
            if self.world.bossIntro then self.world:bossIntro(nil) end
            return 'Complete'
        end
        return 'Active'
    end

    function Intro:step(now)
        if self.cancelled then return 'Cancelled' end
        if self.complete then return 'Complete' end
        local state=self.state
        if self.director.result or self.session.state.status~='Active' then return self:cancel('RunEnded') end
        if self.session.state.runId~=state.runId or self.session.state.levelEpoch~=state.levelEpoch then
            return self:cancel('RunReplaced')
        end
        if not finite(now) or now&lt;state.startedAt then return 'INVALID_TIME' end
        local counter=math.clamp(math.floor((now-state.startedAt)*60+1e-7),1,255)
        if counter&lt;=state.counter then return 'Active' end
        return self:_advance(counter)
    end

    function Intro:cancel(reason)
        if self.cancelled or self.complete then return self.complete and 'Complete' or 'Cancelled' end
        self.cancelled=true;self.state.active=false;self.state.phase='Cancelled';self.state.events={}
        self.state.cancelReason=reason
        if self.world.bossIntro then self.world:bossIntro(nil) end
        return 'Cancelled'
    end

    function Intro:snapshot()
        local s=self.state
        return {id=s.id,runId=s.runId,levelEpoch=s.levelEpoch,counter=s.counter,fearFrame=s.fearFrame,
            phase=s.phase,startedAt=s.startedAt,cameraCut=s.cameraCut,active=s.active}
    end
    return Intro
end
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT11">
          <Properties>
            <string name="Name">BossIntroWorld</string>
            <ProtectedString name="Source">-- Party-owned, cosmetic-only Boss Walker INTRO boundary. No hero assembly,
-- ownership, collision, damage, Lighting or Camera is changed here.
-- Replicated interface: world.folder/BossIntro (Folder) exposes Active(bool),
-- IntroId(string), RunId(string), LevelEpoch(number), Counter(number), Phase(string),
-- CameraCut(bool, latched from E0), FearFrame(number), StartedAt(server seconds),
-- and Focus(Vector3: group-local boss position + group offset + 6 vertical studs).
-- The folder is destroyed on FF/cancellation/clearActors; clients must release
-- their intro view when it disappears. World.bossIntroState contains plain data.
return function(World)
    if World.bossIntro then return World end
    local previousClear=World.clearActors
    local steel=Color3.fromRGB(81,93,101)
    local dark=Color3.fromRGB(33,39,44)
    local copper=Color3.fromRGB(184,119,57)
    local light=Color3.fromRGB(255,194,87)
    local function piece(parent,name,size,offset,color,shape)
        local p=Instance.new('Part');p.Name=name;p.Size=size;p.Color=color
        p.Material=Enum.Material.Metal;p.Anchored=true;p.Massless=true
        p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=true
        p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth
        if shape then p.Shape=shape end
        p.CFrame=offset;p.Parent=parent
        return {part=p,offset=offset}
    end
    local function makeFoot(folder)
        local model=Instance.new('Model');model.Name='IntroFoot12';model.Parent=folder
        model:SetAttribute('SourceFrame',0x12)
        model:SetAttribute('SourceScaleHeroHeights',3.88)
        model:SetAttribute('Adaptation','Authored 3D cosmetic path; no stomp damage')
        local parts={}
        local function add(name,x,y,z,sx,sy,sz,color,shape)
            parts[#parts+1]=piece(model,name,Vector3.new(sx,sy,sz),CFrame.new(x,y,z),color,shape)
        end
        -- A six-stud local hero reference yields a 23.28-stud silhouette.
        -- Original mechanical boot forms retain frame12's exaggerated scale.
        add('Sole',-1,1.05,0,12,2.1,8.8,dark)
        add('ToeArmor',-3.7,3.1,0,7,2.2,9.2,steel)
        add('HeelArmor',3.4,3.5,0,3.8,3.2,8.4,steel)
        add('Instep',0,5.2,0,5.8,3.6,7.8,copper)
        add('AnkleJoint',2,7.5,0,5.2,4.2,6.3,dark,Enum.PartType.Ball)
        add('ShinArmor',2,15.1,0,5.9,13.4,6.7,steel)
        add('ShinInset',-1.04,15.3,0,.32,9.8,3.2,copper)
        add('UpperBand',2,22.24,0,6.5,2.08,7.3,dark)
        for _,side in ipairs({-1,1}) do
            add('Piston'..side,2.1,14.5,side*3.65,1.2,12.5,1.1,copper)
            add('AnkleBolt'..side,2,7.5,side*3.4,2.2,2.2,.55,light,Enum.PartType.Ball)
            add('ToeRidge'..side,-3.7,4.32,side*2.5,6.8,.35,.7,dark)
        end
        return parts
    end
    local function importedLeg(folder)
        if not game then return nil end
        local storage=game:GetService('ServerStorage'):FindFirstChild('BrickToadsBossTemplates')
        local template=storage and storage:FindFirstChild('BossWalkerIntroLeg')
        if not template or not template:IsA('Model') then return nil end
        local ok,parts=pcall(function()
            local profile=template:FindFirstChild('AppearanceProfile')
            local scale=template:FindFirstChild('AppearanceScale')
            assert(profile and profile:IsA('StringValue') and profile.Value=='CanonicalBossWalkerIntroLeg')
            assert(scale and scale:IsA('NumberValue') and scale.Value==1)
            local source,count,seen=nil,0,{}
            for _,child in ipairs(template:GetChildren())do
                assert(not seen[child.Name],'Duplicate intro resource child');seen[child.Name]=true
                if child:IsA('MeshPart') then source=child;count+=1
                else
                    assert(#child:GetChildren()==0,'Nested metadata content')
                    if child.Name=='AppearanceProfile' then
                        assert(child:IsA('StringValue') and child.Value=='CanonicalBossWalkerIntroLeg')
                    elseif child.Name=='AppearanceScale' then assert(child:IsA('NumberValue') and child.Value==1)
                    elseif child.Name=='SourceAssetId' then
                        assert(child:IsA('StringValue') and child.Value:match('^%d+$') and tonumber(child.Value)&gt;0)
                    elseif child.Name=='SourceGlbSha256' or child.Name=='AssetManifestSha256' then
                        assert(child:IsA('StringValue') and #child.Value==64 and child.Value:match('^[0-9a-f]+$'))
                    else error('Unexpected intro metadata') end
                end
            end
            assert(count==1 and source.Name=='IntroLeg12' and source.MeshId:match('^rbxassetid://%d+$')
                and tonumber(source.MeshId:sub(14))&gt;0)
            local function finite(n)return type(n)=='number' and n==n and math.abs(n)&lt;math.huge end
            for _,n in ipairs({source.Size.X,source.Size.Y,source.Size.Z})do assert(finite(n) and n&gt;0)end
            local hasMeshSize,meshSize=pcall(function()return source.MeshSize end)
            if hasMeshSize and meshSize~=nil then
                for _,n in ipairs({meshSize.X,meshSize.Y,meshSize.Z})do assert(finite(n) and n&gt;0)end
            end
            assert(finite(source.Transparency) and source.Transparency&gt;=0 and source.Transparency&lt;1)
            local origin,n,surfaces=nil,0,0
            for _,child in ipairs(source:GetChildren())do
                assert(#child:GetChildren()==0,'Nested intro mesh content')
                if child:IsA('Attachment')then assert(child.Name=='IntroOriginRigAttachment');origin=child;n+=1
                else
                    assert(child:IsA('SurfaceAppearance') and child.Name=='SurfaceAppearance')
                    surfaces+=1;assert(surfaces&lt;=1)
                end
            end
            assert(n==1)
            local identity=source.CFrame*origin.CFrame
            local x,y,z=identity:ToEulerAnglesXYZ()
            for _,v in ipairs({identity.Position.X,identity.Position.Y,identity.Position.Z,x,y,z})do
                assert(finite(v) and math.abs(v)&lt;=1e-4)
            end
            -- Clone only the validated mesh; no behaviour travels with this resource.
            local mesh=source:Clone();mesh.Anchored=true;mesh.Massless=true
            mesh.CanCollide=false;mesh.CanTouch=false;mesh.CanQuery=false
            local model=Instance.new('Model');model.Name='IntroFoot12'
            model:SetAttribute('SourceFrame',0x12);model:SetAttribute('Appearance','CanonicalBossWalkerIntroLeg')
            model:SetAttribute('Adaptation','Source12 silhouette; authored3D depth and path')
            mesh.Parent=model;model.PrimaryPart=mesh;model.Parent=folder
            return {{part=mesh,offset=mesh.CFrame}}
        end)
        return ok and parts or nil
    end
    local function footFrame(state,offset)
        local c=state.counter==0xE0 and 0xDF or state.counter
        local p=state.bossPosition
        local x,y
        if c&lt;0x64 then
            local t=math.clamp((c-0x50)/20,0,1)
            x=p.x-29+13*t;y=22*(1-t)^2
        elseif c&lt;0xE0 then
            local t=(c-0x64)/(0xE0-0x64)
            x=p.x-16+16*t;y=4*math.sin(math.pi*t)
        else
            local t=math.clamp((c-0xE0)/30,0,1)
            x=p.x+10*t;y=17*t
        end
        return CFrame.new(Vector3.new(x,p.y-3+y,p.z)+offset)
    end
    function World:bossIntro(state)
        if not state then
            self.bossIntroState=nil
            if self.bossIntroFolder then self.bossIntroFolder:Destroy() end
            self.bossIntroFolder=nil;self.bossIntroParts=nil;self.bossIntroRipples=nil
            return
        end
        if self.bossIntroFolder and self.bossIntroFolder:GetAttribute('IntroId')~=state.id then self:bossIntro(nil) end
        if not self.bossIntroFolder then
            local folder=Instance.new('Folder');folder.Name='BossIntro';folder.Parent=self.folder
            folder:SetAttribute('IntroId',state.id)
            self.bossIntroFolder=folder;self.bossIntroParts=importedLeg(folder) or makeFoot(folder);self.bossIntroRipples={}
            -- Exactly two reused markers, even across skipped heartbeats.
            for _,counter in ipairs({0x30,0x64}) do
                local ring=piece(folder,'StompRipple'..counter,Vector3.new(.08,1,1),CFrame.new(),light,Enum.PartType.Cylinder).part
                ring.Material=Enum.Material.Neon;ring.CastShadow=false;ring.Transparency=1
                self.bossIntroRipples[counter]=ring
            end
        end
        self.bossIntroState=state
        local folder=self.bossIntroFolder
        folder:SetAttribute('Active',state.active==true)
        folder:SetAttribute('RunId',state.runId);folder:SetAttribute('LevelEpoch',state.levelEpoch)
        folder:SetAttribute('Counter',state.counter);folder:SetAttribute('Phase',state.phase)
        folder:SetAttribute('CameraCut',state.cameraCut==true);folder:SetAttribute('FearFrame',state.fearFrame)
        folder:SetAttribute('StartedAt',state.startedAt)
        local p=state.bossPosition
        folder:SetAttribute('Focus',Vector3.new(p.x,p.y+6,p.z)+self.offset)
        local frame=footFrame(state,self.offset)
        for _,row in ipairs(self.bossIntroParts) do
            row.part.CFrame=frame*row.offset
            row.part.Transparency=state.footFrame==0x12 and 0 or 1
        end
        for counter,ring in pairs(self.bossIntroRipples) do
            local age=state.counter-counter
            local visible=age&gt;=0 and age&lt;24
            ring.Transparency=visible and .2+.8*age/24 or 1
            local diameter=visible and 5+age*1.4 or 1
            ring.Size=Vector3.new(.08,diameter,diameter)
            local x=p.x-(counter==0x30 and 29 or 16)
            ring.CFrame=CFrame.new(Vector3.new(x,p.y-2.9,p.z)+self.offset)*CFrame.Angles(0,0,math.pi/2)
        end
    end
    function World:clearActors()
        self:bossIntro(nil)
        previousClear(self)
    end
    return World
end
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT12">
          <Properties>
            <string name="Name">BossQueue</string>
            <ProtectedString name="Source">-- Server-owned FIFO selection. Slots may compete, but each user has one queue/role state.
-- All methods are synchronous; eligibility is supplied by the authoritative controller.
-- The eligibility callback must not yield, mutate this queue, or reenter its methods.
local BossQueue={}
BossQueue.__index=BossQueue

local function finite(value)
    return type(value)=='number' and value==value and value&gt;-math.huge and value&lt;math.huge
end
local function identifier(value)
    return type(value)=='string' and #value&gt;0 and #value&lt;=160
end
local function validUser(userId)
    -- Studio clients use negative IDs; the server has already authenticated the identity.
    return finite(userId) and userId%1==0 and math.abs(userId)&lt;=9007199254740991
end

function BossQueue.new(options,eligible)
    options=options or {}
    local inviteSeconds=options.inviteSeconds or 10
    local connectSeconds=options.connectSeconds or 15
    assert(finite(inviteSeconds) and inviteSeconds&gt;0,'Invalid invitation duration')
    assert(finite(connectSeconds) and connectSeconds&gt;0,'Invalid connection duration')
    assert(eligible==nil or type(eligible)=='function','Invalid eligibility callback')
    return setmetatable({inviteSeconds=inviteSeconds,connectSeconds=connectSeconds,
        eligible=eligible or function() return true end,entries={},waiting={},slots={},slotOrder={},serial=0,now=0},BossQueue)
end

function BossQueue:_removeWaiting(entry)
    local waiting=self.waiting[entry.bossId]
    if not waiting then return end
    for index,userId in ipairs(waiting) do
        if userId==entry.userId then table.remove(waiting,index); return end
    end
end

function BossQueue:_release(entry)
    local slot=entry.slotId and self.slots[entry.slotId]
    if slot and slot.userId==entry.userId then slot.userId=nil end
    entry.slotId=nil; entry.offerId=nil; entry.deadline=nil
end

function BossQueue:_forget(entry)
    self:_removeWaiting(entry)
    self:_release(entry)
    self.entries[entry.userId]=nil
end

function BossQueue:_rotate(entry)
    self:_removeWaiting(entry)
    self:_release(entry)
    entry.state='Queued'
    local waiting=self.waiting[entry.bossId]
    waiting[#waiting+1]=entry.userId
end

function BossQueue:_fill()
    -- Registration order is stable even when slot identifiers sort differently.
    for _,slot in ipairs(self.slotOrder) do
        if slot.state=='Open' and not slot.userId then
            for _,userId in ipairs(self.waiting[slot.bossId] or {}) do
                local entry=self.entries[userId]
                if entry and entry.state=='Queued' and not slot.tried[userId] and self.eligible(userId,slot.context) then
                    self.serial+=1
                    entry.state='Invited'; entry.slotId=slot.id
                    entry.offerId='boss-offer:'..self.serial; entry.deadline=self.now+self.inviteSeconds
                    slot.userId=userId; slot.tried[userId]=true
                    break
                end
            end
        end
    end
end

function BossQueue:_advance(now)
    if not finite(now) or now&lt;0 then return 'INVALID_TIME' end
    -- A delayed caller cannot roll back deadlines already observed by the server.
    self.now=math.max(self.now,now)
    for _,slot in ipairs(self.slotOrder) do
        if slot.state=='Open' and slot.userId then
            local entry=self.entries[slot.userId]
            if not entry or entry.slotId~=slot.id then
                slot.userId=nil
            elseif (entry.deadline and self.now&gt;=entry.deadline) or not self.eligible(entry.userId,slot.context) then
                if entry.state=='Invited' then self:_rotate(entry)
                else self:_forget(entry) end
            end
        end
    end
    self:_fill()
    return 'OK'
end

function BossQueue:register(slotId,bossId,context,now)
    if not identifier(slotId) then return 'INVALID_SLOT' end
    if not identifier(bossId) then return 'INVALID_BOSS' end
    local result=self:_advance(now); if result~='OK' then return result end
    if self.slots[slotId] then return 'SLOT_EXISTS' end
    local slot={id=slotId,bossId=bossId,context=context,state='Open',tried={}}
    self.slots[slotId]=slot; self.slotOrder[#self.slotOrder+1]=slot
    self:_fill()
    return 'OK'
end

function BossQueue:select(userId,bossId,now)
    if not validUser(userId) then return 'INVALID_USER' end
    if not identifier(bossId) then return 'INVALID_BOSS' end
    local result=self:_advance(now); if result~='OK' then return result end
    local entry=self.entries[userId]
    if entry and entry.bossId==bossId then return 'OK' end
    if entry and (entry.state=='Accepted' or entry.state=='Ready' or entry.state=='Active') then return 'ROLE_RESERVED' end
    if not self.eligible(userId,nil) then return 'INELIGIBLE' end
    if entry then self:_forget(entry) end
    entry={userId=userId,bossId=bossId,state='Queued'}
    self.entries[userId]=entry
    local waiting=self.waiting[bossId]
    if not waiting then waiting={}; self.waiting[bossId]=waiting end
    waiting[#waiting+1]=userId
    self:_fill()
    return 'OK'
end

function BossQueue:cancel(userId,now)
    if not validUser(userId) then return 'INVALID_USER' end
    local result=self:_advance(now); if result~='OK' then return result end
    local entry=self.entries[userId]
    if not entry then return 'OK' end
    if entry.state=='Active' then return 'ROLE_ACTIVE' end
    self:_forget(entry); self:_fill()
    return 'OK'
end

function BossQueue:reply(userId,offerId,accepted,now)
    if not validUser(userId) then return 'INVALID_USER' end
    if not identifier(offerId) then return 'INVALID_OFFER' end
    if type(accepted)~='boolean' then return 'INVALID_REPLY' end
    local result=self:_advance(now); if result~='OK' then return result end
    local entry=self.entries[userId]
    if not entry or entry.offerId~=offerId then return 'STALE_OFFER' end
    if entry.state~='Invited' then
        if accepted and (entry.state=='Accepted' or entry.state=='Ready' or entry.state=='Active') then return 'OK' end
        return 'STALE_OFFER'
    end
    if accepted then
        self:_removeWaiting(entry)
        entry.state='Accepted'; entry.deadline=self.now+self.connectSeconds
    else
        -- tried is retained by the slot, so this entry can only serve a future slot.
        self:_rotate(entry)
    end
    self:_fill()
    return 'OK'
end

function BossQueue:connect(userId,offerId,now)
    if not validUser(userId) then return 'INVALID_USER' end
    if not identifier(offerId) then return 'INVALID_OFFER' end
    local result=self:_advance(now); if result~='OK' then return result end
    local entry=self.entries[userId]
    if not entry or entry.offerId~=offerId then return 'STALE_OFFER' end
    if entry.state=='Ready' or entry.state=='Active' then return 'OK' end
    if entry.state~='Accepted' then return 'STALE_OFFER' end
    entry.state='Ready'; entry.deadline=nil
    return 'OK'
end

function BossQueue:step(now)
    return self:_advance(now)
end

function BossQueue:start(slotId,now)
    local result=self:_advance(now); if result~='OK' then return nil,result end
    local slot=self.slots[slotId]
    if not slot then return nil,'UNKNOWN_SLOT' end
    if slot.state=='Closed' then return nil,'SLOT_CLOSED' end
    if slot.state=='NPC' then return {state='NPC'} end
    if slot.state=='Human' then return {state='Human',userId=slot.userId} end
    local entry=slot.userId and self.entries[slot.userId]
    if entry then
        if entry.state~='Ready' then return {state='Waiting'} end
        entry.state='Active'; slot.state='Human'
        return {state='Human',userId=entry.userId}
    end
    slot.state='NPC'
    return {state='NPC'}
end

function BossQueue:close(slotId,now)
    if not finite(now) or now&lt;0 then return 'INVALID_TIME' end
    local slot=self.slots[slotId]
    if not slot then return 'UNKNOWN_SLOT' end
    -- Close before processing deadlines: expiry must not rotate this owner or
    -- create a replacement offer that closing would immediately discard.
    if slot.userId then
        local entry=self.entries[slot.userId]
        if entry then self:_forget(entry) end
    end
    slot.userId=nil; slot.state='Closed'
    return self:_advance(now)
end

function BossQueue:view(userId,now)
    local result=self:_advance(now); if result~='OK' then return {state='None'},result end
    local entry=self.entries[userId]
    if not entry then return {state='None'} end
    local view={state=entry.state,bossId=entry.bossId,offerId=entry.offerId,
        slotId=entry.slotId,deadline=entry.deadline}
    if entry.state=='Queued' or entry.state=='Invited' then
        for position,id in ipairs(self.waiting[entry.bossId]) do
            if id==userId then view.position=position; break end
        end
    end
    return view
end

return BossQueue
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT13">
          <Properties>
            <string name="Name">CampaignBoss</string>
            <ProtectedString name="Source">-- Original 3D encounters. Source byte arithmetic, C0/80 Life thresholds and
-- 0583 reaction progress are measured; seconds/studs, move bindings and attack
-- vulnerability windows are Roblox tuning (research/2026-11-09-campaign-bosses.md).
-- Session owns hero shields, damage, death and respawn. This object owns no hero resources.
local Boss={}
Boss.__index=Boss
local profiles={
    BigBlag={life=255,first='Hop',second='BellyDrop',name='Big Blag'},
    RoboManus={life=15,progress=true,first='Burst',second='Jump',name='Robo-Manus'},
    GeneralSlaughter={life=255,progress=true,first='Charge',second='Headbutt',name='General Slaughter'},
    Buzzball={life=207,first='Roll',second='Bounce',name='Buzzball'},
    DarkQueen={life=15,progress=true,first='Sweep',second='Spin',name='Dark Queen'},
}
local moves={
    Hop={tell=.55,active=.65,recovery=.8,radius=5,lift=6,damage='PigHeavy'},
    BellyDrop={tell=.8,active=.85,recovery=1.05,radius=7,lift=12,damage='WalkerHeavy'},
    Burst={tell=.45,active=.55,recovery=.8,shots=3,damage='DragonFire'},
    Jump={tell=.65,active=.8,recovery=.9,radius=6,lift=10,damage='WalkerHeavy'},
    Charge={tell=.65,active=.75,recovery=1.0,speed=38,radius=3.2,damage='PigRush'},
    Headbutt={tell=.35,active=.2,recovery=.65,reach=7,width=3.5,height=4,damage='PigHeavy'},
    Roll={tell=.45,active=1.0,recovery=.85,speed=32,radius=3,damage='DragonHeadbutt'},
    Bounce={tell=.55,active=.85,recovery=.8,radius=5.5,lift=9,damage='DragonFire'},
    Sweep={tell=.4,active=.25,recovery=.7,reach=8,width=4,height=4,damage='WalkerHeavy'},
    Spin={tell=.7,active=1.8,recovery=1.1,radius=3.2,orbit=8,damage='PigRush'},
}
local damageByAction={Punch=2,HeroJab=2,HeroKick=8,HeroUppercut=16,HeroPowerPunch=255,HeroBoot=255,HeroElbow=8,
    Club=16,PigJab=2,PigHeavy=16,PigRush=16,WalkerLight=2,WalkerHeavy=16,
    DragonHeadbutt=16,DragonFire=16,EnemyThrow=4,EnemyRunStrike=16}
local responseByAction={Punch=0,HeroJab=0,HeroKick=1,HeroUppercut=2,HeroPowerPunch=3,HeroBoot=6,HeroElbow=10,
    Club=2,PigJab=0,PigHeavy=2,PigRush=4,WalkerLight=0,WalkerHeavy=2,
    DragonHeadbutt=4,DragonFire=4,EnemyRunStrike=4}
local function finite(n) return type(n)=='number' and n==n and n&gt;-math.huge and n&lt;math.huge end
local function point(p) return type(p)=='table' and finite(p.x) and finite(p.y) and finite(p.z) end
local function copy(p) return {x=p.x,y=p.y,z=p.z} end
local function distance(a,b)
    if not point(a) or not point(b) then return math.huge end
    return math.sqrt((a.x-b.x)^2+(a.y-b.y)^2+(a.z-b.z)^2)
end
local function segmentDistance(a,b,p)
    if not point(a) or not point(b) or not point(p) then return math.huge end
    local x,y,z=b.x-a.x,b.y-a.y,b.z-a.z;local length=x*x+y*y+z*z
    local t=length&gt;0 and math.clamp(((p.x-a.x)*x+(p.y-a.y)*y+(p.z-a.z)*z)/length,0,1) or 0
    return distance({x=a.x+t*x,y=a.y+t*y,z=a.z+t*z},p)
end
local function aimVector(aim)
    if type(aim)~='table' or not finite(aim.x) or not finite(aim.z) then return nil end
    local length=math.sqrt(aim.x^2+aim.z^2)
    if not finite(length) or length&lt;.001 then return nil end
    return {x=aim.x/length,z=aim.z/length}
end
local function byteDamage(raw,damage)
    if raw&lt;damage then return 0,true end
    local after=raw-damage
    if math.floor(after/16)~=math.floor(raw/16) then after=math.floor(after/16)*16+15 end
    return after,false
end

function Boss.new(session,world,config,definition)
    local authored=definition.boss or {};local profile=assert(profiles[authored.type],'Unknown campaign boss')
    local now=session.now or 0;local origin=authored.position or {x=0,y=3,z=0}
    assert(point(origin),'Boss position must be finite')
    local gate=definition.bossGate or {};local actorId=session.state.runId..':boss:'..session.state.levelEpoch..':'..authored.type
    local arena=definition.arena
    local platform=authored.platform
    if not arena and type(platform)=='table' and finite(platform.x) and finite(platform.z)
        and finite(platform.w) and finite(platform.d) and platform.w&gt;6 and platform.d&gt;6 then
        arena={minX=platform.x-platform.w/2+3,maxX=platform.x+platform.w/2-3,
            minZ=platform.z-platform.d/2+3,maxZ=platform.z+platform.d/2-3}
    end
    local enemy={boss=true,kind=authored.type,name=profile.name,actorId=actorId,rawLife=profile.life,
        maxRawLife=profile.life,health=profile.life,maxHealth=profile.life,progress=profile.progress and 0 or nil,
        ownerUserId=gate.ownerUserId,connected=gate.connected~=false,connectionEpoch=gate.connectionEpoch or 1,lastSeq=0,dead=false}
    local self=setmetatable({session=session,world=world,config=config,definition=definition,profile=profile,
        kind=authored.type,enemies={[-99]=enemy},projectiles={},byUserId={},now=now,serial=0,attackSerial=0,
        state=authored.type=='Buzzball' and authored.chaseComplete~=true and 'Chase' or 'Ready',readyAt=now+.5,
        origin=copy(origin),arena=arena or {},defeated=false,ownerName=gate.ownerName},Boss)
    if gate.ownerUserId then self.byUserId[gate.ownerUserId]=-99 end
    assert(world:spawnEnemy(-99,authored.type,origin),'Campaign boss spawn failed')
    if world.enemyIdentity then world:enemyIdentity(-99,actorId,gate.ownerName) end
    self:_health();self:_log('CampaignBossSpawned',{bossType=self.kind,rawLife=enemy.rawLife,progress=enemy.progress})
    return self
end
function Boss:_log(kind,data)
    if self.session._record then self.session:_record(kind,-99,data,self.now) end
end
function Boss:_active() return not self.closed and not self.defeated and self.session.state.status=='Active' end
function Boss:_health()
    local e=self.enemies[-99];e.health=e.rawLife
    self.world:enemyHealth(-99,e.rawLife,e.maxRawLife)
end
function Boss:_phase()
    local e=self.enemies[-99]
    if self.kind=='BigBlag' then return e.rawLife&gt;=192 and 1 or e.rawLife&gt;=128 and 2 or 3 end
    if self.kind=='Buzzball' then return e.rawLife&gt;=128 and 1 or 2 end
    return (e.progress or 0)&gt;=120 and 2 or 1
end
function Boss:_bound(p)
    local a=self.arena;local o=self.origin
    return {x=math.clamp(p.x,a.minX or o.x-28,a.maxX or o.x+28),y=p.y,
        z=math.clamp(p.z,a.minZ or o.z-22,a.maxZ or o.z+22)}
end
function Boss:_contain()
    -- The source encounter is camera/arena locked. Constrain the boss body in
    -- every combat state, including physical knockback, so a reaction cannot
    -- strand it beneath its finite authored platform. Chase owns another route.
    if self.state=='Chase' then return end
    local p=self.world:position(-99);if not point(p) then return end
    local bounded=self:_bound(p);bounded.y=math.max(p.y,self.origin.y)
    if distance(p,bounded)&gt;.001 then self.world:placeActor(-99,bounded) end
end
function Boss:_targets()
    local ids={}
    for _,id in ipairs(self.session.order) do
        local h=self.session.state.heroes[id];local c=self.session.combat[id]
        if h and h.status=='Alive' and c and not c.deathAt and point(self.world:position(id)) then ids[#ids+1]=id end
    end
    for id,e in pairs(self.externalEnemies or {}) do
        if id~=-99 and not e.dead and point(self.world:position(id)) then ids[#ids+1]=id end
    end
    table.sort(ids);return ids
end
function Boss:_nearest()
    local origin=self.world:position(-99);local selected,best=nil,math.huge
    for _,id in ipairs(self:_targets()) do
        local range=distance(origin,self.world:position(id))
        if range&lt;best then selected,best=id,range end
    end
    return selected,best
end
function Boss:canMove() return self:_active() and self.state=='Ready' end
function Boss:_damage(target,action,hitSet)
    if hitSet[target] then return end
    hitSet[target]=true
    local tuning=self.config.Attacks[action] or self.config.Attacks.Dash
    if self.session.state.heroes[target] then self.session:_hit(-99,target,action,tuning)
    elseif self.enemyHit then self.enemyHit(-99,target,action,tuning) end
end
function Boss:_sweep(before,after,radius,attack)
    for _,id in ipairs(self:_targets()) do
        if segmentDistance(before,after,self.world:position(id))&lt;=radius then self:_damage(id,attack.move.damage,attack.hits) end
    end
end
function Boss:_radial(center,radius,attack)
    for _,id in ipairs(self:_targets()) do
        local p=self.world:position(id)
        if math.abs(p.y-center.y)&lt;=3.5 and (p.x-center.x)^2+(p.z-center.z)^2&lt;=radius^2 then
            self:_damage(id,attack.move.damage,attack.hits)
        end
    end
end
function Boss:_melee(attack)
    local p=self.world:position(-99);local m=attack.move
    for _,id in ipairs(self:_targets()) do
        local q=self.world:position(id);local x,z=q.x-p.x,q.z-p.z
        local forward=x*attack.aim.x+z*attack.aim.z;local side=x*attack.aim.z-z*attack.aim.x
        if forward&gt;=0 and forward&lt;=m.reach and math.abs(side)&lt;=m.width and math.abs(q.y-p.y)&lt;=m.height then
            self:_damage(id,m.damage,attack.hits)
        end
    end
end
function Boss:_removeProjectile(id)
    if not self.projectiles[id] then return end
    self.projectiles[id]=nil;self.world:removeProjectile(id)
end
function Boss:_clearProjectiles()
    local ids={};for id in pairs(self.projectiles) do ids[#ids+1]=id end
    for _,id in ipairs(ids) do self:_removeProjectile(id) end
end
function Boss:_projectile(attack,at,index)
    self.serial+=1;local id=-4001-self.serial*2;local origin=copy(self.world:position(-99))
    local angle=(index-2)*.10;local c,s=math.cos(angle),math.sin(angle)
    local aim={x=attack.aim.x*c-attack.aim.z*s,z=attack.aim.x*s+attack.aim.z*c}
    local p={position=origin,direction=aim,created=at,lastAt=at,expiresAt=at+2.5,action=attack.move.damage,hits={},attackSerial=attack.serial}
    self.projectiles[id]=p;self.world:projectile(id,p.position,false,'RoboBolt')
end
function Boss:_projectiles(now)
    local ids={};for id in pairs(self.projectiles) do ids[#ids+1]=id end;table.sort(ids)
    for _,id in ipairs(ids) do
        local p=self.projectiles[id];local duration=math.max(0,math.min(now,p.expiresAt)-p.lastAt)
        local before=p.position
        local after={x=before.x+p.direction.x*42*duration,y=before.y,z=before.z+p.direction.z*42*duration}
        local best,bestDistance=nil,math.huge
        for _,target in ipairs(self:_targets()) do
            local q=self.world:position(target)
            if segmentDistance(before,after,q)&lt;=2.1
                and not (self.world.campaignProjectileBlocked and self.world:campaignProjectileBlocked(before,q)) then
                local d=distance(before,q);if d&lt;bestDistance then best,bestDistance=target,d end
            end
        end
        if best then self:_damage(best,p.action,p.hits);self:_removeProjectile(id)
        elseif now&gt;=p.expiresAt or self.world.campaignProjectileBlocked and self.world:campaignProjectileBlocked(before,after) then self:_removeProjectile(id)
        else p.position=after;p.lastAt=now;self.world:projectile(id,after,false,'RoboBolt') end
    end
end
function Boss:_begin(name,aim,target)
    if not self:_active() then return 'RUN_CLOSED' end
    if self.state~='Ready' then return 'COOLDOWN' end
    local origin=self.world:position(-99);if not point(origin) then return 'NO_TARGET' end
    local direction=aimVector(aim)
    if aim~=nil and not direction then return 'INVALID_AIM' end
    if not direction then
        target=target or self:_nearest();local p=target and self.world:position(target)
        if not point(p) then return 'NO_TARGET' end
        direction=aimVector({x=p.x-origin.x,z=p.z-origin.z}) or {x=1,z=0}
    end
    local m=moves[name];local destination
    if target then destination=copy(self.world:position(target))
    else destination={x=origin.x+direction.x*12,y=origin.y,z=origin.z+direction.z*12} end
    destination.y=origin.y;destination=self:_bound(destination)
    self.attackSerial+=1
    self.attack={name=name,move=m,aim=direction,target=target,origin=copy(origin),destination=destination,
        tellAt=self.now+m.tell,activeUntil=self.now+m.tell+m.active,
        recoveryUntil=self.now+m.tell+m.active+m.recovery,hits={},shots=0,serial=self.attackSerial,lastAt=self.now+m.tell}
    self.state='Tell';self.enemies[-99].engaged=true
    if self.world.move then self.world:move(-99,0,0) end
    if self.world.aim then self.world:aim(-99,direction.x,direction.z) end
    if target and self.world.face then self.world:face(-99,target) end
    self.world:cue(-99,true)
    if self.world.bossTell then self.world:bossTell(name,destination,m.radius or m.reach or 3,self.attack.tellAt) end
    self:_log('CampaignBossAttack',{bossType=self.kind,attack=name,serial=self.attackSerial,phase=self:_phase(),effectAt=self.attack.tellAt})
    return 'OK'
end
function Boss:command(action,aim,now)
    if now~=nil then
        if not finite(now) or now&lt;0 then return 'INVALID_TIME' end
        if now&lt;self.now then return 'TIME_REVERSED' end
        self.now=now
    elseif finite(self.session.now) then self.now=math.max(self.now,self.session.now) end
    if not self:_active() then return 'RUN_CLOSED' end
    local e=self.enemies[-99]
    if e.ownerUserId and not e.connected then return 'OFFLINE' end
    if action~='Punch' and action~='Dash' then return 'INVALID_ACTION' end
    return self:_begin(self:_chooseAttack(action),aim)
end
function Boss:_chooseAttack(action)
    if action=='Dash' then return self.profile.second end
    if self.kind=='BigBlag' and self:_phase()==1 then return 'Hop' end
    return self.attackSerial%2==0 and self.profile.first or self.profile.second
end
function Boss:_motion(attack,at)
    local m=attack.move;local t=math.clamp((at-attack.tellAt)/m.active,0,1);local p
    if m.lift then
        p={x=attack.origin.x+(attack.destination.x-attack.origin.x)*t,
            y=attack.origin.y+math.sin(t*math.pi)*m.lift,z=attack.origin.z+(attack.destination.z-attack.origin.z)*t}
    elseif m.speed then
        local speed=m.speed*(self:_phase()==2 and self.kind=='GeneralSlaughter' and 1.2 or 1)
        p={x=attack.origin.x+attack.aim.x*speed*(at-attack.tellAt),y=attack.origin.y,
            z=attack.origin.z+attack.aim.z*speed*(at-attack.tellAt)}
    elseif m.orbit then
        p={x=attack.origin.x+math.sin(t*math.pi*4)*m.orbit,y=attack.origin.y,
            z=attack.origin.z+(1-math.cos(t*math.pi*4))*m.orbit*.5}
    else return copy(self.world:position(-99)) end
    return self:_bound(p)
end
function Boss:_attackStep(now)
    local a=self.attack;if not a then return end
    if self.state=='Tell' and now&gt;=a.tellAt then self.state='Active';self.world:cue(-99,false) end
    if self.state=='Active' then
        local m=a.move;local untilAt=math.min(now,a.activeUntil)
        if m.shots then
            for index=a.shots+1,m.shots do
                local at=a.tellAt+(index-1)*.18
                if at&gt;untilAt then break end
                self:_projectile(a,at,index);a.shots=index
            end
        elseif m.reach then self:_melee(a)
        elseif m.orbit then
            -- Curved spin is subdivided, so a coarse frame cannot cut through
            -- the orbit and strike a target the actual path never crossed.
            local cursor=a.lastAt
            while cursor&lt;untilAt do
                local nextAt=math.min(untilAt,cursor+.05)
                local before=self:_motion(a,cursor);local after=self:_motion(a,nextAt)
                self:_sweep(before,after,m.radius,a);cursor=nextAt
            end
            self.world:placeActor(-99,self:_motion(a,untilAt))
        elseif m.speed then
            local before=self:_motion(a,a.lastAt);local after=self:_motion(a,untilAt)
            self:_sweep(before,after,m.radius,a);self.world:placeActor(-99,after)
        elseif m.lift then self.world:placeActor(-99,self:_motion(a,untilAt)) end
        a.lastAt=untilAt
        if now&gt;=a.activeUntil then
            if m.lift then self:_radial(a.destination,m.radius,a) end
            self.state='Recovery';self.world:cue(-99,false)
        end
    end
    if self.state=='Recovery' and now&gt;=a.recoveryUntil then
        self.state='Ready';self.attack=nil;self.readyAt=now+.25
    end
end
function Boss:_defeat()
    if self.defeated then return end
    self.defeated=true;self.state='Defeated';self.attack=nil
    local e=self.enemies[-99];e.dead=true;e.rawLife=0;self:_health();self:_clearProjectiles()
    self.world:cue(-99,false);if self.world.kill then self.world:kill(-99) end
    self:_log('CampaignBossDefeated',{bossType=self.kind,progress=e.progress})
end
function Boss:hit(attacker,target,action,tuning)
    if finite(self.session.now) then self.now=math.max(self.now,self.session.now) end
    if target~=-99 or attacker==-99 or not self:_active()
        or self.state~='Ready' and self.state~='Recovery' and not (self.state=='Reaction' and self.lightReaction) then return false end
    local origin=self.world:position(attacker);local destination=self.world:position(-99)
    local cfg=self.config.Attacks[action];local damage=damageByAction[action]
    if action=='Dash' then damage=self.enemies[-99].rawLife&lt;16 and 255 or 16 end
    if not cfg or not damage or not point(origin) or not point(destination) then return false end
    local geometry=tuning or cfg
    -- Only server projectile collision code supplies this contact point. Public
    -- intents cannot carry tuning, target IDs or collision coordinates.
    local impact=tuning and tuning.impactPosition
    local reach=finite(geometry.reach) and geometry.reach or cfg.reach or 6
    local height=finite(geometry.height) and geometry.height or cfg.height or 4
    if impact~=nil then
        if not point(impact) or distance(impact,destination)&gt;2.5 then return false end
    elseif distance(origin,destination)&gt;reach+1 or math.abs(origin.y-destination.y)&gt;height then return false end
    if impact==nil and self.world.targets then
        local visible=false
        for _,id in ipairs(self.world:targets(attacker,geometry)) do if id==-99 then visible=true;break end end
        if not visible then return false end
    end
    local hero=self.session.state.heroes[attacker];local enemy=self.externalEnemies and self.externalEnemies[attacker]
    if hero then
        local c=self.session.combat[attacker]
        if hero.status~='Alive' or not c or c.deathAt then return false end
    elseif not enemy or enemy.dead and impact==nil then return false end
    local e=self.enemies[-99];local before=e.rawLife;local after,underflow=byteDamage(before,damage)
    e.rawLife=after
    self:_log('CampaignBossHit',{attacker=attacker,action=action,before=before,after=after,underflow=underflow,progress=e.progress})
    if underflow and (not self.profile.progress or e.progress&gt;=240) then self:_defeat();return true end
    if underflow then e.progress+=12 end
    self.attack=nil;self.state='Reaction';self.lightReaction=damage==2;self.heavyReaction=damage~=2
    self.reactionUntil=self.now+(self.lightReaction and 1.05 or .4)
    self.world:cue(-99,false);if self.world.setReaction then self.world:setReaction(-99,true) end
    local response=responseByAction[action] or (action=='Dash' and (damage==255 and 3 or 4))
    local impulse=response and self.config.Impulses[response]
    if impulse and self.world.impulse then self.world:impulse(-99,attacker,impulse,response) end
    self:_health();return true
end
function Boss:selectAction(input)
    local raw=self.enemies[-99].rawLife
    local heavy=self.state=='Reaction' and self.heavyReaction==true
    if input=='Dash' then return heavy and 'HeroBoot' or 'Dash' end
    if heavy then return raw&lt;8 and 'HeroBoot' or 'HeroKick' end
    if raw&lt;4 then return 'HeroPowerPunch' end
    if raw%16&lt;4 then return 'HeroUppercut' end
    return 'HeroJab'
end
function Boss:finishChase()
    if not self:_active() then return 'RUN_CLOSED' end
    if self.state~='Chase' then return 'NO_CHANGE' end
    self.state='Ready';self.readyAt=self.now+.5
    self:_log('BuzzballBattleStarted',{actorId=self.enemies[-99].actorId,rawLife=self.enemies[-99].rawLife})
    return 'OK'
end
function Boss:step(now,dt)
    if not finite(now) or now&lt;0 or dt~=nil and (not finite(dt) or dt&lt;0) then return 'INVALID_TIME' end
    if now&lt;self.now then return 'TIME_REVERSED' end
    self.now=now
    if not self:_active() then self:_clearProjectiles();return 'OK' end
    self:_contain()
    if self.state=='Reaction' and now&gt;=self.reactionUntil then
        local e=self.enemies[-99];e.rawLife=math.floor(e.rawLife/8)*8+7
        self.state='Ready';self.reactionUntil=nil;self.lightReaction=nil;self.heavyReaction=nil;self.readyAt=now+.25
        if self.world.setReaction then self.world:setReaction(-99,false) end;self:_health()
    end
    self:_attackStep(now);self:_projectiles(now)
    local e=self.enemies[-99]
    if self.state=='Ready' and not e.ownerUserId and now&gt;=self.readyAt then
        local target,range=self:_nearest()
        if target and range&lt;=80 then
            local name=self:_chooseAttack('Punch')
            self:_begin(name,nil,target)
        end
    end
    return 'OK'
end
function Boss:available() return {} end
function Boss:claim() return 'UNKNOWN_ENEMY' end
function Boss:connection(userId,connected)
    local e=self.enemies[-99]
    if userId~=e.ownerUserId then return 'UNKNOWN_ENEMY' end
    if type(connected)~='boolean' then return 'INVALID_CONNECTION' end
    if e.connected==connected then return 'NO_CHANGE' end
    e.connected=connected;e.connectionEpoch+=1;e.lastSeq=0
    if self.world.move then self.world:move(-99,0,0) end
    return 'OK'
end
function Boss:controlled(userId)
    local e=self.enemies[-99];if e.ownerUserId~=userId then return nil end
    return {enemyId=-99,actorId=e.actorId,attempt=1,connectionEpoch=e.connectionEpoch,connected=e.connected,
        status=e.dead and 'Dead' or 'Alive',template='Boss',name=self.ownerName or e.name,
        hearts=e.rawLife,maxHearts=e.maxRawLife,rawLife=e.rawLife,progress=e.progress,maxProgress=self.profile.progress and 240 or nil,
        bossType=self.kind,bossState=self.state,bossPhase=self:_phase()}
end
function Boss:snapshot()
    local e=self.enemies[-99]
    return {bossType=self.kind,bossName=e.name,bossRawLife=e.rawLife,bossMaxRawLife=e.maxRawLife,
        rawLife=e.rawLife,maxRawLife=e.maxRawLife,progress=e.progress,maxProgress=self.profile.progress and 240 or nil,
        bossProgress=e.progress,bossMaxProgress=self.profile.progress and 240 or nil,bossPhase=self:_phase(),
        bossState=self.state,bossAttack=self.attack and self.attack.name,bossDefeated=self.defeated,
        bossVulnerable=self:_active() and (self.state=='Ready' or self.state=='Recovery' or self.state=='Reaction' and self.lightReaction),projectiles=(function()
            local n=0;for _ in pairs(self.projectiles) do n+=1 end;return n end)()}
end
function Boss:close(reason)
    if self.closed then return end
    self.closed=reason or 'Closed';self.state='Closed';self.attack=nil;self:_clearProjectiles()
    self.world:cue(-99,false);if self.world.move then self.world:move(-99,0,0) end
    if self.world.setReaction then self.world:setReaction(-99,false) end
end
return Boss
</ProtectedString>
