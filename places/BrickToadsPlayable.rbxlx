      <Item class="ModuleScript" referent="BT49">
        <Properties>
          <string name="Name">BrickToadsConfig</string>
          <ProtectedString name="Source">-- BrickToads metadata shared by the server and client entry points.
return table.freeze({
    Name = "BrickToads",
})
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="BT50">
        <Properties>
          <string name="Name">HeroPortraits</string>
          <ProtectedString name="Source">-- Front portraits rendered directly from the authored game meshes.
-- Missing/unavailable images retain the small local portrait in the menu.
return table.freeze({
    ['Mr. Green'] = '81768891375221',
    ['Mr. Yellow'] = '112046401281853',
})
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="BT51">
        <Properties>
          <string name="Name">TextCatalog</string>
          <ProtectedString name="Source">-- English source strings and curated Russian translations. No user display names.
-- Roblox LocalizationTable entries; add supported languages to Values here.
local Catalog={entries={
    {Key="The Guardian approaches",Source="The Guardian approaches",Values={["en-us"]="The Guardian approaches",["ru"]="Страж приближается"}},
    {Key="1  ·  Flooded Gate",Source="1  ·  Flooded Gate",Values={["en-us"]="1  ·  Flooded Gate",["ru"]="1  ·  Затопленные ворота"}},
    {Key="2  ·  Broken Aqueduct",Source="2  ·  Broken Aqueduct",Values={["en-us"]="2  ·  Broken Aqueduct",["ru"]="2  ·  Разбитый акведук"}},
    {Key="3  ·  Stone Courtyard",Source="3  ·  Stone Courtyard",Values={["en-us"]="3  ·  Stone Courtyard",["ru"]="3  ·  Каменный двор"}},
    {Key="4  ·  Cliffs and Ledges",Source="4  ·  Cliffs and Ledges",Values={["en-us"]="4  ·  Cliffs and Ledges",["ru"]="4  ·  Обрыв и уступы"}},
    {Key="5  ·  Watchforge",Source="5  ·  Watchforge",Values={["en-us"]="5  ·  Watchforge",["ru"]="5  ·  Кузница дозора"}},
    {Key="6  ·  Long Bridge",Source="6  ·  Long Bridge",Values={["en-us"]="6  ·  Long Bridge",["ru"]="6  ·  Длинный мост"}},
    {Key="Heroes in combat: {count:int}",Source="Heroes in combat: {count:int}",Values={["en-us"]="Heroes in combat: {count:int}",["ru"]="Героев в бою: {count:int}"}},
    {Key="Ball hits: {count:int} / {maximum:int}",Source="Ball hits: {count:int} / {maximum:int}",Values={["en-us"]="Ball hits: {count:int} / {maximum:int}",["ru"]="Попаданий шаром: {count:int} / {maximum:int}"}},
    {Key="Enemies in district: {count:int}",Source="Enemies in district: {count:int}",Values={["en-us"]="Enemies in district: {count:int}",["ru"]="Противников в районе: {count:int}"}},
    {Key="Shots reflected: {count:int} / {maximum:int}",Source="Shots reflected: {count:int} / {maximum:int}",Values={["en-us"]="Shots reflected: {count:int} / {maximum:int}",["ru"]="Отражено снарядов: {count:int} / {maximum:int}"}},
    {Key="Enemies ahead: {count:int}",Source="Enemies ahead: {count:int}",Values={["en-us"]="Enemies ahead: {count:int}",["ru"]="Противников впереди: {count:int}"}},
    {Key="BOSS QUEUE",Source="BOSS QUEUE",Values={["en-us"]="BOSS QUEUE",["ru"]="ОЧЕРЕДЬ БОССА"}},
    {Key="Causeway Guardian",Source="Causeway Guardian",Values={["en-us"]="Causeway Guardian",["ru"]="Страж переправы"}},
    {Key="Joining the queue does not assign a role immediately or add Guardian health.",Source="Joining the queue does not assign a role immediately or add Guardian health.",Values={["en-us"]="Joining the queue does not assign a role immediately or add Guardian health.",["ru"]="Очередь не даёт роль сразу и не добавляет стражу здоровье."}},
    {Key="Unavailable",Source="Unavailable",Values={["en-us"]="Unavailable",["ru"]="Недоступно"}},
    {Key="Queued",Source="Queued",Values={["en-us"]="Queued",["ru"]="В очереди"}},
    {Key="Choosing a regular enemy leaves the queue.",Source="Choosing a regular enemy leaves the queue.",Values={["en-us"]="Choosing a regular enemy leaves the queue.",["ru"]="Выбор обычного противника отменит ожидание."}},
    {Key="Leave queue",Source="Leave queue",Values={["en-us"]="Leave queue",["ru"]="Покинуть очередь"}},
    {Key="Invitation · ",Source="Invitation · ",Values={["en-us"]="Invitation · ",["ru"]="Приглашение · "}},
    {Key=" s",Source=" s",Values={["en-us"]=" s",["ru"]=" с"}},
    {Key="Accept before time runs out.",Source="Accept before time runs out.",Values={["en-us"]="Accept before time runs out.",["ru"]="Примите до конца таймера."}},
    {Key="Accept the invitation before time runs out.",Source="Accept the invitation before time runs out.",Values={["en-us"]="Accept the invitation before time runs out.",["ru"]="Примите приглашение до таймера."}},
    {Key="Accept",Source="Accept",Values={["en-us"]="Accept",["ru"]="Принять"}},
    {Key="Connecting · ",Source="Connecting · ",Values={["en-us"]="Connecting · ",["ru"]="Подключение · "}},
    {Key="Connecting automatically… your role is reserved.",Source="Connecting automatically… your role is reserved.",Values={["en-us"]="Connecting automatically… your role is reserved.",["ru"]="Подключаем автоматически… роль зарезервирована."}},
    {Key="Cancel",Source="Cancel",Values={["en-us"]="Cancel",["ru"]="Отменить"}},
    {Key="Ready to fight",Source="Ready to fight",Values={["en-us"]="Ready to fight",["ru"]="Готово к бою"}},
    {Key="The Guardian is yours. Waiting for the encounter.",Source="The Guardian is yours. Waiting for the encounter.",Values={["en-us"]="The Guardian is yours. Waiting for the encounter.",["ru"]="Страж закреплён за вами. Ждём начала встречи."}},
    {Key="In combat",Source="In combat",Values={["en-us"]="In combat",["ru"]="В бою"}},
    {Key="You control the Causeway Guardian.",Source="You control the Causeway Guardian.",Values={["en-us"]="You control the Causeway Guardian.",["ru"]="Вы управляете стражем переправы."}},
    {Key="Role assigned",Source="Role assigned",Values={["en-us"]="Role assigned",["ru"]="Роль назначена"}},
    {Key="Queue available",Source="Queue available",Values={["en-us"]="Queue available",["ru"]="Можно записаться"}},
    {Key="Wait for an invitation before the Guardian encounter.",Source="Wait for an invitation before the Guardian encounter.",Values={["en-us"]="Wait for an invitation before the Guardian encounter.",["ru"]="Ждите приглашения перед встречей со стражем."}},
    {Key="Join the queue and accept an invitation before the heroes reach the Guardian.",Source="Join the queue and accept an invitation before the heroes reach the Guardian.",Values={["en-us"]="Join the queue and accept an invitation before the heroes reach the Guardian.",["ru"]="Встаньте в очередь и примите приглашение перед встречей героев со стражем."}},
    {Key="The queue is unavailable for your current role.",Source="The queue is unavailable for your current role.",Values={["en-us"]="The queue is unavailable for your current role.",["ru"]="Очередь сейчас недоступна для вашей роли."}},
