        <Item class="ModuleScript" referent="BT14">
          <Properties>
            <string name="Name">CampaignDefinition</string>
            <ProtectedString name="Source">-- Original BrickToads courses. Mode/family inventory follows FULL_GAME_SCOPE;
-- every distance, speed, geometry, population and timer here is Roblox tuning.
-- No ROM track data, music, art or unknown source object identities are copied.
local Definition={count=13,bossTypes={'CausewayGuardian','BigBlag','RoboManus','GeneralSlaughter','Buzzball','DarkQueen'}}
local MOD=2147483647
local function copy(v) if type(v)~='table' then return v end;local r={};for k,a in pairs(v) do r[k]=copy(a) end;return r end
local function floor(x,top,z,w,d) return {x=x,y=top-1,z=z,w=w,h=2,d=d} end
local function point(x,y,z) return {x=x,y=y,z=z or 0} end
local function volume(x,y,z,w,h,d) return {minX=x-w/2,maxX=x+w/2,minY=y-h/2,maxY=y+h/2,minZ=z-d/2,maxZ=z+d/2} end
local function hazard(id,kind,x,y,z,w,h,d,motion)
    return {id=id,kind=kind,x=x,y=y,z=z,w=w,h=h,d=d,motion=motion}
end
local names={"Flooded Causeway","Echo Shaft","Copper Rush","Frostworks","Tidal Foundry","Four Coil Vaults",
    "Ember Airway","Machine Ascent","Pressure Pipes","Fuse Pursuit","Magnetic Circuit","Turning Spire","Last Eclipse"}
local modes={'Causeway','Rope','Speeder','Ice','Surf','Serpents','Jet','Ascent','Tubes','Race','Clinger','Tower','Finale'}
local bossByLevel={[5]='BigBlag',[8]='RoboManus',[10]='GeneralSlaughter',[11]='Buzzball',[13]='DarkQueen'}
local objectives={Rope='Descend on the rope; swing clear of the shaft traps',Speeder='Board the speeder; steer and jump through the course',
    Ice='Control your slide across the frozen platforms',Surf='Board the surfboard and reach the shoreline',Serpents='Ride moving serpents through all four vaults',
    Jet='Board the jet and steer through the aerial gates',Ascent='Climb the lifts, springs and fan shafts',Tubes='Cross dry pipes and swim the flooded chambers',
    Race='Beat the rat to every bomb and defuse it',Clinger='Hold each route direction and stay ahead of the orb',Tower='Climb around the rotating spire and resist the wind',
    Finale='Enter the eclipse arena and defeat the final guardian'}
local function sourceModule(name)
    if script then return require(script.Parent[name]) end
    return require('./'..name)
end
function Definition.build(index,seed)
    assert(type(index)=='number' and index%1==0 and index&gt;=1 and index&lt;=13,'Invalid campaign index')
    assert(type(seed)=='number' and seed==seed and seed%1==0 and seed&gt;=1 and seed&lt;MOD,'Invalid campaign seed')
    if index==1 then
        local d=sourceModule('LevelVariation').build(sourceModule('LevelDefinition'),seed)
        d.campaignIndex=1;d.mode='Causeway';d.spawn=point(-65,3,0);d.boss.kind='CausewayGuardian';return d
    end
    local rng=(seed+index*7919)%(MOD-1)+1
    local choices={}
    local function choose() rng=rng*48271%MOD;local n=rng%3+1;choices[#choices+1]=n;return n end
    local c={hazards={},checkpoints={},supports={},media={},platforms={},tuning='ROBLOX_ORIGINAL_COURSE',speed=28}
    local d={id='campaign-'..index,name=names[index],campaignIndex=index,mode=modes[index],course=c,
        requiresClearAtExit=false,
        spawn=point(0,3,0),bounds={minX=-32,maxX=500,minY=-60,maxY=280,minZ=-56,maxZ=56},
        variation={version=1,seed=seed,sectionChoices=choices},calibration='ORIGINAL_ROBLOX_MODE_TUNING'}
    local platforms,enemies={},{}
    local function addFloor(x,y,z,w,depth) local p=floor(x,y,z,w,depth);platforms[#platforms+1]=p;return p end
    local function cp(x,y,z,progress) c.checkpoints[#c.checkpoints+1]={position=point(x,y,z),progress=progress} end
    local function foe(kind,x,y,z) enemies[#enemies+1]={id=-#enemies-1,kind=kind,x=x,y=y,z=z,rawLife=31} end
    local finish=point(180,3,0)
    if index==2 then
        c.anchor=point(0,258,0);c.ropeLength=15;c.descentSpeed=10;c.swingLimit=16;c.swingAcceleration=32;c.swingDamping=1.1;c.emitters={}
        d.spawn=point(0,240,0);addFloor(0,237,0,18,20);addFloor(0,0,0,46,32);cp(0,240,0,0)
        for n=1,9 do local v=choose();local y=220-n*20
            c.hazards[#c.hazards+1]=hazard('shaft-'..n,({'Raven','ElectricTrap','Toadtrap'})[(n-1)%3+1],(v-2)*10,y,0,9,5,18,
                n%3==0 and {axis='x',amplitude=5,period=3.5,phase=n} or nil)
            if n%3==0 then cp(0,y+12,0,240-y-12) end
        end
        for n=1,3 do c.emitters[n]={id='shaft-blaster-'..n,kind='RetroBlaster',position=point(n%2==0 and -22 or 22,225-n*55,0),interval=2.3,speed=15,life=3} end
        finish=point(0,3,0);c.axis='descent';d.bounds.maxX=38;d.bounds.maxY=270;d.bounds.minY=-25
    elseif index==3 or index==5 or index==7 then
        local surf=index==5;local jet=index==7
        c.speed=jet and 35 or (surf and 29 or 32);c.acceleration=jet and .45 or .35;c.maxSpeed=jet and 52 or 48
        c.mount=point(24,3,0);c.mountRange=7;c.finishDistance=420;c.laneLimit=18;c.steerSpeed=22;c.jumpSpeed=42
        -- Only the entry foot patrol blocks boarding. Rocket rats are actual
        -- later scripted encounters, never an enemy that must die before riding.
        addFloor(5,0,0,58,46);foe('Invader',28,3,-10)
        c.restart={stopSeconds=.35,rewindSeconds=.55,acceleration=110,tuning='ROBLOX_ORIGINAL_RESTART_TIMING'}
        c.encounters={}
        if index==3 or index==7 then c.encounters[1]={id='rocket-rat-pass-1',kind='RocketRat',progress=90,
            position=point(138,jet and 27 or 14,12),allowedDrop=true,
            trajectory={from=point(138,jet and 27 or 14,12),to=point(274,jet and 27 or 14,-12),duration=4,dropAt=1.5,dropGroundY=3}}
        end
        if surf then c.media[1]={kind='Water',minX=32,maxX=450,minY=-12,maxY=1,minZ=-25,maxZ=25} end
        if jet then c.altitudeMin=5;c.altitudeMax=31;c.mount.y=8 end
        c.ramps={};c.emitters={}
        cp(24,c.mount.y,0,0)
        local sectionX=54
        for n=1,12 do local v=choose();sectionX+=25+v;local x=sectionX
            local kind=jet and ({'AirMine','ElectricGate','Rocket'})[(n-1)%3+1] or
                (surf and ({'Mine','Log','Whirlpool'})[(n-1)%3+1] or ({'Wall','LowBarrier','Overhead'})[(n-1)%3+1])
            local y=jet and (8+(v-1)*9) or (kind=='Overhead' and 10 or 3)
            local h=jet and 9 or (kind=='Overhead' and 5 or (kind=='Wall' and 18 or 3))
            local z=jet and 0 or (v-2)*12;local depth=(jet or kind=='LowBarrier' or kind=='Log') and 44 or 12
            c.hazards[#c.hazards+1]=hazard('ride-'..n,kind,x,y,z,3,h,depth,
                kind=='Rocket' and {axis='z',amplitude=8,period=2.4,phase=n} or nil)
            if n==4 or n==8 then cp(x+12,c.mount.y,0,x+12-c.mount.x) end
            if index==3 and (n==2 or n==8) then c.ramps[#c.ramps+1]={id='ramp-'..n,x=x-10,y=1,z=0,w=10,h=2,d=12,launchSpeed=50} end
        end
        if surf or jet then for n=1,3 do c.emitters[n]={id='ride-launcher-'..n,kind='RocketLauncher',position=point(100+n*85,jet and 20 or 4,23),interval=3,speed=18,life=2} end end
        addFloor(439,0,0,62,48);finish=point(434,3,0);d.bounds.maxX=495;c.axis='x'
        if index==3 then
            -- The logical speeder floor is y=0 across every steering lane.
            -- Render that same solid road, overlapping both arrival and finish
            -- ledges; water and flight retain their distinct support geometry.
            addFloor((c.mount.x+finish.x)/2,0,0,finish.x-c.mount.x+24,c.laneLimit*2+10)
        end
    elseif index==4 then
        c.acceleration=19;c.friction=2.4;c.maxSpeed=25;c.gravity=150;c.jumpSpeed=51
        local cursor=-12
        for n=1,9 do local v=choose();local width=25+v*4;local z=(v-2)*3
            addFloor(cursor+width/2,(n%3==0 and 2 or 0),z,width,30);cursor+=width
            if n&lt;9 then cursor+=4 end
            if n%2==0 then c.hazards[#c.hazards+1]=hazard('ice-'..n,n%4==0 and 'Icicle' or 'Snowball',cursor-8,5,(v-2)*9,4,6,7,
                {axis=n%4==0 and 'y' or 'z',amplitude=n%4==0 and 4 or 10,period=3,phase=n}) end
            if n==3 or n==6 then cp(cursor-8,5,z,cursor-8) end
        end
        c.blocks={}
        for _,n in ipairs({2,6}) do local p=platforms[n]
            c.blocks[#c.blocks+1]={id='ice-block-'..n,kind='IceBlock',position=point(p.x,p.y+p.h/2+2,p.z+8),w=6,h=4,d=6,
                minX=p.x-p.w/2+4,maxX=p.x+p.w/2-4}
        end
        c.walls={}
        for _,n in ipairs({3,7}) do local p=platforms[n]
            c.walls[#c.walls+1]={id='ice-wall-'..n,kind='MovingWall',x=p.x,y=p.y+7,z=p.z+10,w=4,h=14,d=5,
                motion={axis='z',amplitude=3,period=4.5,phase=n}}
        end
        local p=platforms[4];local edge=p.x+p.w/2+2
        c.supports[1]={id='ice-shuttle',kind='MovingIcePlatform',w=7,h=1,d=12,speed=3,
            path={point(edge,p.y+1,-5),point(edge,p.y+1,5)}}
        for _,n in ipairs({3,7}) do local p=platforms[n]
            c.hazards[#c.hazards+1]=hazard('ice-spike-'..n,'Spike',p.x+4,p.y+3.5,9,5,5,5,
                {axis='y',amplitude=1.5,period=4,phase=n})
        end
        table.sort(c.hazards,function(a,b) return a.x&lt;b.x end)
        cp(0,3,0,0);finish=point(cursor-6,3,0);foe('Snowman',56,3,6);foe('Snowman',154,3,-7);d.bounds.maxX=cursor+52
    elseif index==6 then
        c.gravity=150;c.jumpSpeed=51;c.maxSpeed=16;c.rooms={}
        for room=1,4 do local v=choose();local base=(room-1)*80;local y=(room-1)*6
            addFloor(base,y,0,20,22);addFloor(base+72,y+6,0,20,24)
            local ex=volume(base+72,y+9,0,12,8,18)
            c.rooms[room]={id=room,exit=ex,start=point(base,y+3,0)}
            c.supports[room]={id='serpent-'..room,kind='Serpent',room=room,speed=10+v,w=15,h=1,d=14,segments=4,segmentSpacing=6,
                path={point(base+19,y+1,0),point(base+36,y+3,(v-2)*4),point(base+55,y+5,0),point(base+36,y+3,-(v-2)*4)}}
            c.hazards[#c.hazards+1]=hazard('coil-spike-'..room,'Spike',base+38,y+5,(v-2)*6,4,4,5)
            cp(base,y+3,0,room-1)
        end
        finish=point(312,27,0);d.bounds.maxX=350;c.axis='rooms'
    elseif index==8 then
        c.gravity=150;c.jumpSpeed=52;c.maxSpeed=16;c.fans={};c.springs={};c.lifts={};c.axis='ascent'
        addFloor(0,0,0,36,30);cp(0,3,0,0)
        for n=1,16 do local v=choose();local x=n%2==0 and -8 or 8;local y=n*6
            addFloor(x,y,(v-2)*2,25,24)
            if n==4 or n==12 then c.fans[#c.fans+1]={id='fan-'..n,x=x,y=y+7,z=0,w=12,h=14,d=14,force=170} end
            if n==6 then c.springs[1]={x=x,y=y+3,z=0,w=8,h=4,d=8,power=68} end
            if n==8 then cp(x,y+3,0,y) end
            if n%4==2 then c.hazards[#c.hazards+1]=hazard('ascent-'..n,'Gas',x+(v-2)*8,y+4,9,6,6,6,
                {axis='z',amplitude=5,period=4,phase=n}) end
            if n==5 or n==13 then c.hazards[#c.hazards+1]=hazard('ascent-electric-'..n,'ElectricTrap',x+7,y+5,8,6,8,7,
                {phase=n}) end
            if n==9 then c.hazards[#c.hazards+1]=hazard('ascent-piston','MechanicalCrusher',x+8,y+7,9,6,10,6,
                {axis='y',amplitude=5,period=3.5,phase=n}) end
        end
        c.lifts[1]={id='lift-a',kind='Lift',w=14,h=1,d=15,path={point(-24,16,0),point(-24,34,0)},speed=5}
        foe('SentryDrone',8,15,0);foe('Slug',-8,39,0);foe('GasTurret',8,63,8)
        finish=point(-8,99,0);d.bounds.maxX=65;d.bounds.maxY=150;d.bounds.minX=-65
    elseif index==9 then
        c.gravity=150;c.jumpSpeed=51;c.maxSpeed=16;c.swimSpeed=15;c.swimAcceleration=28;c.oxygenSeconds=18
        addFloor(12,0,0,50,30);addFloor(91,-18,0,112,34);addFloor(172,0,0,52,30)
        addFloor(246,-25,0,96,34);addFloor(321,0,0,58,36);cp(0,3,0,0);cp(174,3,0,174)
        c.media={{kind='Water',minX=35,maxX=148,minY=-17,maxY=5,minZ=-18,maxZ=18,current={x=-5,y=0,z=0}},
            {kind='Water',minX=196,maxX=295,minY=-24,maxY=5,minZ=-18,maxZ=18,current={x=4,y=-1.5,z=0}}}
        for n=1,6 do local v=choose();local x=46+n*37
            c.hazards[#c.hazards+1]=hazard('pipe-'..n,n%2==0 and 'Gear' or 'PipeCrusher',x,-5,(v-2)*9,5,10,8,
                {axis='y',amplitude=6,period=3.5,phase=n})
        end
        foe('Robot',20,3,6);foe('Electrofish',78,-6,-8);foe('Hammerfish',117,-8,7);foe('Shark',230,-9,-6);foe('Duck',276,-5,8)
        finish=point(337,3,0);d.bounds.maxX=390
    elseif index==10 then
        c.gravity=150;c.jumpSpeed=52;c.maxSpeed=19;c.axis='race';c.bombs={};c.ratSpeed=9
        addFloor(0,90,0,30,28);d.spawn=point(0,93,0);cp(0,93,0,0)
        for race=1,3 do local v=choose();local y=90-race*30;local x=(race%2==0 and -1 or 1)*(8+v*2)
            for stair=1,5 do addFloor(x*(stair%2==0 and -.3 or 1),90-(race-1)*30-stair*6,0,28,28) end
            c.bombs[race]={id='bomb-'..race,position=point(x,y+3,0),radius=7,
                checkpoint=point(x,y+3,0),ratStart=point(-x,y+28,0)}
            if race&lt;3 then cp(x,y+3,0,race) end
            c.hazards[#c.hazards+1]=hazard('race-gas-'..race,'Gas',-x,y+17,9,6,6,6)
        end
        foe('SentryDrone',0,75,7);foe('GasTurret',0,45,8);finish=point(c.bombs[3].position.x,3,0)
        d.bounds.minX=-60;d.bounds.maxX=60;d.bounds.maxY=140
    elseif index==11 then
        c.speed=24;c.chaseSpeed=22;c.chaseGap=32;c.chaseLife=207;c.path={};c.axis='path'
        local x,y,z=0,3,0;local directions={{x=1,z=0},{x=0,z=1},{x=-1,z=0},{x=0,z=-1}}
        for n=1,12 do local v=choose();local direction=directions[(n-1)%4+1];local length=32+v*6
            c.path[n]={from=point(x,y,z),direction=copy(direction),length=length}
            local nx,nz=x+direction.x*length,z+direction.z*length
            addFloor((x+nx)/2,0,(z+nz)/2,direction.x~=0 and length+8 or 9,direction.z~=0 and length+8 or 9)
            x,z=nx,nz
        end
        finish=point(x,y,z);d.bounds={minX=-70,maxX=120,minY=-30,maxY=65,minZ=-70,maxZ=120}
    elseif index==12 then
        c.gravity=150;c.jumpSpeed=52;c.maxSpeed=16;c.radius=23;c.rotationSpeed=.16;c.windForce=6;c.towerPlatforms={};c.springs={};c.axis='tower';c.renderDynamicPlatforms=true
        local v=choose();c.windPhase=v
        d.spawn=point(23,3,0);cp(23,3,0,0)
        for n=0,18 do local choice=choose();local angle=n*.48;local y=n*5.5;local radius=23+(choice-2)
            local x,z=math.cos(angle)*radius,math.sin(angle)*radius
            addFloor(x,y,z,18,18);c.towerPlatforms[#c.towerPlatforms+1]={angle=angle,radius=radius,y=y,w=18,d=18}
            if n==9 then cp(x,y+3,z,y) end
            if n==7 or n==14 then c.springs[#c.springs+1]={x=x,y=y+3,z=z,w=8,h=3,d=8,power=65,towerPlatform=#c.towerPlatforms} end
            if n&gt;0 and n%5==0 then c.hazards[#c.hazards+1]=hazard('spire-spike-'..n,'RotatingSpike',x,y+3,z,4,5,4,
                {axis='orbit',radius=radius,period=6,phase=angle}) end
        end
        foe('Hordhead',23,25,0);foe('Swellcheeks',-20,58,4);foe('FlyingHead',-4,86,-20)
        local final=c.towerPlatforms[#c.towerPlatforms];finish=point(math.cos(final.angle)*final.radius,final.y+3,math.sin(final.angle)*final.radius)
        d.bounds={minX=-64,maxX=64,minY=-30,maxY=160,minZ=-64,maxZ=64}
    elseif index==13 then
        local v=choose();addFloor(0,0,0,70+v*4,68+v*4);addFloor(43,0,0,22,24)
        finish=point(38,3,0);cp(0,3,0,0);c.axis='arena';d.bounds={minX=-60,maxX=110,minY=-30,maxY=90,minZ=-60,maxZ=60}
    end
    if #c.checkpoints==0 then cp(d.spawn.x,d.spawn.y,d.spawn.z,0) end
    table.sort(c.checkpoints,function(a,b) return a.progress&lt;b.progress end)
    if index==2 or index==3 or index==5 or index==7 then
        for n,p in ipairs(c.checkpoints) do if n&gt;1 then addFloor(p.position.x,p.position.y-3,p.position.z,16,20) end end
    end
    c.finishPoint=finish;c.finish=volume(finish.x,finish.y,finish.z,12,10,18);c.platforms=copy(platforms)
    local arenaX,arenaY,arenaZ=finish.x+34,finish.y-3,finish.z
    if index==2 or index==8 or index==10 or index==12 then arenaX=finish.x;arenaZ=finish.z+28 end
    local arena=floor(arenaX,arenaY,arenaZ,72,64)
    d.boss={kind=bossByLevel[index],position=point(arenaX+12,arenaY+3,arenaZ),platform=arena,gateX=arenaX+31,
        exit=volume(arenaX+28,arenaY+3,arenaZ,12,10,20),pad={x=arenaX+28,y=arenaY+.09,z=arenaZ,w=12,d=20}}
    d.zones={{id=d.mode..'Course',name=d.name,objective=objectives[d.mode],gateX=finish.x,exit=copy(c.finish),platforms=platforms,enemies=enemies}}
    d.bounds.maxX=math.max(d.bounds.maxX,arena.x+arena.w/2+8);d.bounds.minX=math.min(d.bounds.minX,arena.x-arena.w/2-8)
    d.bounds.maxZ=math.max(d.bounds.maxZ,arena.z+arena.d/2+8);d.bounds.minZ=math.min(d.bounds.minZ,arena.z-arena.d/2-8)
    sourceModule('CampaignRoster').apply(d,index)
    return d
end
return Definition
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT15">
          <Properties>
            <string name="Name">CampaignDirector</string>
            <ProtectedString name="Source">-- A campaign stage has independent traversal, ordinary-combat and boss gates.
-- The ordinary first-route director supplies family combat, never its exit FSM.
local CampaignDirector={}
CampaignDirector.__index=CampaignDirector
local function finite(value)
    return type(value)=='number' and value==value and value&gt;-math.huge and value&lt;math.huge
end

function CampaignDirector.new(session,world,Combat,config,deps)
    local self=setmetatable({session=session,world=world,config=config,deps=deps,
        definition=config.Level,now=session.now,stage=config.Level.mode or 'Course',bossSequences={},encounterSerial=0},CampaignDirector)
    self.modes=deps.CampaignModes.new(session,world,self.definition)
    world.campaignModes=self.modes
    self.ordinary=deps.Director.new(session,world,Combat,config,deps.GuardianPattern,deps.HealingFlies,
        deps.EnemyCarry,deps.WalkerClubs,deps.DragonFlight,deps.BossIntro)
    -- Authored campaign courses own topology and completion. Family AI still
    -- resolves its attacks, reactions, claims and same-body ownership normally.
    self.ordinary._zoneReached=function() return false end
    self.ordinary._boss=function() end
    self.enemies=table.clone(self.ordinary.enemies)
    self.ownerNames=self.ordinary.ownerNames
    self.ownerConnections=self.ordinary.ownerConnections or {}
    self.ordinary.ownerConnections=self.ownerConnections
    self.carry=self.ordinary.carry;self.clubs=self.ordinary.clubs;self.dragons=self.ordinary.dragons
    self.modes.canBoard=function() return self:_boardingCleared() end
    self.modes.spawnEncounter=function(event) return self:_spawnEncounter(event) end
    self.modes.resetEncounters=function(event) return self:_resetEncounters(event) end
    self.modes.ropeKick=function(slot,now) return self:_ropeKick(slot,now) end
    if deps.CampaignEnemies then
        self.campaignEnemies=deps.CampaignEnemies.new(self.ordinary)
        self.ordinary.campaignEnemies=self.campaignEnemies
        self.campaignEnemies.externalEnemies=self.enemies
        self.campaignEnemies.enemyHit=function(attacker,target,action,tuning) return self:hit(attacker,target,action,tuning) end
        self.campaignEnemies.vehicleObstacleHit=function(slot,owner,actorId) return self.modes:vehicleObstacleHit(slot) end
    end
    if self.modes.race then
        self.enemies[self.modes.race.enemyId]=self.modes.race.enemy
        self.modes.race.ownerNames=self.ownerNames
    end
    return self
end

function CampaignDirector:_boardingCleared()
    for id,enemy in pairs(self.ordinary.enemies) do
        if id~=-99 and not enemy.dead and not enemy.encounter
            and not (self.dragons and self.dragons:isMounted(id)) then return false end
    end
    return true
end
function CampaignDirector:_spawnEncounter(event)
    if self.closed or self.result then return false end
    self.encounterSerial+=1
    local row=table.clone(event)
    -- A course rewind is a new scripted appearance, never reuse an old identity.
    row.id=-200-self.encounterSerial
    assert(row.id&gt;-1000,'Too many scripted encounter appearances')
    local p=event.position
    row.x,row.y,row.z=p.x,p.y,p.z;row.spawnSerial=self.encounterSerial
    self.ordinary.now=self.session.now
    self.ordinary:_wave('Route',{row})
    local enemy=self.ordinary.enemies[row.id]
    enemy.encounter=true;enemy.encounterKey=event.id
    self.enemies[row.id]=enemy
    return row.id
end
function CampaignDirector:_resetEncounters(event)
    for id,enemy in pairs(self.ordinary.enemies) do
        -- Cleanup is unconditional; Modes separately decides which triggers
        -- lie beyond the checkpoint and may create a new scripted appearance.
        if enemy.encounter then
            if not enemy.dead then self.ordinary:_kill(id,'CourseRewind') end
            if self.campaignEnemies and self.campaignEnemies.expireEncounter then self.campaignEnemies:expireEncounter(id) end
        end
    end
end
function CampaignDirector:_ropeKick(slot,now)
    local hero=self.session.state.heroes[slot]
    local combat=self.session.combat[slot]
    if not hero or hero.status~='Alive' or not hero.connected or not combat or combat.deathAt then return 'NOT_ALIVE' end
    self.now=now;self.ordinary.now=now
    local code=self.session:_event('BeginAttack',slot,{connectionEpoch=hero.connectionEpoch})
    if code~='OK' then return code end
    self.world:hold(slot,false)
    local armed=self.campaignEnemies and self.campaignEnemies:hasRavenClaw(slot)
    local targets=self.world:targets(slot,self.config.Attacks[armed and 'RopeClaw' or 'RopeStrike'])
    self:closeTargetForAttack(targets)
    local action=armed and 'RopeClaw' or 'RopeStrike'
    for _,target in ipairs(targets) do
        local enemy=self.ordinary.enemies[target]
        if enemy and not enemy.dead then
            action=(enemy.kind~='LargeRaven' and enemy.rawLife and (enemy.rawLife&lt;16 or enemy.kind=='RetroBlaster' and enemy.rawLife&lt;32)) and 'RopeBoot'
                or (armed and 'RopeClaw' or 'RopeStrike')
            if self.ordinary:hit(slot,target,action,self.config.Attacks[action]) then break end
        elseif self.session.state.heroes[target] and self.session:_hit(slot,target,action,self.config.Attacks[action]) then break end
    end
    combat.lastStrikeAction='HeroKick';combat.strikeRecoveryUntil=now+.25
    self.session:_record('AttackAccepted',slot,{action=action,context='Rope',sourceAnimation='46/48/4E/50/52'})
    return 'OK'
end

function CampaignDirector:_ordinaryCleared()
    for id,enemy in pairs(self.ordinary.enemies) do
        if id~=-99 and not enemy.dead and not (self.dragons and self.dragons:isMounted(id)) then return false end
    end
    return true
end

function CampaignDirector:_startBoss(now,chase)
    local assigned=self.bossGate and self.bossGate(now) or {state='NPC'}
    if not assigned or assigned.state=='Waiting' then self.stage='BossReady';return false end
    local definition=table.clone(self.definition)
    definition.boss=table.clone(self.definition.boss)
    definition.boss.type=definition.boss.type or definition.boss.kind
    definition.boss.chaseComplete=chase~=true
    definition.bossGate={ownerUserId=assigned.state=='Human' and assigned.userId or nil,
        connected=assigned.state~='Human' or self.ownerConnections[assigned.userId]~=false,
        connectionEpoch=1,ownerName=assigned.userId and self.ownerNames[assigned.userId]}
    self.boss=self.deps.CampaignBoss.new(self.session,self.world,self.config,definition)
    self.boss.externalEnemies=self.enemies
    self.boss.enemyHit=function(attacker,target,action,tuning) return self:hit(attacker,target,action,tuning) end
    self.enemies[-99]=self.boss.enemies[-99]
    if chase then
        self.stage='Chase'
        self.modes.chaseActor=function(point)
            if self.boss.state=='Chase' then self.world:placeActor(-99,point) end
        end
        self.modes.chaseLife=self.boss.enemies[-99].rawLife
        if definition.bossGate.ownerUserId and self.modes.setChaseController then
            self.modes:setChaseController(definition.bossGate.ownerUserId,definition.bossGate.connected)
        end
    else self.stage='Boss' end
    self.world:stage(self.stage)
    return true
end

function CampaignDirector:step(now,dt)
    if self.closed or self.result then return end
    self.now=now;self.ordinary.now=now
    if self.session.state.status=='Lost' then
        self.result='Lost';self.stage='Lost';self.world:stage('Lost');self:close('Lost');return
    end
    if self.definition.mode=='Clinger' and not self.boss and not self:_startBoss(now,true) then return end
    self.modes:step(now,dt)
    self.ordinary:step(now,dt)
    if self.campaignEnemies then self.campaignEnemies:step(now,dt) end
    if self.boss then
        if self.boss.state=='Chase' and self.modes.complete then
            self.modes.chaseFinished=true
            self.world:placeActor(-99,self.definition.boss.position)
            self.boss:finishChase();self.stage='Boss';self.world:stage('Boss')
        end
        self.boss:step(now,dt)
        if self.boss.defeated and self.modes.complete then self.result='Won';self.stage='Won';self.world:stage('Won') end
    elseif self.modes.complete and (self.definition.requiresClearAtExit==false or self:_ordinaryCleared()) then
        local boss=self.definition.boss
        if boss and (boss.kind or boss.type) then self:_startBoss(now)
        else self.result='Won';self.stage='Won';self.world:stage('Won') end
    end
end

function CampaignDirector:hit(attacker,target,action,tuning)
    if self.closed or self.result then return false end
    if self.modes.race and self.modes.race:isTarget(target) then
        self.modes.race.now=math.max(self.now,self.session.now or 0)
        return self.modes.race:hit(attacker,target,action,tuning)
    end
    if target==-99 then
        if not self.boss then return false end
        self.boss.now=self.now
        return self.boss:hit(attacker,target,action,tuning)
    end
    self.ordinary.now=self.now
    return self.ordinary:hit(attacker,target,action,tuning)
end
function CampaignDirector:selectBossAction(target,input)
    if target==-99 and self.boss and self.boss.selectAction then return self.boss:selectAction(input) end
end
function CampaignDirector:_finishReaction(id,enemy) return self.ordinary:_finishReaction(id,enemy) end
function CampaignDirector:closeTargetForAttack(targets)
    if self.modes.race then self.modes.race:closeTargetForAttack(targets) end
    return self.ordinary:closeTargetForAttack(targets)
end
function CampaignDirector:controlled(userId)
    local boss=self.boss and self.boss:controlled(userId)
    local racer=self.modes.race and self.modes.race:controlled(userId)
    return boss or racer or self.ordinary:controlled(userId)
end
function CampaignDirector:available(userId)
    if self.closed or self.result or (self.boss and self.boss:controlled(userId)) then return {} end
    local race=self.modes.race
    if race and race:controlled(userId) then return {} end
    local offers=self.ordinary:available(userId)
    if race and not self.ordinary:controlled(userId) then
        for _,offer in ipairs(race:available(userId)) do offers[#offers+1]=offer end
    end
    return offers
end
function CampaignDirector:claim(userId,id)
    if self.closed or self.result then return 'RUN_CLOSED' end
    if id==-99 then return 'UNKNOWN_ENEMY' end
    if self.boss and self.boss:controlled(userId) then return 'ENEMY_ALREADY_OWNED' end
    if self.modes.race then
        if self.modes.race:controlled(userId) or self.ordinary:controlled(userId) and id==self.modes.race.enemyId then return 'ENEMY_ALREADY_OWNED' end
        if id==self.modes.race.enemyId then return self.modes.race:claim(userId,id) end
    end
    return self.ordinary:claim(userId,id)
end
function CampaignDirector:connection(userId,connected)
    if self.modes.race and self.modes.race:controlled(userId) then return self.modes.race:connection(userId,connected) end
    if self.boss and self.boss:controlled(userId) then
        if self.boss.state=='Chase' and self.modes.chaseConnection then self.modes:chaseConnection(connected) end
        return self.boss:connection(userId,connected)
    end
    return self.ordinary:connection(userId,connected)
end
function CampaignDirector:command(userId,payload,now,validator)
    if self.modes.race and self.modes.race:controlled(userId) then return self.modes.race:command(userId,payload,now,validator) end
    local role=self.boss and self.boss:controlled(userId)
    if not role then return self.ordinary:command(userId,payload,now,validator) end
    if type(validator)~='function' or not validator(payload) then return 'INVALID_INTENT' end
    if payload.runId~=self.session.state.runId then return 'WRONG_RUN' end
    if self.closed or self.result or self.session.state.status~='Active' then return 'RUN_CLOSED' end
    if not role.connected then return 'OFFLINE' end
    if role.status~='Alive' then return 'NOT_ALIVE' end
    if payload.actorId~=role.actorId or payload.attempt~=role.attempt
        or payload.levelEpoch~=self.session.state.levelEpoch then return 'STALE_ACTOR' end
    if payload.connectionEpoch~=role.connectionEpoch then return 'STALE_CONNECTION' end
    local sequence=self.bossSequences[userId]
    if sequence and sequence.connectionEpoch==role.connectionEpoch and payload.seq&lt;=sequence.seq then return 'STALE_SEQUENCE' end
    if not finite(now) or now&lt;0 then return 'INVALID_TIME' end
    if now&lt;self.now then return 'TIME_REVERSED' end
    self.now=now;self.bossSequences[userId]={connectionEpoch=role.connectionEpoch,seq=payload.seq}
    if self.boss.state=='Chase' then
        if payload.kind~='Move' then return 'CHASE_ONLY' end
        if self.modes.chaseCommand then return self.modes:chaseCommand(payload.x,payload.z,now) end
        return 'CHASE_ONLY'
    end
    if payload.kind=='Attack' then return self.boss:command(payload.attack,self.bossAim,now) end
    if not self.boss:canMove() then return 'REACTION' end
    if payload.kind=='Jump' then self.world:jump(-99)
    else
        local length=math.sqrt(payload.x^2+payload.z^2)
        if length&gt;0 then self.bossAim={x=payload.x/length,z=payload.z/length} end
        self.world:move(-99,payload.x,payload.z,false)
    end
    return 'OK'
end
function CampaignDirector:interaction(slot)
    local mode=self.modes:interaction(slot)
    if mode and (mode.available or mode.carrying) then
        mode.label=mode.label or mode.action
        if mode.kind=='CampaignKick' and self.campaignEnemies and self.campaignEnemies:hasRavenClaw(slot) then mode.label='Raven claw strike' end
        return mode
    end
    return self.ordinary:interaction(slot)
end
function CampaignDirector:interact(slot,now,action)
    local result=self.modes:interact(slot,now,action)
    if result~='NO_INTERACTION' then return result end
    return self.ordinary:interact(slot,now,action)
end
function CampaignDirector:cancelBossIntro(reason) return self.ordinary:cancelBossIntro(reason) end
function CampaignDirector:close(reason)
    if self.closed then return end
    self.closed=true
    self.modes:close(reason)
    if self.world.campaignModes==self.modes then self.world.campaignModes=nil end
    if self.boss then self.boss:close(reason) end
    if self.campaignEnemies then self.campaignEnemies:close(reason) end
    self.ordinary:cancelBossIntro(reason)
    for _,name in ipairs({'flies','carry','clubs','dragons'}) do
        local component=self.ordinary[name]
        if component and component.close then component:close(reason) end
    end
end
function CampaignDirector:snapshot()
    local data=self.ordinary:snapshot()
    local mode=self.modes:snapshot()
    data.stage=self.stage;data.mode=self.definition.mode;data.modeState=mode
    data.bossMechanic=self.boss and 'Campaign' or nil;data.bossHits=nil;data.bossMax=nil;data.bossIntro=nil
    data.objective=mode.objective or self.definition.objective or self.definition.name
    if self.definition.course and self.definition.course.mount and not self:_boardingCleared() then
        data.objective='Defeat the patrol before boarding'
    end
    data.campaignIndex=self.definition.campaignIndex;data.campaignCount=self.deps.CampaignDefinition and self.deps.CampaignDefinition.count or 13
    data.levelName=self.definition.name;data.result=self.result
    if self.modes.race then
        local rival=self.modes.race:snapshot()
        data.enemies[#data.enemies+1]={id=rival.enemyId,actorId=rival.actorId,kind='RacingRat',resourceKind='CourseRival',
            dead=rival.dead,courseRival=true,reactionEpoch=self.modes.race.enemy.reactionEpoch}
    end
    if self.stage=='BossReady' then data.objective='Assigning boss: waiting for the invited player' end
    if self.boss then
        data.boss=self.boss:snapshot();data.bossType=self.definition.boss.kind or self.definition.boss.type
        data.bossRawLife=data.boss.rawLife;data.bossProgress=data.boss.progress
        for key,value in pairs(data.boss) do if string.sub(key,1,4)=='boss' then data[key]=value end end
        data.objective=data.boss.objective or 'Defeat '..data.bossType
    end
    if self.result=='Won' then data.objective='Course cleared' elseif self.result=='Lost' then data.objective='Team eliminated' end
    return data
end
return CampaignDirector
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT16">
          <Properties>
            <string name="Name">CampaignEnemies</string>
            <ProtectedString name="Source">-- Original 3D family controllers. Source handler identities/attack families are
-- recorded in research/2026-11-09-campaign-enemies.md; all physical budgets,
-- attack bindings, populations and named-action mappings below are Roblox tuning.
-- Existing Director owns spawn, engagement, one-life claims, raw Life and damage.
local Enemies={}
Enemies.__index=Enemies
local families={
    Raven={mode='Fly',attack='Swoop',range=28,speed=10},LargeRaven={mode='Fly',attack='Swoop',range=30,speed=8},
    Invader={mode='Ground',attack='StealLife',range=16,speed=9},
    RocketRat={mode='Ride',attack='DropObstacle',range=35,speed=14},
    Snowman={mode='Ground',attack='Snowball',range=38,speed=4},
    SentryDrone={mode='Ground',attack='TwinBolt',range=40,speed=0},
    GasTurret={mode='Ground',attack='Gas',range=30,speed=0},
    RetroBlaster={mode='Wall',attack='Bolt',range=42,speed=0},
    SaturnToadtrap={mode='Wall',attack='Snap',range=9,speed=0},
    Robot={mode='Ground',attack='Bolt',range=36,speed=6},
    Slug={mode='Ground',attack='Latch',range=10,speed=5},
    Electrofish={mode='Swim',attack='Shock',range=8,speed=9},
    Hammerfish={mode='Swim',attack='Lunge',range=15,speed=10},
    Shark={mode='Swim',attack='Bite',range=18,speed=13},
    Duck={mode='Swim',attack='Bite',range=12,speed=7},
    Hordhead={mode='Ground',attack='Roll',range=15,speed=8},
    Swellcheeks={mode='Fly',attack='Gas',range=30,speed=8},
    FlyingHead={mode='Fly',attack='Swoop',range=25,speed=11},
}
local actions={
    Swoop={tell=.4,active=.75,recovery=.6,lift=-3,radius=2.6,damage='DragonHeadbutt'},
    Leap={tell=.35,active=.7,recovery=.6,lift=5,radius=2.8,damage='PigRush'},
    StealLife={tell=.35,active=.7,recovery=.6,lift=5,radius=2.8},
    DropObstacle={tell=.45,active=.1,recovery=.8,projectile='Obstacle',damage='WalkerHeavy'},
    Snowball={tell=.5,active=.15,recovery=.75,projectile='Snowball',speed=28,damage='DragonFire'},
    Bolt={tell=.45,active=.12,recovery=.65,projectile='Bolt',speed=34,damage='DragonFire'},
    TwinBolt={tell=.4,active=.15,recovery=.8,projectile='Bolt',speed=34,twin=true,damage='DragonFire'},
    Gas={tell=.5,active=.2,recovery=.9,projectile='GasCloud',speed=12,damage='PigJab'},
    Shock={tell=.4,active=.2,recovery=.8,radial=6,damage='DragonFire'},
    Lunge={tell=.4,active=.65,recovery=.6,lift=0,radius=2.8,damage='WalkerHeavy'},
    Bite={tell=.3,active=.6,recovery=.6,lift=0,radius=2.7,damage='PigHeavy'},
    Roll={tell=.4,active=.7,recovery=.8,lift=1.5,radius=3,damage='PigRush'},
    Snap={tell=.45,active=.25,recovery=.9,reach=9,width=3,height=4,damage='WalkerHeavy'},
    Latch={tell=.3,active=.6,recovery=.7,lift=3,radius=2.6,damage='PigJab'},
    Explode={tell=.8,active=.1,recovery=0,radial=7,damage='HeroBoot',selfDestruct=true},
}
local function finite(n) return type(n)=='number' and n==n and n&gt;-math.huge and n&lt;math.huge end
local function point(p) return type(p)=='table' and finite(p.x) and finite(p.y) and finite(p.z) end
local function copy(p) return {x=p.x,y=p.y,z=p.z} end
local function distance(a,b)
    if not point(a) or not point(b) then return math.huge end
    return math.sqrt((a.x-b.x)^2+(a.y-b.y)^2+(a.z-b.z)^2)
end
local function aim(x,z)
    if not finite(x) or not finite(z) then return nil end
    local length=math.sqrt(x*x+z*z)
    if not finite(length) or length&lt;.001 then return nil end
    return {x=x/length,z=z/length}
end
local function sweep(a,b,p)
    if not point(a) or not point(b) or not point(p) then return math.huge end
    local x,y,z=b.x-a.x,b.y-a.y,b.z-a.z;local length=x*x+y*y+z*z
    local t=length&gt;0 and math.clamp(((p.x-a.x)*x+(p.y-a.y)*y+(p.z-a.z)*z)/length,0,1) or 0
    return distance({x=a.x+x*t,y=a.y+y*t,z=a.z+z*t},p)
end
function Enemies.new(director)
    return setmetatable({director=director,session=director.session,world=director.world,config=director.config,
        runId=director.session.state.runId,levelEpoch=director.session.state.levelEpoch,
        now=director.now or 0,states={},projectiles={},lifeTokens={},debris={},ravenClaws={},serial=0},Enemies)
end
function Enemies:owns(_,e) return e~=nil and not e.boss and families[e.kind]~=nil end
function Enemies:movementKind(_,e) return e and families[e.kind] and families[e.kind].mode or nil end
function Enemies:_state(id,e)
    local state=self.states[id]
    if not state or state.actorId~=e.actorId then
        state={actorId=e.actorId,mode='Ready',nextAttack=e.nextAttack or self.now,origin=copy(self.world:position(id)),aim={x=1,z=0},startAt=self.now}
        self.states[id]=state
        local family=families[e.kind]
        if family.mode=='Ground' and self.world.campaignWalkSpeed then self.world:campaignWalkSpeed(id,family.speed) end
    end
    return state
end
function Enemies:stateFor(id) return self.states[id] and self.states[id].mode or 'Ready' end
function Enemies:_targets(id)
    local result,seen={},{}
    for _,target in ipairs(self.session.order) do
        local h,c=self.session.state.heroes[target],self.session.combat[target]
        if h.status=='Alive' and c and not c.deathAt and point(self.world:position(target)) then result[#result+1]=target;seen[target]=true end
    end
    for target,e in pairs(self.director.enemies) do
        if target~=id and not e.dead and point(self.world:position(target)) then result[#result+1]=target;seen[target]=true end
    end
    for target,e in pairs(self.externalEnemies or {}) do
        if target~=id and not seen[target] and not e.dead and point(self.world:position(target)) then result[#result+1]=target end
    end
    table.sort(result);return result
end
function Enemies:_nearest(id,direction)
    local p=self.world:position(id);local selected,best=nil,math.huge
    for _,target in ipairs(self.session.order) do
        local h,c=self.session.state.heroes[target],self.session.combat[target];local q=self.world:position(target)
        if h.status=='Alive' and c and not c.deathAt and point(q) then
            local d=distance(p,q);local front=not direction or (q.x-p.x)*direction.x+(q.z-p.z)*direction.z&gt;=0
            if front and d&lt;best then selected,best=target,d end
        end
    end
    return selected,best
end
function Enemies:_hit(id,target,action,hits,impactPosition)
    if hits[target] then return end;hits[target]=true
    local tuning=self.config.Attacks[action]
    if impactPosition then
        tuning=table.clone(tuning);tuning.impactPosition=copy(impactPosition)
    end
    if self.session.state.heroes[target] then return self.session:_hit(id,target,action,tuning) end
    if self.enemyHit then return self.enemyHit(id,target,action,tuning) end
    return self.director:hit(id,target,action,tuning)
end
function Enemies:_bounded(p,id)
    local b=self.config.Level and self.config.Level.bounds or {}
    local result={x=math.clamp(p.x,b.minX or -10000,b.maxX or 10000),
        y=math.clamp(p.y,b.minY or -10000,b.maxY or 10000),z=math.clamp(p.z,b.minZ or -10000,b.maxZ or 10000)}
    local e=id and self.director.enemies[id];local state=id and self.states[id]
    if e and families[e.kind].mode=='Swim' and state then
        local media=self.config.Level and self.config.Level.course and self.config.Level.course.media or {}
        for _,water in ipairs(media) do
            local o=state.origin
            if water.kind=='Water' and o.x&gt;=water.minX and o.x&lt;=water.maxX and o.y&gt;=water.minY
                and o.y&lt;=water.maxY and o.z&gt;=water.minZ and o.z&lt;=water.maxZ then
                result.x=math.clamp(result.x,water.minX+2,water.maxX-2)
                result.y=math.clamp(result.y,water.minY+2,water.maxY-2)
                result.z=math.clamp(result.z,water.minZ+2,water.maxZ-2);break
            end
        end
    end
    return result
end
function Enemies:_pose(id,p,mode,direction)
    p=self:_bounded(p,id)
    if self.world.campaignPose then self.world:campaignPose(id,p,'Enemy'..mode,direction)
    else self.world:placeActor(id,p) end
end
function Enemies:_waterPlane(s)
    local media=self.config.Level and self.config.Level.course and self.config.Level.course.media or {}
    local o=s.origin
    for _,water in ipairs(media) do
        if water.kind=='Water' and o.x&gt;=water.minX and o.x&lt;=water.maxX and o.y&gt;=water.minY and o.y&lt;=water.maxY
            and o.z&gt;=water.minZ and o.z&lt;=water.maxZ then return (water.minZ+water.maxZ)/2 end
    end
    return o.z
end
function Enemies:_floatMotion(id,s,family,p,move,duration)
    local result=copy(p)
    result.x+=move.x*family.speed*duration
    if family.mode=='Swim' then
        result.y-=move.z*family.speed*duration
        local center=self:_waterPlane(s);local delta=center-result.z
        result.z+=math.clamp(delta,-family.speed*duration*.5,family.speed*duration*.5)
    else
        result.z+=move.z*family.speed*duration
        local gravity=family.speed*2
        local vy=s.flyVy or 0;result.y+=vy*duration-gravity*duration^2/2
        s.flyVy=vy-gravity*duration
        local bounds=self.config.Level and self.config.Level.bounds or {}
        local low=math.max(s.origin.y-12,(bounds.minY or -10000)+3)
        local high=math.min(s.origin.y+24,(bounds.maxY or 10000)-3)
        if result.y&lt;low then result.y=low;s.flyVy=0 end
        if result.y&gt;high then result.y=high;s.flyVy=0 end
    end
    self:_pose(id,result,family.mode,s.aim)
end
function Enemies:_flap(s,family)
    if self.now&lt;(s.flapAt or 0) then return 'COOLDOWN' end
    s.flyVy=family.speed;s.flapAt=self.now+.25
    return 'OK'
end
function Enemies:_release(id)
    local e=self.director.enemies[id];local s=self.states[id]
    if e and not e.dead and families[e.kind] and families[e.kind].mode=='Wall' and s then
        self:_pose(id,s.origin,'Wall',s.aim);return
    end
    if self.world.campaignRelease then self.world:campaignRelease(id) end
end
function Enemies:onHit(id)
    self.now=math.max(self.now,self.director.now or 0)
    local state=self.states[id]
    local token=state and state.stolenKey and self.lifeTokens[state.stolenKey]
    if token and token.mode=='Carried' then
        token.mode='Returning';token.expiresAt=self.now+3
        token.position=copy(self.world:position(id) or token.position)
    end
    if state then state.mode='Ready';state.attack=nil;state.latch=nil;state.move=nil;state.nextAttack=self.now+.4 end
    self:_release(id)
end
function Enemies:forgetEnemy(id) self:onHit(id);self.states[id]=nil end
function Enemies:_begin(id,e,name,direction,target)
    local s=self:_state(id,e)
    if self.closed or e.dead then return 'NOT_ALIVE' end
    if e.reactionUntil then return 'REACTION' end
    if s.mode~='Ready' or self.now&lt;s.nextAttack then return 'COOLDOWN' end
    if name=='StealLife' and s.hasStolen then return 'NO_AMMO' end
    local p=self.world:position(id);if not point(p) then return 'NO_TARGET' end
    local dir=direction or s.aim
    target=target or self:_nearest(id,dir)
    local q=target and self.world:position(target)
    if not q then q={x=p.x+dir.x*10,y=p.y,z=p.z+dir.z*10} end
    local family=families[e.kind];local m=actions[name]
    if distance(p,q)&gt;family.range then q={x=p.x+dir.x*family.range,y=p.y,z=p.z+dir.z*family.range};target=nil end
    if family.mode=='Ground' then q={x=q.x,y=p.y,z=q.z} end
    s.aim=dir;s.mode='Tell';s.move=nil
    s.attack={name=name,move=m,origin=copy(p),destination=self:_bounded(q,id),aim=dir,target=target,
        at=self.now+m.tell,untilAt=self.now+m.tell+m.active,recoverAt=self.now+m.tell+m.active+m.recovery,
        lastAt=self.now+m.tell,hits={},reactionEpoch=e.reactionEpoch or 0}
    e.engaged=true;e.windup=nil;e.lastMove=nil
    self.world:move(id,0,0);self.world:cue(id,true)
    if family.mode~='Ground' then self:_pose(id,p,family.mode,dir) end
    if self.world.aim then self.world:aim(id,dir.x,dir.z) end
    if self.world.bossTell then self.world:bossTell(e.kind..name,s.attack.destination,m.radial or m.radius or 2,s.attack.at) end
    if self.director._log then self.director:_log('CampaignEnemyAttack',id,{kind=e.kind,attack=name,actorId=e.actorId,effectAt=s.attack.at}) end
    return 'OK'
