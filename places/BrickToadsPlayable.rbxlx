            <string name="Name">CanonicalAnimation</string>
            <ProtectedString name="Source">-- Source-derived presentation queries only: no physics, health, damage or remotes.
-- Clock units are unpaused interpreter calls, never claimed wall-clock parity.
local Animation={}
local MAX_CALLS=4096
local function freeze(value)
    if type(value)=='table' and not table.isfrozen(value) then
        for _,item in pairs(value) do freeze(item) end
        table.freeze(value)
    end
    return value
end
local function integer(v) return type(v)=='number' and v==v and v&gt;-math.huge and v&lt;math.huge and v%1==0 end

