        <Item class="ModuleScript" referent="BT18">
          <Properties>
            <string name="Name">CampaignRace</string>
            <ProtectedString name="Source">-- A physical course rival, not an ordinary three-heart enemy. Source evidence:
-- research/2026-11-09-campaign-race.md. All spatial/timing budgets are authored.
-- Session alone commits hero deaths and later paid respawns.
local Race={};Race.__index=Race
local FIXED=1/60
local HEIGHT=3
-- The rat's authored body is four studs tall: three below its root and one
-- above, so the six-stud stair spacing leaves actual head clearance.
local TOP=1
local INPUT_TIMEOUT=.35
local function finite(n) return type(n)=='number' and n==n and n&gt;-math.huge and n&lt;math.huge end
local function copy(p) return {x=p.x,y=p.y,z=p.z} end
local function point(x,y,z) return {x=x,y=y,z=z or 0} end
local function distance(a,b) return math.sqrt((a.x-b.x)^2+(a.y-b.y)^2+(a.z-b.z)^2) end
local function clamp(n,a,b) return math.max(a,math.min(b,n)) end
local function normalized(x,z)
    local n=math.sqrt(x*x+z*z);if n&gt;1 then return x/n,z/n end;return x,z
end
local function direction(x,z)
    local n=math.sqrt(x*x+z*z);if n&lt;.001 then return 0,0 end;return x/n,z/n
end
local function sweptContact(a,b,p,radius)
    -- The bomb uses a finite body volume, not a distance-to-route percentage.
    local enter,leave=0,1
    for _,axis in ipairs({'x','y','z'}) do
        local extent=axis=='y' and 2.6 or radius
        local first=a[axis]-p[axis];local delta=b[axis]-a[axis]
        if math.abs(delta)&lt;1e-8 then if math.abs(first)&gt;extent then return false end
        else
            local lo,hi=(-extent-first)/delta,(extent-first)/delta
            if lo&gt;hi then lo,hi=hi,lo end
            enter=math.max(enter,lo);leave=math.min(leave,hi);if enter&gt;leave then return false end
        end
    end
    return leave&gt;=0 and enter&lt;=1
end

function Race.new(session,world,definition)
    assert(session and world and definition and definition.mode=='Race' and definition.course,'A race course is required')
    assert(type(world.spawnEnemy)=='function','The race rival requires a real enemy body')
    assert(definition.course.bombs and #definition.course.bombs&gt;0,'The race requires authored bombs')
    local epoch=session.state.levelEpoch
    local actorId=session.state.runId..':course-rival:'..epoch..':rat'
    local self=setmetatable({session=session,world=world,definition=definition,course=definition.course,enemyId=-98,
        levelEpoch=epoch,runId=session.state.runId,now=session.now or 0,elapsed=0,simulationTime=0,bombIndex=1,
        failed=false,completeBombs=false,closed=false,discardedSeconds=0,radius=definition.course.ratRadius or 1.3,
        velocity=point(0,0,0),input={x=0,z=0,at=-math.huge},grounded=false,
        enemy={actorId=actorId,kind='RacingRat',courseRival=true,connected=true,connectionEpoch=1,lastSeq=0,
            engaged=false,dead=false,reactionEpoch=0}},Race)
    self.position=copy(self.course.bombs[1].ratStart)
    assert(world:spawnEnemy(self.enemyId,'RacingRat',self.position),'Race rival spawn failed')
    if world.enemyIdentity then world:enemyIdentity(self.enemyId,actorId) end
    if world.courseRival then world:courseRival(self.enemyId,'RACING RAT') end
    self:_beginRound('Initial')
    return self
end
function Race:_log(kind,slot,data)
    if self.session._record then self.session:_record(kind,slot,data,self.now) end
end
function Race:_validContext()
    return self.session.state.runId==self.runId and self.session.state.levelEpoch==self.levelEpoch
end
function Race:_living(slot)
    local h,c=self.session.state.heroes[slot],self.session.combat[slot]
    return h and h.status=='Alive' and c and not c.deathAt and self.world:position(slot)~=nil
end
function Race:_controlledHero(slot)
    local h,c=self.session.state.heroes[slot],self.session.combat[slot]
    return self:_living(slot) and h.connected~=false and not c.reactionEnd
        and not (h.shield and h.shield.kind=='Emergency' and self.now&lt;h.shield.deadline)
end
function Race:_pose()
    if self.world.campaignPose then self.world:campaignPose(self.enemyId,self.position,'RaceRival',self.velocity)
    else self.world:placeActor(self.enemyId,self.position) end
end
function Race:_ground(previous)
    local best=-math.huge;local support
    for index,p in ipairs(self.course.platforms or {}) do
        local y=p.y+p.h/2+HEIGHT
        if math.abs(self.position.x-p.x)&lt;=p.w/2 and math.abs(self.position.z-p.z)&lt;=p.d/2
            and previous.y&gt;=y-.4 and self.position.y&lt;=y+.12 and self.velocity.y&lt;=0 and y&gt;best then
            best=y;support=index
        end
    end
    if best&gt;-math.huge then self.position.y=best;self.velocity.y=0;self.grounded=true;self.support=support
    else self.grounded=false;self.support=nil end
end
function Race:_beginRound(reason)
    local bomb=self.course.bombs[self.bombIndex]
    if not bomb then self.completeBombs=true;self:_retire('BombsDefused');return end
    -- A verified defuse or committed retry authorizes the next authored start.
    -- Claiming a role and individual move packets never call this method.
    self.position=copy(bomb.ratStart);self.previous=copy(self.position);self.velocity=point(0,0,0)
    self.input={x=0,z=0,at=-math.huge};self.route=nil;self.stunnedUntil=nil;self.failed=false;self.failedAttempts=nil
    self.elapsed=0;self.grounded=false;self.support=nil;self.nextHop=0
    self.introRemaining=self.course.ratIntroSeconds==nil and 2 or math.max(0,self.course.ratIntroSeconds)
    self:_ground(self.position);self:_pose()
    if self.world.setReaction then self.world:setReaction(self.enemyId,false) end
    self:_log('CampaignRaceStarted',nil,{bomb=self.bombIndex,reason=reason,actorId=self.enemy.actorId,position=copy(self.position)})
end
function Race:resetRound(reason)
    if self.closed or self.completeBombs or not self:_validContext() then return false end
    if reason~='CommittedRetry' and reason~='BombDefused' then return false end
    self:_beginRound(reason);return true
end
function Race:_retry()
    if not self.failed then return false end
    for _,slot in ipairs(self.session.order) do
        local h=self.session.state.heroes[slot]
        local attempt=self.failedAttempts and self.failedAttempts[slot]
        if attempt and self:_living(slot) and h.attempt&gt;attempt then return self:resetRound('CommittedRetry') end
    end
    return false
end
function Race:_lose()
    if self.failed or self.completeBombs or self.closed then return end
    self.failed=true;self.failedAttempts={};self.input={x=0,z=0,at=-math.huge};self.velocity.x=0;self.velocity.z=0
    for _,slot in ipairs(self.session.order) do
        -- A death already pending in Session still belongs to this failed
        -- round. Only its later committed attempt can authorize the retry.
        local hero=self.session.state.heroes[slot]
        if hero then self.failedAttempts[slot]=hero.attempt end
        if self:_living(slot) then
            self.session:_die(slot,'CampaignRatWon')
        end
    end
    self:_log('CampaignRaceLost',nil,{bomb=self.bombIndex,actorId=self.enemy.actorId,position=copy(self.position)})
    local bomb=self.course.bombs[self.bombIndex]
    if self.world.campaignObject then self.world:campaignObject(bomb.id,'Bomb',bomb.position,{w=3,h=3,d=3},
        {collidable=false,role='Exploded',label='EXPLODED',alpha=.75}) end
end

function Race:_dropRoute()
    local bomb=self.course.bombs[self.bombIndex]
    local current=self.support and self.course.platforms[self.support]
    if not current or self.position.y&lt;=bomb.position.y+.25 then self.route=nil;return end
    local nextFloor,nextY=nil,-math.huge
    local currentY=current.y+current.h/2+HEIGHT
    for _,p in ipairs(self.course.platforms or {}) do
        local y=p.y+p.h/2+HEIGHT
        if y&lt;currentY-.2 and y&gt;=bomb.position.y-.2 and y&gt;nextY then nextFloor=p;nextY=y end
    end
    if not nextFloor then self.route=nil;return end
    -- Original randomized floors determine the route. A drop must cross the
    -- real edge and then land; this point is steering, never a placement.
    local dx,dz=nextFloor.x-current.x,nextFloor.z-current.z
    local axis=math.abs(dx)&gt;=math.abs(dz) and 'x' or 'z'
    local difference=axis=='x' and dx or dz
    if math.abs(difference)&lt;.001 then axis='x';difference=bomb.position.x-current.x;if math.abs(difference)&lt;.001 then difference=1 end end
    local sign=difference&gt;0 and 1 or -1
    local edge=axis=='x' and current.x+sign*(current.w/2+self.radius+.25)
        or current.z+sign*(current.d/2+self.radius+.25)
    local target=point(nextFloor.x,nextY,nextFloor.z);target[axis]=edge
    self.route={phase='Leave',fromY=currentY,target=target,landing=point(nextFloor.x,nextY,nextFloor.z),axis=axis}
end
function Race:_npcInput()
    local bomb=self.course.bombs[self.bombIndex]
    if self.grounded then
        if self.route and self.position.y&lt;self.route.fromY-.5 then self.route=nil end
        if not self.route then self:_dropRoute() end
    end
    local route=self.route
    if route and self.position.y&lt;route.fromY-HEIGHT-.2 then route.phase='Fall' end
    local goal=route and (route.phase=='Leave' and route.target or route.landing) or bomb.position
    local x,z=direction(goal.x-self.position.x,goal.z-self.position.z)
    if math.abs(goal.x-self.position.x)&lt;.15 then x=0 end
    if math.abs(goal.z-self.position.z)&lt;.15 then z=0 end
    return x,z
end
function Race:_collisions(previous)
    local obstacles={}
    for _,p in ipairs(self.course.platforms or {}) do obstacles[#obstacles+1]=p end
    for _,p in ipairs(self.course.raceObstacles or {}) do obstacles[#obstacles+1]=p end
    local blocked=false
    for _,p in ipairs(obstacles) do
        local top=p.y+p.h/2;local bottom=p.y-p.h/2
        if previous.y-HEIGHT&lt;top-.05 and self.position.y+TOP&gt;bottom+.05 and self.position.y-HEIGHT&lt;top-.05 then
            local ex,ez=p.w/2+self.radius,p.d/2+self.radius
            if math.abs(self.position.z-p.z)&lt;ez then
                if previous.x&lt;=p.x-ex+.001 and self.position.x&gt;p.x-ex then
                    self.position.x=p.x-ex;self.velocity.x=0;blocked=true
                elseif previous.x&gt;=p.x+ex-.001 and self.position.x&lt;p.x+ex then
                    self.position.x=p.x+ex;self.velocity.x=0;blocked=true
                end
            end
            if math.abs(self.position.x-p.x)&lt;ex then
                if previous.z&lt;=p.z-ez+.001 and self.position.z&gt;p.z-ez then self.position.z=p.z-ez;self.velocity.z=0;blocked=true
                elseif previous.z&gt;=p.z+ez-.001 and self.position.z&lt;p.z+ez then self.position.z=p.z+ez;self.velocity.z=0;blocked=true end
            end
        end
    end
    return blocked
end
function Race:_jump()
    if not self.grounded then return false end
    self.velocity.y=self.course.ratJumpSpeed or 29;self.grounded=false;self.support=nil
    self.nextHop=self.simulationTime+.65
    self:_log('CampaignRaceRatJump',nil,{bomb=self.bombIndex,actorId=self.enemy.actorId})
    return true
end
function Race:_slice(dt)
    self.simulationTime+=dt;self.elapsed+=dt
    local starting=self.introRemaining&gt;0
    if starting then self.introRemaining=math.max(0,self.introRemaining-dt) end
    local old=copy(self.position);self.previous=old
    local stunned=self.stunnedUntil and self.now&lt;self.stunnedUntil
    if self.stunnedUntil and not stunned then
        self.stunnedUntil=nil;if self.world.setReaction then self.world:setReaction(self.enemyId,false) end
    end
    local x,z=0,0
    if not stunned then
        if not starting then
            if self.enemy.ownerUserId then
                if self.enemy.connected and self.now-self.input.at&lt;=INPUT_TIMEOUT then x,z=self.input.x,self.input.z end
            else x,z=self:_npcInput() end
        end
        local speed=self.course.ratSpeed or 9
        self.velocity.x=x*speed;self.velocity.z=z*speed
        if math.abs(x)+math.abs(z)&gt;.001 then self.enemy.engaged=true end
    else
        local damping=math.exp(-2.6*dt);self.velocity.x*=damping;self.velocity.z*=damping
    end
    self.velocity.y-=(self.course.gravity or 150)*dt
    self.position.x+=self.velocity.x*dt;self.position.y+=self.velocity.y*dt;self.position.z+=self.velocity.z*dt
    local blocked=self:_collisions(old)
    self:_ground(old)
    -- Both controllers use the same supported automatic obstacle hop. A tall
    -- obstruction remains an obstruction: hop height cannot bypass it.
    if blocked and not stunned and self.grounded and math.abs(x)+math.abs(z)&gt;.001 and self.simulationTime&gt;=self.nextHop then self:_jump() end
    local bounds=self.definition.bounds or {}
    self.position.x=clamp(self.position.x,bounds.minX or -10000,bounds.maxX or 10000)
    self.position.z=clamp(self.position.z,bounds.minZ or -10000,bounds.maxZ or 10000)
    self:_pose()
    local bomb=self.course.bombs[self.bombIndex]
    if bomb and sweptContact(old,self.position,bomb.position,self.radius+1.5) then self:_lose() end
    if self.position.y&lt;(bounds.minY or -60)-10 then self:_retire('Fell') end
end
function Race:step(now,dt)
    if self.closed then return end
    if not self:_validContext() then self:close('StaleLevel');return end
    if self.session.state.status~='Active' then self:close('RunClosed');return end
    if not finite(now) or not finite(dt) or now&lt;self.now or dt&lt;0 then return end
    self.now=now
    if self.completeBombs or self.enemy.dead then return end
    if self.failed and not self:_retry() then return end
    local accepted=math.min(.5,dt);self.discardedSeconds+=dt-accepted
    while accepted&gt;1e-8 and not self.failed and not self.enemy.dead do
        local slice=math.min(FIXED,accepted);self:_slice(slice);accepted-=slice
    end
end

function Race:interaction(slot)
    if self.closed or self.failed or self.completeBombs or not self:_validContext() or not self:_controlledHero(slot) then return {available=false} end
    local bomb=self.course.bombs[self.bombIndex];local p=self.world:position(slot)
    if bomb and distance(p,bomb.position)&lt;=bomb.radius then return {available=true,action='Defuse bomb',kind='CampaignBomb'} end
    return {available=false}
end
function Race:interact(slot,now,action)
    if action~='Punch' or not finite(now) or now&lt;self.now or not self:interaction(slot).available then return 'NO_INTERACTION' end
    self.now=now
    local bomb=self.course.bombs[self.bombIndex]
    if self.world.campaignObject then self.world:campaignObject(bomb.id,'Bomb',bomb.position,{w=3,h=3,d=3},
        {collidable=false,role='Defused',alpha=.6}) end
    self:_log('CampaignBombDefused',slot,{bomb=self.bombIndex,actorId=self.enemy.actorId})
    self.bombIndex+=1
    self:resetRound('BombDefused')
    return 'OK'
end

function Race:available(userId)
    if self.closed or self.completeBombs or self.enemy.dead or self.enemy.engaged or self.enemy.ownerUserId
        or not self:_validContext() or self.session.state.status~='Active' then return {} end
    return {{enemyId=self.enemyId,actorId=self.enemy.actorId,name='Racing Rat',resourceKind='CourseRival',hearts=0,maxHearts=0}}
end
function Race:claim(userId,id)
    if self.closed or not self:_validContext() or self.session.state.status~='Active' then return 'RUN_CLOSED' end
    if id~=self.enemyId then return 'UNKNOWN_ENEMY' end
    local e=self.enemy
    if e.ownerUserId==userId then return e.dead and 'ENEMY_LIFE_SPENT' or 'OK' end
    if e.dead or self.completeBombs then return 'ENEMY_DEAD' end
    if e.ownerUserId then return 'ENEMY_OCCUPIED' end
    if e.engaged then return 'ENEMY_ENGAGED' end
    e.ownerUserId=userId;e.connected=true;e.connectionEpoch=1;e.lastSeq=0
    self.input={x=0,z=0,at=-math.huge}
    if self.world.enemyIdentity then self.world:enemyIdentity(self.enemyId,e.actorId,self.ownerNames and self.ownerNames[userId]) end
    self:_log('CampaignRaceClaimed',nil,{enemyId=self.enemyId,actorId=e.actorId,ownerUserId=userId})
    return 'OK'
end
function Race:controlled(userId)
    local e=self.enemy;if e.ownerUserId~=userId then return nil end
    return {enemyId=self.enemyId,actorId=e.actorId,attempt=1,connectionEpoch=e.connectionEpoch,connected=e.connected,
        status=e.dead and 'Dead' or 'Alive',template='Racer',name='Racing Rat',resourceKind='CourseRival',hearts=0,maxHearts=0,
        movementKind='Race',reactionEpoch=e.reactionEpoch,progress=self.bombIndex-1,bombIndex=self.bombIndex}
end
function Race:connection(userId,connected)
    local e=self.enemy
    if e.ownerUserId~=userId then return 'UNKNOWN_ENEMY' end
    if type(connected)~='boolean' then return 'INVALID_CONNECTION' end
    if e.connected==connected then return 'NO_CHANGE' end
    e.connected=connected;e.connectionEpoch+=1;e.lastSeq=0;self.input={x=0,z=0,at=-math.huge}
    if not self.stunnedUntil then self.velocity.x=0;self.velocity.z=0 end
    self:_log('CampaignRaceConnection',nil,{actorId=e.actorId,connected=connected,connectionEpoch=e.connectionEpoch})
    return 'OK'
end
function Race:command(userId,payload,now,validator)
    local e=self.enemy
    if e.ownerUserId~=userId then return 'UNKNOWN_ENEMY' end
    if self.closed or not self:_validContext() or self.session.state.status~='Active' then return 'RUN_CLOSED' end
    if type(validator)~='function' or not validator(payload) then return 'INVALID_INTENT' end
    if payload.runId~=self.runId then return 'WRONG_RUN' end
    if not e.connected then return 'OFFLINE' end
    if e.dead or self.completeBombs then return 'NOT_ALIVE' end
    if payload.actorId~=e.actorId or payload.attempt~=1 or payload.levelEpoch~=self.levelEpoch then return 'STALE_ACTOR' end
    if payload.connectionEpoch~=e.connectionEpoch then return 'STALE_CONNECTION' end
    if payload.seq&lt;=e.lastSeq then return 'STALE_SEQUENCE' end
    if not finite(now) or now&lt;0 then return 'INVALID_TIME' end
    if now&lt;self.now then return 'TIME_REVERSED' end
    self.now=now;e.lastSeq=payload.seq
    if self.failed then return 'RACE_RESET_PENDING' end
    if self.stunnedUntil and now&lt;self.stunnedUntil then return 'REACTION' end
    if payload.kind=='Move' then
        local x,z=normalized(payload.x,payload.z);self.input={x=x,z=z,at=now};return 'OK'
    elseif payload.kind=='Jump' then
        if self.introRemaining&gt;0 then return 'RACE_STARTING' end
        return self:_jump() and 'OK' or 'NO_JUMP'
    end
    return 'NO_ACTION'
end
function Race:closeTargetForAttack(targets)
    for _,id in ipairs(targets) do if id==self.enemyId and not self.enemy.dead then self.enemy.engaged=true;return true end end
    return false
end
function Race:hit(attacker,target,action,tuning)
    if target~=self.enemyId or self.closed or self.failed or self.completeBombs or self.enemy.dead or not self:_validContext() then return false end
    if self.stunnedUntil and self.now&lt;self.stunnedUntil then return false end
    local combat=self.session.Combat
    if not combat or not combat.hitEnemy then return false end
    -- 0xF0 is restored by the racing source handler each running frame. Keep
    -- the source response profile, but do not turn this rival into fake HP.
    local source=combat.hitEnemy(255,action)
    local config=self.session.config
    local policy=tuning and tuning.sourceCombat or config.SourceCombat
    local duration=(policy and (source.heavyReaction and policy.npcHeavyReaction or policy.npcLightReaction))
        or (tuning and tuning.reaction) or self.course.ratStunSeconds or .55
    self.stunnedUntil=self.now+math.max(1/60,duration);self.enemy.reactionEpoch+=1
    if self.session.state.heroes[attacker] then self.enemy.engaged=true end
    self.input={x=0,z=0,at=-math.huge};self.route=nil
    local responses=tuning and tuning.responses or config.Impulses
    local impulse=responses and responses[source.profile]
    local origin=self.world:position(attacker)
    local dx,dz=origin and self.position.x-origin.x or 1,origin and self.position.z-origin.z or 0
    local supplied=tuning and tuning.impulseDirection
    if supplied and finite(supplied.x) and finite(supplied.z) then dx,dz=supplied.x,supplied.z end
    dx,dz=direction(dx,dz);if dx==0 and dz==0 then dx=1 end
    local horizontal=impulse and impulse.horizontal or 6;local vertical=impulse and impulse.vertical or (source.heavyReaction and 16 or 0)
    self.velocity=point(dx*horizontal,vertical,dz*horizontal)
    if vertical&gt;0 then self.grounded=false;self.support=nil end
    if self.world.setReaction then self.world:setReaction(self.enemyId,true) end
    self:_log('CampaignRaceRatHit',nil,{attacker=attacker,action=action,profile=source.profile,actorId=self.enemy.actorId,
        stunUntil=self.stunnedUntil,reactionEpoch=self.enemy.reactionEpoch})
    return true
end
function Race:onHit(attacker,target,action,tuning) return self:hit(attacker,target or self.enemyId,action or 'Punch',tuning) end
function Race:isTarget(id) return id==self.enemyId and not self.enemy.dead and not self.closed end
function Race:_retire(reason)
    if self.enemy.dead then return end
    self.enemy.dead=true;self.input={x=0,z=0,at=-math.huge}
    if self.world.campaignRelease then self.world:campaignRelease(self.enemyId) end
    if self.world.kill then self.world:kill(self.enemyId) end
    self:_log('CampaignRaceRivalClosed',nil,{actorId=self.enemy.actorId,reason=reason})
end
function Race:close(reason)
    if self.closed then return end
    self.closed=true;self:_retire(reason or 'Closed')
end
function Race:snapshot()
    local bomb=self.course.bombs[self.bombIndex]
    return {enemyId=self.enemyId,actorId=self.enemy.actorId,resourceKind='CourseRival',bombIndex=self.bombIndex,
        bombCount=#self.course.bombs,elapsed=self.elapsed,failed=self.failed,completeBombs=self.completeBombs,
        position=copy(self.position),velocity=copy(self.velocity),grounded=self.grounded,support=self.support,
        stunned=self.stunnedUntil~=nil and self.now&lt;self.stunnedUntil,stunUntil=self.stunnedUntil,
        introRemaining=self.introRemaining,engaged=self.enemy.engaged,ownerUserId=self.enemy.ownerUserId,
        connected=self.enemy.connected,dead=self.enemy.dead,
        raceTime=bomb and distance(self.position,bomb.position)/(self.course.ratSpeed or 9) or nil,
        raceTimeKind='DistanceEstimate',discardedSeconds=self.discardedSeconds}
end
return Race
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT19">
          <Properties>
            <string name="Name">CampaignRoster</string>
            <ProtectedString name="Source">-- Pinned source identity/loader profiles, separate from authored Roblox populations.
-- cfg byte 10 OR $0F is loaded by main.asm:28889-28895. Sentinel Life $FF
-- on an Invader is linked health-bar state, never 255 ordinary hit points.
local Roster={}
local prefix='build/canonical-source/'
local function profile(variants,file,lines,extra)
    local p=extra or {};p.lifeVariants=variants;p.source=prefix..file;p.lines=lines
    p.loader='main.asm:28889-28895';return p
end
Roster.profiles={
    Raven=profile({79},'levels_cfgs1.asm',{49,50},{lifeMode='ReactionDeath',handler='main.asm:4990-4998'}),
    LargeRaven=profile({79},'levels_cfgs1.asm',{59,60},{lifeMode='ClawOnReaction',handler='main.asm:4927-4984'}),
    SaturnToadtrap=profile({15,31,47,63},'levels_cfgs1.asm',{53,92,106,108}),
    RetroBlaster=profile({31,47,79},'levels_cfgs1.asm',{67,65,105}),
    Invader=profile({},'levels_cfgs1.asm',{126,127,128},{loaderLife=255,lifeMode='LinkedLife',runtimeLife=15,
        adaptation='Ordinary one-life body; linked raw-eight theft and recoverable token, not linear sentinel HP',handler='main.asm:5472-5723'}),
    RocketRat=profile({15},'levels_cfgs1.asm',{196,197},{handler='main.asm:10088-10124'}),
    Snowman=profile({15,31},'levels_cfgs1.asm',{263,271}),
    SentryDrone=profile({15},'levels_cfgs2.asm',{158}),
    Slug=profile({15},'levels_cfgs2.asm',{176}),
    GasTurret=profile({15},'levels_cfgs2.asm',{185}),
    Robot=profile({15},'levels_cfgs2.asm',{230}),
    Electrofish=profile({15},'levels_cfgs2.asm',{253}),
    Hammerfish=profile({15,31},'levels_cfgs2.asm',{257,282}),
    Shark=profile({15,47,63},'levels_cfgs2.asm',{263,283,275}),
    Duck=profile({15},'levels_cfgs2.asm',{278}),
    Hordhead=profile({47,63},'levels_cfgs1.asm',{336,361}),
    Swellcheeks=profile({47,79,111},'levels_cfgs1.asm',{365,374,380}),
    FlyingHead=profile({15},'levels_cfgs1.asm',{425}),
}
local function assign(e,counts)
    local p=Roster.profiles[e.kind];if not p then return end
    counts[e.kind]=(counts[e.kind] or 0)+1
    local n=e.sourceVariant or (counts[e.kind]-1)%math.max(1,#p.lifeVariants)+1
    e.rawLife=p.runtimeLife or assert(p.lifeVariants[n],'Invalid source Life variant')
    e.sourceVariant=n;e.sourceProfile=p
end
function Roster.apply(def,index)
    if def.rosterProfilesApplied then return def end
    local counts={}
    if index==2 then
        local zone=assert(def.zones[1]);local c=def.course;local hazards,emitters={},{}
        local function add(kind,p)
            local id=-1
            for _,e in ipairs(zone.enemies) do id=math.min(id,e.id-1) end
            zone.enemies[#zone.enemies+1]={id=id,kind=kind,x=p.x,y=p.y,z=p.z}
        end
        for _,h in ipairs(c.hazards) do
            if h.kind=='Raven' or h.kind=='Toadtrap' then add(h.kind=='Raven' and 'Raven' or 'SaturnToadtrap',h)
            else hazards[#hazards+1]=h end
        end
        for _,e in ipairs(c.emitters or {}) do
            if e.kind=='RetroBlaster' then add('RetroBlaster',e.position) else emitters[#emitters+1]=e end
        end
        -- Additional authored large species encounter; source count is not inferred.
        add('LargeRaven',{x=-10,y=128,z=0})
        c.hazards=hazards;c.emitters=emitters
    end
    if index==12 then
        -- Explicit Roblox placements exercise the distinct source capacities;
        -- these are not claims about natural NES object counts or coordinates.
        local zone=def.zones[1];local platforms=def.course.towerPlatforms
        for _,e in ipairs(zone.enemies) do
            if e.kind=='Hordhead' and platforms and platforms[4] then
                local p=platforms[4];e.x=math.cos(p.angle)*p.radius;e.y=p.y+3;e.z=math.sin(p.angle)*p.radius
            end
        end
        local function add(kind,variant,n)
            local p=assert(platforms[n]);local id=-1
            for _,e in ipairs(zone.enemies) do id=math.min(id,e.id-1) end
            zone.enemies[#zone.enemies+1]={id=id,kind=kind,sourceVariant=variant,
                x=math.cos(p.angle)*p.radius,y=p.y+(kind=='Hordhead' and 3 or 7),z=math.sin(p.angle)*p.radius,
                placement='AUTHORED_SOURCE_VARIANT'}
        end
        add('Hordhead',2,7);add('Swellcheeks',2,10);add('Swellcheeks',3,15)
    end
    for _,zone in ipairs(def.zones or {}) do for _,e in ipairs(zone.enemies) do assign(e,counts) end end
    for _,e in ipairs(def.course and def.course.encounters or {}) do assign(e,counts) end
    def.rosterProfilesApplied=true;return def
end
return Roster
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="BT20">
          <Properties>
            <string name="Name">CampaignWorld</string>
            <ProtectedString name="Source">-- Native geometry for authored campaign modes. Coordinates remain local to one party.
-- Mode simulation decides collisions/outcomes; this module never awards progress or lives.
local CampaignWorld={}
CampaignWorld.__index=CampaignWorld
local Workspace=game:GetService('Workspace')
local CourseAppearance=require(script.Parent.CourseAppearance)
local CoursePropAppearance=require(script.Parent.CoursePropAppearance)
local Definition=require(script.Parent.CampaignDefinition)
local palettes={
    Rope={45,63,78},Speeder={106,75,47},Ice={133,185,206},Surf={42,124,141},
    Serpents={71,111,69},Jet={125,65,44},Ascent={76,88,107},Tubes={61,105,114},
    Race={139,98,54},Clinger={106,76,141},Tower={85,107,108},Finale={87,53,103},
}
local function vec(p,default)
    return Vector3.new(p.x or p.w or default,p.y or p.h or default,p.z or p.d or default)
end
local function makePart(parent,name,size,frame,color,collidable,material)
    local p=Instance.new('Part')
    p.Name=name;p.Size=size;p.CFrame=frame;p.Color=color
    p.Material=material or Enum.Material.SmoothPlastic;p.Anchored=true
    p.CanCollide=collidable==true;p.CanTouch=false;p.CanQuery=collidable==true
    p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth
    p.Parent=parent
    return p
end
local function caption(parent,text)
    local gui=Instance.new('BillboardGui');gui.Name='CourseLabel'
    gui.Size=UDim2.fromOffset(230,42);gui.StudsOffset=Vector3.new(0,3,0)
    gui.AlwaysOnTop=false;gui.MaxDistance=80;gui.Parent=parent
    local label=Instance.new('TextLabel');label.Name='Caption';label.Size=UDim2.fromScale(1,1)
    label.BackgroundTransparency=1;label.Text=text;label.TextColor3=Color3.fromRGB(231,244,221)
    label.TextStrokeTransparency=.4;label.Font=Enum.Font.GothamBold;label.TextSize=15
    label.TextWrapped=true;label.Parent=gui
    return label
end
function CampaignWorld.new(world,route)
    local self=setmetatable({world=world,route=route,objects={}},CampaignWorld)
    world.geometry:ClearAllChildren()
    world.allFloors={};world.floors={};world.gates={}
    local rgb=palettes[route.mode] or palettes.Ascent
    self.color=Color3.fromRGB(rgb[1],rgb[2],rgb[3])
    local function support(data,index)
        local material=route.mode=='Ice' and Enum.Material.Ice or Enum.Material.Metal
        local p=makePart(world.geometry,'CourseSupport_'..index,Vector3.new(data.w,data.h,data.d),
            CFrame.new(data.x,data.y,data.z)+world.offset,self.color,true,material)
        if route.mode=='Speeder' then
            local rise=data.roadRise or 0
            local angle=math.atan2(rise,data.w)
            local length=math.sqrt(data.w^2+rise^2)
            local top=CFrame.new(data.x,data.y+data.h/2,data.z)*CFrame.Angles(0,0,angle)+world.offset
            p.Size=Vector3.new(length,data.h,data.d)
            p.CFrame=top*CFrame.new(0,-data.h/2,0)
            p.Material=Enum.Material.Asphalt
            p.Color=Color3.fromRGB(121,107,87)
            -- Arrival overlaps the boarding pad. Keep only one textured top there.
            if index~='Arrival' then
                local grit=Instance.new('Texture')
                grit.Name='RoadAggregate';grit.Face=Enum.NormalId.Top
                grit.Texture='rbxasset://textures/ui/LegacyRbxGui/Asphalt.png'
                grit.StudsPerTileU=5;grit.StudsPerTileV=5;grit.Transparency=.48;grit.Parent=p
            end
            if data.roadRise then
                for _,side in ipairs({-1,1}) do
                    makePart(world.geometry,'CopperShoulder',Vector3.new(length,.08,.55),
                        top*CFrame.new(0,.035,side*(data.d/2-1)),Color3.fromRGB(191,132,65),false,Enum.Material.Concrete)
                    makePart(world.geometry,'WornLaneMark',Vector3.new(length*.38,.045,.24),
                        top*CFrame.new(0,.025,side*7.5),Color3.fromRGB(205,183,137),false,Enum.Material.Concrete)
                end
            end
        end
        p:SetAttribute('SurfaceId',route.id..':'..index);p:SetAttribute('ZoneIndex',1)
        world.allFloors[#world.allFloors+1]=p;world.floors[#world.floors+1]=p
        return p
    end
    if not route.course.renderDynamicPlatforms then
        for i,data in ipairs(route.course.platforms or {}) do support(data,tostring(i)) end
    end
    -- The arrival ledge exists before mode creation, so transition/initial spawn
    -- preflight is based on real support, including a rope or rotating tower.
    support({x=route.spawn.x,y=route.spawn.y-4,z=route.spawn.z,w=18,h=2,d=24},'Arrival')
    support(route.boss.platform,'Arena')
    local p=route.boss.pad
    self.exit=makePart(world.geometry,'CampaignExitSeal',Vector3.new(p.w,.15,p.d),
        CFrame.new(p.x,p.y,p.z)+world.offset,Color3.fromRGB(154,249,130),false,Enum.Material.Neon)
    self.exit.Transparency=.7
    caption(self.exit,'EXIT')
    self.header=makePart(world.geometry,'CourseTitleMarker',Vector3.new(.4,.4,.4),
        CFrame.new(route.spawn.x,route.spawn.y+6,route.spawn.z)+world.offset,self.color,false)
    self.header.Transparency=1
    caption(self.header,tostring(route.campaignIndex)..' / 13  '..route.name)
    -- Decorative depth/walls do not bridge playable gaps or become safe supports.
    if route.mode=='Rope' then
        for _,side in ipairs({-1,1}) do
            makePart(world.geometry,'ShaftWall',Vector3.new(3,270,42),
                CFrame.new(side*27,125,0)+world.offset,Color3.fromRGB(34,43,53),false,Enum.Material.Rock)
        end
    elseif route.mode=='Tower' then
        makePart(world.geometry,'SpireCore',Vector3.new(22,125,22),
            CFrame.new(0,54,0)+world.offset,Color3.fromRGB(42,55,60),false,Enum.Material.Slate)
    elseif route.mode=='Speeder' or route.mode=='Jet' then
        local course=route.course
        for x=40,course.finishDistance or 420,28 do
            for _,side in ipairs({-1,1}) do
                makePart(world.geometry,'CourseLaneBeacon',Vector3.new(.5,3,.5),
                    CFrame.new(x,1+Definition.roadHeight(course,x),side*23)+world.offset,Color3.fromRGB(245,192,76),false,Enum.Material.Neon)
            end
        end
    elseif route.mode=='Clinger' then
        for n,segment in ipairs(route.course.path or {}) do
            local p=segment.from
            local arrow=segment.direction.x&gt;0 and '→' or segment.direction.x&lt;0 and '←'
                or segment.direction.z&gt;0 and '↓' or '↑'
            local marker=makePart(world.geometry,'CircuitDirection_'..n,Vector3.new(.3,.3,.3),
                CFrame.new(p.x+segment.direction.x*5,p.y+.5,p.z+segment.direction.z*5)+world.offset,
                Color3.fromRGB(221,230,114),false)
            marker.Transparency=1;caption(marker,arrow)
        end
    end
    world.folder:SetAttribute('LevelName',route.name)
    world.folder:SetAttribute('CampaignIndex',route.campaignIndex)
    world.folder:SetAttribute('CampaignMode',route.mode)
    world.config.FallY=(route.bounds.minY or -40)-15+world.offset.Y
    return self
end

local surfaces={Serpent=true,Lift=true,TowerPlatform=true,Platform=true,IceBlock=true,Support=true}
local vehicles={Speeder=true,Surfboard=true,Jet=true,Board=true,ClingerVehicle=true}
local orbs={AirMine=true,Mine=true,Bomb=true,Buzzball=true,Orb=true,Snowball=true,Whirlpool=true}
local function scaledFrame(frame,scale)
    return CFrame.new(frame.Position*scale)*frame.Rotation
end
local function meshBounds(model)
    local low,high=Vector3.new(math.huge,math.huge,math.huge),Vector3.new(-math.huge,-math.huge,-math.huge)
    local bodyTop,count=-math.huge,0
    for _,p in ipairs(model:GetChildren())do if p:IsA('MeshPart')then
        count+=1
        for _,x in ipairs({-1,1})do for _,y in ipairs({-1,1})do for _,z in ipairs({-1,1})do
            local point=p.CFrame:PointToWorldSpace(Vector3.new(p.Size.X*x/2,p.Size.Y*y/2,p.Size.Z*z/2))
            low=Vector3.new(math.min(low.X,point.X),math.min(low.Y,point.Y),math.min(low.Z,point.Z))
            high=Vector3.new(math.max(high.X,point.X),math.max(high.Y,point.Y),math.max(high.Z,point.Z))
            if p.Name=='Body'then bodyTop=math.max(bodyTop,point.Y)end
        end end end
    end end
    assert(count&gt;0 and high.X&gt;low.X and high.Z&gt;low.Z and bodyTop&gt;-math.huge,'Invalid serpent mesh bounds')
    return low,high,bodyTop
end
local function removeSerpent(row)
    local skin=row.serpent;if not skin then return end
    row.serpent=nil
    if skin.actor.castAppearance then pcall(skin.appearance.detach,skin.actor)end
    skin.proxy:Destroy();skin.temporary:Destroy()
    if row.part.Parent then row.part.Transparency=skin.previousTransparency end
end
local function prepareSerpent(self,row)
    local appearance=self.world.castAppearance
    if not appearance or type(appearance.attach)~='function' or type(appearance.update)~='function'
        or type(appearance.detach)~='function' then return end
    local templates=game:GetService('ServerStorage'):FindFirstChild('BrickToadsCastTemplates')
    local source=templates and templates:FindFirstChild('Snake')
    if not source or not source:IsA('Model')then return end
    local temporary,proxy,actor
    local ok,skin=pcall(function()
        temporary=Instance.new('Folder');temporary.Name='OwnedSerpentTemplate'
        local template=assert(source:Clone(),'Uncloneable serpent template');template.Parent=temporary
        local low,high,bodyTop=meshBounds(template)
        local size=row.part.Size
        local scale=math.min(size.X/(high.Z-low.Z),size.Z/(high.X-low.X))
        assert(scale&gt;0 and scale&lt;math.huge,'Invalid serpent fit')
        -- A caches immutable rest frames. Scale every mesh and pivot before it
        -- assembles the cosmetic rig; shared ServerStorage assets stay intact.
        for _,p in ipairs(template:GetDescendants())do
            if p:IsA('MeshPart')then
                p.Size=p.Size*scale;p.CFrame=scaledFrame(p.CFrame,scale)
                p.Massless=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
            elseif p:IsA('Attachment')then p.CFrame=scaledFrame(p.CFrame,scale)end
        end
        proxy=Instance.new('Model');proxy.Name='SerpentAppearance_'..tostring(row.id)
        local torso=makePart(proxy,'Torso',Vector3.new(.05,.05,.05),CFrame.new(),self.color,false)
        torso.Transparency=1;torso.Massless=true
        actor={model=proxy,root=torso}
        assert(appearance.attach(actor,'Snake',temporary),'Invalid serpent skin')
        -- The NES body is a nametable path. This bounded3D support fit is an
        -- authored adaptation of the decoded head/link references, not its trace.
        proxy:SetAttribute('CosmeticAdaptation','SourceHeadLinkWithAuthored3DSerpentSupportFit')
        proxy:SetAttribute('SourceBodyTrace','UNKNOWN_NAMETABLE_BODY')
        local middle=(low.Z+high.Z)/2
        local fit=CFrame.new(0,size.Y/2-bodyTop*scale,0)*CFrame.Angles(0,math.pi/2,0)*CFrame.new(0,0,-middle*scale)
        return {actor=actor,proxy=proxy,temporary=temporary,appearance=appearance,fit=fit,size=size,
            previousTransparency=row.part.Transparency or 0}
    end)
    if not ok then
        if actor and actor.castAppearance then pcall(appearance.detach,actor)end
        if proxy then proxy:Destroy()end;if temporary then temporary:Destroy()end
        return
    end
    row.serpent=skin;skin.proxy.Parent=self.world.geometry
    if appearance.addFallback then appearance.addFallback(skin.actor,row.part) end
end
function CampaignWorld:_serpent(row,now)
    local skin=row.serpent;local size=row.part.Size
    if skin and (skin.size.X~=size.X or skin.size.Y~=size.Y or skin.size.Z~=size.Z)then removeSerpent(row);skin=nil end
    if not skin then prepareSerpent(self,row);skin=row.serpent end
    if not skin then return end
    skin.actor.root.CFrame=row.part.CFrame*skin.fit
    skin.appearance.update(skin.actor,{kind='Snake',actorId=self.route.id..':serpent:'..tostring(row.id),
        levelEpoch=self.route.campaignIndex,now=now or 0,dt=0,mode='Idle',speed=0})
end
CampaignWorld.bossNames={BigBlag='Big Blag',RoboManus='Robo-Manus',GeneralSlaughter='General Slaughter',
    Buzzball='Buzzball',DarkQueen='Dark Queen'}
function CampaignWorld.decorateActor(actor,kind)
    local torso=actor.model:FindFirstChild('Torso')
    if not torso then return end
    for _,p in ipairs(actor.model:GetDescendants()) do
        if p:IsA('BasePart') and p~=actor.root then p.Transparency=1 end
    end
    local function shape(name,size,offset,color,round)
        local p=makePart(actor.model,name,size,torso.CFrame*offset,color,false)
        p.Anchored=false;p.Massless=true;p.CanQuery=false
        if round then p.Shape=Enum.PartType.Ball end
        local motor=Instance.new('Motor6D');motor.Name=name..'Joint';motor.Part0=torso;motor.Part1=p
        motor.C0=offset;motor.C1=CFrame.new();motor.Parent=p
        return p
    end
    local purple=Color3.fromRGB(103,54,133)
    local red=Color3.fromRGB(148,52,45)
    local metal=Color3.fromRGB(58,67,75)
    local cream=Color3.fromRGB(218,194,143)
    if kind=='RacingRat' then
        local fur=Color3.fromRGB(143,100,62)
        shape('RacerBody',Vector3.new(3.2,2.2,4.1),CFrame.new(0,-.4,.2),fur,true)
        shape('RacerSnout',Vector3.new(2,1.9,2.5),CFrame.new(0,-.1,-2),fur,true)
        for _,side in ipairs({-1,1}) do
            shape('RacerEar'..side,Vector3.new(.9,.7,.7),CFrame.new(side*.8,.65,-1.9),Color3.fromRGB(205,150,121),true)
            for _,z in ipairs({-1,1}) do shape('RacerFoot'..side..z,Vector3.new(.7,1.3,.7),CFrame.new(side,-2.3,z),fur) end
        end
        shape('RacerTail',Vector3.new(.35,.35,4),CFrame.new(0,-1.4,3.8),Color3.fromRGB(190,140,113))
    elseif kind=='Buzzball' then
        shape('BuzzballShell',Vector3.new(6,6,6),CFrame.new(),purple,true)
        for n=1,8 do local a=n*math.pi/4
            shape('RadialSpike'..n,Vector3.new(.55,1.4,.55),CFrame.new(math.cos(a)*3,math.sin(a)*3,0)*CFrame.Angles(0,0,a-math.pi/2),cream)
        end
        shape('BuzzballCore',Vector3.new(2.8,2.8,.6),CFrame.new(0,0,-2.9),Color3.fromRGB(224,121,220),true)
    elseif kind=='BigBlag' then
        shape('BlagBody',Vector3.new(7.5,5.2,4),CFrame.new(0,.2,0),purple,true)
        shape('BlagBelly',Vector3.new(5.1,4,1.1),CFrame.new(0,-.1,-1.7),cream,true)
        shape('BlagHead',Vector3.new(4.6,2.2,3),CFrame.new(0,3.3,-.4),purple,true)
        for _,side in ipairs({-1,1}) do
            shape('BlagFist'..side,Vector3.new(2.5,2.3,2.5),CFrame.new(side*4,.3,-.2),purple,true)
            shape('BlagFoot'..side,Vector3.new(2.4,.8,2.7),CFrame.new(side*2,-2.4,-.5),purple,true)
        end
    elseif kind=='RoboManus' then
        shape('RobotTorso',Vector3.new(4.2,4.3,2.5),CFrame.new(0,.6,0),red)
        shape('RobotHead',Vector3.new(2.3,2,2),CFrame.new(0,3.7,0),metal)
        shape('RobotVisor',Vector3.new(1.8,.45,.3),CFrame.new(0,3.8,-1.05),Color3.fromRGB(255,186,56))
        for _,side in ipairs({-1,1}) do
            shape('RobotShoulder'..side,Vector3.new(2.2,2,2.6),CFrame.new(side*3,1.6,0),red)
            shape('RobotCannon'..side,Vector3.new(1.5,2,3.6),CFrame.new(side*3,-.1,-1),metal)
            shape('RobotLeg'..side,Vector3.new(1.5,2.4,1.7),CFrame.new(side*1.2,-1.6,0),metal)
        end
    elseif kind=='GeneralSlaughter' then
        shape('GeneralBody',Vector3.new(5.4,4.8,3.3),CFrame.new(0,.2,0),Color3.fromRGB(146,104,67),true)
        shape('GeneralHead',Vector3.new(3.7,2.4,3),CFrame.new(0,3.2,-.7),Color3.fromRGB(123,77,47),true)
        for _,side in ipairs({-1,1}) do
            shape('GeneralHorn'..side,Vector3.new(.7,2.2,.7),CFrame.new(side*1.9,4.2,-.8)*CFrame.Angles(0,0,-side*.65),cream)
            shape('GeneralHoof'..side,Vector3.new(1.7,1.1,2),CFrame.new(side*1.7,-2.4,-.3),metal)
        end
    elseif kind=='DarkQueen' then
        shape('QueenTorso',Vector3.new(2.7,3.1,1.7),CFrame.new(0,.5,0),purple)
        shape('QueenHead',Vector3.new(2.1,2.2,1.8),CFrame.new(0,3.1,-.1),cream,true)
        shape('QueenCape',Vector3.new(5.4,4.4,.55),CFrame.new(0,.4,.9),Color3.fromRGB(49,25,65))
        for _,side in ipairs({-1,1}) do
            shape('QueenArm'..side,Vector3.new(.9,2.8,.9),CFrame.new(side*1.9,.7,0)*CFrame.Angles(0,0,-side*.4),purple)
            shape('QueenBoot'..side,Vector3.new(1,2.5,1.2),CFrame.new(side*.7,-1.4,-.2),purple)
        end
        for n=-2,2 do shape('CrownPoint'..n,Vector3.new(.35,.7+math.abs(n)*.15,.35),CFrame.new(n*.4,4.5,-.1),Color3.fromRGB(227,178,45)) end
    else
        -- Ordinary family silhouettes remain separate from the physical collider.
        local bird=kind=='Raven' or kind=='LargeRaven'
        local color=kind=='Snowman' and Color3.fromRGB(217,237,241) or bird and Color3.fromRGB(42,45,70) or Color3.fromRGB(130,96,70)
        local winged=bird or kind=='FlyingHead' or kind=='SentryDrone'
        shape('CampaignEnemyBody',Vector3.new(2.8,3.2,2.4),CFrame.new(0,-.1,0),color,true)
        shape('CampaignEnemyHead',Vector3.new(2.3,1.9,2.1),CFrame.new(0,2.1,-.3),color,true)
        if winged then for _,side in ipairs({-1,1}) do
            shape('CampaignWing'..side,Vector3.new(3.5,.4,2),CFrame.new(side*2.2,1.1,0),metal)
        end end
        if bird then
            shape('RavenBeak',Vector3.new(1.4,.8,2.2),CFrame.new(0,2,-1.8),Color3.fromRGB(214,167,61))
            if kind=='LargeRaven' then shape('LargeRavenRuff',Vector3.new(4.1,1.2,3.5),CFrame.new(0,.6,0),color,true) end
        end
        if kind=='GasTurret' or kind=='Robot' or kind=='RocketRat' or kind=='RetroBlaster' then
            shape('CampaignWeapon',Vector3.new(1.2,1.2,3.5),CFrame.new(0,.6,-1.8),metal)
        end
        if kind=='SaturnToadtrap' then
            shape('TrapJaw',Vector3.new(3.2,1.1,3.8),CFrame.new(0,.1,-1.4),Color3.fromRGB(80,139,78),true)
        end
    end
end
function CampaignWorld:object(id,kind,point,size,metadata)
    if type(point)~='table' then return end
    metadata=metadata or {};size=size or {x=2,y=2,z=2}
    local row=self.objects[id]
    if row and row.kind~=kind then self:remove(id);row=nil end
    if not row then
        local collidable=metadata.collidable==true or surfaces[kind]==true
        local tint=surfaces[kind] and self.color or Color3.fromRGB(244,107,68)
        if kind=='Tower' then tint=Color3.fromRGB(42,55,60)
        elseif vehicles[kind] then tint=Color3.fromRGB(231,177,51)
        elseif kind=='Rope' then tint=Color3.fromRGB(205,193,136)
        elseif kind=='Water' then tint=Color3.fromRGB(47,144,178)
        elseif kind=='Telegraph' or kind=='Warning' then tint=Color3.fromRGB(255,207,69) end
        local item=kind=='Tower' and self.world.geometry:FindFirstChild('SpireCore')
            or makePart(self.world.geometry,'Campaign_'..kind..'_'..tostring(id),vec(size,2),CFrame.new(),tint,collidable,
                collidable and Enum.Material.Metal or Enum.Material.Neon)
        if orbs[kind] then item.Shape=Enum.PartType.Ball end
        if kind=='Water' then item.Material=Enum.Material.Glass;item.Transparency=.65 end
        if kind=='Rope' then item.Material=Enum.Material.Fabric end
        if collidable then
            item:SetAttribute('SurfaceId',self.route.id..':dynamic:'..tostring(id));item:SetAttribute('ZoneIndex',1)
            self.world.allFloors[#self.world.allFloors+1]=item
            self.world.floors[#self.world.floors+1]=item
        end
        row={kind=kind,part=item,id=id};self.objects[id]=row
        if metadata.label then row.label=caption(item,metadata.label) end
    end
    local yaw=metadata.yaw or point.yaw or 0
    row.part.Size=vec(size,2)
    row.part.CFrame=CFrame.new(point.x,point.y,point.z)*CFrame.Angles(0,yaw,0)+self.world.offset
    if kind=='Tower' then
        row.part.Shape=Enum.PartType.Cylinder
        row.part.Size=Vector3.new(size.h or size.y,size.w or size.x,size.d or size.z)
        row.part.CFrame=CFrame.new(point.x,point.y,point.z)*CFrame.Angles(0,0,math.pi/2)+self.world.offset
    end
    if kind=='Rope' and metadata.anchor and metadata.endpoint then
        local a=vec(metadata.anchor,0)+self.world.offset
        local b=vec(metadata.endpoint,0)+self.world.offset
        if (b-a).Magnitude&gt;.01 then
            row.part.Size=Vector3.new(.18,.18,(b-a).Magnitude)
            row.part.CFrame=CFrame.lookAt((a+b)/2,b)
        end
    end
    if metadata.alpha then row.part.Transparency=metadata.alpha end
    if row.label and metadata.label then row.label.Text=metadata.label end
    row.expiresAt=metadata.expiresAt
    if kind=='Serpent'then self:_serpent(row,self.now or 0)end
    local waterSurfaceY
    if kind=='Surfboard'or kind=='Board'then
        for _,water in ipairs(self.route.course.media or{})do
            if water.kind=='Water'and point.x&gt;=water.minX and point.x&lt;=water.maxX
                and point.z&gt;=water.minZ and point.z&lt;=water.maxZ then
                waterSurfaceY=math.max(waterSurfaceY or-math.huge,water.maxY+self.world.offset.Y)
            end
        end
    end
    CourseAppearance.update(row,self.world.geometry,metadata,waterSurfaceY)
    CoursePropAppearance.update(row,self.world.geometry,metadata,self.now or 0)
    return row.part
end
function CampaignWorld:remove(id)
    local row=self.objects[id]
    if not row then return end
    removeSerpent(row)
    CourseAppearance.remove(row)
    CoursePropAppearance.remove(row)
    for _,floors in ipairs({self.world.allFloors,self.world.floors}) do
        for i=#floors,1,-1 do if floors[i]==row.part then table.remove(floors,i) end end
    end
    row.part:Destroy();self.objects[id]=nil
end
function CampaignWorld:step(now)
    self.now=now
    local expired={}
    for id,row in pairs(self.objects) do
        if row.expiresAt and now&gt;=row.expiresAt then expired[#expired+1]=id end
    end
    for _,id in ipairs(expired) do self:remove(id) end
    for _,row in pairs(self.objects)do
        if row.kind=='Serpent'then self:_serpent(row,now)end
        CoursePropAppearance.step(row,now)
    end
end
function CampaignWorld:stage(name)
    self.world.stageName=name;self.world.folder:SetAttribute('Stage',name)
    self.exit.Transparency=(name=='Exit' or name=='Won') and .12 or .7
end
function CampaignWorld:close()
    local ids={};for id in pairs(self.objects) do ids[#ids+1]=id end
    for _,id in ipairs(ids) do self:remove(id) end
end
return CampaignWorld
