local DASH_TAIL={label='udar_s_razbega:low_life_tail',line=97,endLine=97,bytes={0x31,0xE1,0x04,0x31,0x31,0x31,0x31,0x31,0x31,0x31,0x31,0x31,0x31,0x23,0x23,0x23,0x23,0x00}}
local CATALOG_SHA='fad66ea121c6d92f8c60b2992298738f1a36f6bcaf9731b075772d481f7716f4'
-- END SOURCE CLIPS

local OPCODES={
    [0xE0]={'XSpeed',1},[0xE1]={'ZSpeed',1},[0xE2]={'HitOpportunity',2},
    [0xE3]={'PickupObject',0},[0xE4]={'LinkObject',0},[0xE5]={'DamageLinked',0},
    [0xE6]={'SetFlag4',0},[0xE7]={'AddXSpeed',1},[0xE8]={'SwapDirection',0},
    [0xE9]={'Tongue',0},[0xEA]={'WriteDirection',1},[0xEB]={'XSpeedByShadow',0},
    [0xEC]={'SwapDirection',0},[0xED]={'CreateImpactFrame37',0},[0xEE]={'CreateImpactFrame38',0},
    [0xEF]={'CreateObject32',0},[0xF0]={'SoundFlag',1},[0xF1]={'PlaySound',2},
    [0xF2]={'AddZ',0},[0xF3]={'CreateWeapon',1},[0xF4]={'HeldJumpZSpeed',0},
    [0xF5]={'ClearDamageLatch',0},[0xF6]={'DirectionByX',0},
}
local EMPTY=table.freeze({})
local IDS={}
local function event(opcode,params,sourceByte,advance)
    return freeze({kind=OPCODES[opcode][1],opcode=opcode,params=params,sourceByte=sourceByte,
        advance=advance,appliesDamage=false})
end
local function prepare(clip)
    local frames,events={},{}
    local pointer,advance=1,0
    while pointer&lt;=#clip.bytes do
        local byte=clip.bytes[pointer]
        if byte==0 then break end
        if byte&lt;0xE0 then frames[#frames+1]=byte;advance+=1;pointer+=1
        else
            local count=OPCODES[byte][2]
            local params={}
            for i=1,count do params[i]=clip.bytes[pointer+i] end
            events[#events+1]=event(byte,params,pointer-1+(clip.byteOffset or 0),advance)
            pointer+=count+1
        end
    end
    assert(pointer==#clip.bytes and clip.bytes[pointer]==0,'Source clip must end at its decoded terminator')
    clip.frames=freeze(frames);clip.events=freeze(events)
    clip.description=freeze({animationId=clip.id,label=clip.label,displayAdvances=#frames,
        sourceLine=clip.line,sourceEndLine=clip.endLine,sourceFile='data/anims_moves.asm',
        fallsThroughDeclaredBlock=clip.fallthrough==true,branch=clip.branch or 'Normal',
        frameInterpretation='Caller postprocessing may transform these source frame values'})
    freeze(clip.bytes)
    return clip
end
for id,clip in pairs(CLIPS) do clip.id=id;prepare(clip);IDS[#IDS+1]=id end
table.sort(IDS);freeze(IDS)
DASH_TAIL.id=0x16;DASH_TAIL.branch='DashLowLifeTail';DASH_TAIL.byteOffset=0x37;prepare(DASH_TAIL)
Animation.provenance=freeze({repository='feos-tas/DisAssemble',commit='f1a43b69577246850d136473700a333b3cdfe93f',
    game='Battletoads USA NES',sourceCatalogSha256=CATALOG_SHA,
    mainSha256='71042cf2a4a8fad952e9eb3bcb591cece666c5a790d7ea177b1908d052fca074',
    animationSourceSha256='5dfbe797fa1299d6f6342dbd3a0b6af9e45ff44a0c214bf0cac676ef85e5d181',
    scope='Static presentation domain; emulator timing, full family FSMs and three-player parity unverified',
    unknown={'Complete remaining family animation state traces','Remaining boss appearances','Lag PCM and PAL timing','3D velocity/proportion mapping'}})

local function selected(id,options)
    local clip=integer(id) and CLIPS[id]
    if not clip then return nil,'UNKNOWN_ANIMATION' end
    if options~=nil and type(options)~='table' then return nil,'INVALID_OPTIONS' end
    local branch=options and options.branch or 'Normal'
    if branch=='Normal' then return clip end
    if id==0x16 and branch=='DashLowLifeTail' then return DASH_TAIL end
    return nil,'UNKNOWN_BRANCH'
end
function Animation.ids() return IDS end
function Animation.describe(id,options)
    local clip,code=selected(id,options)
    return clip and clip.description or nil,code
end
function Animation.sampleAdvance(id,advance,options)
    local clip,code=selected(id,options)
    if not clip then return nil,code end
    if not integer(advance) or advance&lt;0 then return nil,'INVALID_ADVANCE' end
    local events={}
    for _,row in ipairs(clip.events) do if row.advance==advance then events[#events+1]=row end end
    return freeze({animationId=id,branch=clip.description.branch,advance=advance,
        frameId=clip.frames[advance+1],ended=advance&gt;=#clip.frames,events=events})
end
function Animation.eventsBetween(id,previous,nextAdvance,options)
    local clip,code=selected(id,options)
    if not clip then return nil,code end
    if not integer(previous) or previous&lt; -1 or not integer(nextAdvance) or nextAdvance&lt;previous then return nil,'INVALID_ADVANCE' end
    local result={}
    for _,row in ipairs(clip.events) do
        if row.advance&gt;previous and row.advance&lt;=nextAdvance then result[#result+1]=row end
    end
    return freeze(result)
end

-- Models the byte interpreter and its caller clock only. Commands are markers:
-- contact, speed, linkage and successful-hit pointer changes never execute here.
-- Dash's verified alternate continuation is selected explicitly.
local schedules={}
local function schedule(clip,mask,phase,firstRead)
    local key=clip.id..':'..clip.description.branch..':'..mask..':'..phase..':'..firstRead
    if schedules[key] then return schedules[key] end
    local result={rows={}}
    local pointer=1
    for tick=0,MAX_CALLS do
        if (tick&gt;0 or firstRead=='Advance') and (phase+tick)%(mask+1)==0 then pointer+=1 end
        local events={}
        while true do
            local byte=clip.bytes[pointer]
            if byte==nil then result.error='SOURCE_BOUNDS';result.endTick=tick;break end
            if byte==0 then
                result.endTick=tick
                result.rows[tick+1]=freeze({animationId=clip.id,branch=clip.description.branch,ended=true,
                    sourceByte=pointer-1+(clip.byteOffset or 0),events=events})
                break
            end
            if byte&lt;0xE0 then
                result.rows[tick+1]=freeze({animationId=clip.id,branch=clip.description.branch,frameId=byte,ended=false,
                    sourceByte=pointer-1+(clip.byteOffset or 0),events=events})
                break
            end
            local opcode=OPCODES[byte]
            if not opcode then result.error='UNKNOWN_OPCODE';result.endTick=tick;break end
            local params={}
            for i=1,opcode[2] do
                params[i]=clip.bytes[pointer+i]
                if params[i]==nil then result.error='SOURCE_BOUNDS' end
            end
            if result.error then result.endTick=tick;break end
            events[#events+1]=event(byte,params,pointer-1+(clip.byteOffset or 0),nil)
            pointer+=opcode[2]+1
        end
        if result.endTick then break end
    end
    assert(result.endTick,'Finite source clip exceeded the explicit clock bound')
    schedules[key]=result
    return result
end
function Animation.sampleClock(id,clock)
    local clip,code=selected(id,clock)
    if not clip then return nil,code end
    if type(clock)~='table' then return nil,'INVALID_CLOCK' end
    local calls,mask,phase=clock.elapsedCalls,clock.callerMask,clock.firstFrameCounterPhase
    local firstRead=clock.firstRead or (clock.branch=='DashLowLifeTail' and 'Read' or 'Advance')
    if not integer(calls) or calls&lt;0 or calls&gt;MAX_CALLS or (mask~=0 and mask~=1 and mask~=3)
        or not integer(phase) or phase&lt;0 or phase&gt;mask or (firstRead~='Read' and firstRead~='Advance')
        or (clock.branch=='DashLowLifeTail' and firstRead~='Read') then return nil,'INVALID_CLOCK' end
    local timeline=schedule(clip,mask,phase,firstRead)
    if calls&gt;=timeline.endTick and timeline.error then return nil,timeline.error end
    local sample=timeline.rows[math.min(calls,timeline.endTick)+1]
    -- End-command markers belong to the termination call, not every later sample.
    if calls&gt;timeline.endTick then return freeze({animationId=id,branch=clip.description.branch,ended=true,
        sourceByte=sample.sourceByte,events=EMPTY,endedAtCall=timeline.endTick}) end
    return sample
end
function Animation.callerMask(family)
    local masks={Hero=1,Pig=3,TallWalker=0,Dragon=3}
    local mask=masks[family]
    if mask==nil then return nil,'UNKNOWN_CALLER' end
    return mask
end

local HERO={Walk={4,5,4,8,6,7,6,3},Run={5,5,8,8,7,7,3,3},CarryWalk={0x11,0x12,0x11,0x10},DepthWalk={1,9,1,0xA}}
local DRAGON={9,9,10,10}
local function inputRow(input)
    if input==nil then return {} end
    if type(input)=='table' then return input end
end
local function phaseIndex(input,length)
    local phase=input.phase or 0
    if not integer(phase) or phase&lt;0 then return nil end
    return phase%length+1
end
local function rawByte(value) return integer(value) and value&gt;= -128 and value&lt;=255 end
function Animation.heroFrame(state,input)
    input=inputRow(input)
    if not input then return nil,'INVALID_STATE_INPUT' end
    if state=='Idle' then return input.blink==true and 2 or 1 end
    if state=='CarryIdle' then return 0x11 end
    if HERO[state] then
        local index=phaseIndex(input,#HERO[state])
        if not index then return nil,'INVALID_STATE_INPUT' end
        return HERO[state][index]
    end
    if state=='Air' then
        if input.holding==true then return 0x2E end
        if not rawByte(input.zSpeedRaw) then return nil,'INVALID_STATE_INPUT' end
        return (input.zSpeedRaw+2)%256&lt;5 and 0x2D or 5
    end
    return nil,'UNKNOWN_STATE'
end
function Animation.dragonFrame(state,input)
    input=inputRow(input)
    if not input then return nil,'INVALID_STATE_INPUT' end
    if state=='Disabled' then return 0xA end
    if state=='Attack' or state=='Capture' then return 0xB end
    if state=='LightReaction' then
        if not integer(input.timerRaw) or input.timerRaw&lt;0 or input.timerRaw&gt;255 then return nil,'INVALID_STATE_INPUT' end
        if input.timerRaw&gt;=0x26 then return 0xC end
    elseif state~='Locomotion' then return nil,'UNKNOWN_STATE' end
    local index=phaseIndex(input,4)
    if not index then return nil,'INVALID_STATE_INPUT' end
    if input.zSpeedRaw~=nil and not rawByte(input.zSpeedRaw) then return nil,'INVALID_STATE_INPUT' end
    if state=='Locomotion' and input.approaching==true and input.zSpeedRaw~=nil and input.zSpeedRaw%256~=0 then return 9 end
    return DRAGON[index]
end

local INTRO_EVENTS=freeze({
    {counter=0x30,kind='Stomp',soundId=0x62,shakeRaw=0xF8},
    {counter=0x50,kind='FootMotionStarted',frameId=0x12},
    {counter=0x64,kind='Stomp',soundId=0x62,shakeRaw=0xF8},
    {counter=0xE0,kind='ArenaCut',musicLevelId=0xE,bank6Function=0x5D},
    {counter=0xFF,kind='IntroEnded'},
})
function Animation.bossWalkerIntro(counter)
    if not integer(counter) or counter&lt;1 or counter&gt;255 then return nil,'INVALID_COUNTER' end
    local ended=counter==255
    local cut=counter==0xE0
    local fear=not ended and not cut and (counter&lt;0xE0 and 0x2C or 0x2E) or nil
    return freeze({counter=counter,ended=ended,phase=ended and 'Complete' or (counter&lt;0xE0 and 'BeforeCut' or 'AfterCut'),
        stomp=counter==0x30 or counter==0x64,footFrame=counter&gt;=0x50 and not ended and 0x12 or nil,
        footMotion=counter&gt;=0x50 and not ended and not cut,cameraCut=cut,
        fearAnimation=fear,fearFrame=fear and (fear==0x2C and 0x32 or 0x33) or nil,
        fearPointerMask=fear and 7 or nil,clearExistingFear=false,
        dropStick=fear~=nil,unlinkCarriedObject=fear~=nil,sourceHeroSlots=2})
end
function Animation.bossWalkerEventsBetween(previous,counter)
    if not integer(previous) or previous&lt;0 or previous&gt;255 or not integer(counter) or counter&lt;previous or counter&gt;255 then return nil,'INVALID_COUNTER' end
    local result={}
    for _,row in ipairs(INTRO_EVENTS) do if row.counter&gt;previous and row.counter&lt;=counter then result[#result+1]=row end end
    return freeze(result)
end
return freeze(Animation)
